def widgets_breadth_selftest() -> "str":
    # L1 acceptance: >= 80 distinct constructors + render non-blank + hit-test.
    print("=== TkvUI widget breadth selftest (L1) ===")
    names = widget_constructor_catalog()
    n = len(names)
    print("  catalog constructors = " + str(n))
    if n < 80:
        print("WIDGETS_BREADTH_FAIL (catalog " + str(n) + " < 80)")
        return "WIDGETS_BREADTH_FAIL"
    acc = []
    acc.append(0)
    acc.append(1)
    acc[0] = acc[0] + 1
    print("  PASS catalog >= 80 = " + str(n))
    W = 480
    H = 400
    buf = []
    i = int(0)
    total = W * H
    while i < total:
        buf.append(0)
        i = i + 1
    surf = PixelSurface(W, H, W)
    bg = ColorRgba(14, 14, 18, 255)
    surface_clear(buf, surf, bg)
    bgp = bg.to_uint32()
    # render Wave A moi widget -> painted bang
    cal = make_calendar(4.0, 4.0, 150.0, 140.0, 2026, 9)
    dte = make_datetime_edit(160.0, 4.0, 160.0, 28.0)
    tbx = make_toolbox(330.0, 4.0, 140.0, 140.0, 3)
    stk = make_stacked(4.0, 150.0, 140.0, 50.0, 3)
    sb = make_scrollbar(150.0, 150.0, 14.0, 80.0, 1)
    dial = make_dial(170.0, 150.0, 60.0, 60.0)
    cl = make_command_link(240.0, 150.0, 150.0, 44.0, "Run", "Execute now")
    kse = make_key_sequence(4.0, 210.0, 140.0, 28.0)
    kse.press_key(1, 0, 1, 0, "P")
    lcd = make_lcd(150.0, 240.0, 90.0, 36.0, 4)
    lcd.set_value(42)
    tip = make_tour_tip(300.0, 320.0, "Breadth tour", 3)
    cal.render(buf, surf)
    dte.render(buf, surf)
    tb_labels = []
    tb_labels.append("A")
    tb_labels.append("B")
    tb_labels.append("C")
    tbx.render(buf, surf, tb_labels, 3)
    st_labels = []
    st_labels.append("One")
    st_labels.append("Two")
    st_labels.append("Three")
    stk.render(buf, surf, st_labels, 3)
    sb.render(buf, surf)
    dial.render(buf, surf)
    cl.render(buf, surf)
    kse.render(buf, surf)
    lcd.render(buf, surf)
    tip.render(buf, surf)
    painted = widget_count_non_bg(buf, surf, bgp)
    acc[1] = acc[1] + 1
    if painted >= 8000:
        acc[0] = acc[0] + 1
        print("  PASS waveA render non-blank (" + str(painted) + ")")
    else:
        print("  FAIL waveA render non-blank got=" + str(painted))
    # hit-test Wave A
    acc[1] = acc[1] + 1
    if cal.hit_day(cal.bx + 70.0, cal.by + 50.0) > 0:
        acc[0] = acc[0] + 1
        print("  PASS hit calendar day")
    else:
        print("  FAIL hit calendar day")
    acc[1] = acc[1] + 1
    if tbx.hit_header(tbx.by + 5.0) == 0:
        acc[0] = acc[0] + 1
        print("  PASS hit toolbox header")
    else:
        print("  FAIL hit toolbox header")
    acc[1] = acc[1] + 1
    if sb.hit_thumb(sb.bx + 7.0, sb.by + sb.thumb_pos() + 4.0) == 1:
        acc[0] = acc[0] + 1
        print("  PASS hit scrollbar thumb")
    else:
        print("  FAIL hit scrollbar thumb")
    acc[1] = acc[1] + 1
    if dial.hit_test(dial.center_x(), dial.center_y()) == 1:
        acc[0] = acc[0] + 1
        print("  PASS hit dial center")
    else:
        print("  FAIL hit dial center")
    acc[1] = acc[1] + 1
    if cl.contains(250.0, 160.0) == 1 and cl.contains(10.0, 10.0) == 0:
        acc[0] = acc[0] + 1
        print("  PASS hit command link")
    else:
        print("  FAIL hit command link")
    acc[1] = acc[1] + 1
    tr = tip.tip_rect()
    if tip.contains(tr.x + 5.0, tr.y + 5.0) == 1:
        acc[0] = acc[0] + 1
        print("  PASS hit tour tip")
    else:
        print("  FAIL hit tour tip")
    acc[1] = acc[1] + 1
    if kse.press_key(1, 0, 1, 0, "P") == "Ctrl+Shift+P":
        acc[0] = acc[0] + 1
        print("  PASS key sequence chord")
    else:
        print("  FAIL key sequence chord")
    # native calendar + media seekbar smoke (phan breadth con lai)
    nc = make_native_calendar(4.0, 330.0, 150.0, 60.0, 2026, 9)
    nc.render(buf, surf, 0)
    msb = make_media_seekbar(160.0, 350.0, 200.0, 1000, 5000)
    msb.render(buf, surf)
    # Wave B smoke: tree multi + dock float + ribbon + propgrid + contextmenu
    wtm = make_native_tree_multi(180.0, 210.0, 140.0, 70.0)
    wsel = [int(0), int(0), int(1)]
    wtm.sels_click(wsel, 2, 3, 0, 0)
    wdl = []
    wdl.append("Root")
    wdl.append("Child")
    wdep = [int(0), int(1)]
    whk = [int(1), int(0)]
    wop = [int(1), int(0)]
    wtm.render_multi(buf, surf, 0, wdl, wdep, whk, wop, wsel, 2)
    wdk = make_native_dock_float(330.0, 210.0, 140.0, 70.0)
    wdk.render(buf, surf, 0, wdl)
    wrb = make_native_ribbon(4.0, 285.0, 320.0, 3)
    wrb.render(buf, surf, 0, wdl, 1, wdl, 1, wdl, 1)
    wpg = make_native_propgrid(330.0, 285.0, 140.0, 70.0)
    wpn = []
    wpn.append("Prop")
    wpv = []
    wpv.append("1")
    wpc = [int(0)]
    wpg.render(buf, surf, 0, wpn, wpv, wpc, 1)
    wcm = make_native_contextmenu(200.0, 300.0, 100.0)
    wcm.show_at(200.0, 300.0)
    wci = []
    wci.append("Open")
    wcs = [int(0)]
    wcm.render(buf, surf, 0, wci, wcs, 1)
    acc[1] = acc[1] + 1
    painted2 = widget_count_non_bg(buf, surf, bgp)
    if painted2 >= 8000:
        acc[0] = acc[0] + 1
        print("  PASS native+media+waveB render non-blank (" + str(painted2) + ")")
    else:
        print("  FAIL native+media+waveB render non-blank got=" + str(painted2))
    # Wave B hit-test
    acc[1] = acc[1] + 1
    if wtm.sels_count(wsel) == 1:
        acc[0] = acc[0] + 1
        print("  PASS tree multi-sel count")
    else:
        print("  FAIL tree multi-sel count")
    wdk.set_floating(0, 0.0, 0.0, 0.0, 0.0)
    acc[1] = acc[1] + 1
    if wdk.floating == 0 and wdk.hit_dock_tab(360.0, 215.0, 2) == 0:
        acc[0] = acc[0] + 1
        print("  PASS dock undock tab hit")
    else:
        print("  FAIL dock undock tab hit")
    acc[1] = acc[1] + 1
    if wrb.hit_group(10.0) == 0 and wrb.select(1) == 1:
        acc[0] = acc[0] + 1
        print("  PASS ribbon group hit+select")
    else:
        print("  FAIL ribbon group hit+select")
    wpg.select(0, 1, wpc)
    acc[1] = acc[1] + 1
    if wpg.begin_edit() == 1 and wpg.editing == 1:
        acc[0] = acc[0] + 1
        print("  PASS propgrid begin edit")
    else:
        print("  FAIL propgrid begin edit")
    acc[1] = acc[1] + 1
    if wcm.open == 1 and wcm.hit_item(310.0, 1) == 0:
        acc[0] = acc[0] + 1
        print("  PASS context menu hit")
    else:
        print("  FAIL context menu hit")
    print("--- breadth selftest: " + str(acc[0]) + "/" + str(acc[1]) + " PASS, constructors=" + str(n) + " ---")
    if acc[0] == acc[1] and n >= 80:
        print("WIDGETS_BREADTH_OK")
        return "WIDGETS_BREADTH_OK"
    print("WIDGETS_BREADTH_FAIL")
    return "WIDGETS_BREADTH_FAIL"

def tkvui_selftest() -> "str":
    # Chay TAT CA selftest cua thu vien va gop ket qua. Moi selftest tra ve "<MODULE>_OK"
    # hoac "<MODULE>_FAIL" (xem quy uoc o tung module).
    print("=== TokenVector.UI selftest suite v" + tkvui_version() + " ===")
    r1 = core_selftest()
    r2 = graphics_selftest()
    r3 = text_selftest()
    r4 = effects_selftest()
    r5 = platform_selftest()
    r6 = input_selftest()
    r7 = layout_selftest()
    r8 = widget_selftest()
    r9 = media_selftest()
    r10 = bidi_selftest()
    r11 = gpu_selftest()
    r12 = a11y_selftest()
    r13 = theme_selftest()
    r14 = native_selftest()
    r15 = data_selftest()
    r16 = sqlite_selftest()
    r17 = printing_selftest()
    r18 = abridge_selftest()
    r19 = fallback_selftest()
    r20 = nativedlg_selftest()
    r21 = ime_selftest()
    r22 = uia_selftest()
    r23 = atspi_selftest()
    r24 = shaping_selftest()
    r25 = fd_selftest()
    r26 = emoji_selftest()
    r27 = kittest_selftest()
    r28 = video_selftest()
    r29 = tkvv_selftest()
    r30 = mjpg_selftest()
    r31 = mjpg_hd_selftest()
    r32 = mp4_selftest()
    r33 = clipboard_selftest()
    r34 = harfbuzz_selftest()
    r35 = hbwire_selftest()
    r36 = widgets_breadth_selftest()
    print("=== ket qua: " + r1 + " / " + r2 + " / " + r3 + " / " + r4 + " / " + r5 + " / " + r6 + " / " + r7 + " / " + r8 + " / " + r9 + " / " + r10 + " / " + r11 + " / " + r12 + " / " + r13 + " / " + r14 + " / " + r15 + " / " + r16 + " / " + r17 + " / " + r18 + " / " + r19 + " / " + r20 + " / " + r21 + " / " + r22 + " / " + r23 + " / " + r24 + " / " + r25 + " / " + r26 + " / " + r27 + " / " + r28 + " / " + r29 + " / " + r30 + " / " + r31 + " / " + r32 + " / " + r33 + " / " + r34 + " / " + r35 + " / " + r36 + " ===")
    bad = int(0)
    if r1 != "CORE_OK":
        bad = bad + 1
    if r2 != "GRAPHICS_OK":
        bad = bad + 1
    if r3 != "TEXT_OK":
        bad = bad + 1
    if r4 != "EFFECTS_OK":
        bad = bad + 1
    if r5 != "PLATFORM_OK":
        bad = bad + 1
    if r6 != "INPUT_OK":
        bad = bad + 1
    if r7 != "LAYOUT_OK":
        bad = bad + 1
    if r8 != "WIDGETS_OK":
        bad = bad + 1
    if r9 != "MEDIA_OK":
        bad = bad + 1
    if r10 != "BIDI_OK":
        bad = bad + 1
    if r11 != "GPU_OK":
        bad = bad + 1
    if r12 != "A11Y_OK":
        bad = bad + 1
    if r13 != "THEME_OK":
        bad = bad + 1
    if r14 != "NATIVE_OK":
        bad = bad + 1
    if r15 != "DATA_OK":
        bad = bad + 1
    if r16 != "SQLITE_OK":
        bad = bad + 1
    if r17 != "PRINTING_OK":
        bad = bad + 1
    if r18 != "ABRIDGE_OK":
        bad = bad + 1
    if r19 != "FALLBACK_OK":
        bad = bad + 1
    if r20 != "NATIVEDLG_OK":
        bad = bad + 1
    if r21 != "IME_OK":
        bad = bad + 1
    if r22 != "UIA_OK":
        bad = bad + 1
    if r23 != "ATSPI_OK":
        bad = bad + 1
    if r24 != "SHAPING_OK":
        bad = bad + 1
    if r25 != "FONTDISCOVERY_OK":
        bad = bad + 1
    if r26 != "EMOJIDATA_OK":
        bad = bad + 1
    if r27 != "KITTEST_OK":
        bad = bad + 1
    if r28 != "VIDEO_OK":
        bad = bad + 1
    if r29 != "TKVV_OK":
        bad = bad + 1
    if r30 != "MJPG_OK":
        bad = bad + 1
    if r31 != "MJHD_OK":
        bad = bad + 1
    if r32 != "MP4_OK":
        bad = bad + 1
    if r33 != "CLIPBOARD_OK":
        bad = bad + 1
    if r34 != "HBWIRE_OK":
        bad = bad + 1
    if r35 != "HBWIRE_OK":
        bad = bad + 1
    if r36 != "WIDGETS_BREADTH_OK":
        bad = bad + 1
    if bad == 0:
        print("TKVUI_OK")
        return "TKVUI_OK"
    print("TKVUI_FAIL (" + str(bad) + " module loi)")
    return "TKVUI_FAIL"

def main() -> "str":
    return tkvui_selftest()
