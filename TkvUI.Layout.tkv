# -*- coding: utf-8 -*-
"""TkvUI.Layout - 2-pass layout engine: Flex (wrap) / Stack / Grid / Constraint (P6)

Phu thuoc: Core (dp_to_px, Rect2D). KHONG phu thuoc Widgets (DAG: Widgets <- Layout).

Quy uoc (do compiler bat buoc - record KHONG duoc chua field `list`):
- Kich thuoc CON mong muon: `child_ws`/`child_hs` ("list[f64]", do caller giu).
- Ket qua: 4 list SONG SONG `ox,oy,ow,oh` ("list[f64]") - caller cap phat truoc n
  phan tu, callee ghi bang CHI SO (index-write lan ra caller).
- Bookkeeping cua flex: `oline` ("list[i32]", chi so dong cua tung con) va
  `line_h` ("list[f64]", chieu cao dong) - caller cap phat truoc >= n phan tu.
"""
__tkv_import__ = ["TkvUI.Core"]

# Huong (documentation; than METHOD dung literal so)
TKV_DIR_ROW = 0
TKV_DIR_COL = 1

# Align (truc cheo) / Justify (truc chinh)
TKV_ALIGN_START = 0
TKV_ALIGN_CENTER = 1
TKV_ALIGN_END = 2
TKV_ALIGN_STRETCH = 3
TKV_JUSTIFY_START = 0
TKV_JUSTIFY_CENTER = 1
TKV_JUSTIFY_END = 2
TKV_JUSTIFY_SPACE_BETWEEN = 3

class FlexStyle:
    dir: "i32"
    gap: "f64"
    pad: "f64"
    align: "i32"
    justify: "i32"
    def __init__(self, dir, gap, pad, align, justify):
        self.dir = dir
        self.gap = gap
        self.pad = pad
        self.align = align
        self.justify = justify

def flex_style(dir: "i32", gap: "f64", pad: "f64", align: "i32", justify: "i32") -> "FlexStyle":
    return FlexStyle(dir, gap, pad, align, justify)

class GridStyle:
    cols: "i32"
    rows: "i32"
    gap: "f64"
    pad: "f64"
    def __init__(self, cols, rows, gap, pad):
        self.cols = cols
        self.rows = rows
        self.gap = gap
        self.pad = pad

def grid_style(cols: "i32", rows: "i32", gap: "f64", pad: "f64") -> "GridStyle":
    return GridStyle(cols, rows, gap, pad)

class Constraint:
    min_w: "f64"
    min_h: "f64"
    max_w: "f64"
    max_h: "f64"
    def __init__(self, min_w, min_h, max_w, max_h):
        self.min_w = min_w
        self.min_h = min_h
        self.max_w = max_w
        self.max_h = max_h

def constraint(min_w: "f64", min_h: "f64", max_w: "f64", max_h: "f64") -> "Constraint":
    return Constraint(min_w, min_h, max_w, max_h)

def layout_clamp(v: "f64", lo: "f64", hi: "f64") -> "f64":
    r = v
    if r < lo:
        r = lo
    if r > hi:
        r = hi
    return r

def constraint_w(v: "f64", c: "Constraint") -> "f64":
    return layout_clamp(v, c.min_w, c.max_w)

def constraint_h(v: "f64", c: "Constraint") -> "f64":
    return layout_clamp(v, c.min_h, c.max_h)

def layout_dp(v_dp: "f64", dpi: "f64") -> "f64":
    # Don vi dp -> pixel theo DPI (96dpi = 1.0x)
    return dp_to_px(v_dp, dpi)

def layout_dp_i(v_dp: "f64", dpi: "f64") -> "i32":
    return int(dp_to_px(v_dp, dpi))

def flex_line_count(oline: "list[i32]", n: "i32") -> "i32":
    mx = int(0)
    i = int(0)
    while i < n:
        if int(oline[i]) > mx:
            mx = int(oline[i])
        i = i + 1
    return mx + 1

def flex_lines_increasing(oline: "list[i32]", main_vals: "list[f64]", n: "i32") -> "i32":
    # 1 neu moi con thuoc dong L+1 deu co toa do truc chinh >= con thuoc dong L
    # (main_vals = oy khi dir ROW, = ox khi dir COL)
    ok = int(1)
    i = int(0)
    while i < n:
        if int(oline[i]) > 0:
            j = int(0)
            while j < n:
                if int(oline[j]) == int(oline[i]) - 1:
                    if main_vals[j] > main_vals[i] + 0.001:
                        ok = 0
                j = j + 1
        i = i + 1
    return ok

def flex_same_line_same_cross(oline: "list[i32]", cross_vals: "list[f64]", n: "i32") -> "i32":
    # Con cung 1 dong phai co cung toa do TRUC CHEO (cross_vals = oy khi dir ROW)
    ok = int(1)
    i = int(0)
    while i < n:
        j = int(0)
        while j < n:
            if int(oline[i]) == int(oline[j]):
                d = cross_vals[i] - cross_vals[j]
                if d < 0.0:
                    d = 0.0 - d
                if d > 0.001:
                    ok = 0
            j = j + 1
        i = i + 1
    return ok

def flex_no_overlap(oline: "list[i32]", main_vals: "list[f64]", sizes: "list[f64]", n: "i32") -> "i32":
    # 2 con lien tiep CUNG dong khong duoc chong lan theo truc chinh
    ok = int(1)
    i = int(0)
    while i + 1 < n:
        if int(oline[i + 1]) == int(oline[i]):
            if main_vals[i + 1] < main_vals[i] + sizes[i] - 0.001:
                ok = 0
        i = i + 1
    return ok

def flex_within_bounds(ox: "list[f64]", oy: "list[f64]", ow: "list[f64]", oh: "list[f64]", n: "i32", x: "f64", y: "f64", w: "f64", h: "f64") -> "i32":
    ok = int(1)
    i = int(0)
    while i < n:
        if ox[i] < x:
            ok = 0
        if oy[i] < y:
            ok = 0
        if ox[i] + ow[i] > x + w + 0.001:
            ok = 0
        if oy[i] + oh[i] > y + h + 0.001:
            ok = 0
        i = i + 1
    return ok

def layout_flex_row(st: "FlexStyle", x: "f64", y: "f64", w: "f64", h: "f64", child_ws: "list[f64]", child_hs: "list[f64]", n: "i32", oline: "list[i32]", line_h: "list[f64]", ox: "list[f64]", oy: "list[f64]", ow: "list[f64]", oh: "list[f64]") -> "i32":
    pad = st.pad
    gap = st.gap
    avail = w - pad * 2.0
    # PASS 1: ngat dong (wrap) theo truc chinh x
    i = int(0)
    line = int(0)
    used = 0.0
    while i < n:
        cw = child_ws[i]
        if used > 0.0:
            if used + gap + cw > avail:
                line = line + 1
                used = 0.0
        oline[i] = line
        if used > 0.0:
            used = used + gap
        used = used + cw
        i = i + 1
    lines = line + 1
    # PASS 2: chieu cao tung dong (= con cao nhat)
    L = int(0)
    while L < lines:
        line_h[L] = 0.0
        L = L + 1
    i = int(0)
    while i < n:
        L = int(oline[i])
        if child_hs[i] > line_h[L]:
            line_h[L] = child_hs[i]
        i = i + 1
    # Justify chi ap dung khi CHI 1 dong (truong hop toolbar); nhieu dong = START.
    off = 0.0
    extra = 0.0
    if lines == 1:
        total = 0.0
        i = int(0)
        while i < n:
            total = total + child_ws[i]
            i = i + 1
        if n > 1:
            total = total + gap * float(n - 1)
        left = avail - total
        if left < 0.0:
            left = 0.0
        if st.justify == 1:
            off = left / 2.0
        if st.justify == 2:
            off = left
        if st.justify == 3:
            if n > 1:
                extra = left / float(n - 1)
    # PASS 3: dat vi tri (con tro truc chinh chay theo tung dong)
    i = int(0)
    placed_lines = int(0)
    cursor = 0.0
    cross = 0.0
    while i < n:
        L = int(oline[i])
        if L >= placed_lines:
            cursor = x + pad + off
            cross = y + pad
            k = int(0)
            while k < L:
                cross = cross + line_h[k] + gap
                k = k + 1
            placed_lines = L + 1
        cw = child_ws[i]
        ch = child_hs[i]
        ty = cross
        if st.align == 1:
            ty = cross + (line_h[L] - ch) / 2.0
        if st.align == 2:
            ty = cross + (line_h[L] - ch)
        th = ch
        if st.align == 3:
            th = line_h[L]
            ty = cross
        ox[i] = cursor
        oy[i] = ty
        ow[i] = cw
        oh[i] = th
        cursor = cursor + cw + gap + extra
        i = i + 1
    return lines

def layout_flex_col(st: "FlexStyle", x: "f64", y: "f64", w: "f64", h: "f64", child_ws: "list[f64]", child_hs: "list[f64]", n: "i32", oline: "list[i32]", line_h: "list[f64]", ox: "list[f64]", oy: "list[f64]", ow: "list[f64]", oh: "list[f64]") -> "i32":
    # Truc chinh = y; line_h[] tai su dung de luu CHIEU RONG dong
    pad = st.pad
    gap = st.gap
    avail = h - pad * 2.0
    i = int(0)
    line = int(0)
    used = 0.0
    while i < n:
        ch = child_hs[i]
        if used > 0.0:
            if used + gap + ch > avail:
                line = line + 1
                used = 0.0
        oline[i] = line
        if used > 0.0:
            used = used + gap
        used = used + ch
        i = i + 1
    lines = line + 1
    L = int(0)
    while L < lines:
        line_h[L] = 0.0
        L = L + 1
    i = int(0)
    while i < n:
        L = int(oline[i])
        if child_ws[i] > line_h[L]:
            line_h[L] = child_ws[i]
        i = i + 1
    off = 0.0
    extra = 0.0
    if lines == 1:
        total = 0.0
        i = int(0)
        while i < n:
            total = total + child_hs[i]
            i = i + 1
        if n > 1:
            total = total + gap * float(n - 1)
        left = avail - total
        if left < 0.0:
            left = 0.0
        if st.justify == 1:
            off = left / 2.0
        if st.justify == 2:
            off = left
        if st.justify == 3:
            if n > 1:
                extra = left / float(n - 1)
    i = int(0)
    placed_lines = int(0)
    cursor = 0.0
    cross = 0.0
    while i < n:
        L = int(oline[i])
        if L >= placed_lines:
            cursor = y + pad + off
            cross = x + pad
            k = int(0)
            while k < L:
                cross = cross + line_h[k] + gap
                k = k + 1
            placed_lines = L + 1
        cw = child_ws[i]
        ch = child_hs[i]
        tx = cross
        if st.align == 1:
            tx = cross + (line_h[L] - cw) / 2.0
        if st.align == 2:
            tx = cross + (line_h[L] - cw)
        tw = cw
        if st.align == 3:
            tw = line_h[L]
            tx = cross
        ox[i] = tx
        oy[i] = cursor
        ow[i] = tw
        oh[i] = ch
        cursor = cursor + ch + gap + extra
        i = i + 1
    return lines

def layout_flex(st: "FlexStyle", x: "f64", y: "f64", w: "f64", h: "f64", child_ws: "list[f64]", child_hs: "list[f64]", n: "i32", oline: "list[i32]", line_h: "list[f64]", ox: "list[f64]", oy: "list[f64]", ow: "list[f64]", oh: "list[f64]") -> "i32":
    if st.dir == 1:
        return layout_flex_col(st, x, y, w, h, child_ws, child_hs, n, oline, line_h, ox, oy, ow, oh)
    return layout_flex_row(st, x, y, w, h, child_ws, child_hs, n, oline, line_h, ox, oy, ow, oh)

def layout_stack_row(st: "FlexStyle", x: "f64", y: "f64", w: "f64", h: "f64", child_ws: "list[f64]", child_hs: "list[f64]", n: "i32", ox: "list[f64]", oy: "list[f64]", ow: "list[f64]", oh: "list[f64]") -> "i32":
    # 1 dong, KHONG wrap; justify + align day du
    pad = st.pad
    gap = st.gap
    avail = w - pad * 2.0
    total = 0.0
    i = int(0)
    while i < n:
        total = total + child_ws[i]
        i = i + 1
    if n > 1:
        total = total + gap * float(n - 1)
    left = avail - total
    if left < 0.0:
        left = 0.0
    off = 0.0
    extra = 0.0
    if st.justify == 1:
        off = left / 2.0
    if st.justify == 2:
        off = left
    if st.justify == 3:
        if n > 1:
            extra = left / float(n - 1)
    cursor = x + pad + off
    i = int(0)
    while i < n:
        cw = child_ws[i]
        ch = child_hs[i]
        ty = y + pad
        th = ch
        if st.align == 1:
            ty = y + pad + (h - pad * 2.0 - ch) / 2.0
        if st.align == 2:
            ty = y + h - pad - ch
        if st.align == 3:
            ty = y + pad
            th = h - pad * 2.0
        ox[i] = cursor
        oy[i] = ty
        ow[i] = cw
        oh[i] = th
        cursor = cursor + cw + gap + extra
        i = i + 1
    return n

def layout_stack_col(st: "FlexStyle", x: "f64", y: "f64", w: "f64", h: "f64", child_ws: "list[f64]", child_hs: "list[f64]", n: "i32", ox: "list[f64]", oy: "list[f64]", ow: "list[f64]", oh: "list[f64]") -> "i32":
    pad = st.pad
    gap = st.gap
    avail = h - pad * 2.0
    total = 0.0
    i = int(0)
    while i < n:
        total = total + child_hs[i]
        i = i + 1
    if n > 1:
        total = total + gap * float(n - 1)
    left = avail - total
    if left < 0.0:
        left = 0.0
    off = 0.0
    extra = 0.0
    if st.justify == 1:
        off = left / 2.0
    if st.justify == 2:
        off = left
    if st.justify == 3:
        if n > 1:
            extra = left / float(n - 1)
    cursor = y + pad + off
    i = int(0)
    while i < n:
        cw = child_ws[i]
        ch = child_hs[i]
        tx = x + pad
        tw = cw
        if st.align == 1:
            tx = x + pad + (w - pad * 2.0 - cw) / 2.0
        if st.align == 2:
            tx = x + w - pad - cw
        if st.align == 3:
            tx = x + pad
            tw = w - pad * 2.0
        ox[i] = tx
        oy[i] = cursor
        ow[i] = tw
        oh[i] = ch
        cursor = cursor + ch + gap + extra
        i = i + 1
    return n

def layout_stack(st: "FlexStyle", x: "f64", y: "f64", w: "f64", h: "f64", child_ws: "list[f64]", child_hs: "list[f64]", n: "i32", ox: "list[f64]", oy: "list[f64]", ow: "list[f64]", oh: "list[f64]") -> "i32":
    if st.dir == 1:
        return layout_stack_col(st, x, y, w, h, child_ws, child_hs, n, ox, oy, ow, oh)
    return layout_stack_row(st, x, y, w, h, child_ws, child_hs, n, ox, oy, ow, oh)

def layout_grid_cell(gs: "GridStyle", x: "f64", y: "f64", w: "f64", h: "f64", row: "i32", col: "i32", col_span: "i32", row_span: "i32") -> "Rect2D":
    pad = gs.pad
    gap = gs.gap
    cell_w = (w - pad * 2.0 - float(gs.cols - 1) * gap) / float(gs.cols)
    cell_h = (h - pad * 2.0 - float(gs.rows - 1) * gap) / float(gs.rows)
    rx = x + pad + float(col) * (cell_w + gap)
    ry = y + pad + float(row) * (cell_h + gap)
    rw = cell_w * float(col_span) + gap * float(col_span - 1)
    rh = cell_h * float(row_span) + gap * float(row_span - 1)
    return Rect2D(rx, ry, rw, rh)

def layout_grid(gs: "GridStyle", x: "f64", y: "f64", w: "f64", h: "f64", n: "i32", ox: "list[f64]", oy: "list[f64]", ow: "list[f64]", oh: "list[f64]") -> "i32":
    row = int(0)
    col = int(0)
    i = int(0)
    rows_used = int(0)
    while i < n:
        r = layout_grid_cell(gs, x, y, w, h, row, col, 1, 1)
        ox[i] = r.x
        oy[i] = r.y
        ow[i] = r.w
        oh[i] = r.h
        rows_used = row + 1
        col = col + 1
        if col >= gs.cols:
            col = 0
            row = row + 1
        i = i + 1
    return rows_used

def layout_measure_total(ws: "list[f64]", n: "i32", gap: "f64") -> "f64":
    total = 0.0
    i = int(0)
    while i < n:
        total = total + ws[i]
        i = i + 1
    if n > 1:
        total = total + gap * float(n - 1)
    return total

def layout_alloc_f64(n: "i32", v: "f64") -> "list[f64]":
    out = []
    i = int(0)
    while i < n:
        out.append(v)
        i = i + 1
    return out

def layout_alloc_i32(n: "i32", v: "i32") -> "list[i32]":
    out = []
    i = int(0)
    while i < n:
        out.append(v)
        i = i + 1
    return out

# =========================================================
# P6 SELFTEST - 3 man hinh Flex wrap (phone / tablet / desktop)
# =========================================================
def layout_check(acc: "list[i32]", name: "str", ok: "i32") -> "i32":
    # acc[0] = so check PASS, acc[1] = tong so check (accumulator list - index-write
    # lan ra caller, thay cho viec phai return nhieu gia tri).
    acc[1] = acc[1] + 1
    if ok == 1:
        acc[0] = acc[0] + 1
        print("  PASS " + name)
        return 1
    print("  FAIL " + name)
    return 0

def layout_check_i(acc: "list[i32]", name: "str", got: "i32", want: "i32") -> "i32":
    acc[1] = acc[1] + 1
    if got == want:
        acc[0] = acc[0] + 1
        print("  PASS " + name + " = " + str(got))
        return 1
    print("  FAIL " + name + " got=" + str(got) + " want=" + str(want))
    return 0

def layout_check_f(acc: "list[i32]", name: "str", got: "f64", want: "f64", tol: "f64") -> "i32":
    acc[1] = acc[1] + 1
    d = got - want
    if d < 0.0:
        d = 0.0 - d
    if d <= tol:
        acc[0] = acc[0] + 1
        print("  PASS " + name + " = " + str(got))
        return 1
    print("  FAIL " + name + " got=" + str(got) + " want=" + str(want))
    return 0

def layout_selftest_screen(acc: "list[i32]", name: "str", w: "f64", h: "f64", st: "FlexStyle", child_ws: "list[f64]", child_hs: "list[f64]", n: "i32") -> "i32":
    print("--- " + name + " (" + str(w) + " x " + str(h) + ", n=" + str(n) + ") ---")
    ox = layout_alloc_f64(n, 0.0)
    oy = layout_alloc_f64(n, 0.0)
    ow = layout_alloc_f64(n, 0.0)
    oh = layout_alloc_f64(n, 0.0)
    oline = layout_alloc_i32(n, 0)
    line_h = layout_alloc_f64(n, 0.0)
    lines = layout_flex(st, 0.0, 0.0, w, h, child_ws, child_hs, n, oline, line_h, ox, oy, ow, oh)
    flag = int(0)
    if lines >= 1:
        flag = 1
    layout_check(acc, "lines >= 1 (lines=" + str(lines) + ")", flag)
    layout_check(acc, "moi con trong khung", flex_within_bounds(ox, oy, ow, oh, n, 0.0, 0.0, w, h))
    if st.align == 0:
        if st.dir == 1:
            layout_check(acc, "cung dong -> cung truc cheo", flex_same_line_same_cross(oline, ox, n))
        else:
            layout_check(acc, "cung dong -> cung truc cheo", flex_same_line_same_cross(oline, oy, n))
    if st.align == 3:
        if st.dir == 1:
            layout_check(acc, "stretch: cung dong -> cung truc cheo", flex_same_line_same_cross(oline, ox, n))
        else:
            layout_check(acc, "stretch: cung dong -> cung truc cheo", flex_same_line_same_cross(oline, oy, n))
    if st.dir == 1:
        layout_check(acc, "dong sau xa hon theo truc cheo", flex_lines_increasing(oline, ox, n))
        layout_check(acc, "khong chong lan theo truc chinh (y)", flex_no_overlap(oline, oy, oh, n))
        layout_check_f(acc, "con[0].y = pad", oy[0], st.pad, 0.001)
    else:
        layout_check(acc, "dong sau nam duoi", flex_lines_increasing(oline, oy, n))
        layout_check(acc, "khong chong lan theo truc chinh", flex_no_overlap(oline, ox, ow, n))
        layout_check_f(acc, "con[0].x = pad", ox[0], st.pad, 0.001)
    layout_check_i(acc, "flex_line_count khop", flex_line_count(oline, n), lines)
    # con thu 2: cung dong -> ke tiep sau con 1 + gap (chi khi justify START);
    # khac dong -> ve dau dong
    if int(oline[1]) == int(oline[0]):
        if st.justify == 0:
            if st.dir == 1:
                layout_check_f(acc, "con[1] ke tiep truc chinh", oy[1], oy[0] + oh[0] + st.gap, 0.001)
            else:
                layout_check_f(acc, "con[1] ke tiep truc chinh", ox[1], ox[0] + ow[0] + st.gap, 0.001)
        else:
            # justify khac START: con[1] phai nam XA HON con[0] (co them khoang gian)
            if st.dir == 1:
                layout_check(acc, "con[1] xa hon con[0]", flex_no_overlap(oline, oy, oh, n))
            else:
                layout_check(acc, "con[1] xa hon con[0]", flex_no_overlap(oline, ox, ow, n))
    else:
        if st.dir == 1:
            layout_check_f(acc, "con[1] ve dau dong moi", oy[1], st.pad, 0.001)
        else:
            layout_check_f(acc, "con[1] ve dau dong moi", ox[1], st.pad, 0.001)
    return 1

def layout_selftest() -> "str":
    print("=== TkvUI.Layout selftest (P6) ===")
    acc = []
    acc.append(0)
    acc.append(0)
    # 1) PHONE 360x640 - chip toolbar (gap 8, pad 8), nhieu dong
    st_phone = flex_style(TKV_DIR_ROW, 8.0, 8.0, TKV_ALIGN_START, TKV_JUSTIFY_START)
    cw = []
    chs = []
    cw.append(100.0)
    chs.append(32.0)
    cw.append(100.0)
    chs.append(32.0)
    cw.append(100.0)
    chs.append(32.0)
    cw.append(100.0)
    chs.append(32.0)
    layout_selftest_screen(acc, "phone-toolbar-wrap", 360.0, 640.0, st_phone, cw, chs, 4)
    # 2) TABLET 768x1024 - card grid-ish flex, align CENTER
    st_tab = flex_style(TKV_DIR_ROW, 12.0, 16.0, TKV_ALIGN_CENTER, TKV_JUSTIFY_START)
    cw2 = []
    ch2 = []
    cw2.append(220.0)
    ch2.append(90.0)
    cw2.append(220.0)
    ch2.append(140.0)
    cw2.append(220.0)
    ch2.append(90.0)
    cw2.append(220.0)
    ch2.append(90.0)
    cw2.append(300.0)
    ch2.append(60.0)
    layout_selftest_screen(acc, "tablet-cards-center", 768.0, 1024.0, st_tab, cw2, ch2, 5)
    # 3) DESKTOP 1280x720 - 1 dong, justify SPACE_BETWEEN + align STRETCH
    st_desk = flex_style(TKV_DIR_ROW, 10.0, 12.0, TKV_ALIGN_STRETCH, TKV_JUSTIFY_SPACE_BETWEEN)
    cw3 = []
    ch3 = []
    cw3.append(160.0)
    ch3.append(40.0)
    cw3.append(160.0)
    ch3.append(40.0)
    cw3.append(160.0)
    ch3.append(40.0)
    layout_selftest_screen(acc, "desktop-toolbar-spacebetween", 1280.0, 720.0, st_desk, cw3, ch3, 3)
    # 3b) SPACE_BETWEEN: con cuoi phai ket thuc dung truoc le phai (pad)
    o = layout_alloc_f64(3, 0.0)
    o2 = layout_alloc_f64(3, 0.0)
    o3 = layout_alloc_f64(3, 0.0)
    o4 = layout_alloc_f64(3, 0.0)
    ln = layout_alloc_i32(3, 0)
    lh = layout_alloc_f64(3, 0.0)
    lines3 = layout_flex(st_desk, 0.0, 0.0, 1280.0, 720.0, cw3, ch3, 3, ln, lh, o, o2, o3, o4)
    layout_check_i(acc, "desktop 1 dong", lines3, 1)
    layout_check_f(acc, "con cuoi cham le phai", o[2] + o3[2], 1280.0 - 12.0, 0.001)
    # 4) COLUMN flex wrap (doc)
    st_col = flex_style(TKV_DIR_COL, 6.0, 10.0, TKV_ALIGN_START, TKV_JUSTIFY_START)
    cw4 = []
    ch4 = []
    cw4.append(80.0)
    ch4.append(200.0)
    cw4.append(80.0)
    ch4.append(200.0)
    cw4.append(80.0)
    ch4.append(200.0)
    cw4.append(120.0)
    ch4.append(200.0)
    layout_selftest_screen(acc, "column-wrap", 400.0, 480.0, st_col, cw4, ch4, 4)
    # 5) STACK doc: NavBar + content + BottomSheet (justify/align)
    st_stack = flex_style(TKV_DIR_COL, 0.0, 0.0, TKV_ALIGN_STRETCH, TKV_JUSTIFY_START)
    sw = []
    sh = []
    sw.append(390.0)
    sh.append(56.0)
    sw.append(390.0)
    sh.append(700.0)
    sw.append(390.0)
    sh.append(88.0)
    sx = layout_alloc_f64(3, 0.0)
    sy = layout_alloc_f64(3, 0.0)
    swd = layout_alloc_f64(3, 0.0)
    shd = layout_alloc_f64(3, 0.0)
    layout_stack(st_stack, 0.0, 0.0, 390.0, 844.0, sw, sh, 3, sx, sy, swd, shd)
    layout_check_f(acc, "stack navbar.y = 0", sy[0], 0.0, 0.001)
    layout_check_f(acc, "stack content.y = 56", sy[1], 56.0, 0.001)
    layout_check_f(acc, "stack bottomsheet.y = 756", sy[2], 756.0, 0.001)
    layout_check(acc, "stack khong tran khung", flex_within_bounds(sx, sy, swd, shd, 3, 0.0, 0.0, 390.0, 844.0))
    # 6) GRID 2x2 + span
    gs = grid_style(2, 2, 8.0, 12.0)
    gx = layout_alloc_f64(4, 0.0)
    gy = layout_alloc_f64(4, 0.0)
    gw = layout_alloc_f64(4, 0.0)
    gh = layout_alloc_f64(4, 0.0)
    rows_used = layout_grid(gs, 0.0, 0.0, 400.0, 400.0, 4, gx, gy, gw, gh)
    layout_check_i(acc, "grid rows used", rows_used, 2)
    layout_check_f(acc, "grid cell w = (400-24-8)/2", gw[0], 184.0, 0.001)
    layout_check_f(acc, "grid cell h = (400-24-8)/2", gh[0], 184.0, 0.001)
    layout_check_f(acc, "grid cell[1].x = 12 + 184 + 8", gx[1], 204.0, 0.001)
    layout_check(acc, "grid trong khung", flex_within_bounds(gx, gy, gw, gh, 4, 0.0, 0.0, 400.0, 400.0))
    span = layout_grid_cell(gs, 0.0, 0.0, 400.0, 400.0, 0, 0, 2, 1)
    layout_check_f(acc, "span 2 cot = 184*2+8", span.w, 376.0, 0.001)
    # 7) CONSTRAINT + DPI
    c = constraint(40.0, 24.0, 200.0, 120.0)
    layout_check_f(acc, "constraint clamp thap", constraint_w(10.0, c), 40.0, 0.001)
    layout_check_f(acc, "constraint clamp cao", constraint_w(900.0, c), 200.0, 0.001)
    layout_check_f(acc, "constraint giu nguyen", constraint_h(60.0, c), 60.0, 0.001)
    layout_check_f(acc, "dp 16 @ 192dpi = 32px", layout_dp(16.0, 192.0), 32.0, 0.001)
    layout_check_f(acc, "dp 44 @ 288dpi = 132px", layout_dp(44.0, 288.0), 132.0, 0.001)
    layout_check_i(acc, "layout_dp_i 24 @ 144 = 36", layout_dp_i(24.0, 144.0), 36)
    layout_check_f(acc, "measure_total 3x160 gap 10", layout_measure_total(cw3, 3, 10.0), 500.0, 0.001)
    print("--- layout selftest: " + str(acc[0]) + "/" + str(acc[1]) + " PASS ---")
    if acc[0] == acc[1]:
        return "LAYOUT_OK"
    return "LAYOUT_FAIL"
