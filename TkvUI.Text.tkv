def ttf_test_kern_bytes() -> "list[i64]":
    # Bang kern format 0 toi thieu: 1 subtable horizontal, 1 pair (65,86,-20).
    # 4 byte pad dau de offset != 0 (0 = missing-table theo convention parser).
    d = []
    d.append(0)
    d.append(0)
    d.append(0)
    d.append(0)
    ttf_put_u16(d, 0)
    ttf_put_u16(d, 1)
    ttf_put_u16(d, 0)
    ttf_put_u16(d, 20)
    ttf_put_u16(d, 1)
    ttf_put_u16(d, 1)
    ttf_put_u16(d, 0)
    ttf_put_u16(d, 0)
    ttf_put_u16(d, 0)
    ttf_put_u16(d, 65)
    ttf_put_u16(d, 86)
    ttf_put_u16(d, 65516)
    return d

def ttf_test_cpal_bytes() -> "list[i64]":
    # CPAL: 1 palette, 2 colors (red, blue). 4 byte pad dau.
    d = []
