def ttf_test_composite_bytes() -> "list[i64]":
    # Raw glyf+loca toi thieu (khong full sfnt): loca short + 2 glyph.
    # glyph0: hinh vuong 1 contour, 4 diem on-curve, toa do TUYET DOI
    #   (convention engine - giong ttf_test_font_bytes).
    # glyph1: composite = glyph0 + glyph0 dich (+300, 0), flags WORDS+XY.
    # Layout: [loca 6B][glyph0 34B][glyph1 26B]; glyf_off=6, loca_off=0.
    d = []
    ttf_put_u16(d, 0)
    ttf_put_u16(d, 17)
    ttf_put_u16(d, 30)
    ttf_put_u16(d, 40)
    ttf_put_u16(d, 53)
    # glyph0: simple square (100,100)-(200,200)
    ttf_put_u16(d, 1)
    ttf_put_u16(d, 100)
    ttf_put_u16(d, 100)
    ttf_put_u16(d, 200)
    ttf_put_u16(d, 200)
    ttf_put_u16(d, 3)
    ttf_put_u16(d, 0)
    d.append(1)
    d.append(1)
    d.append(1)
    d.append(1)
    ttf_put_u16(d, 100)
    ttf_put_u16(d, 200)
    ttf_put_u16(d, 200)
    ttf_put_u16(d, 100)
    ttf_put_u16(d, 100)
    ttf_put_u16(d, 100)
    ttf_put_u16(d, 200)
    ttf_put_u16(d, 200)
    # glyph1: composite, bbox bao ca 2 ban (100..500)
    ttf_put_u16(d, 65535)
    ttf_put_u16(d, 100)
    ttf_put_u16(d, 100)
    ttf_put_u16(d, 500)
    ttf_put_u16(d, 200)
    ttf_put_u16(d, 35)
    ttf_put_u16(d, 0)
    ttf_put_u16(d, 0)
    ttf_put_u16(d, 0)
    ttf_put_u16(d, 3)
    ttf_put_u16(d, 0)
    ttf_put_u16(d, 300)
    ttf_put_u16(d, 0)
    # glyph2: composite 1 component, WE_HAVE_A_SCALE 0.5 (8192 = 0.5*16384).
    # Thu tu spec: flags, gid, args(dx,dy), scale.
    ttf_put_u16(d, 65535)
    ttf_put_u16(d, 0)
    ttf_put_u16(d, 0)
    ttf_put_u16(d, 200)
    ttf_put_u16(d, 200)
    ttf_put_u16(d, 11)
    ttf_put_u16(d, 0)
    ttf_put_u16(d, 0)
    ttf_put_u16(d, 0)
    ttf_put_u16(d, 8192)
    # glyph3: composite 1 component, 2x2 identity + dx 500.
    # Thu tu spec: flags, gid, args(dx,dy), 2x2.
    ttf_put_u16(d, 65535)
    ttf_put_u16(d, 400)
    ttf_put_u16(d, 0)
    ttf_put_u16(d, 700)
    ttf_put_u16(d, 200)
    ttf_put_u16(d, 131)
    ttf_put_u16(d, 0)
    ttf_put_u16(d, 500)
    ttf_put_u16(d, 0)
    ttf_put_u16(d, 16384)
    ttf_put_u16(d, 0)
    ttf_put_u16(d, 0)
    ttf_put_u16(d, 16384)
    return d

