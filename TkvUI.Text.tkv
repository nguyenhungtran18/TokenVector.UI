    d.append(0)
    d.append(255)
    d.append(255)
    d.append(255)
    d.append(0)
    d.append(0)
    d.append(255)
    return d

def ttf_test_colr_bytes() -> "list[i64]":
    # COLR v0: base 5->[(0,red)], 6->[(0,red),(0,blue)], 7->[(0,fg)],
    # 8->[(9,red)] (gid 9 miss). 4 byte pad dau.
    d = []
    d.append(0)
    d.append(0)
    d.append(0)
    d.append(0)
    ttf_put_u16(d, 0)
    ttf_put_u16(d, 3)
    ttf_put_u32(d, 14)
    ttf_put_u32(d, 38)
    ttf_put_u16(d, 4)
    ttf_put_u32(d, 5)
    ttf_put_u16(d, 0)
    ttf_put_u16(d, 1)
    ttf_put_u32(d, 6)
    ttf_put_u16(d, 0)
    ttf_put_u16(d, 2)
    ttf_put_u32(d, 7)
    ttf_put_u16(d, 2)
    ttf_put_u16(d, 1)
    ttf_put_u16(d, 0)
    ttf_put_u16(d, 0)
    ttf_put_u16(d, 0)
    ttf_put_u16(d, 1)
    ttf_put_u16(d, 0)
    ttf_put_u16(d, 65535)
    ttf_put_u16(d, 9)
    ttf_put_u16(d, 0)
    return d

# =========================================================
# P2 SELFTEST - bitmap font + renderer (headless)
# =========================================================
def text_check(acc: "list[i32]", name: "str", ok: "i32") -> "i32":
    acc[1] = acc[1] + 1
    if ok == 1:
        acc[0] = acc[0] + 1
        print("  PASS " + name)
        return 1
    print("  FAIL " + name)
    return 0

def text_check_i(acc: "list[i32]", name: "str", got: "i32", want: "i32") -> "i32":
    acc[1] = acc[1] + 1
    if got == want:
        acc[0] = acc[0] + 1
        print("  PASS " + name + " = " + str(got))
        return 1
    print("  FAIL " + name + " got=" + str(got) + " want=" + str(want))
    return 0

def text_check_i64(acc: "list[i32]", name: "str", got: "i64", want: "i64") -> "i32":
    acc[1] = acc[1] + 1
    if got == want:
        acc[0] = acc[0] + 1
        print("  PASS " + name + " = " + str(got))
        return 1
    print("  FAIL " + name + " got=" + str(got) + " want=" + str(want))
    return 0

def text_check_f(acc: "list[i32]", name: "str", got: "f64", want: "f64", tol: "f64") -> "i32":
    d = got - want
    if d < 0.0:
        d = 0.0 - d
    acc[1] = acc[1] + 1
    if d <= tol:
        acc[0] = acc[0] + 1
        print("  PASS " + name + " = " + str(got))
        return 1
    print("  FAIL " + name + " got=" + str(got) + " want=" + str(want))
    return 0

def text_check_gt(acc: "list[i32]", name: "str", got: "i32", lo: "i32") -> "i32":
    acc[1] = acc[1] + 1
    if got > lo:
        acc[0] = acc[0] + 1
        print("  PASS " + name + " = " + str(got))
        return 1
    print("  FAIL " + name + " got=" + str(got) + " want > " + str(lo))
    return 0

def text_count_nonzero(buf: "list[i64]", n: "i32", from_i: "i32", to_i: "i32") -> "i32":
    c = int(0)
    i = from_i
    while i < to_i:
        if buf[i] != 0:
            c = c + 1
        i = i + 1
    return c


def text_selftest_ttfxtra(acc: "list[i32]", white: "ColorRgba") -> "i32":
    # TTF extended (composite/kern/cpal/colr): tach rieng de moi
    # method duoi 256 locals (gioi han ldloc.s/stloc.s 1-byte).
    # composite: square + square@dx300 -> 2 contours, 8 points, bbox hop
    cd = ttf_test_composite_bytes()
    gsq = ttf_parse_glyf(cd, 10, 0, 0, 0)
    text_check_i(acc, "ttf comp base contours", gsq[0], 1)
    gc = ttf_parse_glyf(cd, 10, 0, 0, 1)
    text_check_i(acc, "ttf comp contours", gc[0], 2)
    text_check_i(acc, "ttf comp len", len(gc), 31)
    text_check_i(acc, "ttf comp end0", gc[5], 3)
    text_check_i(acc, "ttf comp end1", gc[6], 7)
    text_check_i(acc, "ttf comp xmin", gc[1], 100)
    text_check_i(acc, "ttf comp xmax", gc[3], 500)
    text_check_i(acc, "ttf comp x0", gc[15], 100)
    text_check_i(acc, "ttf comp y0", gc[16], 100)
    text_check_i(acc, "ttf comp x2", gc[19], 200)
    text_check_i(acc, "ttf comp x4", gc[23], 400)
    # scale 0.5 component: square 100..200 -> 50..100
    g2 = ttf_parse_glyf(cd, 10, 0, 0, 2)
    text_check_i(acc, "ttf comp scale contours", g2[0], 1)
    text_check_i(acc, "ttf comp scale xmin", g2[1], 50)
    text_check_i(acc, "ttf comp scale xmax", g2[3], 100)
    text_check_i(acc, "ttf comp scale x0", g2[10], 50)
    text_check_i(acc, "ttf comp scale y0", g2[11], 50)
    # 2x2 identity + dx500: square -> 600..700
    g3 = ttf_parse_glyf(cd, 10, 0, 0, 3)
    text_check_i(acc, "ttf comp 2x2 contours", g3[0], 1)
    text_check_i(acc, "ttf comp 2x2 xmin", g3[1], 600)
    text_check_i(acc, "ttf comp 2x2 xmax", g3[3], 700)
    text_check_i(acc, "ttf comp 2x2 x0", g3[10], 600)
    # raster: merged ink = 2x single (2 hinh khong giao nhau)
    cb1 = []
    ci = int(0)
    while ci < 4096:
        cb1.append(0)
        ci = ci + 1
    text_check_i(acc, "ttf comp raster sq", ttf_rasterize_glyph(gsq, 0.1, 64, 64, 0, 0, cb1, 64), 1)
    ink1 = text_count_nonzero(cb1, 4096, 0, 4096)
    cb2 = []
    ci = int(0)
    while ci < 4096:
        cb2.append(0)
        ci = ci + 1
    text_check_i(acc, "ttf comp raster merged", ttf_rasterize_glyph(gc, 0.1, 64, 64, 0, 0, cb2, 64), 1)
    ink2 = text_count_nonzero(cb2, 4096, 0, 4096)
    text_check_i(acc, "ttf comp ink 2x", ink2, ink1 + ink1)
    # scaled square ink nam giua 0 va single (nho hon nhung > 0)
    cb3 = []
    ci = int(0)
    while ci < 4096:
        cb3.append(0)
        ci = ci + 1
    text_check_i(acc, "ttf comp raster scaled", ttf_rasterize_glyph(g2, 0.1, 64, 64, 0, 0, cb3, 64), 1)
    ink3 = text_count_nonzero(cb3, 4096, 0, 4096)
    scok = 0
    if ink3 > 0:
        if ink3 < ink1:
            scok = 1
    text_check(acc, "ttf comp ink scaled", scok)
    # kern format 0: 1 pair (65,86,-20), offset 4 (0 = missing)
    kd = ttf_test_kern_bytes()
    kk = ttf_parse_kern(kd, 4)
    text_check_i(acc, "ttf kern len", len(kk), 3)
    text_check_i(acc, "ttf kern adjust", ttf_kern_adjust(kk, 65, 86), -20)
    text_check_i(acc, "ttf kern miss", ttf_kern_adjust(kk, 65, 65), 0)
    text_check_i(acc, "ttf kern empty", ttf_kern_adjust([], 65, 86), 0)
    text_check_i(acc, "ttf kern noff", len(ttf_parse_kern(kd, 0)), 0)
    # CPAL: 1 palette, red + blue
    cpd = ttf_test_cpal_bytes()
    cp = ttf_parse_cpal(cpd, 4)
    text_check_i(acc, "ttf cpal len", len(cp), 11)
    text_check_i64(acc, "ttf cpal red", ttf_cpal_color(cp, 0, 0), 255 * 16777216 + 255 * 65536)
    text_check_i64(acc, "ttf cpal blue", ttf_cpal_color(cp, 0, 1), 255 * 16777216 + 255)
    text_check_i64(acc, "ttf cpal miss pal", ttf_cpal_color(cp, 1, 0), 0)
    text_check_i64(acc, "ttf cpal miss idx", ttf_cpal_color(cp, 0, 5), 0)
    text_check_i(acc, "ttf cpal noff", len(ttf_parse_cpal(cpd, 0)), 0)
    # COLR v0: layers per base
    crd = ttf_test_colr_bytes()
    cr = ttf_parse_colr(crd, 4)
    text_check_i(acc, "ttf colr len", len(cr), 19)
    lay = []
    text_check_i(acc, "ttf colr base5", ttf_colr_layers(cr, 5, lay), 1)
    text_check_i(acc, "ttf colr l0 gid", lay[0], 0)
    text_check_i(acc, "ttf colr l0 pal", lay[1], 0)
    lay2 = []
    text_check_i(acc, "ttf colr base6", ttf_colr_layers(cr, 6, lay2), 2)
    layfg = []
    text_check_i(acc, "ttf colr base7", ttf_colr_layers(cr, 7, layfg), 1)
    text_check_i(acc, "ttf colr fg pal", layfg[1], 65535)
    lay3 = []
    text_check_i(acc, "ttf colr miss", ttf_colr_layers(cr, 99, lay3), 0)
    text_check_i(acc, "ttf colr noff", len(ttf_parse_colr(crd, 0)), 0)
    # COLR draw: red square == ink truc tiep; overpaint xanh het do
    cbuf = []
    ci = int(0)
    while ci < 4096:
        cbuf.append(0)
        ci = ci + 1
    csurf = PixelSurface(64, 64, 64)
    white = ColorRgba(255, 255, 255, 255)
    text_check_i(acc, "ttf colr draw red", ttf_draw_colr(cd, 10, 0, 0, cp, cr, 5, 0.1, 64, 64, cbuf, csurf, 0, 0, white), 1)
    reds = int(0)
    i = int(0)
    while i < 4096:
        pix = cbuf[i]
        if pix != 0:
            if (pix // 65536) % 256 == 255:
                if (pix // 256) % 256 == 0:
                    if pix % 256 == 0:
                        reds = reds + 1
        i = i + 1
    text_check_i(acc, "ttf colr red ink", reds, ink1)
    cbuf2 = []
    ci = int(0)
    while ci < 4096:
        cbuf2.append(0)
        ci = ci + 1
    text_check_i(acc, "ttf colr draw overpaint", ttf_draw_colr(cd, 10, 0, 0, cp, cr, 6, 0.1, 64, 64, cbuf2, csurf, 0, 0, white), 2)
    blues = int(0)
    reds2 = int(0)
    i = int(0)
    while i < 4096:
        pix = cbuf2[i]
        if pix != 0:
            if (pix // 65536) % 256 == 0:
                if (pix // 256) % 256 == 0:
                    if pix % 256 == 255:
                        blues = blues + 1
            if (pix // 65536) % 256 == 255:
                if (pix // 256) % 256 == 0:
                    if pix % 256 == 0:
                        reds2 = reds2 + 1
        i = i + 1
    text_check_i(acc, "ttf colr blue ink", blues, ink1)
    text_check_i(acc, "ttf colr no red left", reds2, 0)
    green = ColorRgba(0, 255, 0, 255)
    cbuf3 = []
    ci = int(0)
    while ci < 4096:
        cbuf3.append(0)
        ci = ci + 1
    text_check_i(acc, "ttf colr draw fg", ttf_draw_colr(cd, 10, 0, 0, cp, cr, 7, 0.1, 64, 64, cbuf3, csurf, 0, 0, green), 1)
    greens = int(0)
    i = int(0)
    while i < 4096:
        pix = cbuf3[i]
        if pix != 0:
            if (pix // 65536) % 256 == 0:
                if (pix // 256) % 256 == 255:
                    if pix % 256 == 0:
                        greens = greens + 1
        i = i + 1
    text_check_i(acc, "ttf colr fg ink", greens, ink1)
    text_check_i(acc, "ttf colr draw miss", ttf_draw_colr(cd, 10, 0, 0, cp, cr, 8, 0.1, 64, 64, cbuf3, csurf, 0, 0, white), 0)
    # CBDT bitmap 1bpp: 4x4 block + 9-wide (rowbytes 2) + truncate/empty
    bbd = []
    bbd.append(240)
    bbd.append(144)
    bbd.append(144)
    bbd.append(240)
    bbd.append(255)
    bbd.append(128)
    bbd.append(255)
    bbd.append(128)
    bsurf = PixelSurface(16, 16, 16)
    bbuf = []
    bi = int(0)
    while bi < 256:
        bbuf.append(0)
        bi = bi + 1
    text_check_i(acc, "ttf cbdt 4x4", ttf_cbdt_blit(bbd, 0, 4, 4, bbuf, bsurf, 0, 0, white), 12)
    bok = 0
    if bbuf[0] != 0:
        if bbuf[17] == 0:
            bok = 1
    text_check(acc, "ttf cbdt spot", bok)
    text_check_i(acc, "ttf cbdt 9wide", ttf_cbdt_blit(bbd, 4, 9, 2, bbuf, bsurf, 0, 6, white), 18)
    text_check_i(acc, "ttf cbdt trunc", ttf_cbdt_blit(bbd, 100, 4, 4, bbuf, bsurf, 0, 0, white), -1)
    text_check_i(acc, "ttf cbdt empty", ttf_cbdt_blit(bbd, 0, 0, 4, bbuf, bsurf, 0, 0, white), 0)
    # composite edge: self-ref (depth cap, ket thuc) + no-XY (reject)
    ed = ttf_test_composite_edge_bytes()
    text_check_i(acc, "ttf comp selfref", len(ttf_parse_glyf(ed, 8, 0, 0, 1)), 0)
    text_check_i(acc, "ttf comp noxy", len(ttf_parse_glyf(ed, 8, 0, 0, 2)), 0)
    text_check_i(acc, "ttf comp edge base", ttf_parse_glyf(ed, 8, 0, 0, 0)[0], 1)
    return 1
def text_selftest() -> "str":
    print("=== TkvUI.Text selftest (P2) ===")
    acc = []
    acc.append(0)
    acc.append(0)
    white = ColorRgba(255, 255, 255, 255)
    empty = ColorRgba(0, 0, 0, 0)
    # --- glyph table
    text_check_i(acc, "glyph_width mono = 6", glyph_width("A"), 6)
    text_check_i(acc, "glyph space row 0 rong", glyph_pattern(" ", 0), 0)
    text_check_gt(acc, "glyph A row 3 co net", glyph_pattern("A", 3), 0)
    text_check_gt(acc, "glyph A row 6 co net", glyph_pattern("A", 6), 0)
    fb = glyph_pattern("~", 3)
    text_check_gt(acc, "glyph ~ row 3 co net", fb, 0)
    # Ngoai bang ROM 5x7 (32..126) -> tra ve hop bao loi (row0=31, row3=17)
    uni0 = glyph_pattern("Om", 0)
    text_check_gt(acc, "glyph ngoai bang -> box row 0", uni0, 0)
    # --- measure_string
    m1 = measure_string("ABC", 1.0)
    text_check_f(acc, "measure_string ABC @1 -> w", m1.w, 18.0, 0.001)
    text_check_f(acc, "measure_string ABC @1 -> h", m1.h, 7.0, 0.001)
    m2 = measure_string("AB", 2.0)
    text_check_f(acc, "measure_string AB @2 -> w", m2.w, 24.0, 0.001)
    m3 = measure_string("", 1.0)
    text_check_f(acc, "measure_string rong -> w=0", m3.w, 0.0, 0.001)
    # --- draw_string
    buf = []
    surface_ensure_capacity(buf, 4800)
    surf = PixelSurface(200, 24, 200)
    surface_clear(buf, surf, empty)
    rc = draw_string(buf, surf, "AB", 0.0, 0.0, 1.0, white)
    text_check_i(acc, "draw_string tra 1", rc, 1)
    text_check_gt(acc, "draw_string AB co ve pixel", text_count_nonzero(buf, 4800, 0, 4800), 0)
    surface_clear(buf, surf, empty)
    draw_string(buf, surf, "", 0.0, 0.0, 1.0, white)
    text_check_i(acc, "draw_string rong -> 0 pixel", text_count_nonzero(buf, 4800, 0, 4800), 0)
    # --- align Center: box 100, text w=12 -> x=44
    surface_clear(buf, surf, empty)
    draw_string(buf, surf, "AB", 0.0, 0.0, 1.0, white, 1, 100.0)
    left_zone = 0
    i = 0
    while i < 24:
        left_zone = left_zone + text_count_nonzero(buf, 4800, i * 200 + 0, i * 200 + 44)
        i = i + 1
    right_zone = 0
    i = 0
    while i < 24:
        right_zone = right_zone + text_count_nonzero(buf, 4800, i * 200 + 44, i * 200 + 56)
        i = i + 1
    text_check_i(acc, "align Center: vung trai trong", left_zone, 0)
    text_check_gt(acc, "align Center: ve trong khung 44..56", right_zone, 0)
    # --- align Right: x=88
    surface_clear(buf, surf, empty)
    draw_string(buf, surf, "AB", 0.0, 0.0, 1.0, white, 2, 100.0)
    r_left = 0
    i = 0
    while i < 24:
        r_left = r_left + text_count_nonzero(buf, 4800, i * 200 + 0, i * 200 + 88)
        i = i + 1
    r_right = 0
    i = 0
    while i < 24:
        r_right = r_right + text_count_nonzero(buf, 4800, i * 200 + 88, i * 200 + 100)
        i = i + 1
    text_check_i(acc, "align Right: vung trai trong", r_left, 0)
    text_check_gt(acc, "align Right: ve trong khung 88..100", r_right, 0)
    # --- tracking: char thu 2 doi tu x=6 sang x=10
    surface_clear(buf, surf, empty)
    draw_string(buf, surf, "AB", 0.0, 0.0, 1.0, white, 0, 0.0, 4.0)
    gap_zone = 0
    i = 0
    while i < 24:
        gap_zone = gap_zone + text_count_nonzero(buf, 4800, i * 200 + 6, i * 200 + 10)
        i = i + 1
    track_zone = 0
    i = 0
    while i < 24:
        track_zone = track_zone + text_count_nonzero(buf, 4800, i * 200 + 10, i * 200 + 16)
        i = i + 1
    text_check_i(acc, "tracking 4: khoang 6..10 trong", gap_zone, 0)
    text_check_gt(acc, "tracking 4: char 2 nam tai 10..16", track_zone, 0)
    # --- draw_string scale 2 phu 2x pixel
    surface_clear(buf, surf, empty)
    draw_string(buf, surf, "A", 0.0, 0.0, 2.0, white)
    scaled = text_count_nonzero(buf, 4800, 0, 4800)
    surface_clear(buf, surf, empty)
    draw_string(buf, surf, "A", 0.0, 0.0, 1.0, white)
    plain = text_count_nonzero(buf, 4800, 0, 4800)
    text_check_i(acc, "scale 2 = 4x so pixel cua scale 1", scaled, plain * 4)
    # --- wrap
    lines = text_line_count("one two three four", 1.0, 48.0)
    text_check_i(acc, "text_line_count wrap 3 dong", lines, 3)
    text_check_i(acc, "text_line_count chuoi rong = 0", text_line_count("", 1.0, 48.0), 0)
    mb = measure_block("one two three four", 1.0, 48.0, 0.0)
    text_check_f(acc, "measure_block w = dong dai nhat", mb.w, 42.0, 0.001)
    text_check_f(acc, "measure_block h = 3 x lineHeight", mb.h, 27.0, 0.001)
    # --- draw_text_block + ellipsis khi gioi han dong
    surface_clear(buf, surf, empty)
    drawn = draw_text_block(buf, surf, "one two three four", 0.0, 0.0, 1.0, 48.0, 9.0, white)
    text_check_i(acc, "draw_text_block ve 3 dong", drawn, 3)
    line1_px = text_count_nonzero(buf, 4800, 0, 200)
    line2_px = text_count_nonzero(buf, 4800, 9 * 200, 10 * 200)
    text_check_gt(acc, "draw_text_block dong 1 co pixel", line1_px, 0)
    text_check_gt(acc, "draw_text_block dong 2 (y=9) co pixel", line2_px, 0)
    surface_clear(buf, surf, empty)
    drawn2 = draw_text_block(buf, surf, "one two three four", 0.0, 0.0, 1.0, 48.0, 9.0, white, 0, 2)
    text_check_i(acc, "draw_text_block max_lines=2 -> 2 dong", drawn2, 2)
    line3_px = text_count_nonzero(buf, 4800, 18 * 200, 19 * 200)
    text_check_i(acc, "max_lines=2: dong 3 khong ve", line3_px, 0)
    # --- P2.1: char_code (binary search trong charset 94 ky tu)
    text_check_i(acc, "char_code A=65", char_code("A"), 65)
    text_check_i(acc, "char_code a=97", char_code("a"), 97)
    text_check_i(acc, "char_code 0=48", char_code("0"), 48)
    text_check_i(acc, "char_code space=32", char_code(" "), 32)
    text_check_i(acc, "char_code ~=126", char_code("~"), 126)
    text_check_i(acc, "char_code ngoai bang = -1", char_code("Om"), 0 - 1)
    # --- P2.1: glyph atlas
    atlas = text_atlas_record(1)
    abuf = text_atlas_baked_buffer(atlas)
    atlas_sc = atlas.scale
    atlas_w = atlas.width
    atlas_h = atlas.height
    text_check_i(acc, "atlas scale=1", atlas_sc, 1)
    text_check_i(acc, "atlas width = 16*6", atlas_w, 96)
    text_check_i(acc, "atlas height = 6 hang x 7", atlas_h, 42)
    # bake xong phai co pixel sang (mask kenh r > 0)
    lit = int(0)
    total = atlas_w * atlas_h
    i = int(0)
    while i < total:
        pix = abuf[i]
        if (pix // 65536) % 256 > 0:
            lit = lit + 1
        i = i + 1
    text_check_gt(acc, "atlas bake co pixel sang", lit, 0)
    print("  atlas: " + str(lit) + " px sang / " + str(total))
    # --- P2.1: draw qua atlas ra dung bang pixel nhu draw_string
    surface_clear(buf, surf, empty)
    rc = text_atlas_draw_string(abuf, atlas, buf, surf, "AB", 0.0, 0.0, white)
    text_check_i(acc, "text_atlas_draw_string tra 1", rc, 1)
    atlas_px = text_count_nonzero(buf, 4800, 0, 4800)
    surface_clear(buf, surf, empty)
    draw_string(buf, surf, "AB", 0.0, 0.0, 1.0, white)
    classic_px = text_count_nonzero(buf, 4800, 0, 4800)
    text_check_i(acc, "atlas ve dung so px nhu draw_string", atlas_px, classic_px)
    # vi tri pixel giong het: draw 'AB' 2 lan (atlas vs classic) vao 2 buffer roi so
    abuf_draw = []
    i = int(0)
    while i < 4800:
        abuf_draw.append(0)
        i = i + 1
    surf_draw = PixelSurface(200, 24, 200)
    text_atlas_draw_string(abuf, atlas, abuf_draw, surf_draw, "AB", 0.0, 0.0, white)
    same = int(1)
    i = int(0)
    while i < 4800:
        if (buf[i] != 0) != (abuf_draw[i] != 0):
            same = 0
        i = i + 1
    text_check_i(acc, "atlas va draw_string cung vi tri pixel", same, 1)
    # mau sac: atlas blend dung mau color (buf[0] la pixel dau cua 'A' - hang 0 cua
    # glyph A co mask 14 -> chi cot 1,2,3 sang nen x=0 trong; kiem tra pixel dau tien MAU)
    surface_clear(buf, surf, empty)
    red = ColorRgba(255, 0, 0, 255)
    text_atlas_draw_string(abuf, atlas, buf, surf, "A", 0.0, 0.0, red)
    pix = int(0)
    found_red = int(0)
    i = int(0)
    while i < 4800:
        if buf[i] != 0:
            pix = buf[i]
            if (pix // 65536) % 256 == 255:
                if (pix // 256) % 256 == 0:
                    if pix % 256 == 0:
                        found_red = found_red + 1
        i = i + 1
    text_check_gt(acc, "atlas blend mau red (so px red)", found_red, 0)
    # tracking + align qua atlas
    surface_clear(buf, surf, empty)
    text_atlas_draw_string(abuf, atlas, buf, surf, "AB", 0.0, 0.0, white, 1, 100.0)
    left_zone = int(0)
    i = int(0)
    while i < 24:
        left_zone = left_zone + text_count_nonzero(buf, 4800, i * 200, i * 200 + 44)
        i = i + 1
    text_check_i(acc, "atlas align Center: vung trai trong", left_zone, 0)
    # --- P2.1 benchmark: atlas vs classic tren khoi text lon (lap nhieu vong)
    bench_text = "the quick brown fox jumps over the lazy dog 0123456789"
    bench_repeat = 400
    bench_buf1 = []
    bench_buf2 = []
    surface_ensure_capacity(bench_buf1, 4800)
    surface_ensure_capacity(bench_buf2, 4800)
    bench_surf = PixelSurface(200, 24, 200)
    # classic
    t0 = text_ticks()
    r = int(0)
    while r < bench_repeat:
        surface_clear(bench_buf1, bench_surf, empty)
        draw_string(bench_buf1, bench_surf, bench_text, 0.0, 0.0, 1.0, white)
        r = r + 1
    t1 = text_ticks()
    classic_ms = t1 - t0
    # atlas
    t0 = text_ticks()
    r = int(0)
    while r < bench_repeat:
        surface_clear(bench_buf2, bench_surf, empty)
        text_atlas_draw_string(abuf, atlas, bench_buf2, bench_surf, bench_text, 0.0, 0.0, white)
        r = r + 1
    t1 = text_ticks()
    atlas_ms = t1 - t0
    print("  bench: classic=" + str(classic_ms) + "ms atlas=" + str(atlas_ms) + "ms (" + str(bench_repeat) + " lap x " + str(len(bench_text)) + " ky tu)")
    if atlas_ms > 0:
        speedup_x10 = (classic_ms * 10) // atlas_ms
        print("  speedup ~" + str(speedup_x10 // 10) + "." + str(speedup_x10 % 10) + "x")
        if speedup_x10 >= 10:
            text_check(acc, "atlas nhanh hon classic (>=1x)", 1)
        else:
            text_check(acc, "atlas nhanh hon classic (>=1x)", 0)
    else:
        print("  speedup: atlas < 1ms (qua nhanh de do)")
        text_check(acc, "atlas nhanh hon classic (atlas < 1ms)", 1)
    # ket qua 2 duong phai giong nhau ve so px
    c1 = text_count_nonzero(bench_buf1, 4800, 0, 4800)
    c2 = text_count_nonzero(bench_buf2, 4800, 0, 4800)
    text_check_i(acc, "bench: classic va atlas cung so px", c2, c1)
    # --- TTF rasterizer: readers + bit helpers
    rd = []
    rd.append(18)
    rd.append(52)
    rd.append(255)
    rd.append(254)
    rd.append(0)
    rd.append(16)
    rd.append(32)
    rd.append(48)
    text_check_i(acc, "ttf u16", ttf_read_u16(rd, 0), 4660)
    text_check_i(acc, "ttf i16 neg", ttf_read_i16(rd, 2), -2)
    text_check_i(acc, "ttf u32", int(ttf_read_u32(rd, 4)), 1056816)
    tg = []
    tg.append(104)
    tg.append(101)
    tg.append(97)
    tg.append(100)
    text_check_i(acc, "ttf tag head", int(ttf_read_tag(tg, 0)), 1751474532)
    text_check_i(acc, "ttf bit1", bit1(3), 1)
    text_check_i(acc, "ttf bit1 zero", bit1(4), 0)
    text_check_i(acc, "ttf bit2", bit2(2), 1)
    text_check_i(acc, "ttf bit2 zero", bit2(1), 0)
    text_check_i(acc, "ttf bit4", bit4(4), 1)
    text_check_i(acc, "ttf bit8", bit8(8), 1)
    text_check_i(acc, "ttf bit8 zero", bit8(7), 0)
    text_check_i(acc, "ttf bit16", bit16(16), 1)
    text_check_i(acc, "ttf bit32", bit32(32), 1)
    text_check_i(acc, "ttf bit32 zero", bit32(31), 0)
    pw = []
    ttf_put_u16(pw, 4660)
    text_check_i(acc, "ttf put u16", ttf_read_u16(pw, 0), 4660)
    ttf_put_u16(pw, -64)
    text_check_i(acc, "ttf put u16 neg", ttf_read_u16(pw, 2), 65472)
    ttf_put_u32(pw, 1056816)
    text_check_i(acc, "ttf put u32", int(ttf_read_u32(pw, 4)), 1056816)
    # --- TTF bezier + flatten
    bp = ttf_bezier_eval(0.0, 0.0, 10.0, 0.0, 10.0, 10.0, 0.0)
    text_check_f(acc, "ttf bezier t0 x", bp.x, 0.0, 0.001)
    text_check_f(acc, "ttf bezier t0 y", bp.y, 0.0, 0.001)
    bp = ttf_bezier_eval(0.0, 0.0, 10.0, 0.0, 10.0, 10.0, 1.0)
    text_check_f(acc, "ttf bezier t1 x", bp.x, 10.0, 0.001)
    text_check_f(acc, "ttf bezier t1 y", bp.y, 10.0, 0.001)
    bp = ttf_bezier_eval(0.0, 0.0, 10.0, 0.0, 10.0, 10.0, 0.5)
    text_check_f(acc, "ttf bezier t05 x", bp.x, 7.5, 0.001)
    text_check_f(acc, "ttf bezier t05 y", bp.y, 2.5, 0.001)
    fl = []
    fsg = ttf_flatten_quad(0.0, 0.0, 5.0, 0.0, 10.0, 0.0, fl)
    text_check_i(acc, "ttf flatten straight segs", fsg, 1)
    text_check_i(acc, "ttf flatten pts len", len(fl), 4)
    text_check_f(acc, "ttf flatten x0", fl[0], 0.0, 0.001)
    text_check_f(acc, "ttf flatten x1", fl[2], 10.0, 0.001)
    # --- TTF bad font (version sai -> font rong)
    bad = []
    bi = int(0)
    while bi < 8:
        bad.append(0)
        bi = bi + 1
    bf = ttf_load_font(bad)
    text_check_i(acc, "ttf bad version upem", bf.upem, 0)
    # --- TTF synthetic font end-to-end
    fd = ttf_test_font_bytes()
    text_check_i(acc, "ttf synth len", len(fd), 314)
    text_check_i(acc, "ttf find head", ttf_find_table(fd, 1751474532), 124)
    text_check_i(acc, "ttf find hhea", ttf_find_table(fd, 1751672161), 180)
    text_check_i(acc, "ttf find hmtx", ttf_find_table(fd, 1752003704), 224)
    text_check_i(acc, "ttf find cmap", ttf_find_table(fd, 1668112752), 232)
    text_check_i(acc, "ttf find glyf", ttf_find_table(fd, 1735162214), 284)
    text_check_i(acc, "ttf find loca", ttf_find_table(fd, 1819239265), 276)
    text_check_i(acc, "ttf find maxp", ttf_find_table(fd, 1835104368), 216)
    text_check_i(acc, "ttf find missing", ttf_find_table(fd, 1700000000), 0)
    ff = ttf_load_font(fd)
    text_check_i(acc, "ttf upem", ff.upem, 1000)
    text_check_i(acc, "ttf ascent", ff.ascent, 800)
    text_check_i(acc, "ttf descent", ff.descent, -200)
    text_check_i(acc, "ttf num glyphs", ff.num_glyphs, 2)
    text_check_i(acc, "ttf glyf off", ff.glyf_off, 284)
    text_check_i(acc, "ttf loca off", ff.loca_off, 276)
    text_check_i(acc, "ttf loc fmt", ff.index_to_loc_format, 0)
    cm = ttf_parse_cmap(fd)
    text_check_i(acc, "ttf gid A", ttf_get_glyph_id(cm, fd, 65), 1)
    text_check_i(acc, "ttf gid B miss", ttf_get_glyph_id(cm, fd, 66), 0)
    text_check_i(acc, "ttf gid NUL", ttf_get_glyph_id(cm, fd, 0), 0)
    g0 = ttf_parse_glyf(fd, 284, 276, 0, 0)
    text_check_i(acc, "ttf empty glyph", len(g0), 0)
    g1 = ttf_parse_glyf(fd, 284, 276, 0, 1)
    text_check_i(acc, "ttf contours", g1[0], 1)
    text_check_i(acc, "ttf xmin", g1[1], 100)
    text_check_i(acc, "ttf ymin", g1[2], 0)
    text_check_i(acc, "ttf xmax", g1[3], 900)
    text_check_i(acc, "ttf ymax", g1[4], 700)
    tb = []
    ti = int(0)
    while ti < 256:
        tb.append(0)
        ti = ti + 1
    text_check_i(acc, "ttf raster ret", ttf_rasterize_glyph(g1, 0.016, 16, 16, 0, 0, tb, 16), 1)
    trc = text_count_nonzero(tb, 256, 0, 256)
    tok = 0
    if trc > 40:
        tok = 1
    text_check(acc, "ttf raster ink", tok)
    ttop = 0
    if tb[8] == 0:
        ttop = 1
    text_check(acc, "ttf raster top empty", ttop)
    tbot = 0
    if tb[248] != 0:
        tbot = 1
    text_check(acc, "ttf raster bottom filled", tbot)
    text_check_i(acc, "ttf raster empty", ttf_rasterize_glyph(g0, 0.016, 16, 16, 0, 0, tb, 16), 0)
    hx = ttf_parse_hmtx(fd, 224, 2, 2)
    mm = ttf_get_glyph_metrics(hx, 2, 1)
    text_check_i(acc, "ttf adv", mm[0], 600)
    text_check_i(acc, "ttf lsb", mm[1], 100)
    mo = ttf_get_glyph_metrics(hx, 2, 9)
    text_check_i(acc, "ttf metrics oob len", len(mo), 2)
    text_check_i(acc, "ttf metrics oob adv", mo[0], 0)
    text_check(acc, "ttf xtra section", text_selftest_ttfxtra(acc, white))
    ta = text_atlas_record(1)
    tab = []
    tj = int(0)
    while tj < 4032:
        tab.append(0)
        tj = tj + 1
    tcs = text_charset()
    text_check_i(acc, "ttf atlas bake count", ttf_atlas_bake(fd, hx, cm, 284, 276, 0, 1000, 800, -200, 2, ta, tab, tcs), 1)
    tbc = text_count_nonzero(tab, 4032, 0, 4032)
    bok = 0
    if tbc > 8:
        bok = 1
    text_check(acc, "ttf atlas bake ink", bok)
    # --- Vietnamese bitmap (TkvUI.Viet, pure TokenVector) ---
    text_check_i64(acc, "vi a-grave bits", vi_bits("à"), 16692328578)
    text_check_i64(acc, "vi e-hook-below bits", vi_bits("ể"), 15601285476)
    text_check_i64(acc, "vi unknown -> -1", vi_bits("zz"), 0 - 1)
    text_check_i(acc, "vi strlen Viet", vi_strlen("Việt"), 4)
    text_check_i(acc, "vi strlen ascii", vi_strlen("ABC"), 3)
    text_check_i(acc, "vi strlen rong", vi_strlen(""), 0)
    text_check_i(acc, "vi seq V", vi_seq_len_at("Việt", 0, 6), 1)
    text_check_i(acc, "vi seq e-3dv", vi_seq_len_at("Việt", 2, 6), 3)
    text_check_i(acc, "vi seq t", vi_seq_len_at("Việt", 5, 6), 1)
    vm = measure_string("Việt", 1.0)
    text_check_f(acc, "vi measure w=4 cot", vm.w, 24.0, 0.001)
    text_check_i(acc, "vi line_count 2 dong", text_line_count("Việt Nam", 1.0, 24.0), 2)
    vb = measure_block("Việt", 1.0, 100.0, 9.0)
    text_check_f(acc, "vi block w=4 cot", vb.w, 24.0, 0.001)
    vt = vi_truncate("Việt Nam", 4)
    text_check_i(acc, "vi truncate 4 cot", vi_strlen(vt), 4)
    text_check_i(acc, "vi truncate units", len(vt), 6)
    vtok = 0
    if vi_truncate("ABCDEF", 4) == "ABCD":
        vtok = 1
    text_check(acc, "vi truncate ascii nhu cu", vtok)
    surface_clear(buf, surf, empty)
    vrc = draw_string(buf, surf, "Việt", 0.0, 0.0, 1.0, white)
    text_check_i(acc, "vi draw tra 1", vrc, 1)
    text_check_gt(acc, "vi draw co pixel", text_count_nonzero(buf, 4800, 0, 4800), 0)
    vout = 0
    vi = 0
    while vi < 8:
        vout = vout + text_count_nonzero(buf, 4800, vi * 200 + 24, vi * 200 + 200)
        vi = vi + 1
    text_check_i(acc, "vi draw gon trong 4 cot", vout, 0)
    text_check_i(acc, "vi block 2 dong", draw_text_block(buf, surf, "Việt Nam", 0.0, 0.0, 1.0, 24.0, 9.0, white), 2)
    text_check_i(acc, "vi block ellipsis 1 dong", draw_text_block(buf, surf, "Việt Nam Hà Nội", 0.0, 0.0, 1.0, 30.0, 9.0, white, 0, 1), 1)
    # --- i18n baked glyphs (subset that: times Hebrew/Arabic, msyh CJK) ---
    text_check_i(acc, "i18n cp ni", i18n_codepoint("你"), 20320)
    text_check_i(acc, "i18n cp alef", i18n_codepoint("א"), 1488)
    text_check_i(acc, "i18n cp A miss", i18n_codepoint("A"), -1)
    text_check_i(acc, "i18n cp emoji miss", i18n_codepoint("🌍"), -1)
    text_check_i(acc, "i18n slot alef", i18n_slot_for(1488), 0)
    text_check_i(acc, "i18n slot ni", i18n_slot_for(20320), 8)
    text_check_i(acc, "i18n slot miss", i18n_slot_for(65), -1)
    text_check_i(acc, "u8 ni", utf8_seq_len("你好", 0), 3)
    text_check_i(acc, "u8 emoji", utf8_seq_len("🌍", 0), 4)
    text_check_i(acc, "u8 alef", utf8_seq_len("אב", 0), 2)
    iat = text_atlas_record_i18n(1)
    ibf = atlas_buffer(iat)
    text_check_i(acc, "i18n bake count", text_atlas_bake_i18n_all(iat, ibf), 10)
    text_check_gt(acc, "i18n bake ink", text_count_nonzero(ibf, len(ibf), 0, len(ibf)), 20)
    # advances ti le tu hmtx (khong con fixed 6px); gid luu per-slot
    text_check_i(acc, "i18n adv len", len(iat.glyph_adv), 10)
    text_check_i(acc, "i18n gid len", len(iat.glyph_gid), 10)
    advok = 0
    if iat.glyph_adv[0] > 0:
        if iat.glyph_adv[0] <= 8:
            advok = 1
    text_check(acc, "i18n adv sane", advok)
    gidok = 0
    if iat.glyph_gid[0] > 0:
        gidok = 1
    text_check(acc, "i18n gid stored", gidok)
    # fallback: atlas chua bake (adv rong) ve khong crash, dung monospace
    fat = text_atlas_record_i18n(1)
    fbf = []
    fj = int(0)
    while fj < 672:
        fbf.append(0)
        fj = fj + 1
    text_check_i(acc, "i18n draw unbake", text_atlas_draw_i18n(fbf, fat, buf, surf, "א", 0.0, 0.0, white), 1)
    text_check_i(acc, "i18n draw tra 1", text_atlas_draw_i18n(ibf, iat, buf, surf, "你好 שלום", 0.0, 0.0, white), 1)
    text_check_gt(acc, "i18n draw co pixel", text_count_nonzero(buf, 4800, 0, 4800), 0)
    surface_clear(buf, surf, empty)
    text_atlas_draw_i18n(ibf, iat, buf, surf, "א", 0.0, 0.0, white)
    text_check_gt(acc, "i18n alef co muc", text_count_nonzero(buf, 4800, 0, 4800), 0)
    aout = 0
    aix = 0
    while aix < 8:
        aout = aout + text_count_nonzero(buf, 4800, aix * 200 + 6, aix * 200 + 200)
        aix = aix + 1
    text_check_i(acc, "i18n alef gon 1 cot", aout, 0)
    surface_clear(buf, surf, empty)
    draw_string(buf, surf, "א", 0.0, 0.0, 1.0, white)
    text_check_gt(acc, "i18n bitmap tran cot", text_count_nonzero(buf, 4800, 6, 4800), 0)
    surface_clear(buf, surf, empty)
    text_check_i(acc, "i18n milestone tra 1", text_atlas_draw_i18n(ibf, iat, buf, surf, "你好 🌍 שלום", 0.0, 0.0, white), 1)
    # --- fallback chain (ASCII/Viet/i18n/box) ---
    text_check_i(acc, "fb ascii", font_family_resolve("A"), 0)
    text_check_i(acc, "fb space", font_family_resolve(" "), 0)
    text_check_i(acc, "fb viet", font_family_resolve("ệ"), 1)
    text_check_i(acc, "fb heb", font_family_resolve("א"), 2)
    text_check_i(acc, "fb cjk", font_family_resolve("你"), 3)
    text_check_i(acc, "fb emoji box", font_family_resolve("🌍"), 4)
    fas = text_atlas_record(1)
    fab = atlas_buffer(fas)
    atlas_bake(fas, fab)
    surface_clear(buf, surf, empty)
    text_check_i(acc, "fb draw tra 1", text_draw_fallback(fab, fas, ibf, iat, buf, surf, "Aא你🌍", 0.0, 0.0, white), 1)
    text_check_gt(acc, "fb draw co pixel", text_count_nonzero(buf, 4800, 0, 4800), 0)
    surface_clear(buf, surf, empty)
    text_draw_fallback(fab, fas, ibf, iat, buf, surf, " ", 0.0, 0.0, white)
    text_check_i(acc, "fb space blank", text_count_nonzero(buf, 4800, 0, 4800), 0)
    surface_clear(buf, surf, empty)
    text_check_i(acc, "fb milestone tra 1", text_draw_fallback(fab, fas, ibf, iat, buf, surf, "你好 🌍 שלום", 0.0, 0.0, white), 1)
    text_check_gt(acc, "fb milestone co pixel", text_count_nonzero(buf, 4800, 0, 4800), 0)
    fsp = 0
    fix = 0
    while fix < 8:
        fsp = fsp + text_count_nonzero(buf, 4800, fix * 200 + 12, fix * 200 + 18)
        fix = fix + 1
    text_check_i(acc, "fb space cot blank", fsp, 0)
    print("--- text selftest: " + str(acc[0]) + "/" + str(acc[1]) + " PASS ---")
    if acc[0] == acc[1]:
        return "TEXT_OK"
    return "TEXT_FAIL"
