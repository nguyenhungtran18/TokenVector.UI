# -*- coding: utf-8 -*-
"""TkvUI.Text - bitmap font + renderer (Task 3) + TTF rasterizer (P2.8) + Vietnamese (TkvUI.Viet), needs TkvUI.Core"""
__tkv_import__ = ["TkvUI.Core", "TkvUI.Viet", "TkvUI.I18nData"]
# P2.1: pinvoke GetTickCount de do thoi gian (benchmark atlas vs classic)
__tkv_extern_pinvoke__ = [{"name": "text_ticks", "dll": "kernel32.dll", "symbol": "GetTickCount", "convention": "stdcall", "params": [], "returns": "i32"}]
# TASK 3: TEXT - Embedded Bitmap Font 5x7 + Renderer + Glyph Atlas (P2.1)
# =========================================================
class TextMetrics:
    w: "f64"
    h: "f64"
    def __init__(self, w, h):
        self.w = w
        self.h = h

def text_charset() -> "str":
    # 94 ky tu ASCII in duoc (code 32..126), da sap xep tang dan theo code
    return " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

def char_code(ch: "str") -> "i32":
    # Ma ASCII cua 1 ky tu in duoc (32..126) bang binary search trong charset.
    # Compiler chua co ord()/chr() -> so sanh chuoi '<' '>' la so sanh codepoint,
    # search trong bang 95 ky tu da sort la deterministic. Ngoai bang -> -1.
    # P2.1 fix: hi = 94 (95 ky tu, index 0..94) - truoc do hi=93 lam sot '~'.
    alpha = text_charset()
    lo = int(0)
    hi = int(94)
    while lo <= hi:
        mid = (lo + hi) // 2
        c = alpha[mid]
        if c == ch:
            return mid + 32
        if c < ch:
            lo = mid + 1
        else:
            hi = mid - 1
    return 0 - 1

def glyph_width(ch: "str") -> "i32":
    # monospaced 5 +1 spacing
    return 6

# =========================================================
# P2.1: GLYPH ATLAS - pre-bake toan bo 95 glyph vao 1 buffer, draw = blit
# =========================================================
# Atlas layout: 95 glyph (code 32..126), moi glyph 5x7 pixel, xep theo hang.
# ATLAS_COLS glyph/hang de width vuong dep: 16 glyph x 6px = 96px hang.
# Ky thuat: atlas buffer chua packed ARGB (den=0 / trang=0x00FFFFFF); mask alpha
# cua glyph la KENH r (65536) thay vi a de blend nhanh: blit doc r, kenh khac bo qua.
ATLAS_COLS = 16
ATLAS_GLYPH_W = 6
ATLAS_GLYPH_H = 7
ATLAS_COUNT = 95

# Precomputed bit masks for fast pixel testing
def get_bit_mask(col: "i32") -> "i32":
    if col == 0:
        return 16
    if col == 1:
        return 8
    if col == 2:
        return 4
    if col == 3:
        return 2
    return 1

# Fast glyph pattern lookup - just delegate to existing glyph_pattern
def get_glyph_pattern(ch: "str", row: "i32") -> "i32":
    c = char_code(ch)
    if c >= 32 and c <= 126:
        return glyph_pattern(ch, row)
    return 0

class GlyphAtlas:
    cols: "i32"
    glyph_w: "i32"
    glyph_h: "i32"
    glyph_pw: "i32"
    scale: "i32"
    width: "i32"
    height: "i32"
    codes: "list[i32]"
    glyph_ox: "list[i32]"
    glyph_oy: "list[i32]"
    glyph_has_ink: "list[i32]"
    glyph_row_masks: "list[i32]"
    glyph_px_r: "list[i32]"
    glyph_px_c: "list[i32]"
    glyph_px_start: "list[i32]"
    glyph_px_len: "list[i32]"
    glyph_adv: "list[i32]"
    glyph_gid: "list[i32]"
    def __init__(self, cols, glyph_w, glyph_h, glyph_pw, scale, width, height):
        self.cols = cols
        self.glyph_w = glyph_w
        self.glyph_h = glyph_h
        self.glyph_pw = glyph_pw
        self.scale = scale
        self.width = width
        self.height = height
        self.codes = []
        self.glyph_ox = []
        self.glyph_oy = []
        self.glyph_has_ink = []
        self.glyph_row_masks = []
        self.glyph_px_r = []
        self.glyph_px_c = []
        self.glyph_px_start = []
        self.glyph_px_len = []
        self.glyph_adv = []
        self.glyph_gid = []

def atlas_width_for(cols: "i32", glyph_w: "i32", scale: "i32") -> "i32":
    return cols * glyph_w * scale

def atlas_rows_needed(count: "i32", cols: "i32") -> "i32":
    rows = count // cols
    if count % cols != 0:
        rows = rows + 1
    return rows

def atlas_make_record(cols: "i32", gw: "i32", gh: "i32", gpw: "i32", scale: "i32", w: "i32", h: "i32") -> "GlyphAtlas":
    # Factory vi hang so ATLAS_* vo hinh trong method - truyen tu mot ham thuong
    return GlyphAtlas(cols, gw, gh, gpw, scale, w, h)

def atlas_create(scale: "i32") -> "GlyphAtlas":
    # P2.1: han so module van an toan trong ham thuong (dung duoc o day vi
    # atlas_width_for/atlas_rows_needed cung la ham thuong) - KeyError truoc do
    # la do toi truyen vao atlas_make_record ma class field infer gap chu.
    sc = scale
    if sc < 1:
        sc = 1
    cols = int(16)
    gw = int(6)
    gh = int(7)
    gpw = int(5)
    cnt = int(95)
    w = cols * gw * sc
    rows = atlas_rows_needed(cnt, cols)
    h = rows * gh * sc
    atlas = atlas_make_record(cols, gw, gh, gpw, sc, w, h)
    # Pre-compute glyph origins for all 95 glyphs
    i = int(0)
    while i < 95:
        col = i % cols
        row = i // cols
        ox = col * gw * sc
        oy = row * gh * sc
        atlas.glyph_ox.append(ox)
        atlas.glyph_oy.append(oy)
        atlas.glyph_has_ink.append(0)
        atlas.glyph_px_start.append(0)
        atlas.glyph_px_len.append(0)
        atlas.glyph_adv.append(gw * sc)
        atlas.glyph_gid.append(-1)
        atlas.glyph_row_masks.append(0)
        atlas.glyph_row_masks.append(0)
        atlas.glyph_row_masks.append(0)
        atlas.glyph_row_masks.append(0)
        atlas.glyph_row_masks.append(0)
        atlas.glyph_row_masks.append(0)
        atlas.glyph_row_masks.append(0)
        i = i + 1
    return atlas

def atlas_create_extended(scale: "i32") -> "GlyphAtlas":
    sc = scale
    if sc < 1:
        sc = 1
    cols = int(16)
    gw = int(6)
    gh = int(7)
    gpw = int(5)
    cnt = int(239)
    w = cols * gw * sc
    rows = atlas_rows_needed(cnt, cols)
    h = rows * gh * sc
    atlas = atlas_make_record(cols, gw, gh, gpw, sc, w, h)
    i = int(0)
    while i < 239:
        col = i % cols
        row = i // cols
        ox = col * gw * sc
        oy = row * gh * sc
        atlas.glyph_ox.append(ox)
        atlas.glyph_oy.append(oy)
        atlas.glyph_has_ink.append(0)
        atlas.glyph_px_start.append(0)
        atlas.glyph_px_len.append(0)
        atlas.glyph_adv.append(gw * sc)
        atlas.glyph_gid.append(-1)
        atlas.glyph_row_masks.append(0)
        atlas.glyph_row_masks.append(0)
        atlas.glyph_row_masks.append(0)
        atlas.glyph_row_masks.append(0)
        atlas.glyph_row_masks.append(0)
        atlas.glyph_row_masks.append(0)
        i = i + 1
    return atlas

def atlas_buffer(atlas: "GlyphAtlas") -> "list[i64]":
    out = []
    total = atlas.width * atlas.height
    i = int(0)
    while i < total:
        out.append(0)
        i = i + 1
    return out

def atlas_glyph_origin(atlas: "GlyphAtlas", code: "i32") -> "Point2D":
    # Vi tri goc trai-tren cua glyph trong atlas (Point2D de tranh tra nhieu gia tri)
    col = code % atlas.cols
    row = code // atlas.cols
    return Point2D(float(col * atlas.glyph_w * atlas.scale), float(row * atlas.glyph_h * atlas.scale))

def atlas_bake(atlas: "GlyphAtlas", abuf: "list[i64]") -> "i32":
    # Pre-bake 95 glyph (code 32..126) vao atlas buffer. Pixel trong = 0,
    # pixel den = 0x00FFFFFF (r=g=b=255, a=0) -> blend blit doc kenh r nhanh.
    total = atlas.width * atlas.height
    i = int(0)
    while i < total:
        abuf[i] = 0
        i = i + 1
    white = ColorRgba(255, 255, 255, 0)
    charset = text_charset()
    for code in range(ATLAS_COUNT):
        ch = charset[code]
        ox = atlas.glyph_ox[code]
        oy = atlas.glyph_oy[code]
        sc = atlas.scale
        has_ink = 0
        px_start = len(atlas.glyph_px_r)
        px_count = 0
        for row in range(7):
            mask = glyph_pattern(ch, row)
            # Store row mask for fast blit (5 bits: col 0=16, 1=8, 2=4, 3=2, 4=1)
            atlas.glyph_row_masks[code * 7 + row] = mask
            for col in range(5):
                p = 16
                if col == 1:
                    p = 8
                if col == 2:
                    p = 4
                if col == 3:
                    p = 2
                if col == 4:
                    p = 1
                on = 0
                tmp = mask
                if tmp >= 16:
                    if p == 16:
                        on = 1
                    tmp = tmp - 16
                if tmp >= 8:
                    if p == 8:
                        on = 1
                    tmp = tmp - 8
                if tmp >= 4:
                    if p == 4:
                        on = 1
                    tmp = tmp - 4
                if tmp >= 2:
                    if p == 2:
                        on = 1
                    tmp = tmp - 2
                if tmp >= 1:
                    if p == 1:
                        on = 1
                if on == 1:
                    has_ink = 1
                    # Record pattern pixel for ink-list fast blit
                    atlas.glyph_px_r.append(row)
                    atlas.glyph_px_c.append(col)
                    px_count = px_count + 1
                    for sy in range(sc):
                        for sx in range(sc):
                            px = ox + col * sc + sx
                            py = oy + row * sc + sy
                            abuf[py * atlas.width + px] = white.to_uint32() - 0
        atlas.glyph_has_ink[code] = has_ink
        atlas.glyph_px_start[code] = px_start
        atlas.glyph_px_len[code] = px_count
    return ATLAS_COUNT

def atlas_bake_extended(atlas: "GlyphAtlas", abuf: "list[i64]") -> "i32":
    total = atlas.width * atlas.height
    i = int(0)
    while i < total:
        abuf[i] = 0
        i = i + 1
    white = ColorRgba(255, 255, 255, 0)
    charset = text_charset()
    count = int(0)
    # 1. Bake ASCII (95 glyphs, codes 0..94)
    for code in range(95):
        ch = charset[code]
        ox = atlas.glyph_ox[code]
        oy = atlas.glyph_oy[code]
        sc = atlas.scale
        has_ink = 0
        px_start = len(atlas.glyph_px_r)
        px_count = 0
        for row in range(7):
            mask = glyph_pattern(ch, row)
            atlas.glyph_row_masks[code * 7 + row] = mask
            for col in range(5):
                p = 16
                if col == 1:
                    p = 8
                if col == 2:
                    p = 4
                if col == 3:
                    p = 2
                if col == 4:
                    p = 1
                on = 0
                tmp = mask
                if tmp >= 16:
                    if p == 16:
                        on = 1
                    tmp = tmp - 16
                if tmp >= 8:
                    if p == 8:
                        on = 1
                    tmp = tmp - 8
                if tmp >= 4:
                    if p == 4:
                        on = 1
                    tmp = tmp - 4
                if tmp >= 2:
                    if p == 2:
                        on = 1
                    tmp = tmp - 2
                if tmp >= 1:
                    if p == 1:
                        on = 1
                if on == 1:
                    has_ink = 1
                    atlas.glyph_px_r.append(row)
                    atlas.glyph_px_c.append(col)
                    px_count = px_count + 1
                    for sy in range(sc):
                        for sx in range(sc):
                            px = ox + col * sc + sx
                            py = oy + row * sc + sy
                            abuf[py * atlas.width + px] = white.to_uint32() - 0
        atlas.glyph_has_ink[code] = has_ink
        atlas.glyph_px_start[code] = px_start
        atlas.glyph_px_len[code] = px_count
        count = count + 1
    # 2. Bake Viet (134 glyphs, codes 95..228)
    viet_pairs = vi_all_pairs()
    viet_base = 95
    i = int(0)
    while i < 134:
        if i < len(viet_pairs):
            pair = viet_pairs[i]
            code = viet_base + i
            bits = vi_bits(pair)
            if bits >= 0:
                ox = atlas.glyph_ox[code]
                oy = atlas.glyph_oy[code]
                sc = atlas.scale
                has_ink = 0
                px_start = len(atlas.glyph_px_r)
                px_count = 0
                for row in range(7):
                    mask = vi_row_of(bits, row)
                    atlas.glyph_row_masks[code * 7 + row] = mask
                    for col in range(5):
                        p = 16
                        if col == 1:
                            p = 8
                        if col == 2:
                            p = 4
                        if col == 3:
                            p = 2
                        if col == 4:
                            p = 1
                        on = 0
                        tmp = mask
                        if tmp >= 16:
                            if p == 16:
                                on = 1
                            tmp = tmp - 16
                        if tmp >= 8:
                            if p == 8:
                                on = 1
                            tmp = tmp - 8
                        if tmp >= 4:
                            if p == 4:
                                on = 1
                            tmp = tmp - 4
                        if tmp >= 2:
                            if p == 2:
                                on = 1
                            tmp = tmp - 2
                        if tmp >= 1:
                            if p == 1:
                                on = 1
                        if on == 1:
                            has_ink = 1
                            atlas.glyph_px_r.append(row)
                            atlas.glyph_px_c.append(col)
                            px_count = px_count + 1
                            for sy in range(sc):
                                for sx in range(sc):
                                    px = ox + col * sc + sx
                                    py = oy + row * sc + sy
                                    abuf[py * atlas.width + px] = white.to_uint32() - 0
                atlas.glyph_has_ink[code] = has_ink
                atlas.glyph_px_start[code] = px_start
                atlas.glyph_px_len[code] = px_count
                count = count + 1
        i = i + 1
    # 3. Bake i18n (10 glyphs, codes 229..238) - delegate to existing
    count = count + text_atlas_bake_i18n_all(atlas, abuf)
    return count

# =========================================================
# P2.x: FAST BLIT - inline origins, reduced bounds checks, batch support
# =========================================================

def atlas_blit_glyph_fast(abuf: "list[i64]", atlas: "GlyphAtlas", buf: "list[i64]", surf: "PixelSurface", code: "i32", dx: "i32", dy: "i32", color: "ColorRgba", alpha: "i64") -> "i32":
    # Fast path: alpha=255, inline origins, pre-check bounds once
    if code < 0 or code >= ATLAS_COUNT:
        return 0
    ox = atlas.glyph_ox[code]
    oy = atlas.glyph_oy[code]
    gw = atlas.glyph_pw * atlas.scale
    gh = atlas.glyph_h * atlas.scale
    cr = color.r
    cg = color.g
    cb = color.b
    ca = alpha
    if ca == 0:
        return 0
    if ca < 255:
        # Slow path - delegate to full function
        return atlas_blit_glyph(abuf, atlas, buf, surf, code, dx, dy, color, alpha)
    # FAST PATH: opaque overwrite
    packed = ca * 16777216 + cr * 65536 + cg * 256 + cb
    sw = surf.width
    sh = surf.height
    stride = surf.stride
    # Pre-compute clipped bounds
    start_ly = 0
    if dy < 0:
        start_ly = -dy
    end_ly = gh
    if dy + gh > sh:
        end_ly = sh - dy
    if start_ly >= end_ly:
        return 1
    start_lx = 0
    if dx < 0:
        start_lx = -dx
    end_lx = gw
    if dx + gw > sw:
        end_lx = sw - dx
    if start_lx >= end_lx:
        return 1
    # Blit only visible region
    for ly in range(start_ly, end_ly):
        py = dy + ly
        arow = (oy + ly) * atlas.width + ox
        drow = py * stride + dx
        for lx in range(start_lx, end_lx):
            apix = abuf[arow + lx]
            if apix != 0:
                buf[drow + lx] = packed
    return 1

def atlas_blit_batch(abuf: "list[i64]", atlas: "GlyphAtlas", buf: "list[i64]", surf: "PixelSurface", codes: "list[i32]", dx: "i32", dy: "i32", adv: "i32", color: "ColorRgba", alpha: "i64") -> "i32":
    # Batch blit multiple glyphs - optimized per-glyph with hoisted invariants
    if alpha < 255:
        # Fall back to individual blits for transparent
        i = int(0)
        cur_x = dx
        n = len(codes)
        while i < n:
            atlas_blit_glyph_fast(abuf, atlas, buf, surf, codes[i], cur_x, dy, color, alpha)
            cur_x = cur_x + adv
            i = i + 1
        return 1
    # Fast opaque batch blit - hoisted invariants
    cr = color.r
    cg = color.g
    cb = color.b
    ca = alpha
    packed = ca * 16777216 + cr * 65536 + cg * 256 + cb
    sw = surf.width
    sh = surf.height
    stride = surf.stride
    gw = atlas.glyph_pw * atlas.scale
    gh = atlas.glyph_h * atlas.scale
    aw = atlas.width
    sc = atlas.scale
    # Check if fully visible (common case) - skip all clipping
    fully_visible = 1
    if dy < 0:
        fully_visible = 0
    if dy + gh > sh:
        fully_visible = 0
    if dx < 0:
        fully_visible = 0
    # Check last glyph position
    last_dx = dx + (len(codes) - 1) * adv
    if last_dx + gw > sw:
        fully_visible = 0
    if fully_visible == 1:
        if sc == 1:
            # FAST PATH: scale 1, fully visible - horizontal run coalescing + inlined row bases.
            # Group contiguous horizontal pixels per row into runs.
            cur_x = dx
            i = int(0)
            n = len(codes)
            dy_stride = dy * stride
            # Pre-compute 7 row bases as scalars (no list allocation)
            rb0 = dy_stride + 0 * stride
            rb1 = dy_stride + 1 * stride
            rb2 = dy_stride + 2 * stride
            rb3 = dy_stride + 3 * stride
            rb4 = dy_stride + 4 * stride
            rb5 = dy_stride + 5 * stride
            rb6 = dy_stride + 6 * stride
            while i < n:
                code = codes[i]
                if code >= 0 and code < ATLAS_COUNT:
                    pxs = atlas.glyph_px_start[code]
                    pxn = atlas.glyph_px_len[code]
                    if pxn > 0:
                        k = int(0)
                        base_x = cur_x
                        # Process first pixel
                        pr = atlas.glyph_px_r[pxs + k]
                        pc = atlas.glyph_px_c[pxs + k]
                        run_row = pr
                        run_start = pc
                        run_len = int(1)
                        k = k + 1
                        while k < pxn:
                            pr = atlas.glyph_px_r[pxs + k]
                            pc = atlas.glyph_px_c[pxs + k]
                            if pr == run_row and pc == run_start + run_len:
                                # Extend horizontal run
                                run_len = run_len + 1
                            else:
                                # Flush current run (row_base pre-computed)
                                m = int(0)
                                rb = int(0)
                                if run_row == 0:
                                    rb = rb0
                                if run_row == 1:
                                    rb = rb1
                                if run_row == 2:
                                    rb = rb2
                                if run_row == 3:
                                    rb = rb3
                                if run_row == 4:
                                    rb = rb4
                                if run_row == 5:
                                    rb = rb5
                                if run_row == 6:
                                    rb = rb6
                                rb = rb + base_x + run_start
                                while m < run_len:
                                    buf[rb + m] = packed
                                    m = m + 1
                                # Start new run
                                run_row = pr
                                run_start = pc
                                run_len = int(1)
                            k = k + 1
                        # Flush last run
                        m = int(0)
                        rb = int(0)
                        if run_row == 0:
                            rb = rb0
                        if run_row == 1:
                            rb = rb1
                        if run_row == 2:
                            rb = rb2
                        if run_row == 3:
                            rb = rb3
                        if run_row == 4:
                            rb = rb4
                        if run_row == 5:
                            rb = rb5
                        if run_row == 6:
                            rb = rb6
                        rb = rb + base_x + run_start
                        while m < run_len:
                            buf[rb + m] = packed
                            m = m + 1
                cur_x = cur_x + adv
                i = i + 1
            return 1
    # Pre-compute vertical clipping once
    start_ly = 0
    if dy < 0:
        start_ly = -dy
    end_ly = gh
    if dy + gh > sh:
        end_ly = sh - dy
    if start_ly >= end_ly:
        return 1
    # Process each glyph (sequential, better cache locality than scanline)
    cur_x = dx
    i = int(0)
    n = len(codes)
    while i < n:
        code = codes[i]
        if code >= 0 and code < ATLAS_COUNT:
            # Skip entirely transparent glyphs (space, etc.)
            if atlas.glyph_has_ink[code] == 0:
                cur_x = cur_x + adv
                i = i + 1
                continue
            ox = atlas.glyph_ox[code]
            oy = atlas.glyph_oy[code]
            # Horizontal clipping
            start_lx = 0
            if cur_x < 0:
                start_lx = -cur_x
            end_lx = gw
            if cur_x + gw > sw:
                end_lx = sw - cur_x
            if start_lx < end_lx:
                # Hoist row calculations
                ly = start_ly
                while ly < end_ly:
                    py = dy + ly
                    arow = (oy + ly) * aw + ox
                    drow = py * stride + cur_x
                    for lx in range(start_lx, end_lx):
                        apix = abuf[arow + lx]
                        if apix != 0:
                            buf[drow + lx] = packed
                    ly = ly + 1
        cur_x = cur_x + adv
        i = i + 1
    return 1

def atlas_blit_glyph(abuf: "list[i64]", atlas: "GlyphAtlas", buf: "list[i64]", surf: "PixelSurface", code: "i32", dx: "i32", dy: "i32", color: "ColorRgba", alpha: "i64") -> "i32":
    # Blit 1 glyph tu atlas sang buffer dich. Anh sang den: doc kenh r cua atlas pixel
    # lam mask 0..255, blend vao buf voi mau color, do alpha toan cuc (alpha = color.a).
    # P2.2 fast paths (theo thu tu re -> dat):
    #   1. alpha = 255 (font dac, truong hop pho bien nhat): pixel mask > 0 thi GHI TRUC TIEP
    #      mau color, khong can doc/blend/decode kenh dst -> bo ~70% cong sao moi pixel.
    #   2. mask == 0 (pixel trong cua glyph): skip tu luc truoc (da co).
    #   3. alpha < 255: giu blend SrcOver day du (trong suot dan).
    if code < 0:
        return 0
    if code >= ATLAS_COUNT:
        return 0
    origin = atlas_glyph_origin(atlas, code)
    ox = int(origin.x)
    oy = int(origin.y)
    gw = atlas.glyph_pw * atlas.scale
    gh = atlas.glyph_h * atlas.scale
    cr = color.r
    cg = color.g
    cb = color.b
    ca = alpha
    if ca == 0:
        return 0
    if ca >= 255:
        # FAST PATH: font dac, ghi de truc tiep (opaque overwrites)
        packed = ca * 16777216 + cr * 65536 + cg * 256 + cb
        sw = surf.width
        sh = surf.height
        stride = surf.stride
        for ly in range(gh):
            py = dy + ly
            if py < 0:
                continue
            if py >= sh:
                continue
            arow = (oy + ly) * atlas.width + ox
            drow = py * stride + dx
            for lx in range(gw):
                px = dx + lx
                if px < 0:
                    continue
                if px >= sw:
                    continue
                apix = abuf[arow + lx]
                if apix != 0:
                    buf[drow + lx] = packed
        return 1
    # SLOW PATH: alpha trong suot dan -> SrcOver day du
    for ly in range(gh):
        py = dy + ly
        if py < 0:
            continue
        if py >= surf.height:
            continue
        arow = (oy + ly) * atlas.width + ox
        for lx in range(gw):
            px = dx + lx
            if px < 0:
                continue
            if px >= surf.width:
                continue
            apix = abuf[arow + lx]
            mask = (apix // 65536) % 256
            if mask == 0:
                continue
            di = py * surf.stride + px
            dst = buf[di]
            da = dst // 16777216
            rem = dst % 16777216
            dr = rem // 65536
            rem2 = rem % 65536
            dg = rem2 // 256
            db = rem2 % 256
            inv = 255 - ca
            nr = (cr * ca + dr * inv) // 255
            ng = (cg * ca + dg * inv) // 255
            nb = (cb * ca + db * inv) // 255
            na = ca + (da * inv) // 255
            if na > 255:
                na = 255
            buf[di] = na * 16777216 + nr * 65536 + ng * 256 + nb
    return 1

