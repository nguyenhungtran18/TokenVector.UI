# -*- coding: utf-8 -*-
"""TkvUI.ClipPlayer - player cho clip ingest tu MP4 that (chuoi Chrome ingest).

Chan cuoi chuoi: MP4 (Chrome decode) -> PNG frames (tools/chrome_cap.py) ->
TKVV blob (tools/tkvv_import.py -> TkvUI.TkvvClipMp4.tkv) -> parse/decode/
render that (TkvUI.Tkvv) + clock (TkvUI.Video) + transport (TkvUI.Media),
assert sums theo ground truth bake trong clip + nonzero pixels.

Headless: clipplayer_run, khong mo cua so.
Build:
  tkvc.exe build examples/TkvUI.ClipPlayer.tkv --entry clipplayer_run --out build/clipplayer.exe
"""
__tkv_import__ = ["../TkvUI.Core", "../TkvUI.Graphics", "../TkvUI.Text", "../TkvUI.Media", "../TkvUI.Tkvv", "../TkvUI.TkvvClipMp4", "../TkvUI.Video"]

def cpcheck(acc: "list[i32]", name: "str", ok: "i32") -> "i32":
    acc[1] = acc[1] + 1
    if ok == 1:
        acc[0] = acc[0] + 1
        print("  PASS " + name)
        return 1
    print("  FAIL " + name)
    return 0

def cpcheck_i(acc: "list[i32]", name: "str", got: "i32", want: "i32") -> "i32":
    if got == want:
        return cpcheck(acc, name + " = " + str(got), 1)
    print("  FAIL " + name + " got=" + str(got) + " want=" + str(want))
    acc[1] = acc[1] + 1
    return 0

def cp_sum(vals: "list[i32]", n: "i32") -> "i32":
    s = int(0)
    i = int(0)
    while i < n:
        s = s + vals[i]
        i = i + 1
    return s

def cp_decode_sum(data: "list[i32]", w: "i32", h: "i32", ftypes: "list[i32]", foffs: "list[i32]", flens: "list[i32]", palbuf: "list[i32]", k: "i32", idx: "list[i32]", rgb: "list[i32]") -> "i32":
    # Giai frame k (chain tu 0, nhu player that) -> rgb sum.
    ref = []
    j = int(0)
    while j <= k:
        cur = []
        tkvv_decode_frame(data, w, h, ftypes, foffs, flens, j, ref, cur)
        ref = cur
        j = j + 1
    q = int(0)
    while q < w * h:
        idx[q] = ref[q]
        q = q + 1
    while len(rgb) > 0:
        rgb.pop()
    gif_frame_rgb(palbuf, 0, idx, w * h, rgb)
    return cp_sum(rgb, w * h * 3)

def clipplayer_run() -> "str":
    print("== ClipPlayer: play clip ingest tu MP4 that ==")
    acc = [int(0), int(0)]
    data = tkvm_bytes()
    cpcheck_i(acc, "blob len", tkvm_len(), len(data))
    ftypes = []
    foffs = []
    flens = []
    fdelays = []
    palbuf = []
    err = []
    nfr = tkvv_parse(data, ftypes, foffs, flens, fdelays, palbuf, err)
    cpcheck_i(acc, "nframes", nfr, tkvm_nframes())
    cpcheck_i(acc, "parse err", err[0], 0)
    whnp = []
    tkvv_parse_dims(data, whnp)
    cpcheck_i(acc, "dim w", whnp[0], 320)
    cpcheck_i(acc, "dim h", whnp[1], 240)
    total = vid_total_cs(fdelays, nfr)
    print("total_cs=" + str(total))
    oktotal = int(0)
    if total > 0:
        oktotal = 1
    cpcheck(acc, "total cs > 0", oktotal)
    # transport + clock that (TkvUI.Media + TkvUI.Video)
    tr = make_media_transport(8.0, 160.0, 200.0, 1, 1, 1)
    tr.toggle()
    cpcheck_i(acc, "playing", tr.playing, 1)
    fi0 = vid_frame_at(fdelays, nfr, 0)
    cpcheck_i(acc, "frame at 0", fi0, 0)
    fi1 = vid_frame_at(fdelays, nfr, total - 1)
    cpcheck_i(acc, "frame at end", fi1, nfr - 1)
    # decode + render + sums theo ground truth bake trong clip
    npix = 320 * 240
    idx = []
    zi = int(0)
    while zi < npix:
        idx.append(0)
        zi = zi + 1
    rgb = []
    s0 = cp_decode_sum(data, 320, 240, ftypes, foffs, flens, palbuf, 0, idx, rgb)
    cpcheck_i(acc, "rgb sum f0", s0, tkvm_f0_sum())
    s1 = cp_decode_sum(data, 320, 240, ftypes, foffs, flens, palbuf, 1, idx, rgb)
    cpcheck_i(acc, "rgb sum f1", s1, tkvm_f1_sum())
    s2 = cp_decode_sum(data, 320, 240, ftypes, foffs, flens, palbuf, 2, idx, rgb)
    cpcheck_i(acc, "rgb sum f2", s2, tkvm_f2_sum())
    s3 = cp_decode_sum(data, 320, 240, ftypes, foffs, flens, palbuf, 3, idx, rgb)
    cpcheck_i(acc, "rgb sum f3", s3, tkvm_f3_sum())
    nz = text_count_nonzero(rgb, npix * 3, 0, npix * 3)
    okpx = int(0)
    if nz > 1000:
        okpx = 1
    cpcheck(acc, "render nonzero", okpx)
    print("nonzero=" + str(nz))
    print("clipplayer: " + str(acc[0]) + "/" + str(acc[1]))
    if acc[0] == acc[1]:
        return "CLIPPLAYER_OK"
    return "CLIPPLAYER_FAIL"
