# -*- coding: utf-8 -*-
"""TkvUI.Fuzz - fuzz rasterizer + model (Phase 11.4/12.4, deterministic).

LCG i64 (seed co dinh) sinh rect/text/line/widget ngau nhien ke ca bien
am/offscreen/radius lon/chuoi rong — assert khong crash + return code dung.
Build:
  tkvc.exe build examples/TkvUI.Fuzz.tkv --entry fuzz_run --out build/fuzz.exe
"""
__tkv_import__ = ["../TkvUI.Core", "../TkvUI.Graphics", "../TkvUI.Text", "../TkvUI.Theme", "../TkvUI.Widgets.Native", "../TkvUI.Data"]

def fz_seed() -> "i64":
    return 12345

def fz_step(s: "i64") -> "i64":
    nv = s * 1103515245 + 12345
    return nv - (nv // 2147483648) * 2147483648

def fz_below(s: "i64", m: "i64") -> "i32":
    q = s // 65536
    r = q - (q // m) * m
    return int(float(r))

def fz_range(s: "i64", lo: "i64", hi: "i64") -> "i32":
    span = hi - lo
    if span <= 0:
        return int(float(lo))
    q = s // 65536
    return int(float(lo + (q - (q // span) * span)))

def fz_color(k: "i32") -> "ColorRgba":
    if k == 1:
        return ColorRgba(200, 60, 60, 255)
    if k == 2:
        return ColorRgba(60, 200, 90, 255)
    if k == 3:
        return ColorRgba(80, 140, 255, 255)
    if k == 4:
        return ColorRgba(0, 0, 0, 0)
    return ColorRgba(240, 240, 240, 255)

def fz_text(s: "i64", n: "i32") -> "str":
    alpha = "abcXYZ019 (test)"
    out = ""
    i = int(0)
    while i < n:
        s = fz_step(s)
        out = out + alpha[fz_below(s, 16)]
        i = i + 1
    return out

def fz_check(acc: "list[i32]", name: "str", ok: "i32") -> "i32":
    acc[1] = acc[1] + 1
    if ok == 1:
        acc[0] = acc[0] + 1
        print("  PASS " + name)
        return 1
    print("  FAIL " + name)
    return 0

def fz_check_i(acc: "list[i32]", name: "str", got: "i32", want: "i32") -> "i32":
    acc[1] = acc[1] + 1
    if got == want:
        acc[0] = acc[0] + 1
        print("  PASS " + name + " = " + str(got))
        return 1
    print("  FAIL " + name + " got=" + str(got) + " want=" + str(want))
    return 0

def fuzz_run() -> "str":
    print("== TkvUI.Fuzz (seed=12345, 1000 iters) ==")
    acc = [int(0), int(0)]
    w = int(400)
    h = int(400)
    surf = PixelSurface(w, h, w)
    buf = []
    i = int(0)
    while i < w * h:
        buf.append(0)
        i = i + 1
    black = ColorRgba(0, 0, 0, 255)
    surface_clear(buf, surf, black)
    s = fz_seed()
    nrect = int(0)
    ntext = int(0)
    nline = int(0)
    nstroke = int(0)
    nwidget = int(0)
    it = int(0)
    while it < 1000:
        s = fz_step(s)
        op = fz_below(s, 5)
        s = fz_step(s)
        x = fz_range(s, -50, 200)
        s = fz_step(s)
        y = fz_range(s, -50, 200)
        s = fz_step(s)
        ww = fz_range(s, 1, 120)
        s = fz_step(s)
        hh = fz_range(s, 1, 120)
        s = fz_step(s)
        col = fz_color(fz_below(s, 5))
        if op == 0:
            s = fz_step(s)
            r = Rect2D(float(x), float(y), float(ww), float(hh))
            rc = fill_round_rect(buf, surf, r, float(fz_below(s, 21)), col)
            if rc == 1:
                nrect = nrect + 1
        elif op == 1:
            s = fz_step(s)
            t = fz_text(s, fz_below(s, 13))
            rc = draw_string(buf, surf, t, float(x), float(y), 1.0, col)
            if rc >= 0:
                ntext = ntext + 1
        elif op == 2:
            s = fz_step(s)
            x2 = fz_range(s, -50, 200)
            s = fz_step(s)
            y2 = fz_range(s, -50, 200)
            rc = draw_line(buf, surf, float(x), float(y), float(x2), float(y2), 1.0, col)
            if rc == 1:
                nline = nline + 1
        else:
            if op == 3:
                r = Rect2D(float(x), float(y), float(ww), float(hh))
                rc = stroke_round_rect(buf, surf, r, 2.0, 1.0, col)
                if rc == 1:
                    nstroke = nstroke + 1
                it = it + 1
            it = it + 1
    total = nrect + ntext + nline + nstroke + nwidget
    fz_check_i(acc, "fuzz.ops", total, 1357)
    # pixel count nam trong [0, w*h]
    cnt = int(0)
    i = int(0)
    while i < w * h:
        if buf[i] != 0:
            cnt = cnt + 1
        i = i + 1
    okc = 0
    if cnt >= 0:
        if cnt <= w * h:
            okc = 1
    fz_check(acc, "fuzz.pxrange", okc)
    # model fuzz: append/remove/cell guard ngau nhien
    cells = []
    s = fz_step(s)
    r5 = fz_seed_rows()
    a = int(0)
    while a < 120:
        s = fz_step(s)
        m = fz_below(s, 4)
        if m == 0:
            mv_row_append(cells, 3, r5)
        else:
            if m == 1:
                s = fz_step(s)
                mv_row_remove(cells, 3, fz_below(s, 5) - 1)
            else:
                if m == 2:
                    s = fz_step(s)
                    mv_cell_get(cells, 3, fz_below(s, 5) - 1, fz_below(s, 4) - 1)
                else:
                    s = fz_step(s)
                    mv_cell_set(cells, 3, fz_below(s, 5) - 1, fz_below(s, 4) - 1, "fuzz")
        a = a + 1
    fz_check(acc, "fuzz.model.nocrash", 1)
    # adversarial edge cases
    s = fz_step(s)
    r = Rect2D(float(-100), float(-100), float(-10), float(-10))
    rc = fill_round_rect(buf, surf, r, float(fz_below(s, 21)), fz_color(fz_below(s, 5)))
    fz_check(acc, "fuzz.negrect", rc == 1)
    s = fz_step(s)
    rc = draw_string(buf, surf, "", float(0), float(0), 1.0, fz_color(fz_below(s, 5)))
    fz_check(acc, "fuzz.emptytext", rc >= 0)
    s = fz_step(s)
    rc = draw_line(buf, surf, float(100), float(100), float(100), float(100), 1.0, fz_color(fz_below(s, 5)))
    fz_check(acc, "fuzz.zeroline", rc == 1)
    # stress widget fuzz
    s = fz_step(s)
    wcount = int(0)
    while wcount < 20:
        s = fz_step(s)
        b = make_native_button(float(fz_range(s, 0, 400)), float(fz_range(s, 0, 400)), float(fz_range(s, 50, 200)), 24.0, fz_text(s, 6))
        rc = b.render(buf, surf, fz_below(s, 3) - 1)
        if rc == 1:
            wcount = wcount + 1
        s = fz_step(s)
    fz_check_i(acc, "fuzz.widgets", wcount, 20)
    print("fuzz: rect=" + str(nrect) + " text=" + str(ntext) + " line=" + str(nline) + " stroke=" + str(nstroke) + " widget=" + str(nwidget))
    print("fuzz: " + str(acc[0]) + "/" + str(acc[1]))
    if acc[0] == acc[1]:
        return "FUZZ_OK"
    return "FUZZ_FAIL"

def fz_seed_rows() -> "list[str]":
    out = []
    out.append("a")
    out.append("b")
    out.append("c")
    return out