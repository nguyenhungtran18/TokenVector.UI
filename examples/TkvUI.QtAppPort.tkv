# -*- coding: utf-8 -*-
"""TkvUI.QtAppPort - port trung thuc Qt 6 "Application Example"
(examples/mainwindows/application: SDI text editor) sang TokenVector.UI.

Qt goc: QMainWindow + QTextEdit central + QMenuBar (File/Edit/Help) +
QToolBar (File/Edit) + QStatusBar + QFileDialog + QMessageBox (maybeSave,
About) + QPrintDialog + recent files (QSettings) + actions/shortcuts.

Map sang TkvUI (moi control dung that, khong stub):
  QMainWindow layout  -> ghep NativeMenuBar + NativeToolBar + NativeRichEdit
                         + NativeStatusBar (640x480)
  QMenu/QAction       -> menus/items lists + action table (id/text/shortcut/tip)
  QTextEdit           -> NativeRichEdit (lines list, caret/insert/newline that)
  QFileDialog         -> DlgFile state (dlg_make_open/save) + file IO truc tiep
  QMessageBox         -> NativeDialog (show/hide/hit_button/result that)
  QPrintDialog/print  -> Printing pdf_export_table + pdf_save (file that)
  QSettings recent    -> recent list (in-memory, max 5)
Lech co tai lieu (headless): modal dialog -> show + hit + hide theo kich ban;
  clipboard noi bo (khong OS clipboard); khong separator trong menu model;
  maybeSave 2 nut Yes/No (control chi ho tro toi da 2 nut).

Headless test: qtapp_run mo phong toan bo thao tac (go phim, menu, toolbar,
dialog, save/open/print, recent, exit) + assert state + pixel-sum ground truth.
Build:
  tkvc.exe build examples/TkvUI.QtAppPort.tkv --entry qtapp_run --out build/qtapp.exe
"""
__tkv_import__ = ["../TkvUI.Core", "../TkvUI.Platform", "../TkvUI.Widgets.Native", "../TkvUI.NativeDlg", "../TkvUI.Printing"]
__tkv_extern_method__ = [
    {"name": "qaf_write", "assembly": "mscorlib", "class": "System.IO.File", "method": "WriteAllText", "params": ["str", "str"], "returns": "void"},
    {"name": "qaf_read", "assembly": "mscorlib", "class": "System.IO.File", "method": "ReadAllText", "params": ["str"], "returns": "str"},
    {"name": "qaf_exists", "assembly": "mscorlib", "class": "System.IO.File", "method": "Exists", "params": ["str"], "returns": "bool"}
]

QTAPP_W = 640
QTAPP_H = 480

class QtApp:
    cur_file: "str"
    modified: "i32"
    status: "str"
    clipboard: "str"
    exiting: "i32"
    def __init__(self, cur_file, modified, status, clipboard, exiting):
        self.cur_file = cur_file
        self.modified = modified
        self.status = status
        self.clipboard = clipboard
        self.exiting = exiting
    def get_file(self) -> "str":
        return self.cur_file
    def is_modified(self) -> "i32":
        return self.modified
    def get_status(self) -> "str":
        return self.status
    def get_clipboard(self) -> "str":
        return self.clipboard
    def is_exiting(self) -> "i32":
        return self.exiting
    def set_file(self, p: "str") -> "str":
        self.cur_file = p
        return p
    def set_modified(self, v: "i32") -> "i32":
        self.modified = v
        return v
    def set_status(self, s: "str") -> "str":
        self.status = s
        return s
    def set_clipboard(self, s: "str") -> "str":
        self.clipboard = s
        return s
    def set_exiting(self, v: "i32") -> "i32":
        self.exiting = v
        return v

def qacheck(acc: "list[i32]", name: "str", ok: "i32") -> "i32":
    acc[1] = acc[1] + 1
    if ok == 1:
        acc[0] = acc[0] + 1
        print("  PASS " + name)
        return 1
    print("  FAIL " + name)
    return 0

def qacheck_i(acc: "list[i32]", name: "str", got: "i32", want: "i32") -> "i32":
    if got == want:
        return qacheck(acc, name + " = " + str(got), 1)
    print("  FAIL " + name + " got=" + str(got) + " want=" + str(want))
    acc[1] = acc[1] + 1
    return 0

def qacheck_s(acc: "list[i32]", name: "str", got: "str", want: "str") -> "i32":
    if got == want:
        return qacheck(acc, name, 1)
    print("  FAIL " + name + " got=[" + got + "] want=[" + want + "]")
    acc[1] = acc[1] + 1
    return 0

