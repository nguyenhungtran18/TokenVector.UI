def in_clusters(text: "str", starts: "list[i32]", lens: "list[i32]", flags: "list[i32]") -> "i32":
    # Cum Devanagari + flags (0 base / 1 reph / 2 prebase-matra).
    n = len(text)
    idx = int(0)
    cur_start = int(-1)
    cur_len = int(0)
    cur_flag = int(0)
    expect_cons = int(0)
    maybe_reph = int(0)
    count = int(0)
    while idx < n:
        adv = utf8_seq_len(text, idx)
        if idx + adv > n:
            adv = n - idx
        seg = text[idx:idx + adv]
        if in_is_consonant(seg) == 1:
            if cur_start >= 0:
                if expect_cons == 1:
                    cur_len = cur_len + adv
                    expect_cons = 0
                    maybe_reph = 0
                else:
                    starts.append(cur_start)
                    lens.append(cur_len)
                    flags.append(cur_flag)
                    count = count + 1
                    cur_start = idx
                    cur_len = adv
                    cur_flag = 0
                    maybe_reph = 0
            else:
                cur_start = idx
                cur_len = adv
                cur_flag = 0
                maybe_reph = 0
            # Reph candidate: cluster mo dau bang ra, confirm khi virama sau
            if seg == "र":
                maybe_reph = 1
        else:
            if in_is_virama(seg) == 1:
                if cur_start < 0:
                    return 0
                cur_len = cur_len + adv
                expect_cons = 1
                if maybe_reph == 1:
                    cur_flag = 1
                    maybe_reph = 0
            else:
                if in_is_matra(seg) == 1:
                    if cur_start < 0:
                        return 0
                    cur_len = cur_len + adv
                    if in_is_prebase_matra(seg) == 1:
                        if cur_flag == 0:
                            cur_flag = 2
                    expect_cons = 0
                else:
                    if in_is_anusvara(seg) == 1 or in_is_nukta(seg) == 1:
                        if cur_start < 0:
                            return 0
                        cur_len = cur_len + adv
                        expect_cons = 0
                    else:
                        return 0
        idx = idx + adv
    if cur_start >= 0:
        starts.append(cur_start)
        lens.append(cur_len)
        flags.append(cur_flag)
        count = count + 1
    return count

# =========================================================
# SCRIPT DETECTION + GENERIC CLUSTER API (cursor/selection)
# Thu tu: ASCII -> Viet -> Arabic -> Thai -> Devanagari -> baked i18n.
# =========================================================
def shape_script_of(seq: "str") -> "i32":
    if len(seq) == 1:
        if char_code(seq) >= 0:
            return 0
        return 7
    if vi_bits(seq) >= 0:
        return 1
    if ar_join_type(seq) >= 0:
        return 2
    if th_mark_class(seq) > 0 or th_is_consonant(seq) == 1:
        return 5
    if in_is_consonant(seq) == 1 or in_is_matra(seq) == 1 or in_is_virama(seq) == 1 or in_is_anusvara(seq) == 1:
        return 6
    if bn_is_consonant(seq) == 1 or bn_is_matra(seq) == 1 or bn_is_virama(seq) == 1 or bn_is_anusvara(seq) == 1:
        return 8
    if ta_is_consonant(seq) == 1 or ta_is_matra(seq) == 1 or ta_is_virama(seq) == 1:
        return 9
    cp = i18n_codepoint(seq)
    if cp >= 0:
        if i18n_slot_for(cp) < 8:
            return 3
        return 4
    return 7

def shape_clusters(text: "str", starts: "list[i32]", lens: "list[i32]") -> "i32":
    # Cum grapheme script-aware cho cursor/selection.
    # Arabic: joining runs; Thai/Indic: cum chuyen biet; con lai: per-sequence.
    n = len(text)
    if n == 0:
        return 0
    # Xac dinh script cua sequence dau
    adv0 = utf8_seq_len(text, 0)
    if adv0 > n:
        adv0 = n
    s0 = shape_script_of(text[0:adv0])
    if s0 == 2:
        return ar_cluster_runs(text, starts, lens)
    if s0 == 5:
        return th_clusters(text, starts, lens)
    if s0 == 6:
        flags = []
        return in_clusters(text, starts, lens, flags)
    if s0 == 8:
        flags = []
        return bn_clusters(text, starts, lens, flags)
    if s0 == 9:
        flags = []
        return ta_clusters(text, starts, lens, flags)
    # Mac dinh: moi sequence 1 cluster
    idx = int(0)
    count = int(0)
    while idx < n:
        adv = utf8_seq_len(text, idx)
        if idx + adv > n:
            adv = n - idx
        starts.append(idx)
        lens.append(adv)
        count = count + 1
        idx = idx + adv
    return count

def ar_cluster_runs(text: "str", starts: "list[i32]", lens: "list[i32]") -> "i32":
    # Cum Arabic: cat khi het joining (prev dual VA cur joins-right thi gop).
    # Vi du "مرحبا" -> [مر][حبا]. Marks dinh kem (truoc/sau) vao cluster.
    # Dung cho cursor/selection.
    n = len(text)
    idx = int(0)
    cur_start = int(-1)
    cur_len = int(0)
    prev_t = int(-1)
    pend_start = int(-1)
    pend_len = int(0)
    count = int(0)
    while idx < n:
        adv = utf8_seq_len(text, idx)
        if idx + adv > n:
            adv = n - idx
        seg = text[idx:idx + adv]
        t = ar_join_type(seg)
        if t < 0:
            return 0
        if t == 3:
            if pend_start < 0:
                pend_start = idx
                pend_len = adv
            else:
                pend_len = pend_len + adv
        else:
            if pend_start >= 0:
                if cur_start < 0:
                    cur_start = pend_start
                    cur_len = pend_len
                else:
                    cur_len = cur_len + pend_len
                pend_start = -1
                pend_len = 0
            if cur_start < 0:
                cur_start = idx
                cur_len = adv
            else:
                if prev_t == 2 and (t == 1 or t == 2):
                    cur_len = cur_len + adv
                else:
                    starts.append(cur_start)
                    lens.append(cur_len)
                    count = count + 1
                    cur_start = idx
                    cur_len = adv
            prev_t = t
        idx = idx + adv
    if pend_start >= 0:
        if cur_start < 0:
            return 0
        cur_len = cur_len + pend_len
    if cur_start >= 0:
        starts.append(cur_start)
        lens.append(cur_len)
        count = count + 1
    return count

