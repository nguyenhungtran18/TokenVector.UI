def th_clusters(text: "str", starts: "list[i32]", lens: "list[i32]") -> "i32":
    # Cum grapheme Thai: prebase vowel gop FORWARD voi phu am sau;
    # marks gan vao cluster hien tai. Vi du [โต] la 1 cluster.
    n = len(text)
    idx = int(0)
    cur_start = int(-1)
    cur_len = int(0)
    pre_open = int(0)
    count = int(0)
    while idx < n:
        adv = utf8_seq_len(text, idx)
        if idx + adv > n:
            adv = n - idx
        seg = text[idx:idx + adv]
        mc = th_mark_class(seg)
        if mc == 1:
            if cur_start >= 0:
                if pre_open == 0:
                    starts.append(cur_start)
                    lens.append(cur_len)
                    count = count + 1
            cur_start = idx
            cur_len = adv
            pre_open = 1
        else:
            if mc == 0:
                if th_is_consonant(seg) == 0:
                    return 0
                if cur_start >= 0:
                    if pre_open == 0:
                        starts.append(cur_start)
                        lens.append(cur_len)
                        count = count + 1
                else:
                    cur_start = idx
                    cur_len = 0
                if pre_open == 0:
                    cur_start = idx
                    cur_len = adv
                else:
                    cur_len = cur_len + adv
                    pre_open = 0
            else:
                if cur_start < 0:
                    cur_start = idx
                    cur_len = adv
                else:
                    cur_len = cur_len + adv
        idx = idx + adv
    if cur_start >= 0:
        starts.append(cur_start)
        lens.append(cur_len)
        count = count + 1
    return count

