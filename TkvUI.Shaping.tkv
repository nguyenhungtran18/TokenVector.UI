# -*- coding: utf-8 -*-
"""TkvUI.Shaping - Complex script shaping engine, pure TokenVector (M2.2a).

Kien truc (theo docs/PHASE11_2_COMPLEX_SCRIPT.md):
- Khong phu thuoc HarfBuzz DLL (FFI multi-char blocked - gap compiler A2).
- Output dang parallel lists (starts/lens/forms) nhu fb_resolve, khong
  doi hoi literal presentation-form trong source.
- Render integration (pixel) can font co glyph + HarfBuzz unblock (sau).

Phu thuoc: Core, Text (char_code), Viet (utf8_seq_len, vi_bits),
I18nData (i18n_codepoint). Khong vong import.
"""
__tkv_import__ = ["TkvUI.Core", "TkvUI.Text", "TkvUI.Viet", "TkvUI.I18nData"]

# Scripts
SH_LATIN = 0
SH_VIET = 1
SH_ARABIC = 2
SH_HEBREW = 3
SH_CJK = 4
SH_THAI = 5
SH_DEVANAGARI = 6
SH_UNKNOWN = 7
SH_BENGALI = 8
SH_TAMIL = 9

# Arabic joining types
AR_JOIN_NONE = 0
AR_JOIN_RIGHT = 1
AR_JOIN_DUAL = 2
AR_JOIN_TRANSPARENT = 3

# Arabic form selectors
AR_FORM_ISOLATED = 0
AR_FORM_INITIAL = 1
AR_FORM_MEDIAL = 2
AR_FORM_FINAL = 3

# Thai mark classes
TH_MARK_NONE = 0
TH_MARK_PREBASE = 1
TH_MARK_ABOVE = 2
TH_MARK_BELOW = 3

# Indic cluster flags
IN_CLUSTER_BASE = 0
IN_CLUSTER_REPH = 1
IN_CLUSTER_PREBASE_MATRA = 2

def ar_is_transparent(seq: "str") -> "i32":
    # Tatweel + harakat (khong cat joining).
    if seq == "ـ":
        return 1
    if seq == "ً":
        return 1
    if seq == "ٌ":
        return 1
    if seq == "ٍ":
        return 1
    if seq == "َ":
        return 1
    if seq == "ُ":
        return 1
    if seq == "ِ":
        return 1
    if seq == "ّ":
        return 1
    if seq == "ْ":
        return 1
    return 0

def ar_is_right_joining(seq: "str") -> "i32":
    # Chi noi ve phai (logical previous), khong noi ve trai (next).
    if seq == "ا":
        return 1
    if seq == "أ":
        return 1
    if seq == "إ":
        return 1
    if seq == "آ":
        return 1
    if seq == "ؤ":
        return 1
    if seq == "ة":
        return 1
    if seq == "د":
        return 1
    if seq == "ذ":
        return 1
    if seq == "ر":
        return 1
    if seq == "ز":
        return 1
    if seq == "و":
        return 1
    return 0

def ar_is_dual_joining(seq: "str") -> "i32":
    # Noi ca 2 phia.
    if seq == "ب":
        return 1
    if seq == "ت":
        return 1
    if seq == "ث":
        return 1
    if seq == "ج":
        return 1
    if seq == "ح":
        return 1
    if seq == "خ":
        return 1
    if seq == "س":
        return 1
    if seq == "ش":
        return 1
    if seq == "ص":
        return 1
    if seq == "ض":
        return 1
    if seq == "ط":
        return 1
    if seq == "ظ":
        return 1
    if seq == "ع":
        return 1
    if seq == "غ":
        return 1
    if seq == "ف":
        return 1
    if seq == "ق":
        return 1
    if seq == "ك":
        return 1
    if seq == "ل":
        return 1
    if seq == "م":
        return 1
    if seq == "ن":
        return 1
    if seq == "ه":
        return 1
    if seq == "ي":
        return 1
    if seq == "ئ":
        return 1
    if seq == "ى":
        return 1
    return 0

def ar_join_type(seq: "str") -> "i32":
    # 0=none, 1=right, 2=dual, 3=transparent, -1=not Arabic.
    if ar_is_transparent(seq) == 1:
        return 3
    if ar_is_right_joining(seq) == 1:
        return 1
    if ar_is_dual_joining(seq) == 1:
        return 2
    if seq == "ء":
        return 0
    return -1

def ar_shape_word(text: "str", starts: "list[i32]", lens: "list[i32]", forms: "list[i32]") -> "i32":
    # Phan tich joining cho 1 tu Arabic (logical order). Output per-LETTER:
    # starts/lens = byte offsets (gom ca marks dinh kem), forms =
    # 0 iso / 1 initial / 2 medial / 3 final.
    # Transparent marks dau tu gan vao letter ke tiep; cuoi tu gan vao
    # letter truoc; tu chi co marks -> tra 0. Text co ky tu la -> tra 0.
    # Tra so letter.
    n = len(text)
    lstarts = []
    llens = []
    ltypes = []
    idx = int(0)
    pend_start = int(-1)
    pend_len = int(0)
    while idx < n:
        adv = utf8_seq_len(text, idx)
        if idx + adv > n:
            adv = n - idx
        seg = text[idx:idx + adv]
        t = ar_join_type(seg)
        if t < 0:
            return 0
        if t == 3:
            if pend_start < 0:
                pend_start = idx
                pend_len = 0
            pend_len = pend_len + adv
        else:
            if pend_start < 0:
                lstarts.append(idx)
                llens.append(adv)
            else:
                lstarts.append(pend_start)
                llens.append(pend_len + adv)
                pend_start = -1
                pend_len = 0
            ltypes.append(t)
        idx = idx + adv
    # Trailing marks: gan vao letter cuoi
    if pend_start >= 0:
        if len(ltypes) == 0:
            return 0
        li = len(llens) - 1
        llens[li] = llens[li] + pend_len
    m = len(lstarts)
    i = int(0)
    while i < m:
        t = ltypes[i]
        r = int(0)
        if t == 1 or t == 2:
            if i > 0:
                if ltypes[i - 1] == 2:
                    r = 1
        l = int(0)
        if t == 2:
            if i + 1 < m:
                nt = ltypes[i + 1]
                if nt == 1 or nt == 2:
                    l = 1
        f = int(0)
        if r == 1 and l == 1:
            f = 2
        else:
            if l == 1:
                f = 1
            else:
                if r == 1:
                    f = 3
        starts.append(lstarts[i])
        lens.append(llens[i])
        forms.append(f)
        i = i + 1
    return m

# =========================================================
# THAI - mark classes + grapheme clusters
# Logical == visual cho renderer bitmap (prebase vowels dung truoc
# san); gia tri chinh: cluster boundaries cho cursor/selection +
# phan lop marks (stacking sau nay).
# =========================================================
def th_mark_class(seq: "str") -> "i32":
    # 0=not mark, 1=prebase vowel, 2=above, 3=below.
    if seq == "เ":
        return 1
    if seq == "แ":
        return 1
    if seq == "โ":
        return 1
    if seq == "ใ":
        return 1
    if seq == "ไ":
        return 1
    if seq == "ั":
        return 2
    if seq == "็":
        return 2
    if seq == "ิ":
        return 2
    if seq == "ี":
        return 2
    if seq == "ึ":
        return 2
    if seq == "ื":
        return 2
    if seq == "่":
        return 2
    if seq == "้":
        return 2
    if seq == "๊":
        return 2
    if seq == "๋":
        return 2
    if seq == "์":
        return 2
    if seq == "ํ":
        return 2
    if seq == "ุ":
        return 3
    if seq == "ู":
        return 3
    if seq == "ฺ":
        return 3
    return 0

