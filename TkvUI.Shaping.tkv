    sh_check_i(acc, "bn cl0 flag base", bnf[0], 0)
    gs3 = []
    gl3 = []
    sh_check_i(acc, "clusters bengali", shape_clusters("বাংলা", gs3, gl3), 2)
    # Tamil (research doc: தமிழ்)
    sh_check_i(acc, "script tamil", shape_script_of("த"), 9)
    sh_check_i(acc, "script tamil cons", shape_script_of("ம"), 9)
    sh_check_i(acc, "ta cons ta", ta_is_consonant("த"), 1)
    sh_check_i(acc, "ta cons zha", ta_is_consonant("ழ"), 1)
    sh_check_i(acc, "ta virama", ta_is_virama("்"), 1)
    sh_check_i(acc, "ta matra i", ta_is_matra("ி"), 1)
    sh_check_i(acc, "ta prebase e", ta_is_prebase_matra("ெ"), 1)
    sh_check_i(acc, "ta prebase ai", ta_is_prebase_matra("ை"), 1)
    tas = []
    tal = []
    taf = []
    sh_check_i(acc, "ta clusters n", ta_clusters("தமிழ்", tas, tal, taf), 3)
    sh_check_i(acc, "ta cl1 prebase", taf[1], 2)
    gs4 = []
    gl4 = []
    sh_check_i(acc, "clusters tamil", shape_clusters("தமிழ்", gs4, gl4), 3)
    # Lam-alef ligature runs
    ls = []
    ll = []
    sh_check_i(acc, "lamalef n", ar_ligature_runs("لا", ls, ll), 1)
    sh_check_i(acc, "lamalef len", ll[0], 4)
    ls2 = []
    ll2 = []
    sh_check_i(acc, "lamalef none", ar_ligature_runs("مرحبا", ls2, ll2), 0)
    ls3 = []
    ll3 = []
    sh_check_i(acc, "lamalef mid", ar_ligature_runs("بلا", ls3, ll3), 1)
    sh_check_i(acc, "lamalef mid start", ls3[0], 2)
    print("shaping: " + str(acc[0]) + "/" + str(acc[1]))
    if acc[0] == acc[1]:
        return "SHAPING_OK"
    return "SHAPING_FAIL"
