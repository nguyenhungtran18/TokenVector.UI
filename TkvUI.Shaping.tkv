def bn_clusters(text: "str", starts: "list[i32]", lens: "list[i32]", flags: "list[i32]") -> "i32":
    n = len(text)
    idx = int(0)
    cur_start = int(-1)
    cur_len = int(0)
    cur_flag = int(0)
    expect_cons = int(0)
    maybe_reph = int(0)
    count = int(0)
    while idx < n:
        adv = utf8_seq_len(text, idx)
        if idx + adv > n:
            adv = n - idx
        seg = text[idx:idx + adv]
        if bn_is_consonant(seg) == 1:
            if cur_start >= 0:
                if expect_cons == 1:
                    cur_len = cur_len + adv
                    expect_cons = 0
                    maybe_reph = 0
                else:
                    starts.append(cur_start)
                    lens.append(cur_len)
                    flags.append(cur_flag)
                    count = count + 1
                    cur_start = idx
                    cur_len = adv
                    cur_flag = 0
                    maybe_reph = 0
            else:
                cur_start = idx
                cur_len = adv
                cur_flag = 0
                maybe_reph = 0
            if seg == "র":
                maybe_reph = 1
        else:
            if bn_is_virama(seg) == 1:
                if cur_start < 0:
                    return 0
                cur_len = cur_len + adv
                expect_cons = 1
                if maybe_reph == 1:
                    cur_flag = 1
                    maybe_reph = 0
            else:
                if bn_is_matra(seg) == 1:
                    if cur_start < 0:
                        return 0
                    cur_len = cur_len + adv
                    if bn_is_prebase_matra(seg) == 1:
                        if cur_flag == 0:
                            cur_flag = 2
                    expect_cons = 0
                else:
                    if bn_is_anusvara(seg) == 1:
                        if cur_start < 0:
                            return 0
                        cur_len = cur_len + adv
                        expect_cons = 0
                    else:
                        return 0
        idx = idx + adv
    if cur_start >= 0:
        starts.append(cur_start)
        lens.append(cur_len)
        flags.append(cur_flag)
        count = count + 1
    return count

# =========================================================
# TAMIL - classification + clusters (18 consonants, no reph)
# Prebase matras: ி ெ ே ை (visual truoc consonant).
# =========================================================
def ta_is_virama(seq: "str") -> "i32":
    if seq == "்":
        return 1
    return 0

def ta_is_matra(seq: "str") -> "i32":
    if seq == "ா":
        return 1
    if seq == "ி":
        return 1
    if seq == "ீ":
        return 1
    if seq == "ு":
        return 1
    if seq == "ூ":
        return 1
    if seq == "ெ":
        return 1
    if seq == "ே":
        return 1
    if seq == "ை":
        return 1
    return 0

def ta_is_prebase_matra(seq: "str") -> "i32":
    if seq == "ி":
        return 1
    if seq == "ெ":
        return 1
    if seq == "ே":
        return 1
    if seq == "ை":
        return 1
    return 0

def ta_is_consonant(seq: "str") -> "i32":
    if seq == "க":
        return 1
    if seq == "ங":
        return 1
    if seq == "ச":
        return 1
    if seq == "ஞ":
        return 1
    if seq == "ட":
        return 1
    if seq == "ண":
        return 1
    if seq == "த":
        return 1
    if seq == "ந":
        return 1
    if seq == "ப":
        return 1
    if seq == "ம":
        return 1
    if seq == "ய":
        return 1
    if seq == "ர":
        return 1
    if seq == "ல":
        return 1
    if seq == "வ":
        return 1
    if seq == "ழ":
        return 1
    if seq == "ள":
        return 1
    if seq == "ற":
        return 1
    if seq == "ன":
        return 1
    return 0

def ta_clusters(text: "str", starts: "list[i32]", lens: "list[i32]", flags: "list[i32]") -> "i32":
    n = len(text)
    idx = int(0)
    cur_start = int(-1)
    cur_len = int(0)
    cur_flag = int(0)
    expect_cons = int(0)
    count = int(0)
    while idx < n:
        adv = utf8_seq_len(text, idx)
        if idx + adv > n:
            adv = n - idx
        seg = text[idx:idx + adv]
        if ta_is_consonant(seg) == 1:
            if cur_start >= 0:
                if expect_cons == 1:
                    cur_len = cur_len + adv
                    expect_cons = 0
                else:
                    starts.append(cur_start)
                    lens.append(cur_len)
                    flags.append(cur_flag)
                    count = count + 1
                    cur_start = idx
                    cur_len = adv
                    cur_flag = 0
            else:
                cur_start = idx
                cur_len = adv
                cur_flag = 0
        else:
            if ta_is_virama(seg) == 1:
                if cur_start < 0:
                    return 0
                cur_len = cur_len + adv
                expect_cons = 1
            else:
                if ta_is_matra(seg) == 1:
                    if cur_start < 0:
                        return 0
                    cur_len = cur_len + adv
                    if ta_is_prebase_matra(seg) == 1:
                        if cur_flag == 0:
                            cur_flag = 2
                    expect_cons = 0
                else:
                    return 0
        idx = idx + adv
    if cur_start >= 0:
        starts.append(cur_start)
        lens.append(cur_len)
        flags.append(cur_flag)
        count = count + 1
    return count

# =========================================================
# ARABIC LAM-ALEF ligature runs (لا لا لا لا)
# =========================================================
def ar_is_lam(seq: "str") -> "i32":
    if seq == "ل":
        return 1
    return 0

def ar_is_alef_variant(seq: "str") -> "i32":
    if seq == "ا":
        return 1
    if seq == "أ":
        return 1
    if seq == "إ":
        return 1
    if seq == "آ":
        return 1
    return 0

def ar_ligature_runs(text: "str", starts: "list[i32]", lens: "list[i32]") -> "i32":
    # Tim chuoi lam+alef lien tiep (bo qua transparent o giua).
    # Tra so runs; moi run = byte offsets bao ca 2 chu + marks giua.
    n = len(text)
    idx = int(0)
    count = int(0)
    while idx < n:
        adv = utf8_seq_len(text, idx)
        if idx + adv > n:
            adv = n - idx
        seg = text[idx:idx + adv]
        if ar_is_lam(seg) == 1:
            j = idx + adv
            while j < n:
                jadv = utf8_seq_len(text, j)
                if j + jadv > n:
                    jadv = n - j
                jseg = text[j:j + jadv]
                if ar_is_transparent(jseg) == 1:
                    j = j + jadv
                else:
                    break
            if j < n:
                jadv = utf8_seq_len(text, j)
                if j + jadv > n:
                    jadv = n - j
                jseg = text[j:j + jadv]
                if ar_is_alef_variant(jseg) == 1:
                    starts.append(idx)
                    lens.append(j + jadv - idx)
                    count = count + 1
                    idx = j + jadv
                    continue
            idx = idx + adv
        else:
            idx = idx + adv
    return count

# =========================================================
# SELFTEST (pure logic, khong can font that)
# =========================================================
def sh_check(acc: "list[i32]", name: "str", ok: "i32") -> "i32":
    acc[1] = acc[1] + 1
    if ok == 1:
        acc[0] = acc[0] + 1
        print("  PASS " + name)
        return 1
    print("  FAIL " + name)
    return 0

def sh_check_i(acc: "list[i32]", name: "str", got: "i32", want: "i32") -> "i32":
    acc[1] = acc[1] + 1
    if got == want:
        acc[0] = acc[0] + 1
        print("  PASS " + name + " = " + str(got))
        return 1
    print("  FAIL " + name + " got=" + str(got) + " want=" + str(want))
    return 0

def shaping_selftest() -> "str":
    print("== TkvUI.Shaping selftest ==")
    acc = [int(0), int(0)]
    sh_check_i(acc, "script latin", shape_script_of("A"), 0)
    sh_check_i(acc, "script space", shape_script_of(" "), 0)
    sh_check_i(acc, "script viet", shape_script_of("ệ"), 1)
    sh_check_i(acc, "script arabic meem", shape_script_of("م"), 2)
    sh_check_i(acc, "script arabic alef", shape_script_of("ا"), 2)
    sh_check_i(acc, "script hebrew", shape_script_of("א"), 3)
    sh_check_i(acc, "script cjk", shape_script_of("你"), 4)
    sh_check_i(acc, "script thai mark", shape_script_of("ั"), 5)
    sh_check_i(acc, "script thai cons", shape_script_of("ส"), 5)
    sh_check_i(acc, "script deva cons", shape_script_of("न"), 6)
