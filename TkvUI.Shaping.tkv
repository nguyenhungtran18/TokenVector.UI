    sh_check_i(acc, "ar dual beh", ar_join_type("ب"), 2)
    sh_check_i(acc, "ar right alef", ar_join_type("ا"), 1)
    sh_check_i(acc, "ar right dal", ar_join_type("د"), 1)
    sh_check_i(acc, "ar right reh", ar_join_type("ر"), 1)
    sh_check_i(acc, "ar right waw", ar_join_type("و"), 1)
    sh_check_i(acc, "ar none hamza", ar_join_type("ء"), 0)
    sh_check_i(acc, "ar trans tatweel", ar_join_type("ـ"), 3)
    sh_check_i(acc, "ar trans fatha", ar_join_type("َ"), 3)
    sh_check_i(acc, "ar nonarab", ar_join_type("A"), -1)
    st = []
    ln = []
    fm = []
    sh_check_i(acc, "ar word n", ar_shape_word("مرحبا", st, ln, fm), 5)
    sh_check_i(acc, "ar meem initial", fm[0], 1)
    sh_check_i(acc, "ar reh final", fm[1], 3)
    sh_check_i(acc, "ar heh initial", fm[2], 1)
    sh_check_i(acc, "ar beh medial", fm[3], 2)
    sh_check_i(acc, "ar alef final", fm[4], 3)
    st2 = []
    ln2 = []
    fm2 = []
    sh_check_i(acc, "ar single n", ar_shape_word("ب", st2, ln2, fm2), 1)
    sh_check_i(acc, "ar single iso", fm2[0], 0)
    st3 = []
    ln3 = []
    fm3 = []
    sh_check_i(acc, "ar ba n", ar_shape_word("با", st3, ln3, fm3), 2)
    sh_check_i(acc, "ar ba initial", fm3[0], 1)
    sh_check_i(acc, "ar ba final", fm3[1], 3)
    st4 = []
    ln4 = []
    fm4 = []
    sh_check_i(acc, "ar mark n", ar_shape_word("بَ", st4, ln4, fm4), 1)
    sh_check_i(acc, "ar mark iso", fm4[0], 0)
    cs = []
    cl = []
    sh_check_i(acc, "ar clusters n", ar_cluster_runs("مرحبا", cs, cl), 2)
    sh_check_i(acc, "ar cl0 start", cs[0], 0)
    sh_check_i(acc, "ar cl0 len", cl[0], 4)
    sh_check_i(acc, "ar cl1 start", cs[1], 4)
    sh_check_i(acc, "th prebase e", th_mark_class("เ"), 1)
    sh_check_i(acc, "th prebase o", th_mark_class("โ"), 1)
    sh_check_i(acc, "th above maihan", th_mark_class("ั"), 2)
    sh_check_i(acc, "th above tone", th_mark_class("่"), 2)
    sh_check_i(acc, "th below u", th_mark_class("ุ"), 3)
    sh_check_i(acc, "th cons", th_is_consonant("ส"), 1)
    sh_check_i(acc, "th cons tho", th_is_consonant("ท"), 1)
    sh_check_i(acc, "th noncons", th_is_consonant("เ"), 0)
    ts = []
    tl = []
    sh_check_i(acc, "th clusters n", th_clusters("สวัสดี", ts, tl), 4)
    sh_check_i(acc, "th cl0 len", tl[0], 3)
    ts2 = []
    tl2 = []
    sh_check_i(acc, "th thai n", th_clusters("ไทย", ts2, tl2), 2)
    ts3 = []
    tl3 = []
    sh_check_i(acc, "th to n", th_clusters("โต", ts3, tl3), 1)
    sh_check_i(acc, "th to len", tl3[0], 6)
    sh_check_i(acc, "in cons na", in_is_consonant("न"), 1)
    sh_check_i(acc, "in cons ha", in_is_consonant("ह"), 1)
    sh_check_i(acc, "in virama", in_is_virama("्"), 1)
    sh_check_i(acc, "in matra aa", in_is_matra("ा"), 1)
    sh_check_i(acc, "in prebase i", in_is_prebase_matra("ि"), 1)
    sh_check_i(acc, "in matra e no", in_is_prebase_matra("े"), 0)
    sh_check_i(acc, "in anusvara", in_is_anusvara("ं"), 1)
    ins = []
    inl = []
    inf = []
    sh_check_i(acc, "in clusters n", in_clusters("नमस्ते", ins, inl, inf), 3)
    sh_check_i(acc, "in cl2 flag base", inf[2], 0)
    ins2 = []
    inl2 = []
    inf2 = []
    sh_check_i(acc, "in hindi n", in_clusters("हिंदी", ins2, inl2, inf2), 2)
    sh_check_i(acc, "in hindi prebase", inf2[0], 2)
    ins3 = []
    inl3 = []
    inf3 = []
    sh_check_i(acc, "in reph n", in_clusters("र्क", ins3, inl3, inf3), 1)
    sh_check_i(acc, "in reph flag", inf3[0], 1)
    gs = []
    gl = []
    sh_check_i(acc, "clusters latin", shape_clusters("AB", gs, gl), 2)
    gs2 = []
    gl2 = []
    sh_check_i(acc, "clusters arabic", shape_clusters("مرحبا", gs2, gl2), 2)
    # Bengali (research doc: বাংলা)
    sh_check_i(acc, "script bengali", shape_script_of("ব"), 8)
    sh_check_i(acc, "bn cons ba", bn_is_consonant("ব"), 1)
    sh_check_i(acc, "bn cons la", bn_is_consonant("ল"), 1)
    sh_check_i(acc, "bn virama", bn_is_virama("্"), 1)
    sh_check_i(acc, "bn matra aa", bn_is_matra("া"), 1)
    sh_check_i(acc, "bn prebase i", bn_is_prebase_matra("ি"), 1)
    sh_check_i(acc, "bn anusvara", bn_is_anusvara("ং"), 1)
    bns = []
