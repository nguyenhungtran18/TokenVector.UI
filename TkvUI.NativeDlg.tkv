# =========================================================
# BROWSER RENDER - file dialog don gian
# =========================================================
def dlg_render_browser(buf: "list[i64]", surf: "PixelSurface", mode: "i32", d: "DlgFile", names: "list[str]", isdir: "list[i32]", patterns: "list[str]", filternames: "list[str]", x: "f64", y: "f64", w: "f64", h: "f64") -> "i32":
    pal = os_palette_for_mode(mode)
    r = Rect2D(x, y, w, h)
    fill_round_rect(buf, surf, r, 2.0, os_role_color(pal, 0))
    stroke_round_rect(buf, surf, r, 2.0, 1.0, os_separator_color(pal))
    draw_string(buf, surf, d.path, x + 6.0, y + 6.0, 1.0, os_role_color(pal, 1))
    top = y + 22.0
    rowh = 20.0
    view_h = h - 48.0
    first = os_list_first_visible(d.scroll, rowh)
    vis = os_list_visible_count(view_h, rowh)
    shown = int(0)
    k = int(0)
    while k < vis:
        nth = first + k
        real = d.visible_at(names, isdir, patterns, nth)
        if real >= 0:
            ry = top + float(shown) * rowh - d.scroll
            if ry + rowh > top:
                if ry < top + view_h:
                    sel = 0
                    if real == d.selected:
                        sel = 1
                    rr = Rect2D(x + 2.0, ry, w - 4.0, rowh)
                    fill_round_rect(buf, surf, rr, 0.0, os_row_bg(pal, shown, sel))
                    label = names[real]
                    if real < len(isdir):
                        if isdir[real] == 1:
                            label = "[" + names[real] + "]"
                    draw_string(buf, surf, label, x + 8.0, ry + 6.0, 1.0, os_row_fg(pal, sel))
                    shown = shown + 1
        k = k + 1
    fn = "Filter: all"
    if d.filter_idx < len(filternames):
        if d.filter_idx >= 0:
            fn = "Filter: " + filternames[d.filter_idx]
    draw_string(buf, surf, fn, x + 6.0, y + h - 18.0, 1.0, os_disabled_text(pal))
    return shown

# =========================================================
# SELFTEST (pure logic; native stubs chi assert tra 0)
# =========================================================
def dlgcheck(acc: "list[i32]", name: "str", ok: "i32") -> "i32":
    acc[1] = acc[1] + 1
    if ok == 1:
        acc[0] = acc[0] + 1
        print("  PASS " + name)
        return 1
    print("  FAIL " + name)
    return 0

def dlgcheck_i(acc: "list[i32]", name: "str", got: "i32", want: "i32") -> "i32":
    acc[1] = acc[1] + 1
    if got == want:
        acc[0] = acc[0] + 1
        print("  PASS " + name + " = " + str(got))
        return 1
    print("  FAIL " + name + " got=" + str(got) + " want=" + str(want))
    return 0

def dlgcheck_s(acc: "list[i32]", name: "str", got: "str", want: "str") -> "i32":
    acc[1] = acc[1] + 1
    if got == want:
        acc[0] = acc[0] + 1
        print("  PASS " + name + " = " + got)
        return 1
    print("  FAIL " + name + " got=" + got + " want=" + want)
    return 0

def dlg_seed_names() -> "list[str]":
    out = []
    out.append("docs")
    out.append("a.txt")
    out.append("b.png")
    out.append(".hidden")
    return out

def dlg_seed_dirs() -> "list[i32]":
    out = []
    out.append(1)
    out.append(0)
    out.append(0)
    out.append(0)
    return out

def nativedlg_selftest() -> "str":
    print("== TkvUI.NativeDlg selftest ==")
    acc = [int(0), int(0)]
    # filter
    fnames = []
    fpats = []
    dlgcheck_i(acc, "filter.n", dlg_parse_filter("Text (*.txt)|*.txt|All (*.*)|*.*", fnames, fpats), 2)
    dlgcheck_s(acc, "filter.name", fnames[0], "Text (*.txt)")
    dlgcheck_s(acc, "filter.pat", fpats[1], "*.*")
    dlgcheck_i(acc, "match.ext", dlg_match_star("*.txt", "a.txt"), 1)
    dlgcheck_i(acc, "match.no", dlg_match_star("*.txt", "b.png"), 0)
    dlgcheck_i(acc, "match.all", dlg_match_star("*.*", "x"), 1)
    dlgcheck_i(acc, "match.pre", dlg_match_star("ab*", "abc"), 1)
    dlgcheck_i(acc, "match.list", dlg_match_list(fpats, 0, "a.txt"), 1)
    dlgcheck_i(acc, "match.list.no", dlg_match_list(fpats, 0, "b.png"), 0)
    # path
    dlgcheck_s(acc, "parent", dlg_parent("C:/a/b"), "C:/a")
    dlgcheck_s(acc, "parent.root", dlg_parent("C:/"), "C:/")
    dlgcheck_s(acc, "join", dlg_join("C:/a", "b"), "C:/a/b")
    dlgcheck_s(acc, "base", dlg_basename("C:/a/b.txt"), "b.txt")
    dlgcheck_s(acc, "ext", dlg_ext("b.txt"), ".txt")
    dlgcheck_s(acc, "ext.none", dlg_ext("README"), "")
    # browser nav
    d = dlg_make_open("C:/w")
    names = dlg_seed_names()
    dirs = dlg_seed_dirs()
    pats0 = []
    dlgcheck_i(acc, "vis.all", d.visible_count(names, dirs, pats0), 3)
    d.set_filter(0, 2)
    dlgcheck_i(acc, "vis.filtered", d.visible_count(names, dirs, fpats), 2)
    dlgcheck_i(acc, "vis.at0", d.visible_at(names, dirs, fpats, 0), 0)
    dlgcheck_i(acc, "vis.at1", d.visible_at(names, dirs, fpats, 1), 1)
    d.select(1, 4)
    dlgcheck_s(acc, "accept.file", d.accept(names, dirs), "C:/w/a.txt")
    d.enter(names, dirs, 0)
    dlgcheck_s(acc, "enter.dir", d.path, "C:/w/docs")
    d.move_up()
    dlgcheck_s(acc, "up", d.path, "C:/w")
    # save mode
    s = dlg_make_save("C:/w")
    s.set_filename("out.txt")
    dlgcheck_s(acc, "save.accept", s.accept(names, dirs), "C:/w/out.txt")
    s2 = dlg_make_save("C:/w")
    dlgcheck_s(acc, "save.empty", s2.accept(names, dirs), "")
    # color
    c = dlg_make_color(255, 128, 0)
    dlgcheck_s(acc, "color.hex", c.to_hex(), "#ff8000")
    c.from_hex("#00ff00")
    dlgcheck_i(acc, "color.g", c.g, 255)
    dlgcheck_i(acc, "color.bad", c.from_hex("xyz"), 0)
    customs = []
    dlg_custom_add(customs, dlg_pack(1, 2, 3))
    dlgcheck_i(acc, "custom.r", dlg_unpack_r(dlg_custom_get(customs, 0)), 1)
    dlgcheck_i(acc, "custom.b", dlg_unpack_b(dlg_custom_get(customs, 0)), 3)
    dlgcheck_i(acc, "custom.miss", dlg_custom_get(customs, 5), -1)
    # font
    f = dlg_make_font("Consolas", 12.0)
    f.toggle_bold()
    dlgcheck_s(acc, "font.desc", f.describe(), "Consolas, 12pt, Bold")
    f.set_size(200.0)
    dlgcheck_i(acc, "font.clamp", int(f.size), 144)
    # native stubs (SIM: expect 0)
    dlgcheck_i(acc, "stub.open", dlg_native_open(d), 0)
    dlgcheck_i(acc, "stub.save", dlg_native_save(s), 0)
    dlgcheck_i(acc, "stub.dir", dlg_native_dir(d), 0)
    dlgcheck_i(acc, "stub.color", dlg_native_color(c), 0)
    dlgcheck_i(acc, "stub.font", dlg_native_font(f), 0)
    dlgcheck_i(acc, "stub.present", dlg_native_present(), 0)
    # render smoke
    surf = PixelSurface(300, 200, 300)
    buf = dlg_alloc(300 * 200)
    black = ColorRgba(0, 0, 0, 255)
    surface_clear(buf, surf, black)
    shown = dlg_render_browser(buf, surf, 0, d, names, dirs, fpats, fnames, 0.0, 0.0, 300.0, 200.0)
    dlgcheck(acc, "render.shown", shown - 1)
    print("nativedlg: " + str(acc[0]) + "/" + str(acc[1]))
    if acc[0] == acc[1]:
        return "NATIVEDLG_OK"
    return "NATIVEDLG_FAIL"

def dlg_alloc(n: "i32") -> "list[i64]":
    buf = []
    i = int(0)
    while i < n:
        buf.append(0)
        i = i + 1
    return buf

