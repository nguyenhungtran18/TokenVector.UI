# -*- coding: utf-8 -*-
"""TkvUI.H264 - OpenH264 decode qua C# shim (R2 buffers + R3 full-identity).

Phu thuoc: TkvUI.Core, TkvUI.Platform (tkv_has_file).
Thiet ke:
- Shim C# (tools/h264/OpenH264Shim.cs) giu toan bo struct marshal
  (SDecodingParam/SBufferInfo); .tkv chi goi static methods kieu co ban
  (i32/i64) + R2 buffers — dung hoc ma da chot trong docs/OPENH264.md.
- Stream bake: 230 byte Annex B = SPS/PPS + IDR + 2 P-frame 64x64
  (sinh boi tools/h264/RoundTrip.cs, prefix cua enc_out.264).
- Feed tung NAL (start code 00 00 00 01) — dung mau da proof boi ShimTest.
- Thieu shim/native dll -> return chua ca H264_OK lan H264_SKIPPED
  (verify.sh dem SKIP, khong FAIL).

Build chay tay (canh OpenH264Shim.dll ben canh exe):
  csc /target:library /out:build/OpenH264Shim.dll tools/h264/OpenH264Shim.cs
  tkvc build TkvUI.H264.tkv --entry h264_selftest --out build/h264_test.exe
"""
__tkv_import__ = ["TkvUI.Core", "TkvUI.Platform"]

__tkv_extern_method__ = [
    {"name": "h264_create", "assembly": "OpenH264Shim, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null", "class": "OpenH264Shim", "method": "Create", "params": [], "returns": "i32"},
    {"name": "h264_init_dec", "assembly": "OpenH264Shim, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null", "class": "OpenH264Shim", "method": "Init", "params": ["i32"], "returns": "i32"},
    {"name": "h264_decode", "assembly": "OpenH264Shim, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null", "class": "OpenH264Shim", "method": "Decode", "params": ["i32", "i64", "i32"], "returns": "i32"},
    {"name": "h264_flush", "assembly": "OpenH264Shim, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null", "class": "OpenH264Shim", "method": "Flush", "params": ["i32"], "returns": "i32"},
    {"name": "h264_has_frame", "assembly": "OpenH264Shim, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null", "class": "OpenH264Shim", "method": "HasFrame", "params": ["i32"], "returns": "i32"},
    {"name": "h264_frame_w", "assembly": "OpenH264Shim, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null", "class": "OpenH264Shim", "method": "FrameW", "params": ["i32"], "returns": "i32"},
    {"name": "h264_frame_h", "assembly": "OpenH264Shim, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null", "class": "OpenH264Shim", "method": "FrameH", "params": ["i32"], "returns": "i32"},
    {"name": "h264_copy_rgb", "assembly": "OpenH264Shim, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null", "class": "OpenH264Shim", "method": "CopyFrameRgb", "params": ["i32", "i64"], "returns": "i32"},
    {"name": "h264_destroy", "assembly": "OpenH264Shim, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null", "class": "OpenH264Shim", "method": "Destroy", "params": ["i32"], "returns": "void"}
]

# Annex B 230B: SPS PPS | SPS PPS IDR | P | P — 64x64 gray tang dan (Y=30,45,60).
H264_HEX = ""

def h264check(acc: "list[i32]", name: "str", ok: "i32") -> "i32":
    acc[1] = acc[1] + 1
    if ok == 1:
        acc[0] = acc[0] + 1
        print("  PASS " + name)
        return 1
    print("  FAIL " + name)
    return 0

def h264check_i(acc: "list[i32]", name: "str", got: "i32", want: "i32") -> "i32":
    if got == want:
        return h264check(acc, name + " = " + str(got), 1)
    print("  FAIL " + name + " got=" + str(got) + " want=" + str(want))
    acc[1] = acc[1] + 1
    return 0

def h264_hex_val(c: "str") -> "i32":
    o = ord(c)
    if o >= 48 and o <= 57:
        return o - 48
    if o >= 97 and o <= 102:
        return o - 87
    if o >= 65 and o <= 70:
        return o - 55
    return 0

def h264_dlls_present() -> "i32":
    shim = 0
    if tkv_has_file("build\\OpenH264Shim.dll") == 1:
        shim = 1
    if tkv_has_file("OpenH264Shim.dll") == 1:
        shim = 1
    if shim == 0:
        return 0
    if tkv_has_file("build\\openh264-win64.dll") == 1:
        return 1
    if tkv_has_file("openh264-win64.dll") == 1:
        return 1
    return 0

def h264_capture(dec: "i32", fw: "list[i32]", fh: "list[i32]", rgb_bytes: "list[i32]", rgb_sum: "list[i64]") -> "i32":
    # Chi capture lan dau tien frame ra (fw[0]==0).
    if fw[0] != 0:
        return 0
    fw[0] = h264_frame_w(dec)
    fh[0] = h264_frame_h(dec)
    rgb = alloc_bytes(fw[0] * fh[0] * 3)
    rgb_bytes[0] = h264_copy_rgb(dec, rgb)
    s = int64(0)
    k = int(0)
    while k < rgb_bytes[0]:
        s = s + read_u8(rgb, k)
        k = k + 16
    rgb_sum[0] = s
    free_bytes(rgb)
    return 1

def h264_decode_test(acc: "list[i32]") -> "i32":
    # Giai hex -> R2 buffer, feed tung NAL, dem frame + check dims/rgb.
    n = len(H264_HEX) // 2
    h264check(acc, "stream.bytes > 0", n > 0)
    buf = alloc_bytes(n)
    i = int(0)
    while i < n:
        hi = h264_hex_val(H264_HEX[i * 2:i * 2 + 1])
        lo = h264_hex_val(H264_HEX[i * 2 + 1:i * 2 + 2])
        write_u8(buf, i, hi * 16 + lo)
        i = i + 1
    dec = h264_create()
    h264check(acc, "create.id > 0", dec > 0)
    irc = h264_init_dec(dec)
    h264check_i(acc, "init.rc", irc, 0)
    frames = int(0)
    fwl = [int(0)]
    fhl = [int(0)]
    rb = [int(0)]
    rs = [int64(0)]
    start = int(0)
    idx = int(4)
    while idx + 3 < n:
        if read_u8(buf, idx) == 0 and read_u8(buf, idx + 1) == 0 and read_u8(buf, idx + 2) == 0 and read_u8(buf, idx + 3) == 1:
            h264_decode(dec, buf + start, idx - start)
            if h264_has_frame(dec) == 1:
                frames = frames + 1
                h264_capture(dec, fwl, fhl, rb, rs)
            start = idx
            idx = idx + 4
        else:
            idx = idx + 1
    h264_decode(dec, buf + start, n - start)
    if h264_has_frame(dec) == 1:
        frames = frames + 1
        h264_capture(dec, fwl, fhl, rb, rs)
    h264_flush(dec)
    if h264_has_frame(dec) == 1:
        frames = frames + 1
        h264_capture(dec, fwl, fhl, rb, rs)
    h264check(acc, "frames >= 1", frames >= 1)
    h264check_i(acc, "frame.w", fwl[0], 64)
    h264check_i(acc, "frame.h", fhl[0], 64)
    h264check(acc, "rgb.bytes = 12288", rb[0] == 12288)
    h264check(acc, "rgb.sum > 0", rs[0] > 0)
    h264_destroy(dec)
    free_bytes(buf)
    return 1

def h264_selftest() -> "str":
    print("== TkvUI.H264 selftest (OpenH264 shim) ==")
    if h264_dlls_present() == 0:
        print("  (dll thieu: build theo docstring — dem SKIP)")
        return "H264_OK H264_SKIPPED"
    acc = [int(0), int(0)]
    h264_decode_test(acc)
    print("h264: " + str(acc[0]) + "/" + str(acc[1]))
    if acc[0] == acc[1]:
        return "H264_OK"
    return "H264_FAIL"
