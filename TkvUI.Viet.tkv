def vi_row_of(bits: "i64", row: "i32") -> "i32":
    # Giai 1 hang 5-bit tu so 35-bit. Dung // va % (cam bitwise).
    if row == 0:
        return int(bits % 32)
    if row == 1:
        return int((bits // 32) % 32)
    if row == 2:
        return int((bits // 1024) % 32)
    if row == 3:
        return int((bits // 32768) % 32)
    if row == 4:
        return int((bits // 1048576) % 32)
    if row == 5:
        return int((bits // 33554432) % 32)
    return int((bits // 1073741824) % 32)

def vi_is_ascii(u: "str") -> "i32":
    # 1 don vi nam trong " ".."~" ? (thay char_code de tranh phu thuoc Text)
    if u < " ":
        return 0
    if u > "~":
        return 0
    return 1

def vi_seq_len_at(text: "str", p: "i32", n: "i32") -> "i32":
    # Do dai sequence bat dau tai p: 1 (ASCII), 2/3 (Viet), 1 (la: tien 1).
    u = text[p]
    if vi_is_ascii(u) == 1:
        return 1
    if p + 1 < n:
        p2 = u + text[p + 1]
        if vi_bits(p2) >= 0:
            return 2
    if p + 2 < n:
        p3 = u + text[p + 1] + text[p + 2]
        if vi_bits(p3) >= 0:
            return 3
    return 1

def vi_strlen(s: "str") -> "i32":
    # Dem so ky tu (sequence), khong phai so don vi byte.
    n = len(s)
    idx = 0
    cols = 0
    while idx < n:
        cols = cols + 1
        idx = idx + vi_seq_len_at(s, idx, n)
    return cols

def vi_truncate(s: "str", maxcols: "i32") -> "str":
    # Cat chuoi theo so cot, khong che doi sequence (thay s[0:k] don vi).
    if maxcols <= 0:
        return ""
    out = ""
    n = len(s)
    idx = 0
    cols = 0
    while idx < n:
        if cols >= maxcols:
            break
        adv2 = vi_seq_len_at(s, idx, n)
        out = out + s[idx:idx + adv2]
        cols = cols + 1
        idx = idx + adv2
    return out

def vi_draw_bits(buf: "list[i64]", surf: "PixelSurface", bits: "i64", cx: "i32", cy: "i32", sc: "i32", color: "ColorRgba") -> "i32":
    # Ve 1 glyph tu so 35-bit (giong vong decode cua draw_string).
    row = int(0)
    while row < 7:
        mask = vi_row_of(bits, row)
        col = int(0)
        while col < 5:
            p = 16
            if col == 1:
                p = 8
            if col == 2:
                p = 4
            if col == 3:
                p = 2
            if col == 4:
                p = 1
            on = 0
            if mask >= p:
                tmp = mask
                if tmp >= 16:
                    if p == 16:
                        on = 1
                    tmp = tmp - 16
                if tmp >= 8:
                    if p == 8:
                        on = 1
                    tmp = tmp - 8
                if tmp >= 4:
                    if p == 4:
                        on = 1
                    tmp = tmp - 4
                if tmp >= 2:
                    if p == 2:
                        on = 1
                    tmp = tmp - 2
                if tmp >= 1:
                    if p == 1:
                        on = 1
                    tmp = tmp - 1
                if on == 1:
                    sy = int(0)
                    while sy < sc:
                        sx = int(0)
                        while sx < sc:
                            surface_blend_pixel(buf, surf, cx + col * sc + sx, cy + row * sc + sy, color)
                            sx = sx + 1
                        sy = sy + 1
            col = col + 1
        row = row + 1
    return 1

def utf8_seq_len(text: "str", p: "i32") -> "i32":
    # Do dai sequence UTF-8 bat dau tai p (byte->codepoint buoc 1: tach).
    # Chi dung so sanh 1-don-vi (1v1) + == vi so sanh nhieu-don-vi co F0
    # bi sai (bang chung probe: "F0F0" >= "F09F.." = 0). Pivot F0/E0 lay
    # bang ref[0] (index tren bien). ASCII -> 1; F0.. -> 4; E0..EF -> 3;
    # con lai (C2..DF + byte le) -> 2. Khong bao gio tra 0.
    u = text[p]
    if vi_is_ascii(u) == 1:
        return 1
    ref4 = "🌍"
    f0 = ref4[0]
    ref3 = "ก"
    e0 = ref3[0]
    if u == f0:
        return 4
    if u >= f0:
        return 4
    if u >= e0:
        return 3
    return 2
