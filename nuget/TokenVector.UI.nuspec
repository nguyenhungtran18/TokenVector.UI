<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>TokenVector.UI</id>
    <version>2.3.1</version>
    <title>TokenVector.UI (TkvUI)</title>
    <authors>Nguyen Hung Tran</authors>
    <owners>nguyenhungtran18</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/nguyenhungtran18/TokenVector</projectUrl>
    <readme>README.md</readme>
    <description>TokenVector.UI (TkvUI) - Thu vien UI da nen tang 100% TokenVector (.tkv), zero dependency: software rasterizer, bitmap font + TTF parser (verified), effects (Kawase blur/glass), flex/grid layout, 28 widget + 10 media-player widget + Spring animation, cua so native Win32 (UpdateLayeredWindow), WinForms interop. Danh cho tkvc.exe (TokenVector compiler).</description>
    <summary>UI library for the TokenVector compiler: rasterizer, layout, widgets, media-player UI, native windowing. Import umbrella "TokenVector.UI" from any .tkv app.</summary>
    <releaseNotes>2.3.1: module media-player TkvUI.Media (10 widget, 80 check), TTF parser/rasterizer verified (110 check text, sua 4 bug), WinForms interop that window/app-level (34 check platform), Ant-inspired widgets (95 check widgets), bilinear half-res upsample. Suite: 444 check PASS.</releaseNotes>
    <copyright>Copyright (c) 2026 Nguyen Hung Tran</copyright>
    <tags>tokenvector tkv ui widgets rasterizer flex grid layout win32 cross-platform media-player ttf winforms</tags>
    <repository type="git" url="https://github.com/nguyenhungtran18/TokenVector" />
  </metadata>
  <files>
    <file src="README.md" target="README.md" />
    <file src="LICENSE" target="LICENSE" />
    <file src="CHANGELOG.md" target="CHANGELOG.md" />
    <file src="tkvui.pkg.json" target="tkvui.pkg.json" />
    <!-- Source thu vien: import bang tkvc -->
    <file src="TokenVector.UI.tkv" target="tkv\TokenVector.UI.tkv" />
    <file src="TkvUI.Core.tkv" target="tkv\TkvUI.Core.tkv" />
    <file src="TkvUI.Graphics.tkv" target="tkv\TkvUI.Graphics.tkv" />
    <file src="TkvUI.Text.tkv" target="tkv\TkvUI.Text.tkv" />
    <file src="TkvUI.Effects.tkv" target="tkv\TkvUI.Effects.tkv" />
    <file src="TkvUI.Platform.tkv" target="tkv\TkvUI.Platform.tkv" />
    <file src="TkvUI.Events.tkv" target="tkv\TkvUI.Events.tkv" />
    <file src="TkvUI.Input.tkv" target="tkv\TkvUI.Input.tkv" />
    <file src="TkvUI.Layout.tkv" target="tkv\TkvUI.Layout.tkv" />
    <file src="TkvUI.Widgets.tkv" target="tkv\TkvUI.Widgets.tkv" />
    <file src="TkvUI.Media.tkv" target="tkv\TkvUI.Media.tkv" />
    <file src="TkvUI.Font.tkv" target="tkv\TkvUI.Font.tkv" />
    <!-- Tools + docs + examples -->
    <file src="build\nupkgstage\TokenVector.UI.dll" target="runtimes\any\native\TokenVector.UI.dll" />
    <file src="tools\verify.sh" target="tools\verify.sh" />
    <file src="tools\package.sh" target="tools\package.sh" />
    <file src="docs\TkvUI.Roadmap.md" target="docs\TkvUI.Roadmap.md" />
    <file src="docs\INTEGRATION.md" target="docs\INTEGRATION.md" />
    <file src="examples\*.tkv" target="examples\" />
  </files>
</package>
