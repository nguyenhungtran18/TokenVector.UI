# -*- coding: utf-8 -*-
"""TkvUI.Widgets.Native - 16 widget OS native-look (Phase 1).

Phu thuoc: Core, Graphics, Text, Layout, Theme. DAG: Native <- Theme.
Style: goc vuong nho (radius ~2-3px), palette OS Light/Dark/HighContrast,
border 1px, zebra-row, focus rect — giong Win32/QStyle.

Quy uoc:
- Record chi field phang (f64/i32/i64/str); KHONG list trong record.
- Du lieu bien doi (items, cells, depths, open-flags) do CALLER giu trong
  list va truyen vao render/hit (giong TabsWidget.render(labels, n)).
- Trong METHOD chi dung literal so (hang module vo hinh) — state ghi so
  truc tiep kem comment: 0=normal 1=hover 2=pressed 3=disabled 4=checked 5=focus.
- Nhan ASCII trong print.

Tien to Native*/native_*/make_native_* — khong trung khi merge.
"""
__tkv_import__ = ["TkvUI.Core", "TkvUI.Graphics", "TkvUI.Text", "TkvUI.Layout", "TkvUI.Theme", "TkvUI.Platform"]
__tkv_extern_pinvoke__ = [{"name": "tray_notify", "dll": "shell32.dll", "symbol": "Shell_NotifyIconA", "convention": "stdcall", "params": ["i32", "i64"], "returns": "i32"}, {"name": "tray_load_icon", "dll": "user32.dll", "symbol": "LoadIconA", "convention": "stdcall", "params": ["i64", "i64"], "returns": "i64"}, {"name": "tray_wsprintf_s", "dll": "user32.dll", "symbol": "wsprintfA", "convention": "cdecl", "params": ["i64", "str", "str"], "returns": "i32"}]

# Chieu cao mac dinh (tai lieu; than method dung literal so)
NATIVE_BTN_H = 24.0
NATIVE_EDIT_H = 22.0
NATIVE_HEADER_H = 24.0
NATIVE_ROW_H = 22.0

# =========================================================
# 1) NativeButton - push / checkable / default
# =========================================================
class NativeButton:
    bx: "f64"
    by: "f64"
    bw: "f64"
    bh: "f64"
    label: "str"
    state: "i32"
    checked: "i32"
    checkable: "i32"
    is_default: "i32"
    enabled: "i32"
    def __init__(self, bx, by, bw, bh, label, state, checked, checkable, is_default, enabled):
        self.bx = bx
        self.by = by
        self.bw = bw
        self.bh = bh
        self.label = label
        self.state = state
        self.checked = checked
        self.checkable = checkable
        self.is_default = is_default
        self.enabled = enabled
    def set_hover(self, h: "i32") -> "i32":
        if self.enabled == 0:
            self.state = 3
            return 0
        if h == 1:
            self.state = 1
        else:
            self.state = 0
        return self.state
    def set_pressed(self, p: "i32") -> "i32":
        if self.enabled == 0:
            self.state = 3
            return 0
        if p == 1:
            self.state = 2
        else:
            self.state = 0
        return self.state
    def click(self) -> "i32":
        if self.enabled == 0:
            return 0
        if self.checkable == 1:
            if self.checked == 1:
                self.checked = 0
            else:
                self.checked = 1
        self.state = 0
        return 1
    def contains(self, px: "f64", py: "f64") -> "i32":
        if px < self.bx:
            return 0
        if py < self.by:
            return 0
        if px >= self.bx + self.bw:
            return 0
        if py >= self.by + self.bh:
            return 0
        return 1
    def render(self, buf: "list[i64]", surf: "PixelSurface", mode: "i32") -> "i32":
        pal = os_palette_for_mode(mode)
        st = self.state
        if self.enabled == 0:
            st = 3
        if self.checkable == 1:
            if self.checked == 1:
                st = 4
        bg = os_button_bg(pal, st, self.is_default)
        fg = os_button_fg(pal, st, self.is_default)
        r = Rect2D(self.bx, self.by, self.bw, self.bh)
        rad = 3.0
        fill_round_rect(buf, surf, r, rad, bg)
        stroke_round_rect(buf, surf, r, rad, 1.0, os_separator_color(pal))
        tm = measure_string(self.label, 1.0)
        tx = self.bx + (self.bw - tm.w) / 2.0
        ty = self.by + (self.bh - tm.h) / 2.0
        draw_string(buf, surf, self.label, tx, ty, 1.0, fg)
        if self.is_default == 1:
            inner = Rect2D(self.bx + 1.0, self.by + 1.0, self.bw - 2.0, self.bh - 2.0)
            stroke_round_rect(buf, surf, inner, 2.0, 1.0, os_focus_color(pal))
        return 1

def make_native_button(x: "f64", y: "f64", w: "f64", h: "f64", label: "str") -> "NativeButton":
    return NativeButton(x, y, w, h, label, 0, 0, 0, 0, 1)

def make_native_button_default(x: "f64", y: "f64", w: "f64", h: "f64", label: "str") -> "NativeButton":
    return NativeButton(x, y, w, h, label, 0, 0, 0, 1, 1)

def make_native_check(x: "f64", y: "f64", w: "f64", h: "f64", label: "str") -> "NativeButton":
    return NativeButton(x, y, w, h, label, 0, 0, 1, 0, 1)

# =========================================================
# 2) NativeLineEdit - text/password/search/readonly
# =========================================================
class NativeLineEdit:
    bx: "f64"
    by: "f64"
    bw: "f64"
    bh: "f64"
    text: "str"
    placeholder: "str"
    state: "i32"
    caret: "i32"
    password: "i32"
    readonly: "i32"
    enabled: "i32"
    maxlen: "i32"
    def __init__(self, bx, by, bw, bh, text, placeholder, state, caret, password, readonly, enabled, maxlen):
        self.bx = bx
        self.by = by
        self.bw = bw
        self.bh = bh
        self.text = text
        self.placeholder = placeholder
        self.state = state
        self.caret = caret
        self.password = password
        self.readonly = readonly
        self.enabled = enabled
        self.maxlen = maxlen
    def focus(self, f: "i32") -> "i32":
        if self.enabled == 0:
            self.state = 3
            return 0
        if f == 1:
            self.state = 5
        else:
            self.state = 0
        return self.state
    def type_char(self, ch: "str") -> "str":
        if self.enabled == 0:
            return self.text
        if self.readonly == 1:
            return self.text
        if self.maxlen > 0:
            if len(self.text) >= self.maxlen:
                return self.text
        self.text = self.text + ch
        self.caret = len(self.text)
        return self.text
    def backspace(self) -> "str":
        if self.enabled == 0:
            return self.text
        if self.readonly == 1:
            return self.text
        n = len(self.text)
        if n > 0:
            self.text = self.text[0:n - 1]
            self.caret = n - 1
        return self.text
    def clear(self) -> "i32":
        if self.readonly == 1:
            return 0
        self.text = ""
        self.caret = 0
        return 1
    def display_text(self) -> "str":
        if self.password == 1:
            out = ""
            i = int(0)
            n = len(self.text)
            while i < n:
                out = out + "*"
                i = i + 1
            return out
        return self.text
    def contains(self, px: "f64", py: "f64") -> "i32":
        if px < self.bx:
            return 0
        if py < self.by:
            return 0
        if px >= self.bx + self.bw:
            return 0
        if py >= self.by + self.bh:
            return 0
        return 1
    def render(self, buf: "list[i64]", surf: "PixelSurface", mode: "i32") -> "i32":
        pal = os_palette_for_mode(mode)
        st = self.state
        if self.enabled == 0:
            st = 3
        bg = os_edit_bg(pal, st)
        bd = os_edit_border(pal, st)
        r = Rect2D(self.bx, self.by, self.bw, self.bh)
        fill_round_rect(buf, surf, r, 2.0, bg)
        stroke_round_rect(buf, surf, r, 2.0, 1.0, bd)
        shown = self.display_text()
        ty = self.by + (self.bh - 7.0) / 2.0
        if len(shown) > 0:
            draw_string(buf, surf, shown, self.bx + 5.0, ty, 1.0, os_role_color(pal, 6))
        else:
            draw_string(buf, surf, self.placeholder, self.bx + 5.0, ty, 1.0, os_disabled_text(pal))
        if st == 5:
            cx = self.bx + 5.0 + float(len(shown) * 6)
            if cx > self.bx + self.bw - 8.0:
                cx = self.bx + self.bw - 8.0
            draw_line(buf, surf, cx, self.by + 4.0, cx, self.by + self.bh - 4.0, 1.0, os_role_color(pal, 6))
        return 1

def make_native_lineedit(x: "f64", y: "f64", w: "f64", placeholder: "str") -> "NativeLineEdit":
    return NativeLineEdit(x, y, w, 22.0, "", placeholder, 0, 0, 0, 0, 1, 0)

def make_native_password(x: "f64", y: "f64", w: "f64") -> "NativeLineEdit":
    return NativeLineEdit(x, y, w, 22.0, "", "", 0, 0, 1, 0, 1, 0)

# =========================================================
# 3) NativeComboBox - popup list, editable state
# =========================================================
class NativeComboBox:
    bx: "f64"
    by: "f64"
    bw: "f64"
    bh: "f64"
    selected: "i32"
    open: "i32"
    hover_idx: "i32"
    state: "i32"
    enabled: "i32"
    editable: "i32"
    def __init__(self, bx, by, bw, bh, selected, open, hover_idx, state, enabled, editable):
        self.bx = bx
        self.by = by
        self.bw = bw
        self.bh = bh
        self.selected = selected
        self.open = open
        self.hover_idx = hover_idx
        self.state = state
        self.enabled = enabled
        self.editable = editable
    def toggle_open(self) -> "i32":
        if self.enabled == 0:
            return 0
        if self.open == 1:
            self.open = 0
        else:
            self.open = 1
        return self.open
    def choose(self, idx: "i32", count: "i32") -> "i32":
        if idx < 0:
            return self.selected
        if idx >= count:
            return self.selected
        self.selected = idx
        self.open = 0
        return idx
    def popup_h(self, count: "i32") -> "f64":
        h = float(count) * 20.0
        if h > 120.0:
            h = 120.0
        return h
    def hit_item(self, py: "f64", count: "i32") -> "i32":
        top = self.by + self.bh
        idx = int((py - top) / 20.0)
        if idx < 0:
            return -1
        if idx >= count:
            return -1
        return idx
    def contains(self, px: "f64", py: "f64") -> "i32":
        if px < self.bx:
            return 0
        if py < self.by:
            return 0
        if px >= self.bx + self.bw:
            return 0
        if py >= self.by + self.bh:
            return 0
        return 1
    def render(self, buf: "list[i64]", surf: "PixelSurface", mode: "i32", labels: "list[str]", n: "i32") -> "i32":
        pal = os_palette_for_mode(mode)
        st = self.state
        if self.enabled == 0:
            st = 3
        bg = os_edit_bg(pal, st)
        bd = os_edit_border(pal, st)
        r = Rect2D(self.bx, self.by, self.bw, self.bh)
        fill_round_rect(buf, surf, r, 2.0, bg)
        stroke_round_rect(buf, surf, r, 2.0, 1.0, bd)
        cur = ""
        if self.selected >= 0:
            if self.selected < n:
                if self.selected < len(labels):
                    cur = labels[self.selected]
        ty = self.by + (self.bh - 7.0) / 2.0
        draw_string(buf, surf, cur, self.bx + 5.0, ty, 1.0, os_role_color(pal, 6))
        ax = self.bx + self.bw - 12.0
        ay = self.by + self.bh / 2.0
        draw_line(buf, surf, ax - 4.0, ay - 2.0, ax, ay + 2.0, 1.5, os_role_color(pal, 1))
        draw_line(buf, surf, ax, ay + 2.0, ax + 4.0, ay - 2.0, 1.5, os_role_color(pal, 1))
        if self.open == 1:
            ph = self.popup_h(n)
            pr = Rect2D(self.bx, self.by + self.bh, self.bw, ph)
            fill_round_rect(buf, surf, pr, 2.0, os_role_color(pal, 2))
            stroke_round_rect(buf, surf, pr, 2.0, 1.0, bd)
            i = int(0)
            while i < n:
                iy = self.by + self.bh + float(i) * 20.0
                if i == self.hover_idx:
                    hr = Rect2D(self.bx + 1.0, iy, self.bw - 2.0, 20.0)
                    fill_round_rect(buf, surf, hr, 0.0, os_role_color(pal, 11))
                    if i < len(labels):
                        draw_string(buf, surf, labels[i], self.bx + 5.0, iy + 6.0, 1.0, os_role_color(pal, 12))
                else:
                    if i < len(labels):
                        draw_string(buf, surf, labels[i], self.bx + 5.0, iy + 6.0, 1.0, os_role_color(pal, 6))
                i = i + 1
        return 1

def make_native_combo(x: "f64", y: "f64", w: "f64") -> "NativeComboBox":
    return NativeComboBox(x, y, w, 22.0, 0, 0, -1, 0, 1, 0)

def treecombo_path(labels: "list[str]", depths: "list[i32]", idx: "i32") -> "str":
    # Duong dan "a/b/c" tu root toi idx (outline theo depths).
    if idx < 0 or idx >= len(labels):
        return ""
    if idx >= len(depths):
        return labels[idx]
    out = labels[idx]
    d = depths[idx]
    j = idx - 1
    while j >= 0:
        if j >= len(depths):
            break
        if j >= len(labels):
            break
        if depths[j] < d:
            out = labels[j] + "/" + out
            d = depths[j]
            if d <= 0:
                break
        j = j - 1
    return out

class NativeTreeCombo:
    bx: "f64"
    by: "f64"
    bw: "f64"
    bh: "f64"
    selected: "i32"
    open: "i32"
    hover_idx: "i32"
    state: "i32"
    enabled: "i32"
    def __init__(self, bx, by, bw, bh, selected, open, hover_idx, state, enabled):
        self.bx = bx
        self.by = by
        self.bw = bw
        self.bh = bh
        self.selected = selected
        self.open = open
        self.hover_idx = hover_idx
        self.state = state
        self.enabled = enabled
    def toggle_open(self) -> "i32":
        if self.enabled == 0:
            return 0
        if self.open == 1:
            self.open = 0
        else:
            self.open = 1
        return self.open
    def choose(self, idx: "i32", count: "i32") -> "i32":
        if idx < 0:
            return self.selected
        if idx >= count:
            return self.selected
        self.selected = idx
        self.open = 0
        return idx
    def popup_h(self, count: "i32") -> "f64":
        h = float(count) * 20.0
        if h > 140.0:
            h = 140.0
        return h
    def hit_item(self, py: "f64", count: "i32") -> "i32":
        top = self.by + self.bh
        idx = int((py - top) / 20.0)
        if idx < 0:
            return -1
        if idx >= count:
            return -1
        return idx
    def contains(self, px: "f64", py: "f64") -> "i32":
        if px < self.bx:
            return 0
        if py < self.by:
            return 0
        if px >= self.bx + self.bw:
            return 0
        if py >= self.by + self.bh:
            return 0
        return 1
    def toggle_node(self, open_flags: "list[i32]", idx: "i32") -> "i32":
        if idx < 0:
            return 0
        if idx >= len(open_flags):
            return 0
        if open_flags[idx] == 1:
            open_flags[idx] = 0
        else:
            open_flags[idx] = 1
        return open_flags[idx]
    def render(self, buf: "list[i64]", surf: "PixelSurface", mode: "i32", labels: "list[str]", depths: "list[i32]", has_kids: "list[i32]", open_flags: "list[i32]", n: "i32") -> "i32":
        pal = os_palette_for_mode(mode)
        st = self.state
        if self.enabled == 0:
            st = 3
        bg = os_edit_bg(pal, st)
        bd = os_edit_border(pal, st)
        r = Rect2D(self.bx, self.by, self.bw, self.bh)
        fill_round_rect(buf, surf, r, 2.0, bg)
        stroke_round_rect(buf, surf, r, 2.0, 1.0, bd)
        cur = treecombo_path(labels, depths, self.selected)
        ty = self.by + (self.bh - 7.0) / 2.0
        draw_string(buf, surf, cur, self.bx + 5.0, ty, 1.0, os_role_color(pal, 6))
        ax = self.bx + self.bw - 12.0
        ay = self.by + self.bh / 2.0
        draw_line(buf, surf, ax - 4.0, ay - 2.0, ax, ay + 2.0, 1.5, os_role_color(pal, 1))
        draw_line(buf, surf, ax, ay + 2.0, ax + 4.0, ay - 2.0, 1.5, os_role_color(pal, 1))
        if self.open == 1:
            ph = self.popup_h(n)
            pr = Rect2D(self.bx, self.by + self.bh, self.bw, ph)
            fill_round_rect(buf, surf, pr, 2.0, os_role_color(pal, 2))
            stroke_round_rect(buf, surf, pr, 2.0, 1.0, bd)
            i = int(0)
            while i < n:
                iy = self.by + self.bh + float(i) * 20.0
                if iy + 20.0 > self.by + self.bh + ph:
                    break
                if i == self.hover_idx:
                    hr = Rect2D(self.bx + 1.0, iy, self.bw - 2.0, 20.0)
                    fill_round_rect(buf, surf, hr, 0.0, os_role_color(pal, 11))
                dep = 0
                if i < len(depths):
                    dep = depths[i]
                ix = self.bx + 5.0 + float(dep) * 16.0
                hk = 0
                if i < len(has_kids):
                    hk = has_kids[i]
                if hk == 1:
                    op = 0
                    if i < len(open_flags):
                        op = open_flags[i]
                    cx = ix + 4.0
                    cy = iy + 10.0
                    if op == 1:
                        draw_line(buf, surf, cx - 3.0, cy - 1.5, cx, cy + 1.5, 1.2, os_role_color(pal, 6))
                        draw_line(buf, surf, cx, cy + 1.5, cx + 3.0, cy - 1.5, 1.2, os_role_color(pal, 6))
                    else:
                        draw_line(buf, surf, cx - 1.0, cy - 3.0, cx + 2.0, cy, 1.2, os_role_color(pal, 6))
                        draw_line(buf, surf, cx + 2.0, cy, cx - 1.0, cy + 3.0, 1.2, os_role_color(pal, 6))
                    ix = ix + 11.0
                if i < len(labels):
                    if i == self.hover_idx:
                        draw_string(buf, surf, labels[i], ix, iy + 6.0, 1.0, os_role_color(pal, 12))
                    else:
                        draw_string(buf, surf, labels[i], ix, iy + 6.0, 1.0, os_role_color(pal, 6))
                i = i + 1
        return 1

def make_native_treecombo(x: "f64", y: "f64", w: "f64") -> "NativeTreeCombo":
    return NativeTreeCombo(x, y, w, 22.0, 0, 0, -1, 0, 1)

# =========================================================
# 4) NativeTableView - sort/filter/selection/delegate-ready
# =========================================================
class NativeTableView:
    bx: "f64"
    by: "f64"
    bw: "f64"
    bh: "f64"
    ncols: "i32"
    nrows: "i32"
    sel_row: "i32"
    sel_col: "i32"
    sort_col: "i32"
    sort_dir: "i32"
    scroll_y: "f64"
    scroll_x: "f64"
    enabled: "i32"
    def __init__(self, bx, by, bw, bh, ncols, nrows, sel_row, sel_col, sort_col, sort_dir, scroll_y, scroll_x, enabled):
        self.bx = bx
        self.by = by
        self.bw = bw
        self.bh = bh
        self.ncols = ncols
        self.nrows = nrows
        self.sel_row = sel_row
        self.sel_col = sel_col
        self.sort_col = sort_col
        self.sort_dir = sort_dir
        self.scroll_y = scroll_y
        self.scroll_x = scroll_x
        self.enabled = enabled
    def header_hit(self, px: "f64", widths: "list[f64]") -> "i32":
        x = self.bx - self.scroll_x
        i = int(0)
        while i < self.ncols:
            w = 80.0
            if i < len(widths):
                w = widths[i]
            if px >= x:
                if px < x + w:
                    return i
            x = x + w
            i = i + 1
        return -1
    def cell_hit(self, px: "f64", py: "f64", widths: "list[f64]") -> "i32":
        # Tra ve row (pack col o hang tram): row * 1000 + col; -1 neu miss
        if py < self.by + 24.0:
            return -1
        rel = py - self.by - 24.0 + self.scroll_y
        row = int(rel / 22.0)
        if row < 0:
            return -1
        if row >= self.nrows:
            return -1
        col = self.header_hit(px, widths)
        if col < 0:
            return -1
        return row * 1000 + col
    def select(self, row: "i32", col: "i32") -> "i32":
        if row < 0:
            return 0
        if row >= self.nrows:
            return 0
        if col < 0:
            return 0
        if col >= self.ncols:
            return 0
        self.sel_row = row
        self.sel_col = col
        return 1
    def sort_by(self, col: "i32") -> "i32":
        if col == self.sort_col:
            if self.sort_dir == 1:
                self.sort_dir = 2
            else:
                self.sort_dir = 1
        else:
            self.sort_col = col
            self.sort_dir = 1
        return self.sort_dir
    def scroll_by(self, dy: "f64") -> "f64":
        total = float(self.nrows) * 22.0
        view = self.bh - 24.0
        self.scroll_y = os_clamp_scroll(self.scroll_y + dy, total, view)
        return self.scroll_y
    def render(self, buf: "list[i64]", surf: "PixelSurface", mode: "i32", headers: "list[str]", cells: "list[str]", widths: "list[f64]") -> "i32":
        pal = os_palette_for_mode(mode)
        r = Rect2D(self.bx, self.by, self.bw, self.bh)
        fill_round_rect(buf, surf, r, 2.0, os_role_color(pal, 2))
        stroke_round_rect(buf, surf, r, 2.0, 1.0, os_separator_color(pal))
        x = self.bx - self.scroll_x
        i = int(0)
        while i < self.ncols:
            w = 80.0
            if i < len(widths):
                w = widths[i]
            hr = Rect2D(x, self.by, w, 24.0)
            fill_round_rect(buf, surf, hr, 0.0, os_header_bg(pal, 0))
            if i < len(headers):
                draw_string(buf, surf, headers[i], x + 4.0, self.by + 8.0, 1.0, os_role_color(pal, 1))
            if i == self.sort_col:
                sx = x + w - 12.0
                if self.sort_dir == 1:
                    draw_line(buf, surf, sx, self.by + 16.0, sx + 4.0, self.by + 8.0, 1.5, os_role_color(pal, 1))
                    draw_line(buf, surf, sx + 4.0, self.by + 8.0, sx + 8.0, self.by + 16.0, 1.5, os_role_color(pal, 1))
                else:
                    draw_line(buf, surf, sx, self.by + 8.0, sx + 4.0, self.by + 16.0, 1.5, os_role_color(pal, 1))
                    draw_line(buf, surf, sx + 4.0, self.by + 16.0, sx + 8.0, self.by + 8.0, 1.5, os_role_color(pal, 1))
            draw_line(buf, surf, x + w, self.by, x + w, self.by + self.bh, 1.0, os_separator_color(pal))
            x = x + w
            i = i + 1
        draw_line(buf, surf, self.bx, self.by + 24.0, self.bx + self.bw, self.by + 24.0, 1.0, os_separator_color(pal))
        first = os_list_first_visible(self.scroll_y, 22.0)
        vis = os_list_visible_count(self.bh - 24.0, 22.0)
        k = int(0)
        while k < vis:
            row = first + k
            if row < self.nrows:
                y = self.by + 24.0 + float(row) * 22.0 - self.scroll_y
                if y + 22.0 > self.by + 24.0:
                    if y < self.by + self.bh:
                        xx = self.bx - self.scroll_x
                        j = int(0)
                        while j < self.ncols:
                            w2 = 80.0
                            if j < len(widths):
                                w2 = widths[j]
                            sel = 0
                            if row == self.sel_row:
                                if j == self.sel_col:
                                    sel = 1
                            cr2 = Rect2D(xx, y, w2, 22.0)
                            fill_round_rect(buf, surf, cr2, 0.0, os_row_bg(pal, row, sel))
                            idx = row * self.ncols + j
                            if idx < len(cells):
                                draw_string(buf, surf, cells[idx], xx + 4.0, y + 7.0, 1.0, os_row_fg(pal, sel))
                            j = j + 1
                            xx = xx + w2
            k = k + 1
        return 1

def make_native_table(x: "f64", y: "f64", w: "f64", h: "f64", ncols: "i32", nrows: "i32") -> "NativeTableView":
    return NativeTableView(x, y, w, h, ncols, nrows, -1, -1, -1, 0, 0.0, 0.0, 1)

# =========================================================
# 5) NativeTreeView - expand/collapse, indent
# =========================================================
class NativeTreeView:
    bx: "f64"
    by: "f64"
    bw: "f64"
    bh: "f64"
    scroll: "f64"
    selected: "i32"
    item_h: "f64"
    enabled: "i32"
    def __init__(self, bx, by, bw, bh, scroll, selected, item_h, enabled):
        self.bx = bx
        self.by = by
        self.bw = bw
        self.bh = bh
        self.scroll = scroll
        self.selected = selected
        self.item_h = item_h
        self.enabled = enabled
    def toggle(self, open_flags: "list[i32]", idx: "i32") -> "i32":
        if idx < 0:
            return 0
        if idx >= len(open_flags):
            return 0
        if open_flags[idx] == 1:
            open_flags[idx] = 0
        else:
            open_flags[idx] = 1
        return open_flags[idx]
    def hit_row(self, py: "f64", n: "i32") -> "i32":
        rel = py - self.by + self.scroll
        row = int(rel / 22.0)
        if row < 0:
            return -1
        if row >= n:
            return -1
        return row
    def scroll_by(self, dy: "f64", n: "i32") -> "f64":
        total = float(n) * 22.0
        self.scroll = os_clamp_scroll(self.scroll + dy, total, self.bh)
        return self.scroll
    def render(self, buf: "list[i64]", surf: "PixelSurface", mode: "i32", labels: "list[str]", depths: "list[i32]", has_kids: "list[i32]", open_flags: "list[i32]", n: "i32") -> "i32":
        pal = os_palette_for_mode(mode)
        r = Rect2D(self.bx, self.by, self.bw, self.bh)
        fill_round_rect(buf, surf, r, 2.0, os_role_color(pal, 2))
        stroke_round_rect(buf, surf, r, 2.0, 1.0, os_separator_color(pal))
        first = os_list_first_visible(self.scroll, 22.0)
        vis = os_list_visible_count(self.bh, 22.0)
        k = int(0)
        while k < vis:
            idx = first + k
            if idx < n:
                y = self.by + float(idx) * 22.0 - self.scroll
                if y + 22.0 > self.by:
                    if y < self.by + self.bh:
                        sel = 0
                        if idx == self.selected:
                            sel = 1
                        rr = Rect2D(self.bx + 1.0, y, self.bw - 2.0, 22.0)
                        fill_round_rect(buf, surf, rr, 0.0, os_row_bg(pal, idx, sel))
                        dep = 0
                        if idx < len(depths):
                            dep = depths[idx]
                        ix = self.bx + 4.0 + float(dep) * 18.0
                        hk = 0
                        if idx < len(has_kids):
                            hk = has_kids[idx]
                        if hk == 1:
                            op = 0
                            if idx < len(open_flags):
                                op = open_flags[idx]
                            cx = ix + 5.0
                            cy = y + 11.0
                            if op == 1:
                                draw_line(buf, surf, cx - 4.0, cy - 2.0, cx, cy + 2.0, 1.5, os_role_color(pal, 6))
                                draw_line(buf, surf, cx, cy + 2.0, cx + 4.0, cy - 2.0, 1.5, os_role_color(pal, 6))
                            else:
                                draw_line(buf, surf, cx - 1.0, cy - 4.0, cx + 3.0, cy, 1.5, os_role_color(pal, 6))
                                draw_line(buf, surf, cx + 3.0, cy, cx - 1.0, cy + 4.0, 1.5, os_role_color(pal, 6))
                            ix = ix + 14.0
                        if idx < len(labels):
                            draw_string(buf, surf, labels[idx], ix, y + 7.0, 1.0, os_row_fg(pal, sel))
            k = k + 1
        return 1

def make_native_tree(x: "f64", y: "f64", w: "f64", h: "f64") -> "NativeTreeView":
    return NativeTreeView(x, y, w, h, 0.0, -1, 22.0, 1)

# =========================================================
# 6) NativeTabBar - closable tabs
# =========================================================
class NativeTabBar:
    bx: "f64"
    by: "f64"
    bw: "f64"
    bh: "f64"
    count: "i32"
    active: "i32"
    hover: "i32"
    closable: "i32"
    enabled: "i32"
    def __init__(self, bx, by, bw, bh, count, active, hover, closable, enabled):
        self.bx = bx
        self.by = by
        self.bw = bw
        self.bh = bh
        self.count = count
        self.active = active
        self.hover = hover
        self.closable = closable
        self.enabled = enabled
    def select(self, idx: "i32") -> "i32":
        if idx < 0:
            return self.active
        if idx >= self.count:
            return self.active
        self.active = idx
        return idx
    def hit_tab(self, px: "f64") -> "i32":
        return os_tab_hit(self.bw, self.count, 60.0, px - self.bx)
    def hit_close(self, px: "f64", py: "f64") -> "i32":
        # Nut x o goc phai moi tab: tra ve index tab, -1 neu miss
        if self.closable == 0:
            return -1
        t = self.hit_tab(px)
        if t < 0:
            return -1
        w = os_tab_cell_w(self.bw, self.count, 60.0)
        cx = self.bx + float(t) * w + w - 14.0
        if px >= cx - 5.0:
            if px <= cx + 5.0:
                if py >= self.by + 5.0:
                    if py <= self.by + 15.0:
                        return t
        return -1
    def render(self, buf: "list[i64]", surf: "PixelSurface", mode: "i32", labels: "list[str]", n: "i32") -> "i32":
        pal = os_palette_for_mode(mode)
        base = Rect2D(self.bx, self.by, self.bw, self.bh)
        fill_round_rect(buf, surf, base, 0.0, os_state_color(pal, 7, 0))
        w = os_tab_cell_w(self.bw, self.count, 60.0)
        i = int(0)
        while i < n:
            if i < self.count:
                sel = 0
                if i == self.active:
                    sel = 1
                st = 0
                if i == self.hover:
                    st = 1
                cell = Rect2D(self.bx + float(i) * w + 1.0, self.by + 2.0, w - 2.0, self.bh - 2.0)
                fill_round_rect(buf, surf, cell, 3.0, os_tab_bg(pal, sel, st))
                txt = "Tab"
                if i < len(labels):
                    txt = labels[i]
                draw_string(buf, surf, txt, cell.x + 8.0, cell.y + (cell.h - 7.0) / 2.0, 1.0, os_tab_fg(pal, sel, st))
                if sel == 1:
                    draw_line(buf, surf, cell.x, cell.y + cell.h - 1.0, cell.x + cell.w, cell.y + cell.h - 1.0, 2.0, os_role_color(pal, 11))
                if self.closable == 1:
                    cx = cell.x + cell.w - 14.0
                    cy = cell.y + cell.h / 2.0
                    cc = os_tab_fg(pal, sel, st)
                    draw_line(buf, surf, cx - 3.0, cy - 3.0, cx + 3.0, cy + 3.0, 1.2, cc)
                    draw_line(buf, surf, cx + 3.0, cy - 3.0, cx - 3.0, cy + 3.0, 1.2, cc)
            i = i + 1
        return 1

def make_native_tabs(x: "f64", y: "f64", w: "f64", count: "i32") -> "NativeTabBar":
    return NativeTabBar(x, y, w, 22.0, count, 0, -1, 0, 1)

def make_native_tabs_closable(x: "f64", y: "f64", w: "f64", count: "i32") -> "NativeTabBar":
    return NativeTabBar(x, y, w, 22.0, count, 0, -1, 1, 1)

# =========================================================
# 7) NativeMenuBar - menu + dropdown items
# =========================================================
class NativeMenuBar:
    bx: "f64"
    by: "f64"
    bw: "f64"
    bh: "f64"
    nmenus: "i32"
    open_menu: "i32"
    hover_item: "i32"
    enabled: "i32"
    def __init__(self, bx, by, bw, bh, nmenus, open_menu, hover_item, enabled):
        self.bx = bx
        self.by = by
        self.bw = bw
        self.bh = bh
        self.nmenus = nmenus
        self.open_menu = open_menu
        self.hover_item = hover_item
        self.enabled = enabled
    def open(self, idx: "i32") -> "i32":
        if idx < -1:
            return self.open_menu
        if idx >= self.nmenus:
            return self.open_menu
        self.open_menu = idx
        self.hover_item = -1
        return idx
    def menu_w(self, idx: "i32") -> "f64":
        return 70.0 + float(idx) * 0.0
    def hit_menu(self, px: "f64") -> "i32":
        x = self.bx
        i = int(0)
        while i < self.nmenus:
            w = self.menu_w(i)
            if px >= x:
                if px < x + w:
                    return i
            x = x + w
            i = i + 1
        return -1
    def hit_item(self, py: "f64", nitems: "i32") -> "i32":
        top = self.by + self.bh
        idx = int((py - top) / 20.0)
        if idx < 0:
            return -1
        if idx >= nitems:
            return -1
        return idx
    def render(self, buf: "list[i64]", surf: "PixelSurface", mode: "i32", menus: "list[str]", items: "list[str]", nitems: "i32") -> "i32":
        pal = os_palette_for_mode(mode)
        bar = Rect2D(self.bx, self.by, self.bw, self.bh)
        fill_round_rect(buf, surf, bar, 0.0, os_role_color(pal, 0))
        x = self.bx
        i = int(0)
        while i < self.nmenus:
            w = self.menu_w(i)
            st = 0
            if i == self.open_menu:
                st = 1
            if st == 1:
                mr = Rect2D(x, self.by, w, self.bh)
                fill_round_rect(buf, surf, mr, 0.0, os_menu_bg(pal, 1))
            txt = "Menu"
            if i < len(menus):
                txt = menus[i]
            draw_string(buf, surf, txt, x + 8.0, self.by + 6.0, 1.0, os_menu_fg_fixed(pal, st))
            x = x + w
            i = i + 1
        if self.open_menu >= 0:
            dw = 170.0
            dh = float(nitems) * 20.0 + 8.0
            dx = self.bx
            k = int(0)
            while k < self.open_menu:
                dx = dx + self.menu_w(k)
                k = k + 1
            dr = Rect2D(dx, self.by + self.bh, dw, dh)
            fill_round_rect(buf, surf, dr, 2.0, os_role_color(pal, 2))
            stroke_round_rect(buf, surf, dr, 2.0, 1.0, os_separator_color(pal))
            j = int(0)
            while j < nitems:
                iy = self.by + self.bh + 4.0 + float(j) * 20.0
                st2 = 0
                if j == self.hover_item:
                    st2 = 1
                if st2 == 1:
                    ir = Rect2D(dx + 2.0, iy, dw - 4.0, 20.0)
                    fill_round_rect(buf, surf, ir, 0.0, os_role_color(pal, 11))
                if j < len(items):
                    draw_string(buf, surf, items[j], dx + 10.0, iy + 6.0, 1.0, os_menu_fg_fixed(pal, st2))
                j = j + 1
        return 1

def make_native_menubar(x: "f64", y: "f64", w: "f64", nmenus: "i32") -> "NativeMenuBar":
    return NativeMenuBar(x, y, w, 20.0, nmenus, -1, -1, 1)

# =========================================================
# 8) NativeToolBar - tool buttons row
# =========================================================
class NativeToolBar:
    bx: "f64"
    by: "f64"
    bw: "f64"
    bh: "f64"
    ntools: "i32"
    hover: "i32"
    pressed: "i32"
    checked_mask: "i32"
    enabled: "i32"
    def __init__(self, bx, by, bw, bh, ntools, hover, pressed, checked_mask, enabled):
        self.bx = bx
        self.by = by
        self.bw = bw
        self.bh = bh
        self.ntools = ntools
        self.hover = hover
        self.pressed = pressed
        self.checked_mask = checked_mask
        self.enabled = enabled
    def tool_x(self, idx: "i32") -> "f64":
        return self.bx + 4.0 + float(idx) * 30.0
    def hit_tool(self, px: "f64", py: "f64") -> "i32":
        if py < self.by + 2.0:
            return -1
        if py >= self.by + self.bh - 2.0:
            return -1
        idx = int((px - self.bx - 4.0) / 30.0)
        if idx < 0:
            return -1
        if idx >= self.ntools:
            return -1
        return idx
    def toggle_check(self, idx: "i32") -> "i32":
        # Bitmask toi 30 tool (tranh bitwise: dung cong/tru luy thua 2 qua vong)
        bit = 1
        k = int(0)
        while k < idx:
            bit = bit * 2
            k = k + 1
        has = (self.checked_mask // bit) - ((self.checked_mask // (bit * 2)) * 2)
        if has == 1:
            self.checked_mask = self.checked_mask - bit
        else:
            self.checked_mask = self.checked_mask + bit
        return self.checked_mask
    def is_checked(self, idx: "i32") -> "i32":
        bit = 1
        k = int(0)
        while k < idx:
            bit = bit * 2
            k = k + 1
        return (self.checked_mask // bit) - ((self.checked_mask // (bit * 2)) * 2)
    def render(self, buf: "list[i64]", surf: "PixelSurface", mode: "i32", tips: "list[str]", n: "i32") -> "i32":
        pal = os_palette_for_mode(mode)
        bar = Rect2D(self.bx, self.by, self.bw, self.bh)
        fill_round_rect(buf, surf, bar, 0.0, os_role_color(pal, 0))
        draw_line(buf, surf, self.bx, self.by + self.bh - 1.0, self.bx + self.bw, self.by + self.bh - 1.0, 1.0, os_separator_color(pal))
        i = int(0)
        while i < n:
            if i < self.ntools:
                tx = self.tool_x(i)
                tr = Rect2D(tx, self.by + 2.0, 26.0, self.bh - 4.0)
                ck = self.is_checked(i)
                if ck == 1:
                    fill_round_rect(buf, surf, tr, 3.0, os_state_color(pal, 11, 0))
                else:
                    if i == self.pressed:
                        fill_round_rect(buf, surf, tr, 3.0, os_state_color(pal, 7, 2))
                    else:
                        if i == self.hover:
                            fill_round_rect(buf, surf, tr, 3.0, os_state_color(pal, 7, 1))
                cc = os_role_color(pal, 1)
                if ck == 1:
                    cc = os_role_color(pal, 12)
                cx = tx + 13.0
                cy = self.by + self.bh / 2.0
                draw_arc(buf, surf, cx, cy, 5.0, 2.0, 0.0, 360.0, cc)
            i = i + 1
        return 1

def make_native_toolbar(x: "f64", y: "f64", w: "f64", ntools: "i32") -> "NativeToolBar":
    return NativeToolBar(x, y, w, 30.0, ntools, -1, -1, 0, 1)

# =========================================================
# 9) NativeDialog - message/file/progress kinds
# =========================================================
class NativeDialog:
    bx: "f64"
    by: "f64"
    bw: "f64"
    bh: "f64"
    title: "str"
    message: "str"
    kind: "i32"
    buttons: "i32"
    visible: "i32"
    result: "i32"
    hover_btn: "i32"
    def __init__(self, bx, by, bw, bh, title, message, kind, buttons, visible, result, hover_btn):
        self.bx = bx
        self.by = by
        self.bw = bw
        self.bh = bh
        self.title = title
        self.message = message
        self.kind = kind
        self.buttons = buttons
        self.visible = visible
        self.result = result
        self.hover_btn = hover_btn
    def show(self) -> "i32":
        self.visible = 1
        self.result = -1
        return 1
    def hide(self, result: "i32") -> "i32":
        self.visible = 0
        self.result = result
        return result
    def button_count(self) -> "i32":
        if self.buttons == 1:
            return 1
        return 2
    def button_rect(self, idx: "i32") -> "Rect2D":
        n = self.button_count()
        bw = os_dialog_button_w(self.bw, 12.0)
        by = self.by + self.bh - 40.0
        if n == 1:
            return Rect2D(self.bx + (self.bw - bw) / 2.0, by, bw, 28.0)
        if idx == 0:
            return Rect2D(self.bx + 12.0, by, bw, 28.0)
        return Rect2D(self.bx + 12.0 * 2.0 + bw, by, bw, 28.0)
    def button_label(self, idx: "i32") -> "str":
        if self.buttons == 1:
            return "OK"
        if self.buttons == 2:
            if idx == 0:
                return "OK"
            return "Cancel"
        if idx == 0:
            return "Yes"
        return "No"
    def hit_button(self, px: "f64", py: "f64") -> "i32":
        n = self.button_count()
        i = int(0)
        while i < n:
            br = self.button_rect(i)
            if px >= br.x:
                if px < br.x + br.w:
                    if py >= br.y:
                        if py < br.y + br.h:
                            return i
            i = i + 1
        return -1
    def render(self, buf: "list[i64]", surf: "PixelSurface", mode: "i32") -> "i32":
        if self.visible == 0:
            return 0
        pal = os_palette_for_mode(mode)
        dr = Rect2D(0.0, 0.0, float(surf.width), float(surf.height))
        fill_round_rect(buf, surf, dr, 0.0, ColorRgba(0, 0, 0, 110))
        r = Rect2D(self.bx, self.by, self.bw, self.bh)
        fill_round_rect(buf, surf, r, 4.0, os_role_color(pal, 0))
        stroke_round_rect(buf, surf, r, 4.0, 1.0, os_separator_color(pal))
        tr = Rect2D(self.bx, self.by, self.bw, 28.0)
        fill_round_rect(buf, surf, tr, 4.0, os_state_color(pal, 7, 0))
        draw_string(buf, surf, self.title, self.bx + 10.0, self.by + 10.0, 1.0, os_role_color(pal, 1))
        draw_string(buf, surf, self.message, self.bx + 46.0, self.by + 44.0, 1.0, os_role_color(pal, 1))
        ic = os_role_color(pal, 11)
        if self.kind == 1:
            ic = ColorRgba(220, 170, 40, 255)
        if self.kind == 2:
            ic = ColorRgba(200, 60, 60, 255)
        draw_arc(buf, surf, self.bx + 24.0, self.by + 52.0, 9.0, 3.0, 0.0, 360.0, ic)
        n = self.button_count()
        i = int(0)
        while i < n:
            br = self.button_rect(i)
            st = 0
            if i == self.hover_btn:
                st = 1
            dflt = 0
            if i == 0:
                dflt = 1
            fill_round_rect(buf, surf, br, 3.0, os_button_bg(pal, st, dflt))
            stroke_round_rect(buf, surf, br, 3.0, 1.0, os_separator_color(pal))
            lb = self.button_label(i)
            tm = measure_string(lb, 1.0)
            draw_string(buf, surf, lb, br.x + (br.w - tm.w) / 2.0, br.y + (br.h - tm.h) / 2.0, 1.0, os_button_fg(pal, st, dflt))
            i = i + 1
        return 1

def make_native_dialog(x: "f64", y: "f64", w: "f64", h: "f64", title: "str", message: "str") -> "NativeDialog":
    return NativeDialog(x, y, w, h, title, message, 0, 2, 0, -1, -1)

def make_native_dialog_buttons(x: "f64", y: "f64", w: "f64", h: "f64", title: "str", message: "str", kind: "i32", buttons: "i32") -> "NativeDialog":
    return NativeDialog(x, y, w, h, title, message, kind, buttons, 0, -1, -1)

# =========================================================
# 10) NativeScrollBar - vertical/horizontal
# =========================================================
class NativeScrollBar:
    bx: "f64"
    by: "f64"
    bw: "f64"
    bh: "f64"
    orient: "i32"
    value: "f64"
    minimum: "f64"
    maximum: "f64"
    page: "f64"
    dragging: "i32"
    state: "i32"
    enabled: "i32"
    def __init__(self, bx, by, bw, bh, orient, value, minimum, maximum, page, dragging, state, enabled):
        self.bx = bx
        self.by = by
        self.bw = bw
        self.bh = bh
        self.orient = orient
        self.value = value
        self.minimum = minimum
        self.maximum = maximum
        self.page = page
        self.dragging = dragging
        self.state = state
        self.enabled = enabled
    def track_len(self) -> "f64":
        if self.orient == 1:
            return self.bh
        return self.bw
    def thumb_len(self) -> "f64":
        return os_scrollbar_thumb(self.track_len(), self.page, self.maximum - self.minimum + self.page)
    def thumb_pos(self) -> "f64":
        return os_scrollbar_thumb_pos(self.track_len(), self.thumb_len(), self.value, self.minimum, self.maximum)
    def set_value(self, v: "f64") -> "f64":
        if v < self.minimum:
            v = self.minimum
        if v > self.maximum:
            v = self.maximum
        self.value = v
        return v
    def step(self, d: "f64") -> "f64":
        return self.set_value(self.value + d)
    def page_step(self, d: "i32") -> "f64":
        if d > 0:
            return self.set_value(self.value + self.page)
        return self.set_value(self.value - self.page)
    def set_from_pointer(self, p: "f64") -> "f64":
        rel = p - self.thumb_len() / 2.0
        if self.orient == 1:
            rel = rel - self.by
        else:
            rel = rel - self.bx
        span = self.track_len() - self.thumb_len()
        r = 0.0
        if span > 0.0:
            r = rel / span
        v = os_slider_value(r, self.minimum, self.maximum)
        return self.set_value(v)
    def render(self, buf: "list[i64]", surf: "PixelSurface", mode: "i32") -> "i32":
        pal = os_palette_for_mode(mode)
        r = Rect2D(self.bx, self.by, self.bw, self.bh)
        fill_round_rect(buf, surf, r, 0.0, os_role_color(pal, 0))
        tl = self.thumb_len()
        tp = self.thumb_pos()
        tr = Rect2D(self.bx, self.by, self.bw, self.bh)
        if self.orient == 1:
            tr = Rect2D(self.bx + 2.0, self.by + tp, self.bw - 4.0, tl)
        else:
            tr = Rect2D(self.bx + tp, self.by + 2.0, tl, self.bh - 4.0)
        st = self.state
        if self.enabled == 0:
            st = 3
        fill_round_rect(buf, surf, tr, 4.0, os_state_color(pal, 7, st))
        return 1

def make_native_scrollbar(x: "f64", y: "f64", w: "f64", h: "f64", orient: "i32") -> "NativeScrollBar":
    return NativeScrollBar(x, y, w, h, orient, 0.0, 0.0, 100.0, 10.0, 0, 0, 1)

# =========================================================
# 11) NativeSplitter - resizable panes
# =========================================================
class NativeSplitter:
    bx: "f64"
    by: "f64"
    bw: "f64"
    bh: "f64"
    ratio: "f64"
    orient: "i32"
    min_ratio: "f64"
    dragging: "i32"
    enabled: "i32"
    def __init__(self, bx, by, bw, bh, ratio, orient, min_ratio, dragging, enabled):
        self.bx = bx
        self.by = by
        self.bw = bw
        self.bh = bh
        self.ratio = ratio
        self.orient = orient
        self.min_ratio = min_ratio
        self.dragging = dragging
        self.enabled = enabled
    def set_ratio(self, r: "f64") -> "f64":
        self.ratio = os_split_clamp(r, self.min_ratio)
        return self.ratio
    def set_from_pointer(self, p: "f64") -> "f64":
        r = 0.5
        if self.orient == 1:
            r = (p - self.by) / self.bh
        else:
            r = (p - self.bx) / self.bw
        return self.set_ratio(r)
    def pane_a(self) -> "Rect2D":
        if self.orient == 1:
            return Rect2D(self.bx, self.by, self.bw, self.bh * self.ratio)
        return Rect2D(self.bx, self.by, self.bw * self.ratio, self.bh)
    def pane_b(self) -> "Rect2D":
        if self.orient == 1:
            return Rect2D(self.bx, self.by + self.bh * self.ratio, self.bw, self.bh * (1.0 - self.ratio))
        return Rect2D(self.bx + self.bw * self.ratio, self.by, self.bw * (1.0 - self.ratio), self.bh)
    def handle_rect(self) -> "Rect2D":
        if self.orient == 1:
            return Rect2D(self.bx, self.by + self.bh * self.ratio - 2.0, self.bw, 4.0)
        return Rect2D(self.bx + self.bw * self.ratio - 2.0, self.by, 4.0, self.bh)
    def render(self, buf: "list[i64]", surf: "PixelSurface", mode: "i32") -> "i32":
        pal = os_palette_for_mode(mode)
        a = self.pane_a()
        b = self.pane_b()
        fill_round_rect(buf, surf, a, 0.0, os_role_color(pal, 0))
        fill_round_rect(buf, surf, b, 0.0, os_role_color(pal, 2))
        h = self.handle_rect()
        fill_round_rect(buf, surf, h, 0.0, os_separator_color(pal))
        return 1

def make_native_splitter(x: "f64", y: "f64", w: "f64", h: "f64", ratio: "f64", orient: "i32") -> "NativeSplitter":
    return NativeSplitter(x, y, w, h, ratio, orient, 0.2, 0, 1)

class NativeDockPanel:
    bx: "f64"
    by: "f64"
    bw: "f64"
    bh: "f64"
    left_w: "f64"
    right_w: "f64"
    top_h: "f64"
    bottom_h: "f64"
    enabled: "i32"
    def __init__(self, bx, by, bw, bh, left_w, right_w, top_h, bottom_h, enabled):
        self.bx = bx
        self.by = by
        self.bw = bw
        self.bh = bh
        self.left_w = left_w
        self.right_w = right_w
        self.top_h = top_h
        self.bottom_h = bottom_h
        self.enabled = enabled
    def set_left(self, w: "f64") -> "f64":
        if w < 0.0:
            w = 0.0
        if w > self.bw * 0.5:
            w = self.bw * 0.5
        self.left_w = w
        return w
    def set_right(self, w: "f64") -> "f64":
        if w < 0.0:
            w = 0.0
        if w > self.bw * 0.5:
            w = self.bw * 0.5
        self.right_w = w
        return w
    def set_top(self, h: "f64") -> "f64":
        if h < 0.0:
            h = 0.0
        if h > self.bh * 0.5:
            h = self.bh * 0.5
        self.top_h = h
        return h
    def set_bottom(self, h: "f64") -> "f64":
        if h < 0.0:
            h = 0.0
        if h > self.bh * 0.5:
            h = self.bh * 0.5
        self.bottom_h = h
        return h
    def left_rect(self) -> "Rect2D":
        return Rect2D(self.bx, self.by + self.top_h, self.left_w, self.bh - self.top_h - self.bottom_h)
    def right_rect(self) -> "Rect2D":
        return Rect2D(self.bx + self.bw - self.right_w, self.by + self.top_h, self.right_w, self.bh - self.top_h - self.bottom_h)
    def top_rect(self) -> "Rect2D":
        return Rect2D(self.bx, self.by, self.bw, self.top_h)
    def bottom_rect(self) -> "Rect2D":
        return Rect2D(self.bx, self.by + self.bh - self.bottom_h, self.bw, self.bottom_h)
    def central_rect(self) -> "Rect2D":
        return Rect2D(self.bx + self.left_w, self.by + self.top_h, self.bw - self.left_w - self.right_w, self.bh - self.top_h - self.bottom_h)
    def hit_gutter(self, px: "f64", py: "f64") -> "i32":
        if px < self.bx or px >= self.bx + self.bw:
            return 0
        if py < self.by or py >= self.by + self.bh:
            return 0
        gx = self.bx + self.left_w
        if px >= gx - 4.0 and px < gx + 4.0:
            if py >= self.by + self.top_h and py < self.by + self.bh - self.bottom_h:
                return 1
        gx = self.bx + self.bw - self.right_w
        if px >= gx - 4.0 and px < gx + 4.0:
            if py >= self.by + self.top_h and py < self.by + self.bh - self.bottom_h:
                return 2
        gy = self.by + self.top_h
        if py >= gy - 4.0 and py < gy + 4.0:
            return 3
        gy = self.by + self.bh - self.bottom_h
        if py >= gy - 4.0 and py < gy + 4.0:
            return 4
        return 0
    def render(self, buf: "list[i64]", surf: "PixelSurface", mode: "i32", labels: "list[str]") -> "i32":
        pal = os_palette_for_mode(mode)
        c = self.central_rect()
        fill_round_rect(buf, surf, c, 0.0, os_role_color(pal, 0))
        lr = self.left_rect()
        if lr.w > 0.0:
            fill_round_rect(buf, surf, lr, 0.0, os_role_color(pal, 2))
        rr = self.right_rect()
        if rr.w > 0.0:
            fill_round_rect(buf, surf, rr, 0.0, os_role_color(pal, 2))
        tr = self.top_rect()
        if tr.h > 0.0:
            fill_round_rect(buf, surf, tr, 0.0, os_state_color(pal, 7, 0))
        br = self.bottom_rect()
        if br.h > 0.0:
            fill_round_rect(buf, surf, br, 0.0, os_state_color(pal, 7, 0))
        draw_line(buf, surf, self.bx + self.left_w, self.by + self.top_h, self.bx + self.left_w, self.by + self.bh - self.bottom_h, 1.0, os_separator_color(pal))
        draw_line(buf, surf, self.bx + self.bw - self.right_w, self.by + self.top_h, self.bx + self.bw - self.right_w, self.by + self.bh - self.bottom_h, 1.0, os_separator_color(pal))
        i = int(0)
        while i < 4 and i < len(labels):
            draw_string(buf, surf, labels[i], self.bx + 6.0 + float(i) * 60.0, self.by + 6.0, 1.0, os_role_color(pal, 1))
            i = i + 1
        return 1

def make_native_dock(x: "f64", y: "f64", w: "f64", h: "f64") -> "NativeDockPanel":
    return NativeDockPanel(x, y, w, h, 120.0, 120.0, 28.0, 24.0, 1)

class NativeMdiArea:
    bx: "f64"
    by: "f64"
    bw: "f64"
    bh: "f64"
    active: "i32"
    enabled: "i32"
    def __init__(self, bx, by, bw, bh, active, enabled):
        self.bx = bx
        self.by = by
        self.bw = bw
        self.bh = bh
        self.active = active
        self.enabled = enabled
    def count(self, titles: "list[str]") -> "i32":
        return len(titles)
    def add_child(self, titles: "list[str]", xs: "list[f64]", ys: "list[f64]", ws: "list[f64]", hs: "list[f64]", mins: "list[i32]", title: "str", w: "f64", h: "f64") -> "i32":
        n = len(titles)
        titles.append(title)
        xs.append(self.bx + 20.0 + float(n % 5) * 24.0)
        ys.append(self.by + 20.0 + float(n % 5) * 22.0)
        ws.append(w)
        hs.append(h)
        mins.append(0)
        self.active = n
        return n
    def close_child(self, titles: "list[str]", xs: "list[f64]", ys: "list[f64]", ws: "list[f64]", hs: "list[f64]", mins: "list[i32]", idx: "i32") -> "i32":
        if idx < 0 or idx >= len(titles):
            return 0
        j = idx
        while j + 1 < len(titles):
            titles[j] = titles[j + 1]
            xs[j] = xs[j + 1]
            ys[j] = ys[j + 1]
            ws[j] = ws[j + 1]
            hs[j] = hs[j + 1]
            mins[j] = mins[j + 1]
            j = j + 1
        titles.pop()
        xs.pop()
        ys.pop()
        ws.pop()
        hs.pop()
        mins.pop()
        if self.active >= len(titles):
            self.active = len(titles) - 1
        return 1
    def activate(self, idx: "i32", n: "i32") -> "i32":
        if idx < 0 or idx >= n:
            return self.active
        self.active = idx
        return idx
    def minimize(self, mins: "list[i32]", idx: "i32") -> "i32":
        if idx < 0 or idx >= len(mins):
            return 0
        if mins[idx] == 1:
            mins[idx] = 0
        else:
            mins[idx] = 1
        return mins[idx]
    def cascade(self, xs: "list[f64]", ys: "list[f64]", n: "i32") -> "i32":
        i = int(0)
        while i < n:
            if i < len(xs):
                xs[i] = self.bx + 20.0 + float(i % 5) * 24.0
            if i < len(ys):
                ys[i] = self.by + 20.0 + float(i % 5) * 22.0
            i = i + 1
        return n
    def tile_vertical(self, xs: "list[f64]", ws: "list[f64]", n: "i32") -> "i32":
        if n <= 0:
            return 0
        w = self.bw / float(n)
        i = int(0)
        while i < n:
            if i < len(xs):
                xs[i] = self.bx + float(i) * w
            if i < len(ws):
                ws[i] = w
            i = i + 1
        return n
    def hit_child(self, titles: "list[str]", xs: "list[f64]", ys: "list[f64]", ws: "list[f64]", hs: "list[f64]", mins: "list[i32]", px: "f64", py: "f64") -> "i32":
        i = len(titles) - 1
        while i >= 0:
            if i < len(mins):
                if mins[i] == 0:
                    if i < len(xs) and i < len(ys) and i < len(ws) and i < len(hs):
                        if px >= xs[i] and px < xs[i] + ws[i]:
                            if py >= ys[i] and py < ys[i] + hs[i]:
                                return i
            i = i - 1
        return -1
    def render(self, buf: "list[i64]", surf: "PixelSurface", mode: "i32", titles: "list[str]", xs: "list[f64]", ys: "list[f64]", ws: "list[f64]", hs: "list[f64]", mins: "list[i32]") -> "i32":
        pal = os_palette_for_mode(mode)
        r = Rect2D(self.bx, self.by, self.bw, self.bh)
        fill_round_rect(buf, surf, r, 0.0, os_state_color(pal, 7, 2))
        i = int(0)
        n = len(titles)
        while i < n:
            if i < len(mins):
                if mins[i] == 0:
                    if i < len(xs) and i < len(ys) and i < len(ws) and i < len(hs):
                        cr = Rect2D(xs[i], ys[i], ws[i], hs[i])
                        fill_round_rect(buf, surf, cr, 2.0, os_role_color(pal, 2))
                        bd = os_separator_color(pal)
                        if i == self.active:
                            bd = os_role_color(pal, 11)
                        stroke_round_rect(buf, surf, cr, 2.0, 1.0, bd)
                        tr = Rect2D(xs[i], ys[i], ws[i], 20.0)
                        fill_round_rect(buf, surf, tr, 2.0, os_state_color(pal, 7, 0))
                        if i < len(titles):
                            draw_string(buf, surf, titles[i], xs[i] + 6.0, ys[i] + 6.0, 1.0, os_role_color(pal, 1))
            i = i + 1
        ty = self.by + self.bh - 22.0
        fill_round_rect(buf, surf, Rect2D(self.bx, ty, self.bw, 22.0), 0.0, os_state_color(pal, 7, 0))
        i = int(0)
        while i < n:
            bx = self.bx + 4.0 + float(i) * 90.0
            if bx + 86.0 > self.bx + self.bw:
                break
            br = Rect2D(bx, ty + 2.0, 86.0, 18.0)
            if i == self.active:
                fill_round_rect(buf, surf, br, 2.0, os_role_color(pal, 11))
            if i < len(titles):
                draw_string(buf, surf, titles[i], bx + 4.0, ty + 5.0, 1.0, os_role_color(pal, 1))
            i = i + 1
        return 1

def make_native_mdi(x: "f64", y: "f64", w: "f64", h: "f64") -> "NativeMdiArea":
    return NativeMdiArea(x, y, w, h, -1, 1)

# P4 systray: Shell_NotifyIconA tooltip icon (Win32).
# Han che v1 (ghi nhan): hien tooltip-only; click can WndProc subclassing
# (callback pointer - gap compiler, cung ho voi wf_run). Khong render vao
# buffer (OS ve icon). Headless-safe: thieu shell32/handle -> 0.
# NOTIFYICONDATAA V1 (64-bit): cbSize@0, hWnd@8, uID@16, uFlags@20,
# uCallbackMessage@24, hIcon@32, szTip[128]@40. VirtualAlloc zero san.
def tray_present() -> "i32":
    if tkv_has_file("shell32.dll") == 1:
        return 1
    if tkv_has_file("C:\\Windows\\System32\\shell32.dll") == 1:
        return 1
    return 0

def tray_write_ptr(mem: "i64", off: "i64", val: "i64") -> "i32":
    # Ghi con tro 64-bit (HWND/HICON thuc te < 2^31 - user handle 32-bit).
    win_write_u32_le(mem, off, int(val))
    win_write_u32_le(mem, off + 4, 0)
    return 1

def tray_build_nid(uid: "i32", hwnd: "i64", icon: "i64", tip: "str") -> "i64":
    # Cap phat + dien NOTIFYICONDATA V1, tra con tro (0 neu loi). Caller free.
    # VirtualAlloc zero san nen cac field con lai = 0.
    mem = mem_alloc(1024)
    if mem == 0:
        return 0
    win_write_u32_le(mem, 0, 168)
    tray_write_ptr(mem, 8, hwnd)
    win_write_u32_le(mem, 16, uid)
    win_write_u32_le(mem, 20, 7)
    win_write_u32_le(mem, 24, 1025)
    tray_write_ptr(mem, 32, icon)
    t = tip
    if len(t) > 127:
        t = t[0:127]
    rc = tray_wsprintf_s(mem + 40, "%s", t)
    if rc < 0:
        mem_free(mem)
        return 0
    return mem

class NativeSysTray:
    uid: "i32"
    hwnd: "i64"
    added: "i32"
    def __init__(self, uid, hwnd, added):
        self.uid = uid
        self.hwnd = hwnd
        self.added = added
    def show(self, icon: "i64", tip: "str") -> "i32":
        if tray_present() == 0:
            return 0
        if self.hwnd == 0:
            return 0
        nid = tray_build_nid(self.uid, self.hwnd, icon, tip)
        if nid == 0:
            return 0
        rc = tray_notify(0, nid)
        mem_free(nid)
        if rc == 0:
            return 0
        self.added = 1
        return 1
    def update_tip(self, tip: "str") -> "i32":
        if self.added == 0:
            return 0
        nid = tray_build_nid(self.uid, self.hwnd, 0, tip)
        if nid == 0:
            return 0
        rc = tray_notify(1, nid)
        mem_free(nid)
        if rc == 0:
            return 0
        return 1
    def remove(self) -> "i32":
        if self.added == 0:
            return 0
        nid = tray_build_nid(self.uid, self.hwnd, 0, "")
        if nid == 0:
            return 0
        rc = tray_notify(2, nid)
        mem_free(nid)
        if rc == 0:
            return 0
        self.added = 0
        return 1

def make_native_systray(uid: "i32", hwnd: "i64") -> "NativeSysTray":
    return NativeSysTray(uid, hwnd, 0)

def tray_default_icon() -> "i64":
    # IDI_APPLICATION (32512) shared - khong can destroy.
    if tray_present() == 0:
        return 0
    return tray_load_icon(0, 32512)

# =========================================================
# 12) NativeProgressBar
# =========================================================
class NativeProgressBar:
    bx: "f64"
    by: "f64"
    bw: "f64"
    bh: "f64"
    value: "f64"
    minimum: "f64"
    maximum: "f64"
    state: "i32"
    text_visible: "i32"
    def __init__(self, bx, by, bw, bh, value, minimum, maximum, state, text_visible):
        self.bx = bx
        self.by = by
        self.bw = bw
        self.bh = bh
        self.value = value
        self.minimum = minimum
        self.maximum = maximum
        self.state = state
        self.text_visible = text_visible
    def set_value(self, v: "f64") -> "f64":
        if v < self.minimum:
            v = self.minimum
        if v > self.maximum:
            v = self.maximum
        self.value = v
        return v
    def percent(self) -> "i32":
        span = self.maximum - self.minimum
        if span <= 0.0:
            return 0
        return int((self.value - self.minimum) * 100.0 / span)
    def fill_w(self) -> "f64":
        return os_progress_fill(self.bw, self.value, self.minimum, self.maximum)
    def render(self, buf: "list[i64]", surf: "PixelSurface", mode: "i32") -> "i32":
        pal = os_palette_for_mode(mode)
        r = Rect2D(self.bx, self.by, self.bw, self.bh)
        fill_round_rect(buf, surf, r, 2.0, os_progress_bg(pal))
        stroke_round_rect(buf, surf, r, 2.0, 1.0, os_separator_color(pal))
        fw = self.fill_w()
        if fw > 1.0:
            fr = Rect2D(self.bx + 1.0, self.by + 1.0, fw - 2.0, self.bh - 2.0)
            fill_round_rect(buf, surf, fr, 1.0, os_progress_chunk(pal, self.state))
        if self.text_visible == 1:
            pct = str(self.percent()) + "%"
            tm = measure_string(pct, 1.0)
            draw_string(buf, surf, pct, self.bx + (self.bw - tm.w) / 2.0, self.by + (self.bh - tm.h) / 2.0, 1.0, os_role_color(pal, 1))
        return 1

def make_native_progress(x: "f64", y: "f64", w: "f64") -> "NativeProgressBar":
    return NativeProgressBar(x, y, w, 16.0, 0.0, 0.0, 100.0, 0, 1)

# =========================================================
# 13) NativeSlider - horizontal/vertical
# =========================================================
class NativeSlider:
    bx: "f64"
    by: "f64"
    bw: "f64"
    bh: "f64"
    value: "f64"
    minimum: "f64"
    maximum: "f64"
    orient: "i32"
    dragging: "i32"
    state: "i32"
    enabled: "i32"
    def __init__(self, bx, by, bw, bh, value, minimum, maximum, orient, dragging, state, enabled):
        self.bx = bx
        self.by = by
        self.bw = bw
        self.bh = bh
        self.value = value
        self.minimum = minimum
        self.maximum = maximum
        self.orient = orient
        self.dragging = dragging
        self.state = state
        self.enabled = enabled
    def ratio(self) -> "f64":
        return os_slider_ratio(self.value, self.minimum, self.maximum)
    def set_value(self, v: "f64") -> "f64":
        if v < self.minimum:
            v = self.minimum
        if v > self.maximum:
            v = self.maximum
        self.value = v
        return v
    def set_from_pointer(self, p: "f64") -> "f64":
        r = 0.0
        if self.orient == 1:
            r = (p - self.by) / self.bh
        else:
            r = (p - self.bx) / self.bw
        return self.set_value(os_slider_value(r, self.minimum, self.maximum))
    def knob_xy(self) -> "Point2D":
        t = self.ratio()
        if self.orient == 1:
            return Point2D(self.bx + self.bw / 2.0, self.by + self.bh * t)
        return Point2D(self.bx + self.bw * t, self.by + self.bh / 2.0)
    def render(self, buf: "list[i64]", surf: "PixelSurface", mode: "i32") -> "i32":
        pal = os_palette_for_mode(mode)
        st = self.state
        if self.enabled == 0:
            st = 3
        if self.orient == 1:
            gr = Rect2D(self.bx + self.bw / 2.0 - 2.0, self.by, 4.0, self.bh)
            fill_round_rect(buf, surf, gr, 2.0, os_slider_groove(pal))
        else:
            gr = Rect2D(self.bx, self.by + self.bh / 2.0 - 2.0, self.bw, 4.0)
            fill_round_rect(buf, surf, gr, 2.0, os_slider_groove(pal))
        k = self.knob_xy()
        draw_arc(buf, surf, k.x, k.y, 6.0, 12.0, 0.0, 360.0, os_slider_handle(pal, st))
        return 1

def make_native_slider(x: "f64", y: "f64", w: "f64", value: "f64") -> "NativeSlider":
    return NativeSlider(x, y, w, 22.0, value, 0.0, 100.0, 0, 0, 0, 1)

# =========================================================
# 14) NativeSpinBox - numeric up/down
# =========================================================
class NativeSpinBox:
    bx: "f64"
    by: "f64"
    bw: "f64"
    bh: "f64"
    value: "i32"
    minimum: "i32"
    maximum: "i32"
    step_v: "i32"
    state: "i32"
    enabled: "i32"
    def __init__(self, bx, by, bw, bh, value, minimum, maximum, step_v, state, enabled):
        self.bx = bx
        self.by = by
        self.bw = bw
        self.bh = bh
        self.value = value
        self.minimum = minimum
        self.maximum = maximum
        self.step_v = step_v
        self.state = state
        self.enabled = enabled
    def set_value(self, v: "i32") -> "i32":
        if v < self.minimum:
            v = self.minimum
        if v > self.maximum:
            v = self.maximum
        self.value = v
        return v
    def step_up(self) -> "i32":
        return self.set_value(self.value + self.step_v)
    def step_down(self) -> "i32":
        return self.set_value(self.value - self.step_v)
    def hit_button(self, px: "f64", py: "f64") -> "i32":
        # 1 = up, 0 = down, -1 = miss
        bw = 22.0
        if px < self.bx + self.bw - bw:
            return -1
        mid = self.by + self.bh / 2.0
        if py < self.by:
            return -1
        if py >= self.by + self.bh:
            return -1
        if py < mid:
            return 1
        return 0
    def render(self, buf: "list[i64]", surf: "PixelSurface", mode: "i32") -> "i32":
        pal = os_palette_for_mode(mode)
        st = self.state
        if self.enabled == 0:
            st = 3
        r = Rect2D(self.bx, self.by, self.bw, self.bh)
        fill_round_rect(buf, surf, r, 2.0, os_edit_bg(pal, st))
        stroke_round_rect(buf, surf, r, 2.0, 1.0, os_edit_border(pal, st))
        draw_string(buf, surf, str(self.value), self.bx + 5.0, self.by + (self.bh - 7.0) / 2.0, 1.0, os_role_color(pal, 6))
        bw = 22.0
        draw_line(buf, surf, self.bx + self.bw - bw, self.by, self.bx + self.bw - bw, self.by + self.bh, 1.0, os_separator_color(pal))
        mid = self.by + self.bh / 2.0
        draw_line(buf, surf, self.bx + self.bw - bw, mid, self.bx + self.bw, mid, 1.0, os_separator_color(pal))
        cx = self.bx + self.bw - bw / 2.0
        fg = os_role_color(pal, 1)
        draw_line(buf, surf, cx - 4.0, mid - 6.0, cx, mid - 10.0, 1.5, fg)
        draw_line(buf, surf, cx, mid - 10.0, cx + 4.0, mid - 6.0, 1.5, fg)
        draw_line(buf, surf, cx - 4.0, mid + 6.0, cx, mid + 10.0, 1.5, fg)
        draw_line(buf, surf, cx, mid + 10.0, cx + 4.0, mid + 6.0, 1.5, fg)
        return 1

def make_native_spinbox(x: "f64", y: "f64", w: "f64", value: "i32") -> "NativeSpinBox":
    return NativeSpinBox(x, y, w, 22.0, value, 0, 100, 1, 0, 1)

# =========================================================
# 15) NativeListView - single column, icon/text, selection
# =========================================================
class NativeListView:
    bx: "f64"
    by: "f64"
    bw: "f64"
    bh: "f64"
    item_h: "f64"
    scroll: "f64"
    count: "i32"
    selected: "i32"
    hover: "i32"
    enabled: "i32"
    def __init__(self, bx, by, bw, bh, item_h, scroll, count, selected, hover, enabled):
        self.bx = bx
        self.by = by
        self.bw = bw
        self.bh = bh
        self.item_h = item_h
        self.scroll = scroll
        self.count = count
        self.selected = selected
        self.hover = hover
        self.enabled = enabled
    def first_visible(self) -> "i32":
        return os_list_first_visible(self.scroll, self.item_h)
    def visible_count(self) -> "i32":
        return os_list_visible_count(self.bh, self.item_h)
    def scroll_by(self, dy: "f64") -> "f64":
        total = float(self.count) * self.item_h
        self.scroll = os_clamp_scroll(self.scroll + dy, total, self.bh)
        return self.scroll
    def hit_item(self, py: "f64") -> "i32":
        rel = py - self.by + self.scroll
        idx = int(rel / self.item_h)
        if idx < 0:
            return -1
        if idx >= self.count:
            return -1
        return idx
    def select(self, idx: "i32") -> "i32":
        if idx < 0:
            return self.selected
        if idx >= self.count:
            return self.selected
        self.selected = idx
        return idx
    def ensure_visible(self, idx: "i32") -> "f64":
        top = float(idx) * self.item_h
        if top < self.scroll:
            self.scroll = top
        if top + self.item_h > self.scroll + self.bh:
            self.scroll = top + self.item_h - self.bh
        total = float(self.count) * self.item_h
        self.scroll = os_clamp_scroll(self.scroll, total, self.bh)
        return self.scroll
    def render(self, buf: "list[i64]", surf: "PixelSurface", mode: "i32", labels: "list[str]", n: "i32") -> "i32":
        pal = os_palette_for_mode(mode)
        r = Rect2D(self.bx, self.by, self.bw, self.bh)
        fill_round_rect(buf, surf, r, 2.0, os_role_color(pal, 2))
        stroke_round_rect(buf, surf, r, 2.0, 1.0, os_separator_color(pal))
        first = self.first_visible()
        vis = self.visible_count()
        k = int(0)
        while k < vis:
            idx = first + k
            if idx < n:
                if idx < self.count:
                    y = self.by + float(idx) * self.item_h - self.scroll
                    if y + self.item_h > self.by:
                        if y < self.by + self.bh:
                            sel = 0
                            if idx == self.selected:
                                sel = 1
                            rr = Rect2D(self.bx + 1.0, y, self.bw - 2.0, self.item_h)
                            if sel == 1:
                                fill_round_rect(buf, surf, rr, 0.0, os_role_color(pal, 11))
                            else:
                                if idx == self.hover:
                                    fill_round_rect(buf, surf, rr, 0.0, os_state_color(pal, 2, 1))
                                else:
                                    fill_round_rect(buf, surf, rr, 0.0, os_row_bg(pal, idx, 0))
                            if idx < len(labels):
                                draw_string(buf, surf, labels[idx], self.bx + 6.0, y + (self.item_h - 7.0) / 2.0, 1.0, os_row_fg(pal, sel))
            k = k + 1
        return 1

def make_native_listview(x: "f64", y: "f64", w: "f64", h: "f64", count: "i32") -> "NativeListView":
    return NativeListView(x, y, w, h, 22.0, 0.0, count, -1, -1, 1)

# =========================================================
# 16) NativeToolTip - hover hint + status text
# =========================================================
class NativeToolTip:
    bx: "f64"
    by: "f64"
    text: "str"
    alpha: "f64"
    visible: "i32"
    timeout: "f64"
    def __init__(self, bx, by, text, alpha, visible, timeout):
        self.bx = bx
        self.by = by
        self.text = text
        self.alpha = alpha
        self.visible = visible
        self.timeout = timeout
    def show_at(self, x: "f64", y: "f64", text: "str") -> "i32":
        self.bx = x
        self.by = y
        self.text = text
        self.alpha = 1.0
        self.visible = 1
        self.timeout = 4.0
        return 1
    def hide(self) -> "i32":
        self.visible = 0
        self.alpha = 0.0
        return 0
    def step(self, dt: "f64") -> "f64":
        if self.visible == 0:
            return 0.0
        self.timeout = self.timeout - dt
        if self.timeout < 1.0:
            self.alpha = self.timeout
            if self.alpha < 0.0:
                self.alpha = 0.0
        if self.timeout <= 0.0:
            self.visible = 0
        return self.alpha
    def tip_size(self) -> "Point2D":
        tm = measure_string(self.text, 1.0)
        return Point2D(tm.w + 12.0, 20.0)
    def render(self, buf: "list[i64]", surf: "PixelSurface", mode: "i32") -> "i32":
        if self.visible == 0:
            return 0
        pal = os_palette_for_mode(mode)
        sz = self.tip_size()
        r = Rect2D(self.bx, self.by, sz.x, sz.y)
        bg = os_tooltip_bg(pal)
        a = int(self.alpha * 255)
        fill_round_rect(buf, surf, r, 2.0, ColorRgba(bg.r, bg.g, bg.b, a))
        stroke_round_rect(buf, surf, r, 2.0, 1.0, os_separator_color(pal))
        fg = os_tooltip_fg(pal)
        draw_string(buf, surf, self.text, self.bx + 6.0, self.by + 6.0, 1.0, ColorRgba(fg.r, fg.g, fg.b, a))
        return 1

def make_native_tooltip() -> "NativeToolTip":
    return NativeToolTip(0.0, 0.0, "", 0.0, 0, 0.0)

# =========================================================
# 17) NativeCalendar - month grid + selection (Gregorian)
# =========================================================
class NativeCalendar:
    bx: "f64"
    by: "f64"
    bw: "f64"
    bh: "f64"
    year: "i32"
    month: "i32"
    day: "i32"
    hover_day: "i32"
    enabled: "i32"
    def __init__(self, bx, by, bw, bh, year, month, day, hover_day, enabled):
        self.bx = bx
        self.by = by
        self.bw = bw
        self.bh = bh
        self.year = year
        self.month = month
        self.day = day
        self.hover_day = hover_day
        self.enabled = enabled
    def days_in_month(self, y: "i32", m: "i32") -> "i32":
        if m == 2:
            leap = 0
            if y % 4 == 0:
                if y % 100 != 0 or y % 400 == 0:
                    leap = 1
            if leap == 1:
                return 29
            return 28
        if m == 4 or m == 6 or m == 9 or m == 11:
            return 30
        return 31
    def first_weekday(self, y: "i32", m: "i32") -> "i32":
        # Zeller Gregorian -> 0=Sunday..6=Saturday.
        yy = y
        mm = m
        if mm < 3:
            mm = mm + 12
            yy = yy - 1
        k = yy % 100
        j = yy // 100
        h = (1 + (13 * (mm + 1)) // 5 + k + k // 4 + j // 4 + 5 * j) % 7
        dow = h + 6
        if dow >= 7:
            dow = dow - 7
        return dow
    def select(self, y: "i32", m: "i32", d: "i32") -> "i32":
        if m < 1 or m > 12:
            return 0
        if d < 1 or d > self.days_in_month(y, m):
            return 0
        self.year = y
        self.month = m
        self.day = d
        return 1
    def next_month(self) -> "i32":
        m = self.month + 1
        y = self.year
        if m > 12:
            m = 1
            y = y + 1
        dim = self.days_in_month(y, m)
        if self.day > dim:
            self.day = dim
        self.month = m
        self.year = y
        return m
    def prev_month(self) -> "i32":
        m = self.month - 1
        y = self.year
        if m < 1:
            m = 12
            y = y - 1
        dim = self.days_in_month(y, m)
        if self.day > dim:
            self.day = dim
        self.month = m
        self.year = y
        return m
    def grid_rows(self) -> "i32":
        dim = self.days_in_month(self.year, self.month)
        return (self.first_weekday(self.year, self.month) + dim + 6) // 7
    def hit_day(self, px: "f64", py: "f64") -> "i32":
        top = self.by + 34.0
        if px < self.bx or px >= self.bx + self.bw:
            return -1
        if py < top:
            return -1
        rows = self.grid_rows()
        rh = (self.bh - 34.0) / float(rows)
        if rh <= 0.0:
            return -1
        row = int((py - top) / rh)
        if row < 0 or row >= rows:
            return -1
        cw = self.bw / 7.0
        if cw <= 0.0:
            return -1
        col = int((px - self.bx) / cw)
        if col < 0 or col >= 7:
            return -1
        d = row * 7 + col - self.first_weekday(self.year, self.month) + 1
        if d < 1 or d > self.days_in_month(self.year, self.month):
            return -1
        return d
    def render(self, buf: "list[i64]", surf: "PixelSurface", mode: "i32") -> "i32":
        pal = os_palette_for_mode(mode)
        r = Rect2D(self.bx, self.by, self.bw, self.bh)
        fill_round_rect(buf, surf, r, 2.0, os_role_color(pal, 2))
        stroke_round_rect(buf, surf, r, 2.0, 1.0, os_separator_color(pal))
        head = str(self.year) + "-" + str(self.month)
        draw_string(buf, surf, head, self.bx + 6.0, self.by + 6.0, 1.0, os_role_color(pal, 1))
        wd = "SMTWTFS"
        cw = self.bw / 7.0
        i = int(0)
        while i < 7:
            draw_string(buf, surf, wd[i], self.bx + float(i) * cw + 4.0, self.by + 20.0, 1.0, os_role_color(pal, 1))
            i = i + 1
        rows = self.grid_rows()
        rh = (self.bh - 34.0) / float(rows)
        dim = self.days_in_month(self.year, self.month)
        fd = self.first_weekday(self.year, self.month)
        d = int(1)
        while d <= dim:
            idx = fd + d - 1
            row = idx // 7
            col = idx - row * 7
            cx = self.bx + float(col) * cw
            cy = self.by + 34.0 + float(row) * rh
            if d == self.day:
                cr = Rect2D(cx, cy, cw, rh)
                fill_round_rect(buf, surf, cr, 2.0, os_role_color(pal, 11))
            draw_string(buf, surf, str(d), cx + 4.0, cy + 4.0, 1.0, os_role_color(pal, 1))
            d = d + 1
        return 1

def make_native_calendar(x: "f64", y: "f64", w: "f64", h: "f64", year: "i32", month: "i32") -> "NativeCalendar":
    return NativeCalendar(x, y, w, h, year, month, 1, -1, 1)

# =========================================================
# 18) NativeColorPicker - HSV model + swatch + hex
# =========================================================
class NativeColorPicker:
    bx: "f64"
    by: "f64"
    bw: "f64"
    bh: "f64"
    h: "i32"
    s: "i32"
    v: "i32"
    enabled: "i32"
    def __init__(self, bx, by, bw, bh, h, s, v, enabled):
        self.bx = bx
        self.by = by
        self.bw = bw
        self.bh = bh
        self.h = h
        self.s = s
        self.v = v
        self.enabled = enabled
    def set_hsv(self, h: "i32", s: "i32", v: "i32") -> "i32":
        if h < 0:
            h = 0
        if h >= 360:
            h = 359
        if s < 0:
            s = 0
        if s > 100:
            s = 100
        if v < 0:
            v = 0
        if v > 100:
            v = 100
        self.h = h
        self.s = s
        self.v = v
        return 1
    def rgb(self) -> "ColorRgba":
        hh = float(self.h)
        s1 = float(self.s) / 100.0
        v1 = float(self.v) / 100.0
        c = v1 * s1
        sector = int(hh / 60.0)
        if sector > 5:
            sector = 5
        if sector < 0:
            sector = 0
        f = hh / 60.0 - float(sector)
        p = v1 - c
        q = v1 - f * c
        t = v1 - (1.0 - f) * c
        r1 = v1
        g1 = v1
        b1 = v1
        if sector == 0:
            r1 = v1
            g1 = t
            b1 = p
        else:
            if sector == 1:
                r1 = q
                g1 = v1
                b1 = p
            else:
                if sector == 2:
                    r1 = p
                    g1 = v1
                    b1 = t
                else:
                    if sector == 3:
                        r1 = p
                        g1 = q
                        b1 = v1
                    else:
                        if sector == 4:
                            r1 = t
                            g1 = p
                            b1 = v1
                        else:
                            r1 = v1
                            g1 = p
                            b1 = q
        return ColorRgba(int(r1 * 255.0), int(g1 * 255.0), int(b1 * 255.0), 255)
    def hex(self) -> "str":
        dg = "0123456789ABCDEF"
        c = self.rgb()
        ri = int(c.r // 16)
        rj = int(c.r % 16)
        gi = int(c.g // 16)
        gj = int(c.g % 16)
        bi = int(c.b // 16)
        bj = int(c.b % 16)
        return "#" + dg[ri] + dg[rj] + dg[gi] + dg[gj] + dg[bi] + dg[bj]
    def hit_hue(self, py: "f64") -> "i32":
        if py < self.by or py >= self.by + self.bh:
            return -1
        h = int((py - self.by) * 360.0 / self.bh)
        if h < 0:
            h = 0
        if h >= 360:
            h = 359
        return h
    def pick_sv(self, px: "f64", py: "f64") -> "i32":
        if px < self.bx or px >= self.bx + self.bw - 28.0:
            return -1
        if py < self.by or py >= self.by + self.bh:
            return -1
        sw = self.bw - 28.0
        if sw <= 0.0:
            return -1
        self.s = int((px - self.bx) * 100.0 / sw)
        self.v = 100 - int((py - self.by) * 100.0 / self.bh)
        if self.s < 0:
            self.s = 0
        if self.s > 100:
            self.s = 100
        if self.v < 0:
            self.v = 0
        if self.v > 100:
            self.v = 100
        return 1
    def render(self, buf: "list[i64]", surf: "PixelSurface", mode: "i32") -> "i32":
        pal = os_palette_for_mode(mode)
        r = Rect2D(self.bx, self.by, self.bw, self.bh)
        fill_round_rect(buf, surf, r, 2.0, os_role_color(pal, 2))
        stroke_round_rect(buf, surf, r, 2.0, 1.0, os_separator_color(pal))
        c = self.rgb()
        sw = self.bw - 28.0
        if sw > 0.0:
            sr = Rect2D(self.bx + 4.0, self.by + 4.0, sw - 8.0, self.bh - 30.0)
            fill_round_rect(buf, surf, sr, 2.0, c)
        hy = self.by + 4.0
        seg = (self.bh - 8.0) / 6.0
        si = int(0)
        while si < 6:
            hc = ColorRgba(255, 0, 0, 255)
            if si == 1:
                hc = ColorRgba(255, 255, 0, 255)
            else:
                if si == 2:
                    hc = ColorRgba(0, 255, 0, 255)
                else:
                    if si == 3:
                        hc = ColorRgba(0, 255, 255, 255)
                    else:
                        if si == 4:
                            hc = ColorRgba(0, 0, 255, 255)
                        else:
                            if si == 5:
                                hc = ColorRgba(255, 0, 255, 255)
            hr = Rect2D(self.bx + self.bw - 24.0, hy + float(si) * seg, 20.0, seg)
            fill_round_rect(buf, surf, hr, 1.0, hc)
            si = si + 1
        draw_string(buf, surf, self.hex(), self.bx + 6.0, self.by + self.bh - 18.0, 1.0, os_role_color(pal, 1))
        return 1

def make_native_colorpicker(x: "f64", y: "f64", w: "f64", h: "f64") -> "NativeColorPicker":
    return NativeColorPicker(x, y, w, h, 0, 100, 100, 1)

# =========================================================
# 19) NativeStatusBar - equal panels + text
# =========================================================
class NativeStatusBar:
    bx: "f64"
    by: "f64"
    bw: "f64"
    bh: "f64"
    n_panels: "i32"
    enabled: "i32"
    def __init__(self, bx, by, bw, bh, n_panels, enabled):
        self.bx = bx
        self.by = by
        self.bw = bw
        self.bh = bh
        self.n_panels = n_panels
        self.enabled = enabled
    def panel_at(self, px: "f64") -> "i32":
        if self.n_panels <= 0:
            return -1
        if px < self.bx or px >= self.bx + self.bw:
            return -1
        idx = int((px - self.bx) * float(self.n_panels) / self.bw)
        if idx < 0:
            return -1
        if idx >= self.n_panels:
            return -1
        return idx
    def render(self, buf: "list[i64]", surf: "PixelSurface", mode: "i32", panels: "list[str]", n: "i32") -> "i32":
        pal = os_palette_for_mode(mode)
        r = Rect2D(self.bx, self.by, self.bw, self.bh)
        fill_round_rect(buf, surf, r, 0.0, os_role_color(pal, 2))
        draw_line(buf, surf, self.bx, self.by, self.bx + self.bw, self.by, 1.0, os_separator_color(pal))
        pw = self.bw / float(self.n_panels)
        i = int(0)
        while i < n and i < self.n_panels:
            txt = ""
            if i < len(panels):
                txt = panels[i]
            draw_string(buf, surf, txt, self.bx + float(i) * pw + 6.0, self.by + 6.0, 1.0, os_role_color(pal, 1))
            if i > 0:
                draw_line(buf, surf, self.bx + float(i) * pw, self.by + 3.0, self.bx + float(i) * pw, self.by + self.bh - 3.0, 1.0, os_separator_color(pal))
            i = i + 1
        return 1

def make_native_statusbar(x: "f64", y: "f64", w: "f64") -> "NativeStatusBar":
    return NativeStatusBar(x, y, w, 22.0, 1, 1)

class NativeWizard:
    bx: "f64"
    by: "f64"
    bw: "f64"
    bh: "f64"
    npages: "i32"
    page: "i32"
    can_finish: "i32"
    enabled: "i32"
    def __init__(self, bx, by, bw, bh, npages, page, can_finish, enabled):
        self.bx = bx
        self.by = by
        self.bw = bw
        self.bh = bh
        self.npages = npages
        self.page = page
        self.can_finish = can_finish
        self.enabled = enabled
    def next_page(self) -> "i32":
        if self.page + 1 < self.npages:
            self.page = self.page + 1
        return self.page
    def prev_page(self) -> "i32":
        if self.page > 0:
            self.page = self.page - 1
        return self.page
    def goto_page(self, i: "i32") -> "i32":
        if i < 0:
            i = 0
        if i >= self.npages:
            i = self.npages - 1
        if self.npages <= 0:
            return 0
        self.page = i
        return self.page
    def is_first(self) -> "i32":
        if self.page <= 0:
            return 1
        return 0
    def is_last(self) -> "i32":
        if self.npages <= 0:
            return 0
        if self.page >= self.npages - 1:
            return 1
        return 0
    def finished(self) -> "i32":
        if self.is_last() == 1 and self.can_finish == 1:
            return 1
        return 0
    def render(self, buf: "list[i64]", surf: "PixelSurface", mode: "i32", titles: "list[str]", n: "i32") -> "i32":
        pal = os_palette_for_mode(mode)
        r = Rect2D(self.bx, self.by, self.bw, self.bh)
        fill_round_rect(buf, surf, r, 2.0, os_role_color(pal, 2))
        stroke_round_rect(buf, surf, r, 2.0, 1.0, os_separator_color(pal))
        title = "Step"
        if self.page < len(titles):
            if self.page >= 0:
                title = titles[self.page]
        draw_string(buf, surf, title, self.bx + 8.0, self.by + 8.0, 1.0, os_role_color(pal, 1))
        info = str(self.page + 1) + "/" + str(self.npages)
        draw_string(buf, surf, info, self.bx + self.bw - 40.0, self.by + 8.0, 1.0, os_role_color(pal, 1))
        btn = "Next"
        if self.is_last() == 1:
            btn = "Finish"
        draw_string(buf, surf, "Back", self.bx + 8.0, self.by + self.bh - 18.0, 1.0, os_role_color(pal, 1))
        draw_string(buf, surf, btn, self.bx + self.bw - 48.0, self.by + self.bh - 18.0, 1.0, os_role_color(pal, 1))
        return 1

def make_native_wizard(x: "f64", y: "f64", w: "f64", h: "f64", npages: "i32") -> "NativeWizard":
    return NativeWizard(x, y, w, h, npages, 0, 0, 1)

class NativeFontPicker:
    bx: "f64"
    by: "f64"
    bw: "f64"
    bh: "f64"
    selected: "i32"
    size: "i32"
    bold: "i32"
    italic: "i32"
    enabled: "i32"
    def __init__(self, bx, by, bw, bh, selected, size, bold, italic, enabled):
        self.bx = bx
        self.by = by
        self.bw = bw
        self.bh = bh
        self.selected = selected
        self.size = size
        self.bold = bold
        self.italic = italic
        self.enabled = enabled
    def select(self, i: "i32", n: "i32") -> "i32":
        if i < 0:
            i = 0
        if n > 0 and i >= n:
            i = n - 1
        self.selected = i
        return self.selected
    def set_size(self, px: "i32") -> "i32":
        if px < 6:
            px = 6
        if px > 72:
            px = 72
        self.size = px
        return self.size
    def toggle_bold(self) -> "i32":
        if self.bold == 1:
            self.bold = 0
        else:
            self.bold = 1
        return self.bold
    def toggle_italic(self) -> "i32":
        if self.italic == 1:
            self.italic = 0
        else:
            self.italic = 1
        return self.italic
    def family(self, families: "list[str]") -> "str":
        if self.selected < 0 or self.selected >= len(families):
            return ""
        return families[self.selected]
    def spec(self, families: "list[str]") -> "str":
        s = self.family(families) + "-" + str(self.size)
        if self.bold == 1:
            s = s + "-B"
        if self.italic == 1:
            s = s + "-I"
        return s
    def render(self, buf: "list[i64]", surf: "PixelSurface", mode: "i32", families: "list[str]", nf: "i32") -> "i32":
        pal = os_palette_for_mode(mode)
        r = Rect2D(self.bx, self.by, self.bw, self.bh)
        fill_round_rect(buf, surf, r, 2.0, os_role_color(pal, 2))
        stroke_round_rect(buf, surf, r, 2.0, 1.0, os_separator_color(pal))
        y = self.by + 6.0
        i = int(0)
        while i < nf and i < len(families):
            if y + 10.0 > self.by + self.bh - 30.0:
                break
            fg = os_role_color(pal, 1)
            if i == self.selected:
                fill_round_rect(buf, surf, Rect2D(self.bx + 4.0, y - 1.0, self.bw - 8.0, 10.0), 0.0, os_role_color(pal, 11))
            draw_string(buf, surf, families[i], self.bx + 8.0, y, 1.0, fg)
            y = y + 11.0
            i = i + 1
        prev = "Ag " + self.spec(families)
        draw_string(buf, surf, prev, self.bx + 8.0, self.by + self.bh - 16.0, 1.0, os_role_color(pal, 1))
        return 1

def make_native_fontpicker(x: "f64", y: "f64", w: "f64", h: "f64") -> "NativeFontPicker":
    return NativeFontPicker(x, y, w, h, 0, 12, 0, 0, 1)

class NativeRichEdit:
    bx: "f64"
    by: "f64"
    bw: "f64"
    bh: "f64"
    cx: "i32"
    cy: "i32"
    top: "i32"
    enabled: "i32"
    def __init__(self, bx, by, bw, bh, cx, cy, top, enabled):
        self.bx = bx
        self.by = by
        self.bw = bw
        self.bh = bh
        self.cx = cx
        self.cy = cy
        self.top = top
        self.enabled = enabled
    def line_count(self, lines: "list[str]") -> "i32":
        return len(lines)
    def clamp_caret(self, lines: "list[str]") -> "i32":
        n = len(lines)
        if n <= 0:
            self.cy = 0
            self.cx = 0
            self.top = 0
            return 0
        if self.cy < 0:
            self.cy = 0
        if self.cy >= n:
            self.cy = n - 1
        ln = lines[self.cy]
        if self.cx < 0:
            self.cx = 0
        if self.cx > len(ln):
            self.cx = len(ln)
        if self.top < 0:
            self.top = 0
        if self.top >= n:
            self.top = n - 1
        return 1
    def move_left(self, lines: "list[str]") -> "i32":
        self.clamp_caret(lines)
        if self.cx > 0:
            self.cx = self.cx - 1
            return 1
        if self.cy > 0:
            self.cy = self.cy - 1
            self.clamp_caret(lines)
            self.cx = len(lines[self.cy])
            return 1
        return 0
    def move_right(self, lines: "list[str]") -> "i32":
        self.clamp_caret(lines)
        if self.cy < 0 or self.cy >= len(lines):
            return 0
        if self.cx < len(lines[self.cy]):
            self.cx = self.cx + 1
            return 1
        if self.cy + 1 < len(lines):
            self.cy = self.cy + 1
            self.cx = 0
            return 1
        return 0
    def move_up(self, lines: "list[str]") -> "i32":
        self.clamp_caret(lines)
        if self.cy > 0:
            self.cy = self.cy - 1
            self.clamp_caret(lines)
            return 1
        return 0
    def move_down(self, lines: "list[str]") -> "i32":
        self.clamp_caret(lines)
        if self.cy + 1 < len(lines):
            self.cy = self.cy + 1
            self.clamp_caret(lines)
            return 1
        return 0
    def insert(self, lines: "list[str]", ch: "str") -> "i32":
        self.clamp_caret(lines)
        if self.cy < 0 or self.cy >= len(lines):
            return 0
        ln = lines[self.cy]
        lines[self.cy] = ln[0:self.cx] + ch + ln[self.cx:len(ln)]
        self.cx = self.cx + len(ch)
        return 1
    def backspace(self, lines: "list[str]") -> "i32":
        self.clamp_caret(lines)
        if self.cy < 0 or self.cy >= len(lines):
            return 0
        if self.cx > 0:
            ln = lines[self.cy]
            lines[self.cy] = ln[0:self.cx - 1] + ln[self.cx:len(ln)]
            self.cx = self.cx - 1
            return 1
        if self.cy > 0:
            prev = lines[self.cy - 1]
            cur = lines[self.cy]
            self.cx = len(prev)
            lines[self.cy - 1] = prev + cur
            j = self.cy
            while j + 1 < len(lines):
                lines[j] = lines[j + 1]
                j = j + 1
            lines.pop()
            self.cy = self.cy - 1
            return 1
        return 0
    def newline(self, lines: "list[str]") -> "i32":
        self.clamp_caret(lines)
        if self.cy < 0 or self.cy >= len(lines):
            return 0
        ln = lines[self.cy]
        lines[self.cy] = ln[0:self.cx]
        rest = ln[self.cx:len(ln)]
        j = len(lines)
        lines.append("")
        while j > self.cy + 1:
            lines[j] = lines[j - 1]
            j = j - 1
        lines[self.cy + 1] = rest
        self.cy = self.cy + 1
        self.cx = 0
        return 1
    def render(self, buf: "list[i64]", surf: "PixelSurface", mode: "i32", lines: "list[str]") -> "i32":
        pal = os_palette_for_mode(mode)
        r = Rect2D(self.bx, self.by, self.bw, self.bh)
        fill_round_rect(buf, surf, r, 2.0, os_role_color(pal, 0))
        stroke_round_rect(buf, surf, r, 2.0, 1.0, os_separator_color(pal))
        y = self.by + 4.0
        li = self.top
        while li < len(lines):
            if y + 10.0 > self.by + self.bh:
                break
            draw_string(buf, surf, lines[li], self.bx + 4.0, y, 1.0, os_role_color(pal, 1))
            if li == self.cy:
                fill_round_rect(buf, surf, Rect2D(self.bx + 4.0 + float(self.cx) * 6.0, y, 1.0, 8.0), 0.0, os_role_color(pal, 1))
            y = y + 10.0
            li = li + 1
        return 1

def make_native_richedit(x: "f64", y: "f64", w: "f64", h: "f64") -> "NativeRichEdit":
    return NativeRichEdit(x, y, w, h, 0, 0, 0, 1)

# =========================================================
# SELFTEST
# =========================================================
def nvcheck(acc: "list[i32]", name: "str", ok: "i32") -> "i32":
    acc[1] = acc[1] + 1
    if ok == 1:
        acc[0] = acc[0] + 1
        print("  PASS " + name)
        return 1
    print("  FAIL " + name)
    return 0

def nvcheck_i(acc: "list[i32]", name: "str", got: "i32", want: "i32") -> "i32":
    acc[1] = acc[1] + 1
    if got == want:
        acc[0] = acc[0] + 1
        print("  PASS " + name + " = " + str(got))
        return 1
    print("  FAIL " + name + " got=" + str(got) + " want=" + str(want))
    return 0

def nvcheck_f(acc: "list[i32]", name: "str", got: "f64", want: "f64", tol: "f64") -> "i32":
    d = got - want
    if d < 0.0:
        d = 0.0 - d
    acc[1] = acc[1] + 1
    if d <= tol:
        acc[0] = acc[0] + 1
        print("  PASS " + name + " = " + str(got))
        return 1
    print("  FAIL " + name + " got=" + str(got) + " want=" + str(want))
    return 0

def nv_widths() -> "list[f64]":
    out = []
    out.append(80.0)
    out.append(80.0)
    out.append(80.0)
    return out

def nv_alloc_buf(n: "i32") -> "list[i64]":
    buf = []
    i = int(0)
    while i < n:
        buf.append(0)
        i = i + 1
    return buf

def nv_probe2() -> "str":
    return "UNUSED"

def nv_render_probe() -> "str":
    # Repro: EXACT selftest setup for tab.render.
    rbuf = nv_alloc_buf(100)
    rsurf = PixelSurface(10, 10, 10)
    tlabels = []
    tlabels.append("Ax")
    tlabels.append("Bx")
    tabx = make_native_tabs(0.0, 0.0, 200.0, 2)
    q = tabx.render(rbuf, rsurf, 0, tlabels, 2)
    if q == 1:
        return "TAB_RENDER_OK"
    return "TAB_RENDER_FAIL"

def native_selftest() -> "str":
    print("== TkvUI.Widgets.Native selftest ==")
    acc = [int(0), int(0)]
    # Button
    b = make_native_button(10.0, 10.0, 80.0, 24.0, "OK")
    nvcheck_i(acc, "btn.contains", b.contains(20.0, 20.0), 1)
    nvcheck_i(acc, "btn.miss", b.contains(200.0, 20.0), 0)
    b.set_hover(1)
    nvcheck_i(acc, "btn.hover", b.state, 1)
    nvcheck_i(acc, "btn.click", b.click(), 1)
    c = make_native_check(0.0, 0.0, 80.0, 24.0, "Opt")
    c.click()
    nvcheck_i(acc, "check.toggle", c.checked, 1)
    # LineEdit
    e = make_native_lineedit(0.0, 0.0, 150.0, "Type")
    e.type_char("a")
    e.type_char("b")
    nvcheck_i(acc, "edit.len", len(e.text), 2)
    e.backspace()
    nvcheck_i(acc, "edit.bs", len(e.text), 1)
    p = make_native_password(0.0, 0.0, 150.0)
    p.type_char("x")
    nvcheck_i(acc, "pwd.mask", len(p.display_text()), 1)
    # ComboBox
    cb = make_native_combo(0.0, 0.0, 150.0)
    cb.toggle_open()
    nvcheck_i(acc, "combo.open", cb.open, 1)
    nvcheck_i(acc, "combo.choose", cb.choose(2, 5), 2)
    nvcheck_i(acc, "combo.closed", cb.open, 0)
    nvcheck_f(acc, "combo.popup", cb.popup_h(10), 120.0, 0.001)
    # TableView
    t = make_native_table(0.0, 0.0, 300.0, 200.0, 3, 50)
    t.select(4, 2)
    nvcheck_i(acc, "table.selr", t.sel_row, 4)
    nvcheck_i(acc, "table.sort", t.sort_by(1), 1)
    nvcheck_i(acc, "table.sort2", t.sort_by(1), 2)
    hit = t.cell_hit(90.0, 50.0, nv_widths())
    nvcheck_i(acc, "table.hit", hit, 1001)
    # TreeView
    tr = make_native_tree(0.0, 0.0, 200.0, 200.0)
    flags = [int(0), int(0), int(0)]
    nvcheck_i(acc, "tree.toggle", tr.toggle(flags, 1), 1)
    nvcheck_i(acc, "tree.hit", tr.hit_row(50.0, 10), 2)
    # TabBar
    tb = make_native_tabs_closable(0.0, 0.0, 300.0, 3)
    nvcheck_i(acc, "tab.sel", tb.select(2), 2)
    nvcheck_i(acc, "tab.hit", tb.hit_tab(150.0), 1)
    # MenuBar
    mb = make_native_menubar(0.0, 0.0, 400.0, 3)
    nvcheck_i(acc, "menu.open", mb.open(1), 1)
    nvcheck_i(acc, "menu.hit", mb.hit_menu(80.0), 1)
    nvcheck_i(acc, "menu.item", mb.hit_item(45.0, 5), 1)
    # ToolBar
    bar = make_native_toolbar(0.0, 0.0, 400.0, 4)
    nvcheck_i(acc, "tool.hit", bar.hit_tool(40.0, 15.0), 1)
    bar.toggle_check(1)
    nvcheck_i(acc, "tool.checked", bar.is_checked(1), 1)
    bar.toggle_check(1)
    nvcheck_i(acc, "tool.unchecked", bar.is_checked(1), 0)
    # Dialog
    d = make_native_dialog(100.0, 100.0, 300.0, 150.0, "Save", "Save changes?")
    d.show()
    nvcheck_i(acc, "dlg.visible", d.visible, 1)
    nvcheck_i(acc, "dlg.nbtn", d.button_count(), 2)
    nvcheck_i(acc, "dlg.hit", d.hit_button(120.0, 215.0), 0)
    nvcheck_i(acc, "dlg.hide", d.hide(0), 0)
    # ScrollBar
    sb = make_native_scrollbar(0.0, 0.0, 15.0, 200.0, 1)
    sb.set_value(150.0)
    nvcheck_f(acc, "sb.clamp", sb.value, 100.0, 0.001)
    sb.set_value(40.0)
    nvcheck_f(acc, "sb.thumb.min", sb.thumb_len(), 20.0, 0.001)
    sb.page = 60.0
    nvcheck_f(acc, "sb.thumb", sb.thumb_len(), 200.0 * 60.0 / 160.0, 0.5)
    # Splitter
    sp = make_native_splitter(0.0, 0.0, 400.0, 300.0, 0.5, 0)
    sp.set_from_pointer(40.0)
    nvcheck_f(acc, "split.clamp", sp.ratio, 0.2, 0.001)
    pa = sp.pane_a()
    nvcheck_f(acc, "split.pane", pa.w, 400.0 * 0.2, 0.001)
    # ProgressBar
    pr = make_native_progress(0.0, 0.0, 200.0)
    pr.set_value(25.0)
    nvcheck_i(acc, "prog.pct", pr.percent(), 25)
    nvcheck_f(acc, "prog.fill", pr.fill_w(), 50.0, 0.001)
    # Slider
    sl = make_native_slider(0.0, 0.0, 200.0, 30.0)
    sl.set_from_pointer(100.0)
    nvcheck_f(acc, "slider.val", sl.value, 50.0, 0.001)
    k = sl.knob_xy()
    nvcheck_f(acc, "slider.knob", k.x, 100.0, 0.001)
    # SpinBox
    nx = make_native_spinbox(0.0, 0.0, 100.0, 5)
    nx.step_up()
    nvcheck_i(acc, "spin.up", nx.value, 6)
    nx.step_down()
    nx.step_down()
    nvcheck_i(acc, "spin.down", nx.value, 4)
    nvcheck_i(acc, "spin.hitup", nx.hit_button(95.0, 5.0), 1)
    nvcheck_i(acc, "spin.hitdn", nx.hit_button(95.0, 16.0), 0)
    # ListView
    lv = make_native_listview(0.0, 0.0, 200.0, 200.0, 100)
    nvcheck_i(acc, "list.hit", lv.hit_item(50.0), 2)
    nvcheck_i(acc, "list.sel", lv.select(7), 7)
    lv.ensure_visible(90)
    big = 0
    if lv.scroll > 100.0:
        big = 1
    nvcheck(acc, "list.ensure", big)
    # ToolTip
    tt = make_native_tooltip()
    tt.show_at(50.0, 50.0, "Hint")
    nvcheck_i(acc, "tip.visible", tt.visible, 1)
    tt.step(5.0)
    nvcheck_i(acc, "tip.timeout", tt.visible, 0)
    # Calendar: Gregorian math + selection + hit
    cal = make_native_calendar(0.0, 0.0, 210.0, 200.0, 2026, 9)
    nvcheck_i(acc, "cal.dim.leap", cal.days_in_month(2024, 2), 29)
    nvcheck_i(acc, "cal.dim.1900", cal.days_in_month(1900, 2), 28)
    nvcheck_i(acc, "cal.dim.sep", cal.days_in_month(2026, 9), 30)
    nvcheck_i(acc, "cal.dow.sep26", cal.first_weekday(2026, 9), 2)
    nvcheck_i(acc, "cal.dow.jan26", cal.first_weekday(2026, 1), 4)
    nvcheck_i(acc, "cal.sel.bad", cal.select(2026, 2, 30), 0)
    nvcheck_i(acc, "cal.sel.badm", cal.select(2026, 13, 1), 0)
    nvcheck_i(acc, "cal.sel.ok", cal.select(2026, 9, 15), 1)
    nvcheck_i(acc, "cal.rows", cal.grid_rows(), 5)
    nvcheck_i(acc, "cal.hit.15", cal.hit_day(75.0, 116.4), 15)
    nvcheck_i(acc, "cal.hit.pad", cal.hit_day(5.0, 40.0), -1)
    nvcheck_i(acc, "cal.hit.out", cal.hit_day(500.0, 500.0), -1)
    cal2 = make_native_calendar(0.0, 0.0, 210.0, 200.0, 2023, 1)
    cal2.select(2023, 1, 31)
    nvcheck_i(acc, "cal.next", cal2.next_month(), 2)
    nvcheck_i(acc, "cal.next.clamp", cal2.day, 28)
    nvcheck_i(acc, "cal.prev", cal2.prev_month(), 1)
    nvcheck_i(acc, "cal.prev.year", cal2.year, 2023)
    # ColorPicker: HSV corners + clamp + hit + hex
    cpk = make_native_colorpicker(0.0, 0.0, 200.0, 200.0)
    cpk.set_hsv(0, 100, 100)
    crd = cpk.rgb()
    nvcheck_i(acc, "cpk.red.r", crd.r, 255)
    nvcheck_i(acc, "cpk.red.g", crd.g, 0)
    cpk.set_hsv(120, 100, 100)
    cgr = cpk.rgb()
    nvcheck_i(acc, "cpk.green.g", cgr.g, 255)
    cpk.set_hsv(240, 100, 100)
    cbl = cpk.rgb()
    nvcheck_i(acc, "cpk.blue.b", cbl.b, 255)
    cpk.set_hsv(0, 0, 100)
    nvcheck(acc, "cpk.white", cpk.hex() == "#FFFFFF")
    cpk.set_hsv(0, 0, 0)
    nvcheck(acc, "cpk.black", cpk.hex() == "#000000")
    cpk.set_hsv(0, 100, 100)
    nvcheck(acc, "cpk.hex.red", cpk.hex() == "#FF0000")
    cpk.set_hsv(400, 150, -5)
    nvcheck_i(acc, "cpk.clamp.h", cpk.h, 359)
    nvcheck_i(acc, "cpk.clamp.s", cpk.s, 100)
    nvcheck_i(acc, "cpk.clamp.v", cpk.v, 0)
    nvcheck_i(acc, "cpk.hit.hue0", cpk.hit_hue(0.0), 0)
    nvcheck_i(acc, "cpk.hit.hueout", cpk.hit_hue(500.0), -1)
    nvcheck_i(acc, "cpk.pick", cpk.pick_sv(10.0, 10.0), 1)
    nvcheck_i(acc, "cpk.pick.out", cpk.pick_sv(500.0, 500.0), -1)
    # StatusBar: panels + hit
    sbr = NativeStatusBar(0.0, 0.0, 300.0, 22.0, 3, 1)
    nvcheck_i(acc, "sb.panels", sbr.n_panels, 3)
    nvcheck_i(acc, "sb.hit.0", sbr.panel_at(10.0), 0)
    nvcheck_i(acc, "sb.hit.2", sbr.panel_at(250.0), 2)
    nvcheck_i(acc, "sb.hit.out", sbr.panel_at(500.0), -1)
    # render smoke (no crash + tra 1)
    rbuf = nv_alloc_buf(100)
    rsurf = PixelSurface(10, 10, 10)
    tlabels = []
    tlabels.append("Ax")
    tlabels.append("Bx")
    tabx = make_native_tabs(0.0, 0.0, 200.0, 2)
    nvcheck_i(acc, "tab.render", tabx.render(rbuf, rsurf, 0, tlabels, 2), 1)
    nvcheck_i(acc, "cal.render", cal.render(rbuf, rsurf, 0), 1)
    nvcheck_i(acc, "cpk.render", cpk.render(rbuf, rsurf, 0), 1)
    sbpan = []
    sbpan.append("Ready")
    sbpan.append("Ln 1")
    sbpan.append("UTF-8")
    nvcheck_i(acc, "sb.render", sbr.render(rbuf, rsurf, 0, sbpan, 3), 1)
    # Wizard: multi-step flow
    wz = make_native_wizard(0.0, 0.0, 300.0, 200.0, 3)
    nvcheck_i(acc, "wiz.page", wz.page, 0)
    nvcheck_i(acc, "wiz.first", wz.is_first(), 1)
    nvcheck_i(acc, "wiz.next", wz.next_page(), 1)
    nvcheck_i(acc, "wiz.next2", wz.next_page(), 2)
    nvcheck_i(acc, "wiz.clamp", wz.next_page(), 2)
    nvcheck_i(acc, "wiz.last", wz.is_last(), 1)
    nvcheck_i(acc, "wiz.nofinish", wz.finished(), 0)
    wz.can_finish = 1
    nvcheck_i(acc, "wiz.finish", wz.finished(), 1)
    nvcheck_i(acc, "wiz.prev", wz.prev_page(), 1)
    nvcheck_i(acc, "wiz.goto", wz.goto_page(0), 0)
    nvcheck_i(acc, "wiz.goto.neg", wz.goto_page(-5), 0)
    wtitles = []
    wtitles.append("Welcome")
    wtitles.append("Options")
    wtitles.append("Done")
    nvcheck_i(acc, "wiz.render", wz.render(rbuf, rsurf, 0, wtitles, 3), 1)
    # FontPicker (M2.4 link): family/size/style + preview
    fp = make_native_fontpicker(0.0, 0.0, 200.0, 150.0)
    fams = []
    fams.append("Arial")
    fams.append("Consolas")
    fams.append("Segoe UI")
    nvcheck_i(acc, "fp.sel", fp.select(2, 3), 2)
    nvcheck_i(acc, "fp.sel.clamp", fp.select(9, 3), 2)
    nvcheck_i(acc, "fp.size", fp.set_size(16), 16)
    nvcheck_i(acc, "fp.size.min", fp.set_size(2), 6)
    fp.set_size(16)
    nvcheck_i(acc, "fp.bold", fp.toggle_bold(), 1)
    nvcheck_i(acc, "fp.italic", fp.toggle_italic(), 1)
    ok_fam = 0
    if fp.family(fams) == "Segoe UI":
        ok_fam = 1
    nvcheck_i(acc, "fp.family", ok_fam, 1)
    ok_spec = 0
    if fp.spec(fams) == "Segoe UI-16-B-I":
        ok_spec = 1
    nvcheck_i(acc, "fp.spec", ok_spec, 1)
    fp.toggle_bold()
    ok_spec2 = 0
    if fp.spec(fams) == "Segoe UI-16-I":
        ok_spec2 = 1
    nvcheck_i(acc, "fp.spec2", ok_spec2, 1)
    nvcheck_i(acc, "fp.render", fp.render(rbuf, rsurf, 0, fams, 3), 1)
    # RichEdit lite: multiline caret/edit/render
    re_ = make_native_richedit(0.0, 0.0, 200.0, 100.0)
    rlines = []
    rlines.append("Hello")
    rlines.append("World")
    nvcheck_i(acc, "re.lines", re_.line_count(rlines), 2)
    nvcheck_i(acc, "re.right", re_.move_right(rlines), 1)
    nvcheck_i(acc, "re.cx", re_.cx, 1)
    nvcheck_i(acc, "re.insert", re_.insert(rlines, "i"), 1)
    ok_ins = 0
    if rlines[0] == "Hiello":
        ok_ins = 1
    nvcheck_i(acc, "re.ins.val", ok_ins, 1)
    nvcheck_i(acc, "re.bs", re_.backspace(rlines), 1)
    ok_bs = 0
    if rlines[0] == "Hello":
        ok_bs = 1
    nvcheck_i(acc, "re.bs.val", ok_bs, 1)
    nvcheck_i(acc, "re.down", re_.move_down(rlines), 1)
    nvcheck_i(acc, "re.cy", re_.cy, 1)
    nvcheck_i(acc, "re.up", re_.move_up(rlines), 1)
    nvcheck_i(acc, "re.nl", re_.newline(rlines), 1)
    nvcheck_i(acc, "re.nl.count", re_.line_count(rlines), 3)
    nvcheck_i(acc, "re.render", re_.render(rbuf, rsurf, 0, rlines), 1)
    # TreeCombo: combo field + tree popup + path
    tc = make_native_treecombo(0.0, 0.0, 200.0)
    tcl = []
    tcl.append("root")
    tcl.append("child")
    tcl.append("leaf")
    tcd = [int(0), int(1), int(2)]
    tck = [int(1), int(1), int(0)]
    tcf = [int(1), int(0), int(0)]
    nvcheck_i(acc, "tc.open", tc.toggle_open(), 1)
    nvcheck_i(acc, "tc.choose", tc.choose(2, 3), 2)
    nvcheck_i(acc, "tc.closed", tc.open, 0)
    nvcheck_i(acc, "tc.choose.bad", tc.choose(9, 3), 2)
    nvcheck_i(acc, "tc.hit", tc.hit_item(42.0, 3), 1)
    nvcheck_i(acc, "tc.hit.out", tc.hit_item(500.0, 3), -1)
    nvcheck_i(acc, "tc.toggle", tc.toggle_node(tcf, 0), 0)
    ok_path = 0
    if treecombo_path(tcl, tcd, 2) == "root/child/leaf":
        ok_path = 1
    nvcheck_i(acc, "tc.path", ok_path, 1)
    ok_path0 = 0
    if treecombo_path(tcl, tcd, 0) == "root":
        ok_path0 = 1
    nvcheck_i(acc, "tc.path.root", ok_path0, 1)
    ok_pathbad = 0
    if treecombo_path(tcl, tcd, 9) == "":
        ok_pathbad = 1
    nvcheck_i(acc, "tc.path.bad", ok_pathbad, 1)
    tc.toggle_open()
    nvcheck_i(acc, "tc.render", tc.render(rbuf, rsurf, 0, tcl, tcd, tck, tcf, 3), 1)
    # DockPanel: 4-side layout + gutters
    dk = make_native_dock(0.0, 0.0, 400.0, 300.0)
    dkl = dk.left_rect()
    nvcheck_f(acc, "dock.left", dkl.x, 0.0, 0.001)
    dkc = dk.central_rect()
    nvcheck_f(acc, "dock.central.x", dkc.x, 120.0, 0.001)
    nvcheck_f(acc, "dock.central.w", dkc.w, 160.0, 0.001)
    nvcheck_f(acc, "dock.set", dk.set_left(200.0), 200.0, 0.001)
    nvcheck_f(acc, "dock.set.neg", dk.set_top(-5.0), 0.0, 0.001)
    nvcheck_i(acc, "dock.gutterL", dk.hit_gutter(203.0, 150.0), 1)
    nvcheck_i(acc, "dock.gutter.none", dk.hit_gutter(300.0, 150.0), 0)
    nvcheck_i(acc, "dock.gutter.out", dk.hit_gutter(500.0, 500.0), 0)
    dlabs = []
    dlabs.append("L")
    dlabs.append("R")
    dlabs.append("T")
    dlabs.append("B")
    nvcheck_i(acc, "dock.render", dk.render(rbuf, rsurf, 0, dlabs), 1)
    # MdiArea: child windows + cascade/tile/hit
    mdi = make_native_mdi(0.0, 0.0, 400.0, 300.0)
    mt = []
    mx = []
    my = []
    mw = []
    mh = []
    mm = []
    nvcheck_i(acc, "mdi.add0", mdi.add_child(mt, mx, my, mw, mh, mm, "Doc1", 200.0, 150.0), 0)
    nvcheck_i(acc, "mdi.add1", mdi.add_child(mt, mx, my, mw, mh, mm, "Doc2", 200.0, 150.0), 1)
    nvcheck_i(acc, "mdi.active", mdi.active, 1)
    nvcheck_i(acc, "mdi.activate", mdi.activate(0, 2), 0)
    nvcheck_i(acc, "mdi.activate.bad", mdi.activate(9, 2), 0)
    nvcheck_i(acc, "mdi.min", mdi.minimize(mm, 1), 1)
    nvcheck_i(acc, "mdi.min.off", mdi.minimize(mm, 1), 0)
    mdi.cascade(mx, my, 2)
    nvcheck_f(acc, "mdi.cascade.x", mx[1], 44.0, 0.001)
    mdi.tile_vertical(mx, mw, 2)
    nvcheck_f(acc, "mdi.tile.x", mx[1], 200.0, 0.001)
    nvcheck_f(acc, "mdi.tile.w", mw[0], 200.0, 0.001)
    nvcheck_i(acc, "mdi.hit", mdi.hit_child(mt, mx, my, mw, mh, mm, 50.0, 60.0), 0)
    nvcheck_i(acc, "mdi.hit.out", mdi.hit_child(mt, mx, my, mw, mh, mm, 390.0, 290.0), -1)
    nvcheck_i(acc, "mdi.render", mdi.render(rbuf, rsurf, 0, mt, mx, my, mw, mh, mm), 1)
    nvcheck_i(acc, "mdi.close", mdi.close_child(mt, mx, my, mw, mh, mm, 0), 1)
    nvcheck_i(acc, "mdi.count", mdi.count(mt), 1)
    nvcheck_i(acc, "mdi.close.bad", mdi.close_child(mt, mx, my, mw, mh, mm, 9), 0)
    # SysTray: validation + struct (live add/delete chi khi TKVUI_LIVE_TRAY=1)
    sy = make_native_systray(7, 0)
    nvcheck_i(acc, "tray.nohwnd", sy.show(0, "hi"), 0)
    nvcheck_i(acc, "tray.noadd.upd", sy.update_tip("hi"), 0)
    nvcheck_i(acc, "tray.noadd.del", sy.remove(), 0)
    nidm = tray_build_nid(7, 0, 0, "Tip")
    ok_nid = 0
    if nidm != 0:
        ok_nid = 1
    nvcheck(acc, "tray.nid", ok_nid)
    if nidm != 0:
        nvcheck_i(acc, "tray.nid.size", mem_read_u32(nidm), 168)
        mem_free(nidm)
    sp2 = tray_present()
    ok_sp2 = 0
    if sp2 == 0 or sp2 == 1:
        ok_sp2 = 1
    nvcheck(acc, "tray.present", ok_sp2)
    live = tkv_getenv("TKVUI_LIVE_TRAY") + ""
    if live == "1":
        if detect_platform() == 1:
            wh = win_create_window_ex(524416, "STATIC", "tkvui_tray", 0 - 1879048192, 0, 0, 8, 8, 0, 0, 0, 0)
            ok_wh = 0
            if wh != 0:
                ok_wh = 1
            nvcheck(acc, "tray.live.win", ok_wh)
            if wh != 0:
                ic = tray_default_icon()
                ok_ic = 0
                if ic != 0:
                    ok_ic = 1
                nvcheck(acc, "tray.live.icon", ok_ic)
                sy2 = make_native_systray(77, wh)
                nvcheck_i(acc, "tray.live.add", sy2.show(ic, "tkvui"), 1)
                nvcheck_i(acc, "tray.live.upd", sy2.update_tip("tkvui2"), 1)
                nvcheck_i(acc, "tray.live.del", sy2.remove(), 1)
                drc = win_destroy_window(wh)
                ok_dw = 0
                if drc == 0 or drc == 1:
                    ok_dw = 1
                nvcheck(acc, "tray.live.destroy", ok_dw)
    else:
        nvcheck(acc, "tray.live.skip", 1)
    print("native: " + str(acc[0]) + "/" + str(acc[1]))
    if acc[0] == acc[1]:
        return "NATIVE_OK"
    return "NATIVE_FAIL"
