# =========================================================
# TASK 5: PLATFORM - Abstraction & Native Window (P3: Win32 real)
# =========================================================
WS_EX_LAYERED = 524288
WS_EX_TOPMOST = 8
WS_EX_TOOLWINDOW = 128
TKV_EX_STYLE = 524424
TKV_EX_STYLE_NOTOP = 524416
SW_SHOW = 5
SW_HIDE = 0
ULW_OPAQUE = 4
LWA_COLORKEY = 1
LWA_ALPHA = 2
LWA_BOTH = 3
QS_ALLINPUT = 1279
TKV_COLORKEY = 16711935
TKV_DEFAULT_ALPHA = 255

# IME constants (Win32)
GCS_COMPSTR = 8
GCS_RESULTSTR = 8192
NI_COMPOSITIONSTR = 15
NI_OPENCANDIDATE = 16
NI_CLOSECANDIDATE = 17
IMN_SETCONVERSIONMODE = 1
IMN_SETOPENSTATUS = 2

def tkv_has_env(name: "str") -> "i32":
    # tkv_getenv tra null khi bien khong ton tai -> noi chuoi de null-safe truoc khi len()
    v = tkv_getenv(name) + "|"
    if len(v) > 1:
        return 1
    return 0

def tkv_has_file(path: "str") -> "i32":
    if tkv_file_exists(path) == True:
        return 1
    return 0

# IME helpers (Win32)
def ime_get_context(hwnd: "i64") -> "i64":
    return imm_get_context(hwnd)

def ime_release_context(hwnd: "i64", hIMC: "i64") -> "i32":
    return imm_release_context(hwnd, hIMC)

def ime_get_composition_string(hIMC: "i64", buf: "list[i64]", max_len: "i32") -> "i32":
    # GCS_RESULTSTR = 8192 lay chuoi ket qua
    return imm_get_composition_string_w(hIMC, 8192, buf[0], max_len)

def ime_set_composition_string(hIMC: "i64", text: "str") -> "i32":
    # Can tao buffer chua text UTF-16
    return 0

def ime_notify_ime(hIMC: "i32", action: "i32", index: "i32", value: "i32") -> "i32":
    return imm_notify_ime(hIMC, action, index, value)

def detect_platform_id() -> "str":
    # Ten backend theo ma platform (chi de hien thi/log)
    pid = detect_platform()
    if pid == 1:
        return "win32"
    if pid == 2:
        return "x11"
    if pid == 3:
        return "wayland"
    if pid == 4:
        return "cocoa"
    if pid == 5:
        return "android"
    if pid == 6:
        return "ios"
    return "unknown"

def detect_platform() -> "i32":
    # 1=Win32, 2=X11, 3=Wayland, 4=Cocoa/macOS, 5=Android, 6=iOS
    # P1.1: do that bang probe runtime (env + file probe qua mscorlib), khong doan hang so.
    # Dat bien moi truong TKVUI_PLATFORM=1..6 de ep backend khi test.
    if tkv_has_env("TKVUI_PLATFORM") == 1:
        v = tkv_getenv("TKVUI_PLATFORM") + ""
        if len(v) == 1:
            if v == "1":
                return 1
            if v == "2":
                return 2
            if v == "3":
                return 3
            if v == "4":
                return 4
            if v == "5":
                return 5
            if v == "6":
                return 6
    if tkv_has_env("ANDROID_ROOT") == 1:
        return 5
    if tkv_has_env("ANDROID_DATA") == 1:
        return 5
    if tkv_has_file("/system/build.prop") == 1:
        return 5
    if tkv_has_file("/var/mobile") == 1:
        return 6
    if tkv_has_file("/System/Library/CoreServices") == 1:
        return 4
    if tkv_has_env("WAYLAND_DISPLAY") == 1:
        return 3
    if tkv_has_env("DISPLAY") == 1:
        return 2
    if tkv_has_env("windir") == 1:
        return 1
    # Fallback: Win32 la backend duy nhat day du (xem docs/TkvUI.Roadmap.md §8)
    return 1

def win_last_error() -> "i32":
    return win_get_last_error()

def win_write_u32_le(mem: "i64", off: "i64", val: "i32") -> "i32":
    return win_wsprintf(mem + off, "%c%c%c%c", val % 256, (val // 256) % 256, (val // 65536) % 256, (val // 16777216) % 256)

def win_build_dib_info(w: "i32", h: "i32") -> "i64":
    mem = win_virtual_alloc(0, 64, 12288, 4)
    if mem == 0:
        return 0
    rc = win_wsprintf(mem, "%c%c%c%c", 40, 0, 0, 0)
    rc = win_wsprintf(mem + 4, "%c%c%c%c", w % 256, (w // 256) % 256, (w // 65536) % 256, (w // 16777216) % 256)
    t = 16777216 - h
    rc = win_wsprintf(mem + 8, "%c%c%c%c", t % 256, (t // 256) % 256, (t // 65536) % 256, 255)
    rc = win_wsprintf(mem + 12, "%c%c", 1, 0, 0, 0)
    rc = win_wsprintf(mem + 14, "%c%c", 32, 0, 0, 0)
    return mem

class PlatformWindowHandle:
    handle: "i64"
    x: "i32"
    y: "i32"
    w: "i32"
    h: "i32"
    topmost: "i32"
    memdc: "i64"
    hbmp: "i64"
    oldbmp: "i64"
    screendc: "i64"
    alpha: "i32"
    colorkey: "i32"
    structmem: "i64"
    fmap: "i64"
    mapview: "i64"
    def __init__(self, handle, x, y, w, h, topmost, memdc, hbmp, oldbmp, screendc, alpha, colorkey, structmem, fmap, mapview):
        self.handle = handle
        self.x = x
        self.y = y
        self.w = w
        self.h = h
        self.topmost = topmost
        self.memdc = memdc
        self.hbmp = hbmp
        self.oldbmp = oldbmp
        self.screendc = screendc
        self.alpha = alpha
        self.colorkey = colorkey
        self.structmem = structmem
        self.fmap = fmap
        self.mapview = mapview

class Win32Platform:
    dummy: "i32"
    def __init__(self, dummy):
        self.dummy = dummy
    def create(self, x: "i32", y: "i32", w: "i32", h: "i32", topmost: "i32") -> "PlatformWindowHandle":
        ex = 524424
        if topmost == 0:
            ex = 524416
        style = 0 - 1879048192
        hwnd = win_create_window_ex(ex, "Static", "TkvUI", style, x, y, w, h, 0, 0, 0, 0)
        if hwnd == 0:
            return PlatformWindowHandle(0, x, y, w, h, topmost, 0, 0, 0, 0, 255, 16711935, 0, 0, 0)
        sdc = win_get_dc(0)
        mdc = gdi_create_compat_dc(sdc)
        # P2.4 (v2.3.0): DIB section backed boi file-mapping -> co con tro bo nho
        # truc tiep, present ghi pixel qua wsprintfA thay vi SetPixelV (nhanh ~30x).
        mapsize = w * h * 4 + 65536
        fmap = win_create_file_mapping(0 - 1, 0, 4, 0, mapsize, "")
        mapview = 0
        if fmap != 0:
            mapview = win_map_view(fmap, 6, 0, 0, mapsize)
        info = win_build_dib_info(w, h)
        hb = 0
        if info != 0:
            hb = gdi_create_dib_section(sdc, info, 0, info + 48, fmap, 0)
            fr = win_virtual_free(info, 0, 32768)
        if hb == 0:
            hb = gdi_create_bitmap(w, h, 1, 32, 0)
        old = gdi_select_object(mdc, hb)
        sm = win_virtual_alloc(0, 64, 12288, 4)
        rc = win_show_window(hwnd, 5)
        wh = PlatformWindowHandle(hwnd, x, y, w, h, topmost, mdc, hb, old, sdc, 255, 16711935, sm, fmap, mapview)
        return wh
    def present(self, buf: "list[i64]", surf: "PixelSurface", wh: "PlatformWindowHandle") -> "i32":
        if wh.handle == 0:
            return 0
        if wh.memdc == 0:
            return 0
        drawn = int(0)
        if wh.mapview != 0:
            # P2.4: ghi truc tiep vao DIB bits (mapping) - 1 lenh wsprintfA/pixel.
            mv = wh.mapview
            for y in range(surf.height):
                row = y * surf.stride
                dst = mv + y * wh.w * 4
                for x in range(surf.width):
                    pix = buf[row + x]
                    sa = pix // 16777216
                    rem = pix % 16777216
                    sr = rem // 65536
                    rem2 = rem % 65536
                    sg = rem2 // 256
                    sb = rem2 % 256
                    if sa < 128:
                        rc = win_wsprintf(dst + x * 4, "%c%c%c%c", wh.colorkey % 256, (wh.colorkey // 256) % 256, (wh.colorkey // 65536) % 256, 0)
                    else:
                        rc = win_wsprintf(dst + x * 4, "%c%c%c%c", sr, sg, sb, 0)
                        drawn = drawn + 1
        else:
            for y in range(surf.height):
                for x in range(surf.width):
                    idx = y * surf.stride + x
                    pix = buf[idx]
                    sa = pix // 16777216
                    rem = pix % 16777216
                    sr = rem // 65536
                    rem2 = rem % 65536
                    sg = rem2 // 256
                    sb = rem2 % 256
                    if sa < 128:
                        rc = gdi_set_pixel_v(wh.memdc, x, y, wh.colorkey)
                    else:
                        rgb = int(sr + sg * 256 + sb * 65536)
                        rc = gdi_set_pixel_v(wh.memdc, x, y, rgb)
                        drawn = drawn + 1
        sm = wh.structmem
        rc = win_write_u32_le(sm, 0, wh.alpha * 65536)
        rc = win_write_u32_le(sm, 8, wh.x)
        rc = win_write_u32_le(sm, 12, wh.y)
        rc = win_write_u32_le(sm, 16, wh.w)
        rc = win_write_u32_le(sm, 20, wh.h)
        rc = win_write_u32_le(sm, 24, 0)
        rc = win_write_u32_le(sm, 28, 0)
        ok = win_update_layered(wh.handle, 0, sm + 8, sm + 16, wh.memdc, sm + 24, wh.colorkey, sm, 3)
        if ok == 0:
            return 0 - 1
        return drawn
    def present_diff(self, buf: "list[i64]", prev: "list[i64]", surf: "PixelSurface", wh: "PlatformWindowHandle") -> "i32":
        if wh.handle == 0:
            return 0
        if wh.memdc == 0:
            return 0
        n = surf.width * surf.height
        if len(prev) < n:
            return 0 - 2
        drawn = int(0)
        if wh.mapview != 0:
            # P2.4: diff theo pixel, ghi chi pixel doi (wsprintfA truc tiep).
            mv = wh.mapview
            for i in range(n):
                if buf[i] != prev[i]:
                    y = i // surf.stride
                    x = i - y * surf.stride
                    pix = buf[i]
                    sa = pix // 16777216
                    rem = pix % 16777216
                    sr = rem // 65536
                    rem2 = rem % 65536
                    sg = rem2 // 256
                    sb = rem2 % 256
                    dst = mv + (y * wh.w + x) * 4
                    if sa < 128:
                        rc = win_wsprintf(dst, "%c%c%c%c", wh.colorkey % 256, (wh.colorkey // 256) % 256, (wh.colorkey // 65536) % 256, 0)
                    else:
                        rc = win_wsprintf(dst, "%c%c%c%c", sr, sg, sb, 0)
                    drawn = drawn + 1
        else:
            for i in range(n):
                if buf[i] != prev[i]:
                    y = i // surf.stride
                    x = i - y * surf.stride
                    pix = buf[i]
                    sa = pix // 16777216
                    rem = pix % 16777216
                    sr = rem // 65536
                    rem2 = rem % 65536
                    sg = rem2 // 256
                    sb = rem2 % 256
                    if sa < 128:
                        rc = gdi_set_pixel_v(wh.memdc, x, y, wh.colorkey)
                    else:
                        rgb = int(sr + sg * 256 + sb * 65536)
                        rc = gdi_set_pixel_v(wh.memdc, x, y, rgb)
                    drawn = drawn + 1
        if drawn == 0:
            return 0
        sm = wh.structmem
        rc = win_write_u32_le(sm, 0, wh.alpha * 65536)
        rc = win_write_u32_le(sm, 8, wh.x)
        rc = win_write_u32_le(sm, 12, wh.y)
        rc = win_write_u32_le(sm, 16, wh.w)
        rc = win_write_u32_le(sm, 20, wh.h)
        rc = win_write_u32_le(sm, 24, 0)
        rc = win_write_u32_le(sm, 28, 0)
        ok = win_update_layered(wh.handle, 0, sm + 8, sm + 16, wh.memdc, sm + 24, wh.colorkey, sm, 3)
        if ok == 0:
            return 0 - 1
        return drawn
    def set_pos(self, wh: "PlatformWindowHandle", x: "i32", y: "i32", w: "i32", h: "i32") -> "i32":
        res = win_set_window_pos(wh.handle, 0, x, y, w, h, 68)
        wh.x = x
        wh.y = y
        wh.w = w
        wh.h = h
        return res
    def set_alpha(self, wh: "PlatformWindowHandle", alpha: "i32") -> "i32":
        a = alpha
        if a < 0:
            a = 0
        if a > 255:
            a = 255
        wh.alpha = a
        sm = wh.structmem
        rc = win_write_u32_le(sm, 0, a * 65536)
        rc = win_write_u32_le(sm, 8, wh.x)
        rc = win_write_u32_le(sm, 12, wh.y)
        rc = win_write_u32_le(sm, 16, wh.w)
        rc = win_write_u32_le(sm, 20, wh.h)
        rc = win_write_u32_le(sm, 24, 0)
        rc = win_write_u32_le(sm, 28, 0)
        return win_update_layered(wh.handle, 0, sm + 8, sm + 16, wh.memdc, sm + 24, wh.colorkey, sm, 3)
    def set_title(self, wh: "PlatformWindowHandle", title: "str") -> "i32":
        return win_set_window_text(wh.handle, title)
    def show_window(self, wh: "PlatformWindowHandle", cmd: "i32") -> "i32":
        return win_show_window(wh.handle, cmd)
    def close_window(self, wh: "PlatformWindowHandle") -> "i32":
        if wh.memdc != 0:
            rc64 = gdi_select_object(wh.memdc, wh.oldbmp)
        if wh.hbmp != 0:
            rc = gdi_delete_object(wh.hbmp)
        if wh.memdc != 0:
            rc = gdi_delete_dc(wh.memdc)
        if wh.screendc != 0:
            rc = win_release_dc(0, wh.screendc)
        if wh.handle != 0:
            rc = win_destroy_window(wh.handle)
        if wh.structmem != 0:
            rc = win_virtual_free(wh.structmem, 0, 32768)
        if wh.mapview != 0:
            rc = win_unmap_view(wh.mapview)
        if wh.fmap != 0:
            rc = win_close_handle(wh.fmap)
        wh.handle = wh.handle - wh.handle
        wh.memdc = wh.memdc - wh.memdc
        wh.hbmp = wh.hbmp - wh.hbmp
        wh.screendc = wh.screendc - wh.screendc
        wh.structmem = wh.structmem - wh.structmem
        wh.fmap = wh.fmap - wh.fmap
        wh.mapview = wh.mapview - wh.mapview
        return 1
    def poll_events(self) -> "i32":
        return win_get_queue_status(1279)
    def backend_name(self) -> "str":
        return "win32"

