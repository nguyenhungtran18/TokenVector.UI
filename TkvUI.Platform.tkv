# ---- P7.6: input poll that (GetMessagePos = toa do man hinh lan cuoi) ----
# Luu y da spike: returns pinvoke chi nhan void/bool/f32/f64/i32/i64/... (KHONG
# co i16); float() tren gia tri i32 tra tu pinvoke DUNG (khac quirk float(TkvInt)).
# Gioi han: toa do AM (man hinh thu 2 ben trai) chua ho tro (LOWORD khong xu dau).
def win_poll_messages() -> "i32":
    # Drain het queue; CHI dem mouse (0x0200..0x020A = 512..522) + keyboard
    # (0x0100..0x0108 = 256..264) lam "co input". Con lai drain IM LANG - neu
    # khong thi input gia mai mai (bug da gap: WM_INPUT = 0x00FF tu chuot vat ly
    # repost ~2 msg/frame -> pump>0 lien tuc -> render moi vong -> khong idle).
    # WM_PAINT (15) khong BAO GIO drain: ta khong DispatchMessage nen update
    # region khong duoc validate -> Windows repost WM_PAINT vo han.
    #   dai loai: A=0..14, B=16..255, C=265..511, D=523..32767
    m = win_virtual_alloc(0, 64, 12288, 4)
    if m == 0:
        return 0 - 1
    n = int(0)
    more = int(1)
    guard = int(0)
    have = int(0)
    while more == 1:
        if guard >= 2000:
            more = 0
        have = u_peek(m, 0, 512, 522, 1)
        if have != 0:
            n = n + 1
        else:
            have = u_peek(m, 0, 256, 264, 1)
            if have != 0:
                n = n + 1
            else:
                have = u_peek(m, 0, 0, 14, 1)
                if have == 0:
                    have = u_peek(m, 0, 16, 255, 1)
                if have == 0:
                    have = u_peek(m, 0, 265, 511, 1)
                if have == 0:
                    have = u_peek(m, 0, 523, 32767, 1)
                if have == 0:
                    more = 0
        guard = guard + 1
    rcf = win_virtual_free(m, 0, 32768)
    return n

def win_pointer_x() -> "i32":
    lp = u_getpos()
    return lp % 65536

def win_pointer_y() -> "i32":
    lp = u_getpos()
    return (lp // 65536) % 65536

def win_key_down(vk: "i32") -> "i32":
    k = u_gks(vk)
    if k == 0:
        return 0
    return 1

# ---- P8.3: per-monitor DPI (GetDpiForWindow + fallback DeviceCaps) ----
# GetDpiForWindow chi co tu Win10 1607: kiem tra export qua GetProcAddress
# truoc khi goi (goi thang khi thieu export = crash EntryPointNotFound).
def win_has_dpi_api() -> "i32":
    h = win_get_module("user32.dll")
    if h == 0:
        return 0
    p = win_get_proc(h, "GetDpiForWindow")
    if p == 0:
        return 0
    return 1

def win_dpi_for_window(hwnd: "i64") -> "i32":
    if hwnd == 0:
        return 0
    if win_has_dpi_api() == 0:
        return 0
    d = win_get_dpi_win(hwnd)
    if d < 96:
        d = 96
    if d > 384:
        d = 384
    return d

def win_system_dpi() -> "i32":
    # Fallback moi Windows: LOGPIXELSX (88) tren screen DC
    dc = win_get_dc(0)
    if dc == 0:
        return 96
    d = gdi_get_device_caps(dc, 88)
    rc = win_release_dc(0, dc)
    if d < 96:
        d = 96
    if d > 384:
        d = 384
    return d

def win_dpi_scale(dpi: "i32") -> "f64":
    if dpi <= 0:
        return 1.0
    return float(dpi) / 96.0

def win_window_dpi_scale(hwnd: "i64") -> "f64":
    d = win_dpi_for_window(hwnd)
    if d == 0:
        d = win_system_dpi()
    return win_dpi_scale(d)

def win_dpi_changed() -> "i32":
    # Peek (KHONG remove) WM_DPICHANGED = 736. Goi TRUOC win_poll_messages
    # (pump drain dai 523..32767 se an mat msg nay).
    m = win_virtual_alloc(0, 64, 12288, 4)
    if m == 0:
        return 0
    have = u_peek(m, 0, 736, 736, 0)
    rcf = win_virtual_free(m, 0, 32768)
    if have == 0:
        return 0
    return 1

def win_dpi_ack() -> "i32":
    # Xoa WM_DPICHANGED khoi queue sau khi da ap dung scale moi
    m = win_virtual_alloc(0, 64, 12288, 4)
    if m == 0:
        return 0
    have = u_peek(m, 0, 736, 736, 1)
    rcf = win_virtual_free(m, 0, 32768)
    if have == 0:
        return 0
    return 1

# ---- P8.5: RTL locale detect (LCID, khong out-buffer) ----
# GetUserDefaultLocaleName can buffer ghi -> blocked; GetUserDefaultLCID tra
# i32 truc tiep. Primary lang = LCID % 1024 (khong bitwise).
def win_user_lang() -> "i32":
    lcid = win_get_user_lcid()
    return lcid - (lcid // 1024) * 1024

def win_is_rtl_lang(lang: "i32") -> "i32":
    # Arabic=1 Hebrew=13 Urdu=32 Persian=41 Yiddish=61 Divehi=101
    if lang == 1:
        return 1
    if lang == 13:
        return 1
    if lang == 32:
        return 1
    if lang == 41:
        return 1
    if lang == 61:
        return 1
    if lang == 101:
        return 1
    return 0

def win_is_rtl() -> "i32":
    return win_is_rtl_lang(win_user_lang())

