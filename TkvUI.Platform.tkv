def ios_objc_msg_send_pp(receiver: "i64", selector: "i64", arg1: "i64", arg2: "i64") -> "i64":
    return objc_msg_send_pp(receiver, selector, arg1, arg2)

class IOSPlatform:
    dummy: "i32"
    view: "i64"
    layer: "i64"
    display_link: "i64"
    callback_target: "i64"
    callback_selector: "i64"
    frame_pending: "i32"
    width: "i32"
    height: "i32"
    scale: "f64"
    frame_buf: "i64"
    def __init__(self, dummy):
        self.dummy = dummy
        self.view = 0
        self.layer = 0
        self.display_link = 0
        self.callback_target = 0
        self.callback_selector = 0
        self.frame_pending = 0
        self.width = 0
        self.height = 0
        self.scale = 2.0
        self.frame_buf = 0
    def create(self, x: "i32", y: "i32", w: "i32", h: "i32", topmost: "i32") -> "PlatformWindowHandle":
        self.width = w
        self.height = h
        self.scale = dpi_scale_for_platform(6)
        pid = detect_platform()
        if pid != 6:
            print("iOS backend khong kha dung tren platform " + str(pid) + " (can thiet bi iOS that) - tra handle 0")
            return PlatformWindowHandle(0, x, y, w, h, topmost, 0, 0, 0, 0, 255, 16711935, 0, 0, 0)
        uiview_class = objc_get_class("UIView")
        self.view = ios_uiview_create(0.0, 0.0, float(w), float(h))
        self.layer = ios_uiview_get_layer(self.view)
        calayer_class = objc_get_class("CALayer")
        hnd = 6001
        print("iOS UIView create " + str(w) + "x" + str(h) + " scale=" + str(self.scale))
        return PlatformWindowHandle(hnd, x, y, w, h, topmost, 0, 0, 0, 0, 255, 16711935, 0, 0, 0)
    def set_frame_buffer(self, ptr: "i64") -> "i32":
        # Host (Swift/ObjC) cap buffer RGBA native; library KHONG tu cap phat native memory tren iOS
        self.frame_buf = ptr
        return 1
    def present(self, buf: "list[i64]", surf: "PixelSurface", wh: "PlatformWindowHandle") -> "i32":
        # P1.1 fix: ban cu ghi pixel vao chinh con tro CGContext (CGBitmapContextCreate voi data=NULL)
        # -> ghi de vung nho cua CGContext. Nay duong upload do host dam nhiem; neu chua co buffer
        # thi tra 0 (khong ghi vao vung nho la). Xem docs/TkvUI.Roadmap.md §8.
        if self.view == 0:
            return 0
        if self.frame_buf == 0:
            print("iOS present: can host goi set_frame_buffer(ptr) (upload RGBA do host lam)")
            return 0
        return 0
    def present_diff(self, buf: "list[i64]", prev: "list[i64]", surf: "PixelSurface", wh: "PlatformWindowHandle") -> "i32":
        return self.present(buf, surf, wh)
    def set_pos(self, wh: "PlatformWindowHandle", x: "i32", y: "i32", w: "i32", h: "i32") -> "i32":
        wh.x = x
        wh.y = y
        wh.w = w
        wh.h = h
        if w != self.width or h != self.height:
            self.width = w
            self.height = h
            if self.view != 0:
                rc = ios_uiview_set_frame(self.view, float(x), float(y), float(w), float(h))
        return 1
    def set_alpha(self, wh: "PlatformWindowHandle", alpha: "i32") -> "i32":
        wh.alpha = alpha
        if self.view != 0:
            rc = ios_objc_msg_send_f(self.view, ios_sel_register_name("setAlpha:"), float(alpha) / 255.0)
        return 1
    def set_title(self, wh: "PlatformWindowHandle", title: "str") -> "i32":
        print("iOS title: " + title)
        return 1
    def show_window(self, wh: "PlatformWindowHandle", cmd: "i32") -> "i32":
        if self.view != 0:
            rc = ios_objc_msg_send(self.view, ios_sel_register_name("setHidden:"))
        return 1
    def close_window(self, wh: "PlatformWindowHandle") -> "i32":
        if self.display_link != 0:
            rc = ios_display_link_invalidate(self.display_link)
            self.display_link = 0
        if self.view != 0:
            rc = ios_objc_msg_send(self.view, ios_sel_register_name("removeFromSuperview"))
            self.view = 0
        wh.handle = 0
        return 1
    def poll_events(self) -> "i32":
        return 0
    def post_frame_callback(self, callback: "i64", data: "i64") -> "i32":
        if self.display_link == 0:
            self.callback_target = callback
            self.callback_selector = data
            cadisplaylink_class = objc_get_class("CADisplayLink")
            self.display_link = ios_display_link_create(cadisplaylink_class, callback, data)
            if self.display_link != 0:
                nsrunloop_class = objc_get_class("NSRunLoop")
                main_runloop = ios_objc_msg_send(nsrunloop_class, ios_sel_register_name("mainRunLoop"))
                rc = ios_display_link_add_to_runloop(self.display_link, main_runloop, ios_sel_register_name("NSDefaultRunLoopMode"))
                self.frame_pending = 1
                print("iOS CADisplayLink created: " + str(self.display_link))
                return 1
        return 0
    def backend_name(self) -> "str":
        return "ios"

def make_ios_platform() -> "IOSPlatform":
    return IOSPlatform(0, 0, 0, 0, 0, 0, 0, 0, 0, 2.0, 0)

# =========================================================
# P1.1 SELFTEST - detect_platform + backend parity (headless)
# =========================================================
def platform_check(acc: "list[i32]", name: "str", ok: "i32") -> "i32":
    acc[1] = acc[1] + 1
    if ok == 1:
        acc[0] = acc[0] + 1
        print("  PASS " + name)
        return 1
    print("  FAIL " + name)
    return 0

def platform_check_i(acc: "list[i32]", name: "str", got: "i32", want: "i32") -> "i32":
    acc[1] = acc[1] + 1
    if got == want:
        acc[0] = acc[0] + 1
        print("  PASS " + name + " = " + str(got))
        return 1
    print("  FAIL " + name + " got=" + str(got) + " want=" + str(want))
    return 0

def platform_check_ge(acc: "list[i32]", name: "str", got: "i32", lo: "i32") -> "i32":
    acc[1] = acc[1] + 1
    if got >= lo:
        acc[0] = acc[0] + 1
        print("  PASS " + name + " = " + str(got))
        return 1
    print("  FAIL " + name + " got=" + str(got) + " want >= " + str(lo))
    return 0

def platform_check_f(acc: "list[i32]", name: "str", got: "f64", want: "f64", tol: "f64") -> "i32":
    d = got - want
    if d < 0.0:
        d = 0.0 - d
    acc[1] = acc[1] + 1
    if d <= tol:
        acc[0] = acc[0] + 1
        print("  PASS " + name + " = " + str(got))
        return 1
    print("  FAIL " + name + " got=" + str(got) + " want=" + str(want))
    return 0

def platform_selftest() -> "str":
    print("=== TkvUI.Platform selftest (P1.1) ===")
    acc = []
    acc.append(0)
    acc.append(0)
    # --- probe runtime
    pid = detect_platform()
    name = detect_platform_id()
    print("  detect_platform() = " + str(pid) + " (" + name + ")")
    ok_range = 0
    if pid >= 1:
        if pid <= 6:
            ok_range = 1
    platform_check(acc, "detect_platform trong 1..6", ok_range)
    platform_check_ge(acc, "detect_platform_id tra ten backend", len(name), 3)
    platform_check_i(acc, "bien moi truong khong ton tai -> 0", tkv_has_env("TKVUI_KHONG_CO_BIEN_NAY"), 0)
    platform_check_i(acc, "file probe khong ton tai -> 0", tkv_has_file("/tkvui/khong-ton-tai/file.txt"), 0)
    if pid == 1:
        platform_check_i(acc, "windows: co bien windir", tkv_has_env("windir"), 1)
    # --- backend parity (khong mo cua so)
    w32 = Win32Platform(0)
    x11 = X11Platform(0)
    coc = CocoaPlatform(0)
    w32n = w32.backend_name()
    x11n = x11.backend_name()
    cocn = coc.backend_name()
    platform_check_i(acc, "Win32Platform.backend_name = win32", platform_str_eq(w32n, "win32"), 1)
    platform_check_i(acc, "X11Platform.backend_name = x11", platform_str_eq(x11n, "x11"), 1)
    platform_check_i(acc, "CocoaPlatform.backend_name = cocoa", platform_str_eq(cocn, "cocoa"), 1)
    # --- dpi
    platform_check_f(acc, "dpi_scale android (5)", dpi_scale_for_platform(5), 2.0, 0.001)
    platform_check_f(acc, "dpi_scale ios (6)", dpi_scale_for_platform(6), 2.0, 0.001)
    platform_check_f(acc, "dpi_scale win32 (1)", dpi_scale_for_platform(1), 1.0, 0.001)
    # --- handle 0: moi backend phai tra ve an toan, khong goi native
    buf = []
    surface_ensure_capacity(buf, 64)
    surf = PixelSurface(8, 8, 8)
    surface_clear(buf, surf, ColorRgba(0, 0, 0, 255))
    wh0 = PlatformWindowHandle(0, 0, 0, 8, 8, 0, 0, 0, 0, 0, 255, 16711935, 0, 0, 0)
    platform_check_i(acc, "Win32Platform.present handle 0 -> 0", w32.present(buf, surf, wh0), 0)
    platform_check_i(acc, "Win32Platform.present_diff handle 0 -> 0", w32.present_diff(buf, buf, surf, wh0), 0)
    # --- Android tren runtime khong phai Android -> handle 0, present 0 (khong crash DllNotFound)
    ap = make_android_platform()
    awh = ap.create(0, 0, 390, 844, 0)
    if pid == 5:
        platform_check_ge(acc, "android create tren Android tra handle", awh.handle, 1)
    else:
        platform_check_i(acc, "android create ngoai Android -> handle 0", awh.handle, 0)
    platform_check_i(acc, "android present khong crash", ap.present(buf, surf, awh), 0)
    platform_check_i(acc, "android post_frame_callback khong crash", ap.post_frame_callback(1, 2), 0)
    platform_check_i(acc, "android set_pos tra 1", ap.set_pos(awh, 0, 0, 400, 850), 1)
    platform_check_i(acc, "android set_frame_buffer tra 1", ap.set_frame_buffer(0), 1)
    platform_check_i(acc, "android close_window tra 1", ap.close_window(awh), 1)
    # --- iOS: truoc day crash DllNotFoundException libobjc.dll tren Windows
    ip = make_ios_platform()
    iwh = ip.create(0, 0, 390, 844, 0)
    if pid == 6:
        platform_check_ge(acc, "ios create tren iOS tra handle", iwh.handle, 1)
    else:
        platform_check_i(acc, "ios create ngoai iOS -> handle 0 (khong crash)", iwh.handle, 0)
    platform_check_i(acc, "ios present khong ghi vao con tro CGContext", ip.present(buf, surf, iwh), 0)
    platform_check_i(acc, "ios set_frame_buffer tra 1", ip.set_frame_buffer(0), 1)
    platform_check_i(acc, "ios close_window tra 1", ip.close_window(iwh), 1)
    # --- input poll: chi tren Windows
    if pid == 1:
        platform_check_ge(acc, "win_pointer_x khong am", win_pointer_x(), 0)
    print("--- platform selftest: " + str(acc[0]) + "/" + str(acc[1]) + " PASS ---")
    if acc[0] == acc[1]:
        return "PLATFORM_OK"
    return "PLATFORM_FAIL"

def platform_str_eq(s: "str", want: "str") -> "i32":
    if s == want:
        return 1
    return 0
