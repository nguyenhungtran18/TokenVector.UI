# Backend kinds
GPU_BACKEND_SOFTWARE = 0
GPU_BACKEND_VULKAN = 1
GPU_BACKEND_METAL = 2
GPU_BACKEND_DX11 = 3

# PCI vendor IDs
GPU_VENDOR_NVIDIA = 4318
GPU_VENDOR_INTEL = 32902
GPU_VENDOR_AMD = 4098

class GpuBackend:
    kind: "i32"
    width: "i32"
    height: "i32"
    handle: "i64"
    device: "i64"
    swapchain: "i64"
    vendor: "i32"
    vram_mb: "i32"
    def __init__(self, kind, width, height, handle, device, swapchain, vendor, vram_mb):
        self.kind = kind
        self.width = width
        self.height = height
        self.handle = handle
        self.device = device
        self.swapchain = swapchain
        self.vendor = vendor
        self.vram_mb = vram_mb
    def present(self) -> "i32":
        # Stub Phase 1: chua co device that -> tra 0, khong crash.
        if self.handle == 0:
            return 0
        return 1

def gpu_backend_name(kind: "i32") -> "str":
    if kind == GPU_BACKEND_SOFTWARE:
        return "software"
    if kind == GPU_BACKEND_VULKAN:
        return "vulkan"
    if kind == GPU_BACKEND_METAL:
        return "metal"
    if kind == GPU_BACKEND_DX11:
        return "dx11"
    return "unknown"

def gpu_backend_kind_valid(kind: "i32") -> "i32":
    ok = 0
    if kind == GPU_BACKEND_SOFTWARE:
        ok = 1
    if kind == GPU_BACKEND_VULKAN:
        ok = 1
    if kind == GPU_BACKEND_METAL:
        ok = 1
    if kind == GPU_BACKEND_DX11:
        ok = 1
    return ok

def gpu_pick_backend(pid: "i32") -> "i32":
    # Chon backend uu tien theo platform (1=win32, 2=x11, 3=wayland, 4=cocoa, 5=android, 6=ios).
    if pid == 4:
        return GPU_BACKEND_METAL
    if pid == 6:
        return GPU_BACKEND_METAL
    if pid == 1:
        return GPU_BACKEND_VULKAN
    if pid == 2:
        return GPU_BACKEND_VULKAN
    if pid == 3:
        return GPU_BACKEND_VULKAN
    if pid == 5:
        return GPU_BACKEND_VULKAN
    return GPU_BACKEND_SOFTWARE

def gpu_is_nvidia_vendor(vendor: "i32") -> "i32":
    if vendor == GPU_VENDOR_NVIDIA:
        return 1
    return 0

def gpu_vendor_name(vendor: "i32") -> "str":
    if vendor == GPU_VENDOR_NVIDIA:
        return "nvidia"
    if vendor == GPU_VENDOR_INTEL:
        return "intel"
    if vendor == GPU_VENDOR_AMD:
        return "amd"
    return "unknown"

def make_software_backend(w: "i32", h: "i32") -> "GpuBackend":
    return GpuBackend(GPU_BACKEND_SOFTWARE, w, h, 0, 0, 0, 0, 0)

def make_vulkan_backend(w: "i32", h: "i32") -> "GpuBackend":
    # Thuc thi device creation flow (headless-safe, tra 0 neu thieu DLL/gap).
    # Flow: loader -> instance -> physical device -> queue family -> device -> swapchain.
    if vk_loader_present() == 0:
        return GpuBackend(GPU_BACKEND_VULKAN, w, h, 0, 0, 0, 0, 0)
    inst = vk_instance_create("TkvUI", "TkvUI", 4194304)  # VK_API_VERSION_1_0
    if inst == 0:
        return GpuBackend(GPU_BACKEND_VULKAN, w, h, 0, 0, 0, 0, 0)
    pdev = vk_physical_device_select(inst)
    if pdev == 0:
        vk_instance_destroy(inst)
        return GpuBackend(GPU_BACKEND_VULKAN, w, h, 0, 0, 0, 0, 0)
    qfam = vk_physical_device_get_queue_family(pdev, 1)  # VK_QUEUE_GRAPHICS_BIT
    dev = vk_device_create(pdev, qfam)
    if dev == 0:
        vk_instance_destroy(inst)
        return GpuBackend(GPU_BACKEND_VULKAN, w, h, 0, 0, 0, 0, 0)
    # Surface/swapchain can tao khi co window that (Phase 2 tiep).
    swc = 0
    # Vendor detection (doc properties - gap compiler out-struct).
    vendor = 0
    vram = 0
    return GpuBackend(GPU_BACKEND_VULKAN, w, h, inst, dev, swc, vendor, vram)

def make_metal_backend(w: "i32", h: "i32") -> "GpuBackend":
    # Stub Phase 1: chua tao MTLDevice that (can host macOS/iOS).
    return GpuBackend(GPU_BACKEND_METAL, w, h, 0, 0, 0, 0, 0)

def gpu_create_best(w: "i32", h: "i32") -> "GpuBackend":
    pid = detect_platform()
    kind = gpu_pick_backend(pid)
    if kind == GPU_BACKEND_VULKAN:
        return make_vulkan_backend(w, h)
    if kind == GPU_BACKEND_METAL:
        return make_metal_backend(w, h)
    return make_software_backend(w, h)

def gpu_vulkan_present() -> "i32":
    # Probe vulkan-1.dll (cung thu muc exe); 1 = co, 0 = khong.
    return tkv_has_file("vulkan-1.dll")

def gpu_metal_present() -> "i32":
    # Metal di qua ObjC runtime (quy uoc repo); host that can macOS/iOS.
    return tkv_has_file("libobjc.dll")

def vk_loader_present() -> "i32":
    # Loader co san (CWD/app hoac System32) thi goi that duoc.
    if tkv_has_file("vulkan-1.dll") == 1:
        return 1
    if tkv_has_file("C:\\Windows\\System32\\vulkan-1.dll") == 1:
        return 1
    return 0

def vk_proc_addr(name: "str") -> "i64":
    # Resolve global entry voi instance NULL (khong can struct/out-handle).
    # Tra 0 neu thieu loader. Tao instance that van blocked (can doc
    # out-handle tu bo nho - gap compiler, xem DEVELOPMENT_PLAN §3).
    if vk_loader_present() == 0:
        return 0
    return vk_get_instance_proc_addr(0, name)

def vk_create_instance_ex(create_info: "i64", allocator: "i64", instance: "i64") -> "i32":
    return vk_create_instance(create_info, allocator, instance)

def vk_destroy_instance_ex(instance: "i64", allocator: "i64") -> "i32":
    vk_destroy_instance(instance, allocator)
    return 1

def vk_enumerate_devices_ex(instance: "i64", count: "i64", devices: "i64") -> "i32":
    return vk_enumerate_physical_devices(instance, count, devices)

def mtl_get_class_ex(name: "str") -> "i64":
    return metal_get_class(name)

def mtl_sel_register_ex(name: "str") -> "i64":
    return metal_sel_register(name)

# =========================================================
# Vulkan structs (layout matches Vk C structs)
# =========================================================

class VkApplicationInfo:
    s_type: "i32"
    p_next: "i64"
    p_application_name: "str"
    application_version: "i32"
    p_engine_name: "str"
    engine_version: "i32"
    api_version: "i32"
    def __init__(self, s_type, p_next, p_application_name, application_version, p_engine_name, engine_version, api_version):
        self.s_type = s_type
        self.p_next = p_next
        self.p_application_name = p_application_name
        self.application_version = application_version
        self.p_engine_name = p_engine_name
        self.engine_version = engine_version
        self.api_version = api_version

class VkInstanceCreateInfo:
    s_type: "i32"
    p_next: "i64"
    flags: "i32"
    p_application_info: "i64"
    enabled_layer_count: "i32"
    pp_enabled_layer_names: "i64"
    enabled_extension_count: "i32"
    pp_enabled_extension_names: "i64"
    def __init__(self, s_type, p_next, flags, p_application_info, enabled_layer_count, pp_enabled_layer_names, enabled_extension_count, pp_enabled_extension_names):
        self.s_type = s_type
        self.p_next = p_next
        self.flags = flags
        self.p_application_info = p_application_info
        self.enabled_layer_count = enabled_layer_count
        self.pp_enabled_layer_names = pp_enabled_layer_names
        self.enabled_extension_count = enabled_extension_count
        self.pp_enabled_extension_names = pp_enabled_extension_names

class VkDeviceQueueCreateInfo:
    s_type: "i32"
    p_next: "i64"
    flags: "i32"
    queue_family_index: "i32"
    queue_count: "i32"
    p_queue_priorities: "i64"
    def __init__(self, s_type, p_next, flags, queue_family_index, queue_count, p_queue_priorities):
        self.s_type = s_type
        self.p_next = p_next
        self.flags = flags
        self.queue_family_index = queue_family_index
        self.queue_count = queue_count
        self.p_queue_priorities = p_queue_priorities

class VkDeviceCreateInfo:
    s_type: "i32"
    p_next: "i64"
    flags: "i32"
    queue_create_info_count: "i32"
    p_queue_create_infos: "i64"
    enabled_layer_count: "i32"
    pp_enabled_layer_names: "i64"
    enabled_extension_count: "i32"
    pp_enabled_extension_names: "i64"
    p_enabled_features: "i64"
    def __init__(self, s_type, p_next, flags, queue_create_info_count, p_queue_create_infos, enabled_layer_count, pp_enabled_layer_names, enabled_extension_count, pp_enabled_extension_names, p_enabled_features):
        self.s_type = s_type
        self.p_next = p_next
        self.flags = flags
        self.queue_create_info_count = queue_create_info_count
        self.p_queue_create_infos = p_queue_create_infos
        self.enabled_layer_count = enabled_layer_count
        self.pp_enabled_layer_names = pp_enabled_layer_names
        self.enabled_extension_count = enabled_extension_count
        self.pp_enabled_extension_names = pp_enabled_extension_names
        self.p_enabled_features = p_enabled_features

# =========================================================
# Vulkan device creation helpers (headless-safe, return 0 neu thieu DLL)
# =========================================================

# VkStructureType constants
VK_STRUCTURE_TYPE_APPLICATION_INFO = 0
VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO = 1
VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO = 2
VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO = 3
VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR = 1000001000

# Queue flags
VK_QUEUE_GRAPHICS_BIT = 1
VK_QUEUE_COMPUTE_BIT = 2
VK_QUEUE_TRANSFER_BIT = 4

# Result codes
VK_SUCCESS = 0
# NOTE: Vulkan error codes are negative (e.g. VK_ERROR_OUT_OF_HOST_MEMORY = -1).
# Module-level expression `0 - 1` is rejected by tkvc (constants must be literals),
# so callers must use `0 - 1` inline in function scope. Constant removed (was unused).

def vk_physical_device_get_queue_family(pdevice: "i64", flags: "i32") -> "i32":
    # Tim queue family co flag Graphics (bit 0). Tra index, -1 neu khong tim thay.
    # Can doc struct VkQueueFamilyProperties - gap compiler out-buffer.
    # Stub: null pdevice -> -1 (not found); pdevice that -> 0 (family 0).
    if pdevice == 0:
        return -1
    return 0

def vk_instance_create(app_name: "str", engine_name: "str", api_version: "i32") -> "i64":
    # Tao Vulkan instance. Tra handle instance hoac 0 neu that bai.
    if vk_loader_present() == 0:
        return 0
    # Build VkApplicationInfo
    app_info = VkApplicationInfo(
        VK_STRUCTURE_TYPE_APPLICATION_INFO,
        0,
        app_name,
        1,
        engine_name,
        1,
        api_version
    )
    # Build VkInstanceCreateInfo (pointers passed as 0 - compiler gap)
    create_info = VkInstanceCreateInfo(
        VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
        0,
        0,
        0,
        0,
        0,
        0,
        0
    )
    # Call vkCreateInstance - returns instance in out-param (compiler gap: returns 0)
    # On real GPU host with proper DLL, this would return the instance handle
    return 0

def vk_instance_destroy(instance: "i64") -> "i32":
    if instance == 0:
        return 0
    vk_destroy_instance_ex(instance, 0)
    return 1

def vk_physical_device_select(instance: "i64") -> "i64":
    # Liet ke physical devices va chon cai dau tien co Graphics queue.
    if instance == 0:
        return 0
    # Can doc out-handle array - gap compiler.
    # Build device count query
    count = []
    count.append(0)
    # vkEnumeratePhysicalDevices(instance, count, 0)
    # On real GPU, this would fill count[0]
    # Then allocate array and call again to get devices
    return 0

def vk_device_create(pdevice: "i64", queue_family: "i32") -> "i64":
    # Tao logical device voi queue family da chon.
    if pdevice == 0:
        return 0
    # Build VkDeviceQueueCreateInfo (p_queue_priorities passed as 0 - compiler gap)
    priority = []
    priority.append(1.0)
    queue_info = VkDeviceQueueCreateInfo(
        VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
        0,
        0,
        queue_family,
        1,
        0
    )
    # Build VkDeviceCreateInfo (pointers passed as 0 - compiler gap)
    create_info = VkDeviceCreateInfo(
        VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
        0,
        0,
        1,
        0,
        0,
        0,
        0,
        0,
        0
    )
    # Call vkCreateDevice - returns device in out-param (compiler gap: returns 0)
    return 0

def vk_device_destroy(device: "i64") -> "i32":
    if device == 0:
        return 0
    vk_destroy_device(device, 0)
    return 1

def vk_swapchain_create(device: "i64", surface: "i64", width: "i32", height: "i32", image_count: "i32") -> "i64":
    # Tao swapchain cho surface da cho. Tra swapchain handle.
    if device == 0 or surface == 0:
        return 0
    # Can vkCreateSwapchainKHR (extension, resolve qua vkGetInstanceProcAddr)
    # Gap compiler out-handle.
    return 0

def vk_swapchain_destroy(device: "i64", swapchain: "i64") -> "i32":
    if device == 0 or swapchain == 0:
        return 0
    # vkDestroySwapchainKHR
    return 1

def vk_swapchain_present(device: "i64", swapchain: "i64", queue: "i64", image_index: "i32") -> "i32":
    # Present image len swapchain. Tra VK_SUCCESS(0) neu ok.
    if device == 0 or swapchain == 0 or queue == 0:
        return 0
    # vkQueuePresentKHR
    return 0

def vk_queue_submit(device: "i64", queue: "i64", command_buffer: "i64") -> "i32":
    # Submit command buffer. Tra VK_SUCCESS(0) neu ok.
    return 0

def vk_command_pool_create(device: "i64", queue_family: "i32") -> "i64":
    if device == 0:
        return 0
    return 0

def vk_command_buffer_allocate(device: "i64", pool: "i64") -> "i64":
    return 0

def vk_render_pass_create(device: "i64") -> "i64":
    return 0

def vk_framebuffer_create(device: "i64", render_pass: "i64", width: "i32", height: "i32") -> "i64":
    return 0

def vk_pipeline_create(device: "i64", render_pass: "i64", pipeline_layout: "i64") -> "i64":
    return 0

# =========================================================
# Shader Pipeline Abstraction (backend-agnostic)
# =========================================================

SHADER_STAGE_VERTEX = 0
SHADER_STAGE_FRAGMENT = 1
SHADER_STAGE_COMPUTE = 2

class ShaderModule:
    handle: "i64"
    stage: "i32"
    entry_point: "str"
    def __init__(self, handle, stage, entry_point):
        self.handle = handle
        self.stage = stage
        self.entry_point = entry_point

class PipelineLayout:
    handle: "i64"
    def __init__(self, handle):
        self.handle = handle

class GraphicsPipeline:
    handle: "i64"
    def __init__(self, handle):
        self.handle = handle

class ComputePipeline:
    handle: "i64"
    def __init__(self, handle):
        self.handle = handle

def shader_module_create(device: "i64", backend: "i32", code: "list[i64]", stage: "i32", entry: "str") -> "ShaderModule":
    if device == 0:
        return ShaderModule(0, stage, entry)
    if backend == GPU_BACKEND_VULKAN:
        # Build VkShaderModuleCreateInfo
        # s_type = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO (1000000000+)
        # code_size = len(code) * 4 (bytes)
        # p_code = pointer to code array
        # vkCreateShaderModule(device, create_info, 0, handle)
        return ShaderModule(0, stage, entry)
    if backend == GPU_BACKEND_DX11:
        # d3d11_shader_compile -> ID3DBlob -> CreateVertexShader/CreatePixelShader
        return ShaderModule(0, stage, entry)
    if backend == GPU_BACKEND_METAL:
        # MTLLibrary -> newFunctionWithName
        return ShaderModule(0, stage, entry)
    return ShaderModule(0, stage, entry)

def shader_module_destroy(device: "i64", backend: "i32", sm: "ShaderModule") -> "i32":
    if sm.handle == 0:
        return 0
    if backend == GPU_BACKEND_VULKAN:
        # vkDestroyShaderModule(device, sm.handle, 0)
        noop = 0
    return 1

def pipeline_layout_create(device: "i64", backend: "i32", desc: "i64") -> "PipelineLayout":
    if device == 0:
        return PipelineLayout(0)
    if backend == GPU_BACKEND_VULKAN:
        # VkPipelineLayoutCreateInfo with push constants, descriptor set layouts
        noop = 0
    return PipelineLayout(0)

def pipeline_layout_destroy(device: "i64", backend: "i32", pl: "PipelineLayout") -> "i32":
    if pl.handle == 0:
        return 0
    if backend == GPU_BACKEND_VULKAN:
        # vkDestroyPipelineLayout(device, pl.handle, 0)
        noop = 0
    return 1

def graphics_pipeline_create(device: "i64", backend: "i32", desc: "i64", layout: "PipelineLayout", render_pass: "i64") -> "GraphicsPipeline":
    if device == 0:
        return GraphicsPipeline(0)
    if backend == GPU_BACKEND_VULKAN:
        # VkGraphicsPipelineCreateInfo with vertex/fragment shaders, vertex input, rasterizer, etc.
        noop = 0
    return GraphicsPipeline(0)

def graphics_pipeline_destroy(device: "i64", backend: "i32", gp: "GraphicsPipeline") -> "i32":
    if gp.handle == 0:
        return 0
    if backend == GPU_BACKEND_VULKAN:
        # vkDestroyPipeline(device, gp.handle, 0)
        noop = 0
    return 1

def compute_pipeline_create(device: "i64", backend: "i32", cs: "ShaderModule", layout: "PipelineLayout") -> "ComputePipeline":
    if device == 0:
        return ComputePipeline(0)
    if backend == GPU_BACKEND_VULKAN:
        # VkComputePipelineCreateInfo with compute shader
        noop = 0
    return ComputePipeline(0)

def compute_pipeline_destroy(device: "i64", backend: "i32", cp: "ComputePipeline") -> "i32":
    if cp.handle == 0:
        return 0
    if backend == GPU_BACKEND_VULKAN:
        # vkDestroyPipeline(device, cp.handle, 0)
        noop = 0
    return 1

# =========================================================
# D3D11 Backend (Windows only) - with struct definitions
# =========================================================

class D3D_FEATURE_LEVEL:
    value: "i32"
    def __init__(self, value):
        self.value = value

# D3D_FEATURE_LEVEL constants
D3D_FEATURE_LEVEL_11_1 = 4368
D3D_FEATURE_LEVEL_11_0 = 4352
D3D_FEATURE_LEVEL_10_1 = 4112
D3D_FEATURE_LEVEL_10_0 = 4096

class DXGI_SWAP_CHAIN_DESC:
    buffer_desc: "i64"  # DXGI_MODE_DESC
    sample_desc: "i64"  # DXGI_SAMPLE_DESC
    buffer_usage: "i32"
    buffer_count: "i32"
    output_window: "i64"
    windowed: "i32"
    swap_effect: "i32"
    flags: "i32"
    def __init__(self, buffer_desc, sample_desc, buffer_usage, buffer_count, output_window, windowed, swap_effect, flags):
        self.buffer_desc = buffer_desc
        self.sample_desc = sample_desc
        self.buffer_usage = buffer_usage
        self.buffer_count = buffer_count
        self.output_window = output_window
        self.windowed = windowed
        self.swap_effect = swap_effect
        self.flags = flags

def d3d11_device_create(adapter: "i64", driver_type: "i32", flags: "i32", feature_levels: "i64", sdk_version: "i32", device: "i64", feature_level: "i64", context: "i64") -> "i32":
    # D3D11CreateDevice with feature level array
    if feature_levels == 0:
        # Default feature levels would be 11_1/11_0/10_1/10_0.
        # Compiler gap - can't pass array directly, keep 0.
        feature_levels = 0
    result = d3d11_create_device(adapter, driver_type, 0, flags, feature_levels, 4, sdk_version, device, feature_level, context)
    if result >= 0:
        return 1
    return 0

def d3d11_swap_chain_create(factory: "i64", device: "i64", hwnd: "i64", desc: "i64", swap_chain: "i64") -> "i32":
    # CreateSwapChain with DXGI_SWAP_CHAIN_DESC
    # IDXGIFactory::CreateSwapChain
    return 0

def d3d11_shader_compile(src: "str", entry: "str", target: "str", flags1: "i32", flags2: "i32", blob: "i64", error_blob: "i64") -> "i32":
    return d3d_compile(src, len(src), 0, 0, 0, flags1, flags2, blob, error_blob)

