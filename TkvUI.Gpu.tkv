# -*- coding: utf-8 -*-
"""TkvUI.Gpu - GPU backend abstraction (Vulkan/Metal) + software fallback

Pure TokenVector. Phase 1: detection/selection/stubs (khong can device that).
Vulkan bao NVIDIA tren Win/Linux; Metal cho macOS/iOS (qua ObjC runtime).
Device that + swapchain/present that la Phase 2 (can host co GPU + DLL).
Phu thuoc: Core, Text (text_check), Platform (detect_platform, tkv_has_file). Khong vong import.
"""
__tkv_import__ = ["TkvUI.Core", "TkvUI.Text", "TkvUI.Platform"]
