# -*- coding: utf-8 -*-
"""TkvUI.FontFallback - chuoi font du phong (Phase 11.1)."""
__tkv_import__ = ["TkvUI.Core", "TkvUI.Text", "TkvUI.Graphics", "TkvUI.Viet", "TkvUI.I18nData"]

FB_TEXT = 0
FB_VIET = 1
FB_I18N = 2
FB_MISSING = 3
FB_EMOJI = 4
FB_COLOR = 5

def fb_classify(seq: "str") -> "i32":
    if len(seq) == 1:
        c = char_code(seq)
        if c >= 32:
            if c <= 126:
                return 0
        return 3
    if vi_bits(seq) != -1:
        return 1
    if i18n_codepoint(seq) >= 0:
        return 2
    if fb_is_emoji(seq):
        return 4
    if fb_is_color_font(seq):
        return 5
    return 3

def fb_font_name(font: "i32") -> "str":
    if font == 1:
        return "viet"
    if font == 2:
        return "i18n"
    if font == 3:
        return "missing"
    if font == 4:
        return "emoji"
    if font == 5:
        return "color"
    return "text"

def fb_advance() -> "i32":
    return 6

def fb_measure(text: "str") -> "f64":
    n = len(text)
    idx = int(0)
    cols = int(0)
    while idx < n:
        adv = utf8_seq_len(text, idx)
        if idx + adv > n:
            adv = n - idx
        cols = cols + 1
        idx = idx + adv
    return float(cols * 6)

def fb_is_emoji(seq: "str") -> "i32":
    if len(seq) == 1:
        c = char_code(seq)
        if c >= 127744 and c <= 129775:
            return 1
        if c >= 9984 and c <= 10175:
            return 1
        if c >= 9728 and c <= 9983:
            return 1
        if c >= 128512 and c <= 128591:
            return 1
        if c >= 128512 and c <= 128767:
            return 1
        if c >= 129024 and c <= 129535:
            return 1
        return 0
    zwj = 8205
    i = int(0)
    n = len(seq)
    while i < n:
        adv = utf8_seq_len(seq, i)
        if i + adv > n:
            adv = n - i
        cp = i18n_codepoint(seq[i:i+adv])
        if cp == 8205:
            return 1
        i = i + adv
    return 0

def fb_is_color_font(seq: "str") -> "i32":
    if len(seq) == 1:
        c = char_code(seq)
        if c >= 127744 and c <= 129775:
            return 1
        return 0
    return 0

FB_BOX_BITS = 33874822719

def fb_draw_run_emoji(buf: "list[i64]", surf: "PixelSurface", text: "str", start: "i32", ulen: "i32", x: "i32", y: "i32", color: "ColorRgba") -> "i32":
    end = start + ulen
    idx = start
    cx = x
    while idx < end:
        adv = utf8_seq_len(text, idx)
        if idx + adv > end:
            adv = end - idx
        r = Rect2D(cx, y, 12, 12)
        _ = fill_round_rect(buf, surf, r, 2, ColorRgba(255, 255, 255, 255))
        draw_string(buf, surf, "E", cx + 2, y + 2, 1, ColorRgba(0, 0, 0, 255))
        adv = utf8_seq_len(text, idx)
        if idx + adv > end:
            adv = end - idx
        cx = cx + 12
        idx = idx + adv
    return cx - x

def fb_draw_run_color(buf: "list[i64]", surf: "PixelSurface", text: "str", start: "i32", ulen: "i32", x: "i32", y: "i32", color: "ColorRgba") -> "i32":
    end = start + ulen
    idx = start
    cx = x
    while idx < end:
        adv = utf8_seq_len(text, idx)
        if idx + adv > end:
            adv = end - idx
        r = Rect2D(cx, y, 12, 12)
        _ = fill_round_rect(buf, surf, r, 2, color)
        adv = utf8_seq_len(text, idx)
        if idx + adv > end:
            adv = end - idx
        cx = cx + 12
        idx = idx + adv
    return cx - x

def fb_count_missing(text: "str") -> "i32":
    n = len(text)
    idx = int(0)
    c = int(0)
    while idx < n:
        adv = utf8_seq_len(text, idx)
        if idx + adv > n:
            adv = n - idx
        if fb_classify(text[idx:idx + adv]) == 3:
            c = c + 1
        idx = idx + adv
    return c

def fb_has_font(text: "str", font: "i32") -> "i32":
    n = len(text)
    idx = int(0)
    while idx < n:
        adv = utf8_seq_len(text, idx)
        if idx + adv > n:
            adv = n - idx
        if fb_classify(text[idx:idx + adv]) == font:
            return 1
        idx = idx + adv
    return 0

def fb_resolve(text: "str", starts: "list[i32]", lens: "list[i32]", fonts: "list[i32]") -> "i32":
    n = len(text)
    idx = int(0)
    cur_font = -1
    run_start = 0
    while idx < n:
        adv = utf8_seq_len(text, idx)
        if idx + adv > n:
            adv = n - idx
        f = fb_classify(text[idx:idx + adv])
        if f != cur_font:
            if cur_font >= 0:
                starts.append(run_start)
                lens.append(idx - run_start)
                fonts.append(cur_font)
            cur_font = f
            run_start = idx
        idx = idx + adv
    if cur_font >= 0:
        starts.append(run_start)
        lens.append(n - run_start)
        fonts.append(cur_font)
    return len(fonts)

def fb_draw_string(buf: "list[i64]", surf: "PixelSurface", abuf: "list[i64]", atlas: "PixelSurface", iabuf: "list[i64]", iatlas: "PixelSurface", text: "str", x: "f64", y: "f64", color: "ColorRgba") -> "i32":
    starts = []
    lens = []
    fonts = []
    nruns = fb_resolve(text, starts, lens, fonts)
    cx = int(x)
    cy = int(y)
    r = int(0)
    while r < nruns:
        f = fonts[r]
        sub = text[starts[r]:starts[r] + lens[r]]
        if f == 0:
            draw_string(buf, surf, sub, float(cx), y, 1.0, color)
            cx = cx + vi_strlen(sub) * 6
        elif f == 1:
            cx = cx + fb_draw_run_viet(buf, surf, text, starts[r], lens[r], cx, cy, color)
        elif f == 2:
            cx = cx + fb_draw_run_i18n(iabuf, iatlas, buf, surf, text, starts[r], lens[r], cx, cy, color)
        elif f == 4:
            cx = cx + fb_draw_run_emoji(buf, surf, text, starts[r], lens[r], cx, cy, color)
        elif f == 5:
            cx = cx + fb_draw_run_color(buf, surf, text, starts[r], lens[r], cx, cy, color)
        else:
            cx = cx + fb_draw_run_box(buf, surf, text, starts[r], lens[r], cx, cy, color)
        r = r + 1
    return cx - int(x)

def fb_draw_run_viet(buf: "list[i64]", surf: "PixelSurface", text: "str", start: "i32", ulen: "i32", x: "i32", y: "i32", color: "ColorRgba") -> "i32":
    end = start + ulen
