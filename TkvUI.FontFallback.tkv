        adv = utf8_seq_len(text, idx)
        if idx + adv > end:
            adv = end - idx
        r = Rect2D(cx, y, 12, 12)
        _ = fill_round_rect(buf, surf, r, 2, color)
        adv = utf8_seq_len(text, idx)
        if idx + adv > end:
            adv = end - idx
        cx = cx + 12
        idx = idx + adv
    return cx - x

