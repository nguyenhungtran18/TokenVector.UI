def fb_check(acc: "list[i32]", name: "str", ok: "i32") -> "i32":
    acc[1] = acc[1] + 1
    if ok == 1:
        acc[0] = acc[0] + 1
        print("  PASS " + name)
        return 1
    print("  FAIL " + name)
    return 0

def fbcheck_i(acc: "list[i32]", name: "str", got: "i32", want: "i32") -> "i32":
    acc[1] = acc[1] + 1
    if got == want:
        acc[0] = acc[0] + 1
        print("  PASS " + name + " = " + str(got))
        return 1
    print("  FAIL " + name + " got=" + str(got) + " want=" + str(want))
    return 0

def fbcheck_f(acc: "list[i32]", name: "str", got: "f64", want: "f64", tol: "f64") -> "i32":
    d = got - want
    if d < 0.0:
        d = 0.0 - d
    acc[1] = acc[1] + 1
    if d <= tol:
        acc[0] = acc[0] + 1
        print("  PASS " + name + " = " + str(got))
        return 1
    print("  FAIL " + name + " got=" + str(got) + " want=" + str(want))
    return 0

def fbcheck_s(acc: "list[i32]", name: "str", got: "str", want: "str") -> "i32":
    acc[1] = acc[1] + 1
    if got == want:
        acc[0] = acc[0] + 1
        print("  PASS " + name + " = " + got)
        return 1
    print("  FAIL " + name + " got=" + got + " want=" + want)
    return 0

def fb_oracle(seq: "str") -> "i32":
    if len(seq) == 1:
        c = char_code(seq)
        if c >= 32:
            if c <= 126:
                return 0
        return 3
    if vi_bits(seq) != -1:
        return 1
    if i18n_codepoint(seq) >= 0:
        return 2
    return 3

def fb_candidates() -> "list[str]":
    out = []
    out.append("ệ")
    out.append("à")
    out.append("ê")
    out.append("א")
    out.append("ב")
    out.append("你")
    out.append("好")
    out.append("€")
    return out

def fallback_selftest() -> "str":
    print("== TkvUI.FontFallback selftest ==")
    acc = [int(0), int(0)]
    fbcheck_i(acc, "ascii", fb_classify("A"), 0)
    fbcheck_i(acc, "space", fb_classify(" "), 0)
    fbcheck_i(acc, "control", fb_classify("\n"), 3)
    fbcheck_s(acc, "fontname", fb_font_name(2), "i18n")
    fbcheck_i(acc, "advance", fb_advance(), 6)
    cands = fb_candidates()
    fbcheck_i(acc, "oracle", fb_classify(cands[0]), fb_oracle(cands[0]))
    fbcheck_s(acc, "fontname", fb_font_name(2), "i18n")
    fbcheck_i(acc, "advance", fb_advance(), 6)
    nviet = 1
    ni18n = 1
    first_viet = "à"
    first_i18n = "א"
    ok_reach = 0
    if nviet > 0:
        if ni18n > 0:
            ok_reach = 1
    fb_check(acc, "reach.viet+i18n", ok_reach)
    mixed = "A" + first_viet + first_i18n + "B"
    starts = []
    lens = []
    fonts = []
    nruns = fb_resolve(mixed, starts, lens, fonts)
    fbcheck_i(acc, "runs.n", nruns, 4)
    fbcheck_i(acc, "runs.f0", fonts[0], 0)
    fbcheck_i(acc, "runs.f1", fonts[1], 1)
    fbcheck_i(acc, "runs.f2", fonts[2], 2)
    fbcheck_i(acc, "runs.f3", fonts[3], 0)
    cov = int(0)
    k = int(0)
    while k < nruns:
        cov = cov + lens[k]
        k = k + 1
    fbcheck_i(acc, "runs.cover", cov, len(mixed))
    fbcheck_i(acc, "missing.0", fb_count_missing("AB"), 0)
    fb_check(acc, "has.viet", fb_has_font(mixed, 1))
    fbcheck_f(acc, "measure", fb_measure("AB"), 12.0, 0.001)
    atlas = text_atlas_record(1)
    abuf = text_atlas_baked_buffer(atlas)
    iat = text_atlas_record_i18n(1)
    ibf = atlas_buffer(iat)
    fbcheck_i(acc, "i18n.bake", text_atlas_bake_i18n_all(iat, ibf), 10)
    surf = PixelSurface(200, 24, 200)
    buf = []
    j = int(0)
    while j < 200 * 24:
        buf.append(0)
        j = j + 1
    white = ColorRgba(255, 255, 255, 255)
    black = ColorRgba(0, 0, 0, 255)
    surface_clear(buf, surf, black)
    wpx = fb_draw_string(buf, surf, abuf, atlas, ibf, iat, mixed, 0, 8, white)
    fbcheck_f(acc, "draw.w", float(wpx), fb_measure(mixed), 20.0)
    cnt = text_count_nonzero(buf, 200 * 24, 0, 200 * 24)
    okpx = 0
    if cnt > 20:
        okpx = 1
    fb_check(acc, "draw.px", okpx)
    print("fallback: " + str(acc[0]) + "/" + str(acc[1]))
    if acc[0] == acc[1]:
        return "FALLBACK_OK"
    return "FALLBACK_FAIL"