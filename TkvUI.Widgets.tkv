    re = PointerEventArgs(367.0, 314.0, 1, 1)
    re.is_down = 0
    widget_check_i(acc, "ant rate click star 3", rt.handle_pointer(re), 3)
    widget_check_i(acc, "ant rate clamp high", rt.set_value(9), 5)
    widget_check_i(acc, "ant rate clamp low", rt.set_value(-1), 0)
    rt.set_value(4)
    widget_check_i(acc, "ant rate render", rt.render(abuf, asurf), 1)
    sp = make_ant_spin(430.0, 306.0, 32.0)
    sp.start()
    sp.step(0.5)
    widget_check_ge(acc, "ant spin angle", int(sp.angle), 180)
    widget_check_i(acc, "ant spin render", sp.render(abuf, asurf), 1)
    sp.stop()
    apainted = widget_count_non_bg(abuf, asurf, abg)
    widget_check_ge(acc, "ant widgets painted", apainted, 3000)
    # --- multi-window pump: 1 RenderLoop / window ---
    mloops = []
    mloops.append(make_render_loop(60))
    mloops.append(make_render_loop(60))
    mq0 = mloops[0]
    mq0.request_invalidate()
    widget_check_i(acc, "pump 1 frame due", render_loop_pump_all(mloops, 0.016), 1)
    widget_check_i(acc, "pump het due", render_loop_pump_all(mloops, 0.016), 0)
    # --- Wave A: L1 breadth widgets ---
    cal = make_calendar(10.0, 10.0, 200.0, 160.0, 2026, 9)
    widget_check_i(acc, "cal days sep", cal.days_in_month(2026, 9), 30)
    widget_check_i(acc, "cal days feb non-leap", cal.days_in_month(2026, 2), 28)
    widget_check_i(acc, "cal days feb leap", cal.days_in_month(2024, 2), 29)
    widget_check_i(acc, "cal select ok", cal.select(2026, 9, 24), 1)
    widget_check_i(acc, "cal select bad day", cal.select(2026, 9, 31), 0)
    widget_check_i(acc, "cal next month", cal.next_month(), 10)
    widget_check_i(acc, "cal prev wrap", cal.prev_month(), 9)
    widget_check_i(acc, "cal hit day in", cal.hit_day(cal.bx + 70.0, cal.by + 50.0) > 0, 1)
    widget_check_i(acc, "cal hit miss", cal.hit_day(0.0, 0.0), -1)
    widget_check_i(acc, "cal render", cal.render(abuf, asurf), 1)
    dte = make_datetime_edit(220.0, 10.0, 200.0, 30.0)
    widget_check_s(acc, "dte format vi", dte.format_vi(), "24/09/2026 12:00:00")
    widget_check_i(acc, "dte set date", dte.set_date(2026, 12, 31), 1)
    widget_check_i(acc, "dte set time bad", dte.set_time(25, 0, 0), 0)
    widget_check_i(acc, "dte set time ok", dte.set_time(8, 30, 15), 1)
    widget_check_i(acc, "dte popup open", dte.toggle_popup(), 1)
    widget_check_i(acc, "dte contains", dte.contains(230.0, 20.0), 1)
    widget_check_i(acc, "dte render", dte.render(abuf, asurf), 1)
    tbx = make_toolbox(10.0, 180.0, 180.0, 200.0, 3)
    widget_check_i(acc, "tbx select", tbx.select(2), 2)
    widget_check_i(acc, "tbx select oob", tbx.select(9), 2)
    widget_check_i(acc, "tbx hit header", tbx.hit_header(tbx.by + 5.0), 0)
    widget_check_i(acc, "tbx hit header 1", tbx.hit_header(tbx.by + 40.0), 1)
    widget_check_i(acc, "tbx miss", tbx.hit_header(0.0), -1)
    tb_labels = []
    tb_labels.append("General")
    tb_labels.append("Advanced")
    tb_labels.append("Network")
    widget_check_i(acc, "tbx render", tbx.render(abuf, asurf, tb_labels, 3), 1)
    stk = make_stacked(200.0, 180.0, 160.0, 80.0, 4)
    widget_check_i(acc, "stk set", stk.set_index(2), 2)
    widget_check_i(acc, "stk next", stk.next_page(), 3)
    widget_check_i(acc, "stk clamp", stk.next_page(), 3)
    widget_check_i(acc, "stk prev", stk.prev_page(), 2)
    st_labels = []
    st_labels.append("One")
    st_labels.append("Two")
    st_labels.append("Three")
    widget_check_s(acc, "stk label", stk.current_label(st_labels, 3), "Three")
    widget_check_i(acc, "stk render", stk.render(abuf, asurf, st_labels, 3), 1)
    sb = make_scrollbar(370.0, 180.0, 14.0, 120.0, 1)
    sb.maximum = 90.0
    sb.page = 30.0
    widget_check_ge(acc, "sb thumb len", int(sb.thumb_len()), 16)
    widget_check_i(acc, "sb set clamp hi", int(sb.set_value(200.0)), 90)
    widget_check_i(acc, "sb set clamp lo", int(sb.set_value(-5.0)), 0)
    sb.step(20.0)
    widget_check_i(acc, "sb step", int(sb.value), 20)
    sb.page_step(1)
    widget_check_i(acc, "sb page", int(sb.value), 50)
    widget_check_i(acc, "sb hit thumb", sb.hit_thumb(sb.bx + 7.0, sb.by + sb.thumb_pos() + 4.0), 1)
    widget_check_i(acc, "sb render", sb.render(abuf, asurf), 1)
    dial = make_dial(400.0, 180.0, 70.0, 70.0)
    widget_check_i(acc, "dial hit", dial.hit_test(dial.center_x(), dial.center_y()), 1)
    widget_check_i(acc, "dial miss", dial.hit_test(0.0, 0.0), 0)
    dial.set_value(50.0)
    widget_check_f(acc, "dial angle mid", dial.angle_deg(), 0.0, 0.5)
    dial.set_from_angle(135.0)
    widget_check_i(acc, "dial angle max", int(dial.value), 100)
    dial.set_from_angle(-135.0)
    widget_check_i(acc, "dial angle min", int(dial.value), 0)
    widget_check_i(acc, "dial render", dial.render(abuf, asurf), 1)
    cl = make_command_link(10.0, 390.0, 200.0, 44.0, "Create project", "Start a new workspace")
    ce = PointerEventArgs(50.0, 400.0, 1, 1)
    ce.is_down = 1
