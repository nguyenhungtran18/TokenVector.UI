    ce2 = PointerEventArgs(50.0, 400.0, 1, 0)
    ce2.is_down = 0
    widget_check_i(acc, "cmdlink release click", cl.handle_pointer(ce2), 1)
    ce3 = PointerEventArgs(0.0, 0.0, 1, 0)
    ce3.is_down = 0
    widget_check_i(acc, "cmdlink miss", cl.handle_pointer(ce3), 0)
    widget_check_i(acc, "cmdlink render", cl.render(abuf, asurf), 1)
    kse = make_key_sequence(220.0, 390.0, 160.0, 30.0)
