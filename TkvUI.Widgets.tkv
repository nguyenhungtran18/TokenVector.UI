    widget_check_s(acc, "lcd text", lcd.value_text(), "1234")
    widget_check_i(acc, "lcd seg 0 mid off", lcd.seg_on(0, 6), 0)
    widget_check_i(acc, "lcd seg 8 all", lcd.seg_on(8, 0) + lcd.seg_on(8, 1) + lcd.seg_on(8, 2) + lcd.seg_on(8, 3) + lcd.seg_on(8, 4) + lcd.seg_on(8, 5) + lcd.seg_on(8, 6), 7)
    widget_check_i(acc, "lcd seg 1 only tr/br", lcd.seg_on(1, 1) + lcd.seg_on(1, 2) + lcd.seg_on(1, 0), 2)
