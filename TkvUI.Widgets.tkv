    wave_painted = widget_count_non_bg(abuf, asurf, abg)
    widget_check_ge(acc, "wave A widgets painted", wave_painted, 4000)
    print("--- widgets selftest: " + str(acc[0]) + "/" + str(acc[1]) + " PASS ---")
    if acc[0] == acc[1]:
        return "WIDGETS_OK"
    return "WIDGETS_FAIL"
