# -*- coding: utf-8 -*-
"""TkvUI.I18nData - baked subset font bytes (sinh boi i18n_gen.py, ngoai repo).

Chua byte TTF subset (times: Hebrew/Arabic simple; msyh: CJK) + bang codepoint
cho text_atlas_bake_i18n. Khong doc file luc chay (ne compiler gap file I/O).
"""
__tkv_import__ = ["TkvUI.Core"]

def i18n_cps_he() -> "list[i32]":
    return [1488, 1489, 1513, 1500, 1493, 1501, 1575, 1576]

def i18n_cps_cjk() -> "list[i32]":
    return [20320, 22909]

def i18n_codepoint(seq: "str") -> "i32":
    # seq UTF-8 (2/3 don vi) -> codepoint; -1 neu khong cover.
    if seq == "א":
        return 1488
    if seq == "ב":
        return 1489
    if seq == "ש":
        return 1513
    if seq == "ל":
        return 1500
    if seq == "ו":
        return 1493
    if seq == "ם":
        return 1501
    if seq == "ا":
        return 1575
    if seq == "ب":
        return 1576
    if seq == "你":
        return 20320
    if seq == "好":
        return 22909
    return -1

def i18n_slot_for(cp: "i32") -> "i32":
    # slot atlas = vi tri trong danh sach bake (he truoc, cjk sau).
    he = i18n_cps_he()
    i = int(0)
    while i < len(he):
        if he[i] == cp:
            return i
        i = i + 1
    cjk = i18n_cps_cjk()
    j = int(0)
    while j < len(cjk):
        if cjk[j] == cp:
            return len(he) + j
        j = j + 1
    return -1

