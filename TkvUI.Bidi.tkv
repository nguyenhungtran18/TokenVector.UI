# -*- coding: utf-8 -*-
"""TkvUI.Bidi - Unicode Bidirectional Algorithm (UAX #9) core

Pure TokenVector implementation of Unicode Bidirectional Algorithm + HarfBuzz shaping guard.
Phu thuoc: Core, Text (draw_string, atlas_blit_glyph, i18n bake/draw), Viet (utf8_seq_len, vi_bits), I18nData (i18n_codepoint/slot_for), Platform (tkv_has_file). Khong vong import.
"""

__tkv_import__ = ["TkvUI.Core", "TkvUI.Text", "TkvUI.Viet", "TkvUI.I18nData", "TkvUI.Platform"]
