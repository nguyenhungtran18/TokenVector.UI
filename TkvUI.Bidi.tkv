    text_check_i(acc, "bidi W1 NSM dau -> ON", w1a[0], 13)
    w1b = []
    w1b.append(0)
    w1b.append(8)
    bidi_weak_resolve(w1b, 2)
    text_check_i(acc, "bidi W1 NSM <- L", w1b[1], 0)
    w3 = []
    w3.append(2)
    bidi_weak_resolve(w3, 1)
    text_check_i(acc, "bidi W3 AL -> R", w3[0], 1)
    w2 = []
    w2.append(2)
    w2.append(3)
    bidi_weak_resolve(w2, 2)
    text_check_i(acc, "bidi W2 EN <- AL -> AN", w2[1], 6)
    w4 = []
    w4.append(3)
    w4.append(7)
    w4.append(3)
    bidi_weak_resolve(w4, 3)
    text_check_i(acc, "bidi W4 CS giua EN", w4[1], 3)
    w5 = []
    w5.append(3)
    w5.append(5)
    bidi_weak_resolve(w5, 2)
    text_check_i(acc, "bidi W5 ET <- EN", w5[1], 3)
    w6 = []
    w6.append(4)
    bidi_weak_resolve(w6, 1)
    text_check_i(acc, "bidi W6 ES -> ON", w6[0], 13)
    w7 = []
    w7.append(0)
    w7.append(3)
    bidi_weak_resolve(w7, 2)
    text_check_i(acc, "bidi W7 EN <- L", w7[1], 0)
    n1 = []
