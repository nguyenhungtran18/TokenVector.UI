# -*- coding: utf-8 -*-
"""TkvUI.Bidi - Unicode Bidirectional Algorithm (UAX #9) core

Pure TokenVector implementation of Unicode Bidirectional Algorithm + HarfBuzz shaping guard.
Phu thuoc: Core, Text (draw_string, atlas_blit_glyph, i18n bake/draw), Viet (utf8_seq_len, vi_bits),
I18nData (i18n_codepoint/slot_for), Platform (tkv_has_file), HarfBuzz (leaf FFI + shape orchestration).
Khong vong import: HarfBuzz khong import Text/Bidi.
"""

__tkv_import__ = ["TkvUI.Core", "TkvUI.Text", "TkvUI.Viet", "TkvUI.I18nData", "TkvUI.Platform", "TkvUI.HarfBuzz"]

# Bidi character classes (UAX #9 Table 3)
# Muc dich: phan loai ky tu de xac dinh huong van ban

# Strong types
BIDI_L   = 0   # Left-to-Right
BIDI_R   = 1   # Right-to-Left
BIDI_AL  = 2   # Arabic Letter

# Weak types
BIDI_EN  = 3   # European Number
BIDI_ES  = 4   # European Separator
BIDI_ET  = 5   # European Terminator
BIDI_AN  = 6   # Arabic Number
BIDI_CS  = 7   # Common Separator
BIDI_NSM = 8   # Non-Spacing Mark
BIDI_BN  = 9   # Boundary Neutral

# Neutral types
BIDI_B   = 10  # Paragraph Separator
BIDI_S   = 11  # Segment Separator
BIDI_WS  = 12  # White Space
BIDI_ON  = 13  # Other Neutral

# Explicit formatting
BIDI_LRE = 14  # Left-to-Right Embedding
BIDI_LRO = 15  # Left-to-Right Override
BIDI_RLE = 16  # Right-to-Left Embedding
BIDI_RLO = 17  # Right-to-Left Override
BIDI_PDF = 18  # Pop Directional Format
BIDI_LRI = 19  # Left-to-Right Isolate
BIDI_RLI = 20  # Right-to-Left Isolate
BIDI_FSI = 21  # First Strong Isolate
BIDI_PDI = 22  # Pop Directional Isolate

# Bidi class count
BIDI_CLASS_COUNT = 23

# Max embedding level (UAX #9: 61 levels, 0-125)
BIDI_MAX_LEVEL = 125

# Direction flags
DIR_LTR = 0
DIR_RTL = 1

# NOTE: HB_DIRECTION_*/HB_SCRIPT_*/HB_BUFFER_FLAG_* + Hb* structs + pinvoke
# da chuyen sang leaf TkvUI.HarfBuzz (import o tren). Bidi giu chi Bidi-specific.

# Bidi character info record
class BidiCharInfo:
    ch: "str"
    bidi_class: "i32"
    orig_index: "i32"
    level: "i32"
    def __init__(self, ch, bidi_class, orig_index, level):
        self.ch = ch
        self.bidi_class = bidi_class
        self.orig_index = orig_index
        self.level = level

# Paragraph info
# Record khong chua list (rang buoc TokenVector) - chi luu text va level
# chars duoc quan ly rieng ngoai record
class BidiParagraph:
    text: "str"
    para_level: "i32"
    def __init__(self, text, para_level):
        self.text = text
        self.para_level = para_level

# Unicode database: bidi class for each codepoint
# Day la bang nang luong - chi chua cac range quan trong
# Full table se duoc load tu file hoac sinh bang code

def bidi_get_class(ch: "str") -> "i32":
    """Tra ve bidi class cua ky tu (codepoint).
    Neu khong tim thay tra ve BIDI_L (mac dinh LTR)."""
    if len(ch) != 1:
        return BIDI_L
    cp = char_code(ch)
    
    # ASCII control
    ctrl_max = 31  # 0x1F
    del_char = 127  # 0x7F
    if cp <= ctrl_max:
        return BIDI_BN
    if cp == del_char:
        return BIDI_BN
    
    # Space
    if cp == 32:
        return BIDI_WS
    
    # European number separator
    plus_sign = 43
    minus_sign = 45
    if cp == plus_sign:
        return BIDI_ES
    if cp == minus_sign:
        return BIDI_ES
    if cp == 46:
        return BIDI_CS
    if cp == 47:
        return BIDI_CS
    
    # Digits 0-9
    if cp >= 48:
        if cp <= 57:
            return BIDI_EN
    
    # Colon, semicolon
    if cp == 58:
        return BIDI_CS
    if cp == 59:
        return BIDI_CS
    
    # @ A-Z [\]^_ ` a-z {|}~
    if cp >= 65:
        if cp <= 90:
            return BIDI_L
    if cp >= 97:
        if cp <= 122:
            return BIDI_L
    
    # Explicit formatting chars
    if cp == 8234:
        return BIDI_LRE
    if cp == 8235:
        return BIDI_RLE
    if cp == 8236:
        return BIDI_PDF
    if cp == 8237:
        return BIDI_LRO
    if cp == 8238:
        return BIDI_RLO
    if cp == 8294:
        return BIDI_LRI
    if cp == 8295:
        return BIDI_RLI
    if cp == 8296:
        return BIDI_FSI
    if cp == 8297:
        return BIDI_PDI
    
    # European number separator
    plus_sign = 43
    minus_sign = 45
    dot_char = 46
    slash_char = 47
    if cp == plus_sign:
        return BIDI_ES
    if cp == minus_sign:
        return BIDI_ES
    if cp == dot_char:
        return BIDI_CS
    if cp == slash_char:
        return BIDI_CS
    
    # Digits 0-9
    zero_char = 48
    nine_char = 57
    if cp >= zero_char:
        if cp <= nine_char:
            return BIDI_EN
    
    # Colon, semicolon
    colon_char = 58
    semicolon_char = 59
    if cp == colon_char:
        return BIDI_CS
    if cp == semicolon_char:
        return BIDI_CS
    
    # @ A-Z [\]^_ ` a-z {|}~
    cap_A = 65
    cap_Z = 90
    low_a = 97
    low_z = 122
    if cp >= cap_A:
        if cp <= cap_Z:
            return BIDI_L
    if cp >= low_a:
        if cp <= low_z:
            return BIDI_L
    
    # Explicit formatting chars
    lre_char = 8234
    rle_char = 8235
    pdf_char = 8236
    lro_char = 8237
    rlo_char = 8238
    lri_char = 8294
    rli_char = 8295
    fsi_char = 8296
    pdi_char = 8297
    if cp == lre_char:
        return BIDI_LRE
    if cp == rle_char:
        return BIDI_RLE
    if cp == pdf_char:
        return BIDI_PDF
    if cp == lro_char:
        return BIDI_LRO
    if cp == rlo_char:
        return BIDI_RLO
    if cp == lri_char:
        return BIDI_LRI
    if cp == rli_char:
        return BIDI_RLI
    if cp == fsi_char:
        return BIDI_FSI
    if cp == pdi_char:
        return BIDI_PDI
    
    # Arabic ranges (simplified)
    arabic_start1 = 1536
    arabic_end1 = 1791
    if cp >= arabic_start1:
        if cp <= arabic_end1:
            return BIDI_AL
    arabic_start2 = 1872
    arabic_end2 = 1919
    if cp >= arabic_start2:
        if cp <= arabic_end2:
            return BIDI_AL
    arabic_start3 = 2208
    arabic_end3 = 2303
    if cp >= arabic_start3:
        if cp <= arabic_end3:
            return BIDI_AL
    arabic_start4 = 64208
    arabic_end4 = 65023
    if cp >= arabic_start4:
        if cp <= arabic_end4:
            return BIDI_AL
    arabic_start5 = 65008
    arabic_end5 = 65279
    if cp >= arabic_start5:
        if cp <= arabic_end5:
            return BIDI_AL
    
    # Hebrew
    hebrew_start = 1424
    hebrew_end = 1535
    if cp >= hebrew_start:
        if cp <= hebrew_end:
            return BIDI_R
    
    # RTL scripts
    nko_start = 1984
    nko_end = 2047
    if cp >= nko_start:
        if cp <= nko_end:
            return BIDI_R
    samaritan_start = 2048
    samaritan_end = 2111
    if cp >= samaritan_start:
        if cp <= samaritan_end:
            return BIDI_R
    mandaic_start = 2112
    mandaic_end = 2143
    if cp >= mandaic_start:
        if cp <= mandaic_end:
            return BIDI_R
    syriac_start = 2144
    syriac_end = 2159
    if cp >= syriac_start:
        if cp <= syriac_end:
            return BIDI_AL
    
    # Default: L
    return BIDI_L

def bidi_is_strong(cls: "i32") -> "i32":
    if cls == BIDI_L or cls == BIDI_R or cls == BIDI_AL:
        return 1
    return 0

def bidi_is_weak(cls: "i32") -> "i32":
    if cls >= BIDI_EN and cls <= BIDI_BN:
        return 1
    return 0

def bidi_is_neutral(cls: "i32") -> "i32":
    if cls >= BIDI_B and cls <= BIDI_ON:
        return 1
    return 0

def bidi_is_explicit(cls: "i32") -> "i32":
    if cls >= BIDI_LRE and cls <= BIDI_PDI:
        return 1
    return 0

def bidi_is_rtl(cls: "i32") -> "i32":
    if cls == BIDI_R or cls == BIDI_AL:
        return 1
    return 0

def bidi_is_ltr(cls: "i32") -> "i32":
    if cls == BIDI_L:
        return 1
    return 0

def bidi_mirror_char(ch: "str") -> "str":
    """Tra ve ky tu mirror neu co (UAX #9 Table 4).
    Hien tai chi ho tro cac cap co ban."""
    if len(ch) != 1:
        return ch
    cp = char_code(ch)
    
    # Common mirror pairs (decimal)
    if cp == 40:
        return ")"
    if cp == 41:
        return "("
    if cp == 60:
        return ">"
    if cp == 62:
        return "<"
    if cp == 91:
        return "]"
    if cp == 93:
        return "["
    if cp == 123:
        return "}"
    if cp == 125:
        return "{"
    if cp == 171:
        return "»"
    if cp == 187:
        return "«"
    if cp == 8216:
        return "‘"
    if cp == 8217:
        return "’"
    if cp == 8220:
        return "“"
    if cp == 8221:
        return "”"
    if cp == 8249:
        return "›"
    if cp == 8250:
        return "‹"
    if cp == 8317:
        return "⁽"
    if cp == 8318:
        return "⁾"
    if cp == 8333:
        return "₍"
    if cp == 8334:
        return "₎"
    if cp == 9001:
        return "〈"
    if cp == 9002:
        return "〉"
    if cp == 12296:
        return "〈"
    if cp == 12297:
        return "〉"
    if cp == 12298:
        return "《"
    if cp == 12299:
        return "》"
    if cp == 12300:
        return "「"
    if cp == 12301:
        return "」"
    if cp == 12302:
        return "『"
    if cp == 12303:
        return "』"
    if cp == 12304:
        return "【"
    if cp == 12305:
        return "】"
    if cp == 12308:
        return "〔"
    if cp == 12309:
        return "〕"
    if cp == 12310:
        return "〔"
    if cp == 12311:
        return "〕"
    if cp == 12312:
        return "〝"
    if cp == 12313:
        return "〞"
    if cp == 12314:
        return "〝"
    if cp == 12315:
        return "〞"
    if cp == 12317:
        return "〝"
    if cp == 12318:
        return "〞"
    if cp == 12319:
        return "〟"
    
    return ch

# Bidi run info
class BidiRun:
    start: "i32"
    limit: "i32"
    level: "i32"
    def __init__(self, start, limit, level):
        self.start = start
        self.limit = limit
        self.level = level

def bidi_paragraph_level(text: "str") -> "i32":
    """Xac dinh paragraph embedding level (P2, P3).
    Tim first strong character (L, R, AL).
    Neu khong co -> mac dinh LTR (level 0)."""
    n = len(text)
    i = 0
    while i < n:
        cls = bidi_get_class(text[i])
        if cls == BIDI_L:
            return 0
        if cls == BIDI_R or cls == BIDI_AL:
            return 1
        i = i + 1
    return 0

# Stack frame for explicit embeddings
class BidiStackFrame:
    level: "i32"
    override: "i32"  # 0=none, 1=LRO, 2=RLO
    isolate: "i32"   # 0=none, 1=LRI, 2=RLI, 3=FSI
    def __init__(self, level, override, isolate):
        self.level = level
        self.override = override
        self.isolate = isolate

# =========================================================
# Bidi + HarfBuzz Integration Helpers (Bidi-specific; FFI/shape o TkvUI.HarfBuzz)
# =========================================================

def bidi_hb_direction_from_para_level(para_level: "i32") -> "i32":
    """Chuyen paragraph level sang HB_DIRECTION."""
    if para_level % 2 == 0:
        return HB_DIRECTION_LTR
    return HB_DIRECTION_RTL

def hb_script_from_bidi_class(bidi_class: "i32") -> "i32":
    """Map bidi class den HB_SCRIPT_* (heuristic)."""
    if bidi_class == BIDI_AL:
        return HB_SCRIPT_ARABIC
    if bidi_class == BIDI_R:
        return HB_SCRIPT_HEBREW
    if bidi_class == BIDI_L:
        return HB_SCRIPT_LATIN
    return HB_SCRIPT_COMMON

def hb_script_for_text(text: "str") -> "i32":
    """Heuristic script theo strong dau tien (byte-level; day du can giai ma codepoint)."""
    n = len(text)
    i = 0
    while i < n:
        cls = bidi_get_class(text[i])
        if cls == BIDI_AL:
            return HB_SCRIPT_ARABIC
        if cls == BIDI_R:
            return HB_SCRIPT_HEBREW
        if cls == BIDI_L:
            return HB_SCRIPT_LATIN
        i = i + 1
    return HB_SCRIPT_COMMON

class HbShapePlan:
    direction: "i32"
    script: "i32"
    para_level: "i32"
    language: "str"
    def __init__(self, direction, script, para_level, language):
        self.direction = direction
        self.script = script
        self.para_level = para_level
        self.language = language

def hb_shape_plan(text: "str", language: "str") -> "HbShapePlan":
    """Lap ke hoach shaping pure (khong goi DLL): direction/script/para/language."""
    para = bidi_paragraph_level(text)
    direction = bidi_hb_direction_from_para_level(para)
    script = hb_script_for_text(text)
    return HbShapePlan(direction, script, para, language)

# =========================================================
# UTF-8 sequence split + visual draw (milestone RTL).
# utf8_seq_len (dinh nghia trong TkvUI.Viet) chi dung so sanh 1-don-vi
# (1v1) + ==: so sanh nhieu-don-vi co F0 cho ket qua sai
# (probe: "F0F0" >= "F09F.." = 0). ASCII -> 1; F0.. -> 4; E0..EF -> 3;
# con lai (C2..DF + byte le) -> 2. Khong bao gio tra 0.
# Range class (so sanh 2v2 cung-do-dai, da verify): Viet -> L;
# Hebrew [א,ا) -> R; 2-byte >= ا -> AL; 3-byte -> L; 4-byte -> ON.
# Literal UTF-8 trong source con nguyen (da hexdump). Test swap dung 1
# chuoi + doi direction (auto-direction render "אA" va "Aא" giong nhau).
# Glyph that: bake subset vao atlas qua TkvUI.I18nData + text_atlas_draw_i18n
# (emoji van box: can cmap format12 + outline mau, ngoai pham vi parser).
# =========================================================

BIDI_DIR_AUTO = 0
BIDI_DIR_RTL = 1
BIDI_DIR_LTR = 2

# utf8_seq_len da chuyen sang TkvUI.Viet (leaf, de Text dung chung ma khong
# vong import). Bidi goi qua import (khong doi call site).

def utf8_seq_range(seq: "str", adv: "i32") -> "i32":
    if adv == 1:
        return bidi_get_class(seq)
    if vi_bits(seq) >= 0:
        return BIDI_L
    if adv == 2:
        if seq >= "א":
            if seq < "ا":
                return BIDI_R
        if seq >= "ا":
            return BIDI_AL
        return BIDI_L
    if adv == 3:
        return BIDI_L
    return BIDI_ON

def bidi_is_surrogate(u: "str") -> "i32":
    # Don vi UTF-16 le (D800-DFFF)? Khong viet literal/chr() truc tiep duoc
    # (invalid UTF-8 / ConvertFromUtf32 nem) nen kep bang 2 bien hop-le
    # D7FF/E000 (da probe ordinal-dung 4/4 tren tkvc 22:14).
    if u > chr(55295):
        if u < chr(57344):
            return 1
    return 0

def bidi_seq_step(text: "str", n: "i32", off: "i32") -> "i32":
    # So units cua 1 sequence tai off: 2 neu astral pair hop-le, else 1.
    if off < 0:
        return 1
    if off >= n:
        return 1
    if bidi_is_surrogate(text[off:off + 1]) == 1:
        if off + 1 < n:
            if bidi_is_surrogate(text[off + 1:off + 2]) == 1:
                return 2
    return 1

def bidi_seq_classes(text: "str") -> "list[i32]":
    out = []
    n = len(text)
    idx = 0
    while idx < n:
        step = bidi_seq_step(text, n, idx)
        adv = 4
        if step == 1:
            adv = utf8_seq_len(text, idx)
        cls = utf8_seq_range(text[idx:idx + step], adv)
        out.append(cls)
        idx = idx + step
    return out

def bidi_seq_offset(text: "str", n: "i32", s: "i32") -> "i32":
    # Map class index -> unit offset (di qua pair nhu seq_classes).
    if s <= 0:
        return 0
    off = int(0)
    ci = int(0)
    while ci < s:
        if off >= n:
            return n
        off = off + bidi_seq_step(text, n, off)
        ci = ci + 1
    if off > n:
        return n
    return off

def bidi_draw_visual(buf: "list[i64]", surf: "PixelSurface", text: "str", x: "f64", y: "f64", scale: "f64", color: "ColorRgba", direction: "i32") -> "i32":
    """Ve text theo visual order (RTL/mirror), sequence-aware; tra 1."""
    n = len(text)
    if n == 0:
        return 1
    classes = bidi_seq_classes(text)
    m = len(classes)
    para = bidi_para_level_of(classes, m)
    if direction == BIDI_DIR_RTL:
        para = 1
    if direction == BIDI_DIR_LTR:
        para = 0
    levels = bidi_levels_init(m, para)
    bidi_neutral_resolve(classes, m, para)
    bidi_implicit_resolve(classes, levels, m)
    order = bidi_visual_order(levels, m)
    cur = x
    k = 0
    while k < m:
        s = order[k]
        off = bidi_seq_offset(text, n, s)
        seg = text[off:off + bidi_seq_step(text, n, off)]
        lv = levels[s]
        if lv % 2 == 1:
            seg = bidi_mirror_char(seg)
        draw_string(buf, surf, seg, cur, y, scale, color)
        mm = measure_string(seg, scale)
        cur = cur + mm.w
        k = k + 1
    return 1

def bidi_draw_visual_atlas(buf: "list[i64]", surf: "PixelSurface", iabuf: "list[i64]", iatlas: "PixelSurface", text: "str", x: "f64", y: "f64", scale: "f64", color: "ColorRgba", direction: "i32") -> "i32":
    """Ve text theo visual order, seq co trong atlas i18n thi blit glyph that,
    seq la thi draw_string nhu cu (giu mirror). Atlas bake o scale 1."""
    n = len(text)
    if n == 0:
        return 1
    classes = bidi_seq_classes(text)
    m = len(classes)
    para = bidi_para_level_of(classes, m)
    if direction == BIDI_DIR_RTL:
        para = 1
    if direction == BIDI_DIR_LTR:
        para = 0
    levels = bidi_levels_init(m, para)
    bidi_neutral_resolve(classes, m, para)
    bidi_implicit_resolve(classes, levels, m)
    order = bidi_visual_order(levels, m)
    sc = int(scale)
    if sc < 1:
        sc = 1
    cur = x
    k = 0
    while k < m:
        s = order[k]
        off = bidi_seq_offset(text, n, s)
        seg = text[off:off + bidi_seq_step(text, n, off)]
        lv = levels[s]
        if lv % 2 == 1:
            seg = bidi_mirror_char(seg)
        slot = -1
        cp = i18n_codepoint(seg)
        if cp >= 0:
            slot = i18n_slot_for(cp)
        if slot >= 0:
            atlas_blit_glyph(iabuf, iatlas, buf, surf, slot, int(cur), int(y), color, color.a)
            cur = cur + float(6 * sc)
        else:
            draw_string(buf, surf, seg, cur, y, scale, color)
            mm = measure_string(seg, scale)
            cur = cur + mm.w
        k = k + 1
    return 1

# =========================================================
# Main bidi processing functions se duoc them o day
# 1. bidi_resolve_explicit() - X2, X3, X4, X5, X6, X7, X8
# 2. bidi_resolve_weak() - W1..W7
# 3. bidi_resolve_neutral() - N1, N2
# 4. bidi_resolve_implicit() - I1, I2
# 4. bidi_reorder() - L1, L2, L3, L4

def bidi_process(text: "str") -> "BidiParagraph":
    """Xu ly van ban: tra ve BidiParagraph voi levels da resolved."""
    n = len(text)
    if n == 0:
        p = BidiParagraph("", 0)
        return p
    
    # Step 1: Build initial char info array
    chars = []
    i = 0
    while i < n:
        ch = text[i]
        cls = bidi_get_class(ch)
        info = BidiCharInfo(ch, cls, i, 0)
        chars.append(info)
        i = i + 1
    
    # Step 2: Determine paragraph level
    para_level = bidi_paragraph_level(text)
    
    # TODO: Implement full resolution phases (explicit, weak, neutral, implicit, reorder)
    # For now, just return paragraph info
    p = BidiParagraph(text, para_level)
    return p

# =========================================================
# Bidi Resolution Algorithms (UAX #9)
# =========================================================

def bidi_resolve_explicit(chars: "list[BidiCharInfo]", para_level: "i32") -> "list[BidiCharInfo]":
    """X2-X8: Resolve explicit embeddings and overrides.
    TODO: Full implementation requires array element mutation which is not supported in TokenVector."""
    # Return unchanged for now - explicit resolution is complex and requires
    # mutable record updates which TokenVector doesn't support on array elements
    return chars


def bidi_resolve_weak(chars: "list[BidiCharInfo]") -> "list[BidiCharInfo]":
    """W1-W7: Resolve weak types.
    TODO: Full implementation requires array element mutation which is not supported in TokenVector."""
    return chars

def bidi_resolve_neutral(chars: "list[BidiCharInfo]") -> "list[BidiCharInfo]":
    """N1, N2: Resolve neutral types.
    TODO: Full implementation requires array element mutation which is not supported in TokenVector."""
    return chars

def bidi_resolve_implicit(chars: "list[BidiCharInfo]") -> "list[BidiCharInfo]":
    """I1, I2: Resolve implicit levels.
    TODO: Full implementation requires array element mutation which is not supported in TokenVector."""
    return chars

def bidi_reorder(chars: "list[BidiCharInfo]") -> "list[BidiRun]":
    """L1-L4: Reorder runs for visual display.
    TODO: Full implementation requires array element mutation which is not supported in TokenVector."""
    return []

def bidi_get_visual_runs(para: "BidiParagraph", chars: "list[BidiCharInfo]") -> "list[BidiRun]":
    """Lay danh sach run theo thu tu visual (sau reorder)."""
    return bidi_reorder(chars)

# =========================================================
# X/W/N/I + visual tren parallel list (tranh mutate field tren
# phan tu list - rang buoc compiler; index-set tren list[i32] OK)
# =========================================================

def bidi_classify_all(chars: "list[str]", n: "i32") -> "list[i32]":
    out = []
    i = 0
    while i < n:
        out.append(bidi_get_class(chars[i]))
        i = i + 1
    return out

def bidi_para_level_of(classes: "list[i32]", n: "i32") -> "i32":
    i = 0
    while i < n:
        c = classes[i]
        if c == BIDI_L:
            return 0
        if c == BIDI_R:
            return 1
        if c == BIDI_AL:
            return 1
        i = i + 1
    return 0

def bidi_levels_init(n: "i32", para: "i32") -> "list[i32]":
    out = []
    i = 0
    while i < n:
        out.append(para)
        i = i + 1
    return out

def bidi_weak_resolve(classes: "list[i32]", n: "i32") -> "i32":
    # W1: NSM <- prev (dau -> ON)
    i = 0
    while i < n:
        c = classes[i]
        if c == BIDI_NSM:
            if i == 0:
                classes[i] = BIDI_ON
            else:
                p = classes[i - 1]
                classes[i] = p
        i = i + 1
    # W2: EN <- AL -> AN
    i = 0
    while i < n:
        c = classes[i]
        if c == BIDI_EN:
            j = i - 1
            while j >= 0:
                d = classes[j]
                if d == BIDI_L or d == BIDI_R or d == BIDI_AL:
                    if d == BIDI_AL:
                        classes[i] = BIDI_AN
                    break
                j = j - 1
        i = i + 1
    # W3: AL -> R
    i = 0
    while i < n:
        c = classes[i]
        if c == BIDI_AL:
            classes[i] = BIDI_R
        i = i + 1
    # W4: ES/CS don giua EN-EN / AN-AN
    i = 0
    while i < n:
        c = classes[i]
        if c == BIDI_ES or c == BIDI_CS:
            if i > 0 and i + 1 < n:
                l = classes[i - 1]
                r = classes[i + 1]
                if l == BIDI_EN and r == BIDI_EN:
                    classes[i] = BIDI_EN
                if l == BIDI_AN and r == BIDI_AN:
                    classes[i] = BIDI_AN
        i = i + 1
    # W5: ET ke EN -> EN
    i = 0
    while i < n:
        c = classes[i]
        if c == BIDI_ET:
            hit = 0
            if i > 0:
                l = classes[i - 1]
                if l == BIDI_EN:
                    hit = 1
            if i + 1 < n:
                r = classes[i + 1]
                if r == BIDI_EN:
                    hit = 1
            if hit == 1:
                classes[i] = BIDI_EN
        i = i + 1
    # W6: ES/ET/CS con lai -> ON
    i = 0
    while i < n:
        c = classes[i]
        if c == BIDI_ES or c == BIDI_ET or c == BIDI_CS:
            classes[i] = BIDI_ON
        i = i + 1
    # W7: EN <- L -> L
    i = 0
    while i < n:
        c = classes[i]
        if c == BIDI_EN:
            j = i - 1
            while j >= 0:
                d = classes[j]
                if d == BIDI_L:
                    classes[i] = BIDI_L
                    break
                if d == BIDI_R or d == BIDI_AL:
                    break
                j = j - 1
        i = i + 1
    return 1

def bidi_neutral_resolve(classes: "list[i32]", n: "i32", para: "i32") -> "i32":
    # N1: neutral lay strong 2 ben; N2: con lai -> para dir (don gian hoa, chua full sor/eos).
    none = 0 - 1
    i = 0
    while i < n:
        c = classes[i]
        if c == BIDI_B or c == BIDI_S or c == BIDI_WS or c == BIDI_ON:
            b = none
            j = i - 1
            while j >= 0:
                d = classes[j]
                if d == BIDI_L or d == BIDI_R or d == BIDI_AL:
                    b = d
                    break
                j = j - 1
            a = none
            j = i + 1
            while j < n:
                d = classes[j]
                if d == BIDI_L or d == BIDI_R or d == BIDI_AL:
                    a = d
                    break
                j = j + 1
            if b != none and b == a:
                if b == BIDI_L:
                    classes[i] = BIDI_L
                else:
                    classes[i] = BIDI_R
            elif b != none:
                if b == BIDI_L:
                    classes[i] = BIDI_L
                else:
                    classes[i] = BIDI_R
            elif a != none:
                if a == BIDI_L:
                    classes[i] = BIDI_L
                else:
                    classes[i] = BIDI_R
            else:
                if para % 2 == 0:
                    classes[i] = BIDI_L
                else:
                    classes[i] = BIDI_R
        i = i + 1
    return 1

def bidi_implicit_resolve(classes: "list[i32]", levels: "list[i32]", n: "i32") -> "i32":
    # I1: chan: R/AL -> +1; I2: le: L -> +1.
    i = 0
    while i < n:
        c = classes[i]
        lv = levels[i]
        if lv % 2 == 0:
            if c == BIDI_R or c == BIDI_AL:
                levels[i] = lv + 1
        else:
            if c == BIDI_L:
                levels[i] = lv + 1
        i = i + 1
    return 1

def bidi_visual_order(levels: "list[i32]", n: "i32") -> "list[i32]":
    # L1/L2: identity roi dao tung run co level >= L, tu max xuong 1.
    order = []
    i = 0
    while i < n:
        order.append(i)
        i = i + 1
    maxlv = 0
    i = 0
    while i < n:
        lv = levels[i]
        if lv > maxlv:
            maxlv = lv
        i = i + 1
    lev = maxlv
    while lev >= 1:
        neworder = []
        i = 0
        while i < n:
            idx = order[i]
            lv = levels[idx]
            if lv >= lev:
                run = []
                while i < n:
                    idx2 = order[i]
                    lv2 = levels[idx2]
                    if lv2 < lev:
                        break
                    run.append(idx2)
                    i = i + 1
                j = len(run) - 1
                while j >= 0:
                    neworder.append(run[j])
                    j = j - 1
            else:
                neworder.append(idx)
                i = i + 1
        order = neworder
        lev = lev - 1
    return order

def bidi_visual_text(chars: "list[str]", order: "list[i32]", levels: "list[i32]", n: "i32") -> "str":
    # L4: mirror ky tu o run le + ghep theo visual order.
    out = ""
    k = 0
    while k < n:
        idx = order[k]
        ch = chars[idx]
        lv = levels[idx]
        if lv % 2 == 1:
            ch = bidi_mirror_char(ch)
        out = out + ch
        k = k + 1
    return out

# Self-test
def bidi_buf_equal(b1: "list[i64]", b2: "list[i64]", n: "i32") -> "i32":
    i = int(0)
    while i < n:
        if b1[i] != b2[i]:
            return 0
        i = i + 1
    return 1

def bidi_selftest() -> "str":
    acc = []
    acc.append(0)
    acc.append(0)
    
# Test bidi_get_class with ASCII characters (safe for source encoding)
    text_check_i(acc, "BIDI class L (A)", bidi_get_class("A"), BIDI_L)
    text_check_i(acc, "BIDI class L (R)", bidi_get_class("R"), BIDI_L)  # ASCII is LTR
    text_check_i(acc, "BIDI class L (a)", bidi_get_class("a"), BIDI_L)
    text_check_i(acc, "BIDI class EN", bidi_get_class("1"), BIDI_EN)
    text_check_i(acc, "BIDI class WS", bidi_get_class(" "), BIDI_WS)
    # Skip explicit formatting chars (non-ASCII in source)
    
    # Test mirror
    text_check(acc, "mirror (", bidi_mirror_char("(") == ")")
    text_check(acc, "mirror )", bidi_mirror_char(")") == "(")
    text_check(acc, "mirror <", bidi_mirror_char("<") == ">")
    text_check(acc, "mirror >", bidi_mirror_char(">") == "<")
    text_check(acc, "mirror [", bidi_mirror_char("[") == "]")
    text_check(acc, "mirror ]", bidi_mirror_char("]") == "[")
    text_check(acc, "mirror {", bidi_mirror_char("{") == "}")
    text_check(acc, "mirror }", bidi_mirror_char("}") == "{")
    
    # Test paragraph level (ASCII only)
    text_check_i(acc, "para level LTR", bidi_paragraph_level("Hello"), 0)
    text_check_i(acc, "para level digits", bidi_paragraph_level("123"), 0)
    text_check_i(acc, "para level empty", bidi_paragraph_level(""), 0)
    
    # Test strong/weak/neutral
    text_check(acc, "is strong L", bidi_is_strong(BIDI_L) == 1)
    text_check(acc, "is strong R", bidi_is_strong(BIDI_R) == 1)
    text_check(acc, "is strong AL", bidi_is_strong(BIDI_AL) == 1)
    text_check(acc, "is weak EN", bidi_is_weak(BIDI_EN) == 1)
    text_check(acc, "is weak ES", bidi_is_weak(BIDI_ES) == 1)
    text_check(acc, "is neutral WS", bidi_is_neutral(BIDI_WS) == 1)
    text_check(acc, "is neutral ON", bidi_is_neutral(BIDI_ON) == 1)
    text_check(acc, "is explicit LRE", bidi_is_explicit(BIDI_LRE) == 1)
    text_check(acc, "is explicit RLE", bidi_is_explicit(BIDI_RLE) == 1)

    # --- shaping plan (pure, khong goi DLL) ---
    text_check_i(acc, "hb dir para 0 -> LTR", bidi_hb_direction_from_para_level(0), HB_DIRECTION_LTR)
    text_check_i(acc, "hb dir para 1 -> RTL", bidi_hb_direction_from_para_level(1), HB_DIRECTION_RTL)
    text_check_i(acc, "hb script AL -> ARABIC", hb_script_from_bidi_class(BIDI_AL), HB_SCRIPT_ARABIC)
    text_check_i(acc, "hb script R -> HEBREW", hb_script_from_bidi_class(BIDI_R), HB_SCRIPT_HEBREW)
    text_check_i(acc, "hb script L -> LATIN", hb_script_from_bidi_class(BIDI_L), HB_SCRIPT_LATIN)
    text_check_i(acc, "hb script EN -> COMMON", hb_script_from_bidi_class(BIDI_EN), HB_SCRIPT_COMMON)
    text_check_i(acc, "hb script text Hello -> LATIN", hb_script_for_text("Hello"), HB_SCRIPT_LATIN)
    text_check_i(acc, "hb script text rong -> COMMON", hb_script_for_text(""), HB_SCRIPT_COMMON)
    text_check_i(acc, "hb script text so -> COMMON", hb_script_for_text("123"), HB_SCRIPT_COMMON)
    plan = hb_shape_plan("Hello", "en")
    text_check_i(acc, "hb plan Hello dir LTR", plan.direction, HB_DIRECTION_LTR)
    text_check_i(acc, "hb plan Hello script LATIN", plan.script, HB_SCRIPT_LATIN)
    text_check_i(acc, "hb plan Hello para 0", plan.para_level, 0)
    text_check(acc, "hb plan Hello lang en", plan.language == "en")
    plan2 = hb_shape_plan("", "")
    text_check_i(acc, "hb plan rong dir LTR", plan2.direction, HB_DIRECTION_LTR)
    text_check_i(acc, "hb plan rong script COMMON", plan2.script, HB_SCRIPT_COMMON)

    # --- shape pipeline (guard, khong crash khi thieu DLL) ---
    present = hb_lib_present()
    ok = 0
    if present == 0:
        ok = 1
    if present == 1:
        ok = 1
    text_check(acc, "hb lib present tra 0/1", ok)
    cnt = hb_shape_run("Hello", 0, HB_DIRECTION_LTR, HB_SCRIPT_LATIN, "en")
    ok2 = 0
    if cnt >= 0:
        ok2 = 1
    text_check(acc, "hb shape run khong crash", ok2)
    # --- shape that (can libharfbuzz.dll; font subset embedded, khong file I/O) ---
    hbg = []
    hba = []
    hbc = []
    hbn = hb_shape_full("אב", i18n_font_bytes_he(), HB_DIRECTION_LTR, HB_SCRIPT_HEBREW, "he", hbg, hba, hbc)
    if present == 1:
        text_check_i(acc, "hb shape heb count", hbn, 2)
        text_check_gt(acc, "hb shape gid0", hbg[0], 0)
        text_check_gt(acc, "hb shape gid1", hbg[1], 0)
        gdif = 0
        if hbg[0] != hbg[1]:
            gdif = 1
        text_check(acc, "hb shape gid khac nhau", gdif)
        text_check_i(acc, "hb shape cluster0", hbc[0], 0)
        text_check_i(acc, "hb shape cluster1", hbc[1], 2)
        text_check_gt(acc, "hb shape adv0", hba[0], 0)
        hbg2 = []
        hba2 = []
        hbc2 = []
        hbn2 = hb_shape_full("Hello", i18n_font_bytes_he(), HB_DIRECTION_LTR, HB_SCRIPT_LATIN, "en", hbg2, hba2, hbc2)
        text_check_i(acc, "hb shape lat count", hbn2, 5)
        text_check_i(acc, "hb shape lat cluster4", hbc2[4], 4)
        text_check_gt(acc, "hb shape lat adv0", hba2[0], 0)
        # single-char consistency (bat stride sai: gid don phai khop gid[0]/[1])
        hgo = []
        hao = []
        hco = []
        hbn3 = hb_shape_full("א", i18n_font_bytes_he(), HB_DIRECTION_LTR, HB_SCRIPT_HEBREW, "he", hgo, hao, hco)
        text_check_i(acc, "hb shape one count", hbn3, 1)
        text_check_i(acc, "hb shape one gid = heb gid0", hgo[0], hbg[0])
        hbp = []
        hap = []
        hcp = []
        hbn4 = hb_shape_full("ב", i18n_font_bytes_he(), HB_DIRECTION_LTR, HB_SCRIPT_HEBREW, "he", hbp, hap, hcp)
        text_check_i(acc, "hb shape one gid = heb gid1", hbp[0], hbg[1])
        # hằng số module == giá trị thật từ dll (hb_*_from_string)
        text_check_i(acc, "hb dll dir ltr", hb_direction_from_string_ex("ltr", -1), HB_DIRECTION_LTR)
        text_check_i(acc, "hb dll dir rtl", hb_direction_from_string_ex("rtl", -1), HB_DIRECTION_RTL)
        text_check_i(acc, "hb dll script Latn", hb_script_from_string_ex("Latn", -1), HB_SCRIPT_LATIN)
        text_check_i(acc, "hb dll script Arab", hb_script_from_string_ex("Arab", -1), HB_SCRIPT_ARABIC)
        text_check_i(acc, "hb dll script Hebr", hb_script_from_string_ex("Hebr", -1), HB_SCRIPT_HEBREW)
        text_check_gt(acc, "hb version dai", len(hb_version_string_ex()), 4)
        # font tu file + bake ground truth (arial.ttf — ctypes cung dll 14.5.0)
        arial = "C:\\Windows\\Fonts\\arial.ttf"
        if tkv_has_file(arial) == 1:
            ag = []
            aa = []
            ac = []
            an = hb_shape_text("ABC", arial, 0, ag, aa, ac, 0, 0, "")
            text_check_i(acc, "hb arial ABC n", an, 3)
            text_check_i(acc, "hb arial ABC gid0", ag[0], 36)
            text_check_i(acc, "hb arial ABC gid2", ag[2], 38)
            text_check_i(acc, "hb arial ABC adv0", aa[0], 1366)
            text_check_i(acc, "hb arial ABC adv2", aa[2], 1479)
            text_check_i(acc, "hb arial ABC cl1", ac[1], 1)
            hg = []
            ha = []
            hc = []
            hn2 = hb_shape_text("Hello", arial, 0, hg, ha, hc, 0, 0, "")
            text_check_i(acc, "hb arial Hello n", hn2, 5)
            text_check_i(acc, "hb arial Hello gid0", hg[0], 43)
            text_check_i(acc, "hb arial Hello adv1", ha[1], 1139)
            text_check_i(acc, "hb arial Hello adv2", ha[2], 455)
            mg = []
            ma = []
            mc = []
            mn = hb_shape_text("مرحبا", arial, 0, mg, ma, mc, 0, 0, "")
            text_check_i(acc, "hb arial arab n", mn, 5)
            text_check_i(acc, "hb arial arab gid0", mg[0], 910)
            text_check_i(acc, "hb arial arab gid4", mg[4], 995)
            text_check_i(acc, "hb arial arab adv0", ma[0], 470)
            text_check_i(acc, "hb arial arab adv3", ma[3], 1001)
            text_check_i(acc, "hb arial arab cl0", mc[0], 8)
            text_check_i(acc, "hb arial arab cl4", mc[4], 0)
    else:
        text_check_i(acc, "hb shape vang lib -> 0", hbn, 0)

    # --- UTF-8 byte length + encode (pure, khong can DLL) ---
    text_check_i(acc, "utf8 byte len Hello", utf8_byte_len("Hello"), 5)
    text_check_i(acc, "utf8 byte len heb", utf8_byte_len("אב"), 4)
    text_check_i(acc, "utf8 byte len arab", utf8_byte_len("مرحبا"), 10)
    text_check_i(acc, "utf8 byte len viet", utf8_byte_len("ệ"), 3)
    hbm = mem_alloc(8)
    hbw = utf8_encode_to_mem("é", hbm)
    hbv = mem_read_u32(hbm)
    hbfr = mem_free(hbm)
    text_check_i(acc, "utf8 encode e byte len", hbw, 2)
    text_check_i(acc, "utf8 encode e b0", hbv & 255, 195)
    text_check_i(acc, "utf8 encode e b1", (hbv >> 8) & 255, 169)
    # --- P2-B shaping orchestration (pure, khong can DLL) ---
    text_check_i(acc, "shape unit lat", shape_unit_script("A"), HB_SCRIPT_LATIN)
    text_check_i(acc, "shape unit digit", shape_unit_script("5"), HB_SCRIPT_COMMON)
    text_check_i(acc, "shape unit space", shape_unit_script(" "), HB_SCRIPT_COMMON)
    text_check_i(acc, "shape unit heb", shape_unit_script("א"), HB_SCRIPT_HEBREW)
    text_check_i(acc, "shape unit arab", shape_unit_script("ا"), HB_SCRIPT_ARABIC)
    text_check_i(acc, "shape unit deva", shape_unit_script("अ"), HB_SCRIPT_DEVANAGARI)
    text_check_i(acc, "shape unit beng", shape_unit_script("অ"), HB_SCRIPT_BENGALI)
    text_check_i(acc, "shape unit tamil", shape_unit_script("அ"), HB_SCRIPT_TAMIL)
    text_check_i(acc, "shape unit telugu", shape_unit_script("అ"), HB_SCRIPT_TELUGU)
    text_check_i(acc, "shape unit thai", shape_unit_script("ก"), HB_SCRIPT_THAI)
    text_check_i(acc, "shape unit han", shape_unit_script("你"), HB_SCRIPT_HAN)
    # thu tu anchors (bien gan dung Indic duoc kiem keo monotonicity)
    ordshat = 0
    if "א" < "ا":
        if "ا" < "अ":
            if "अ" < "অ":
                if "অ" < "அ":
                    if "அ" < "అ":
                        if "అ" < "ก":
                            if "ก" < "你":
                                ordshat = 1
    text_check_i(acc, "shape anchors order", ordshat, 1)
    text_check_i(acc, "shape dir heb rtl", shape_run_dir(HB_SCRIPT_HEBREW), HB_DIRECTION_RTL)
    text_check_i(acc, "shape dir lat ltr", shape_run_dir(HB_SCRIPT_LATIN), HB_DIRECTION_LTR)
    runs = []
    text_check_i(acc, "shape runs mix", shape_split_runs("AאB", runs), 3)
    text_check_i(acc, "shape run0 s", runs[0], 0)
    text_check_i(acc, "shape run0 e", runs[1], 1)
    text_check_i(acc, "shape run0 sc", runs[2], HB_SCRIPT_LATIN)
    text_check_i(acc, "shape run1 s", runs[4], 1)
    text_check_i(acc, "shape run1 e", runs[5], 2)
    text_check_i(acc, "shape run1 sc", runs[6], HB_SCRIPT_HEBREW)
    text_check_i(acc, "shape run1 dir", runs[7], HB_DIRECTION_RTL)
    text_check_i(acc, "shape run2 s", runs[8], 2)
    text_check_i(acc, "shape run2 e", runs[9], 3)
    runs2 = []
    text_check_i(acc, "shape runs join", shape_split_runs("AB 12", runs2), 1)
    text_check_i(acc, "shape join e", runs2[1], 5)
    runs0 = []
    text_check_i(acc, "shape runs empty", shape_split_runs("", runs0), 0)
    cls = []
    text_check_i(acc, "shape clusters", shape_seq_clusters("Aא", cls), 2)
    text_check_i(acc, "shape cl0 s", cls[0], 0)
    text_check_i(acc, "shape cl0 e", cls[1], 1)
    text_check_i(acc, "shape cl1 s", cls[2], 1)
    text_check_i(acc, "shape cl1 e", cls[3], 2)
    cls0 = []
    text_check_i(acc, "shape clusters empty", shape_seq_clusters("", cls0), 0)
    fadv = []
    fcl = []
    text_check_i(acc, "shape fallback n", shape_run_fallback("AB", 0, 2, fadv, fcl), 2)
    text_check_i(acc, "shape fallback adv", fadv[1], 6)
    text_check_i(acc, "shape fallback cl", fcl[1], 1)
    if present == 1:
        hgids = []
        hadv = []
        hcl = []
        hn = shape_run_hb("אב", 0, 4, i18n_font_bytes_he(), HB_SCRIPT_HEBREW, HB_DIRECTION_RTL, "he", hgids, hadv, hcl)
        text_check_i(acc, "shape hb heb n", hn, 2)
        # RTL -> thu tu VISUAL: glyph truoc = b (cluster byte 2), glyph sau = a (0)
        text_check_i(acc, "shape hb heb cl0", hcl[0], 2)
        text_check_i(acc, "shape hb heb cl1", hcl[1], 0)
    else:
        hgids = []
        hadv = []
        hcl = []
        text_check_i(acc, "shape hb vang lib", shape_run_hb("אב", 0, 4, i18n_font_bytes_he(), HB_SCRIPT_HEBREW, HB_DIRECTION_RTL, "he", hgids, hadv, hcl), 0)

    # --- X/W/N/I + visual tren parallel list ---
    tc = []
    tc.append("A")
    tc.append("1")
    tc.append(" ")
    cl = bidi_classify_all(tc, 3)
    text_check_i(acc, "bidi classify A", cl[0], 0)
    text_check_i(acc, "bidi classify 1", cl[1], 3)
    text_check_i(acc, "bidi classify space", cl[2], 12)
    pl1 = []
    pl1.append(0)
    pl1.append(3)
    text_check_i(acc, "bidi para_of L", bidi_para_level_of(pl1, 2), 0)
    pl2 = []
    pl2.append(1)
    text_check_i(acc, "bidi para_of R", bidi_para_level_of(pl2, 1), 1)
    pl3 = []
    pl3.append(3)
    text_check_i(acc, "bidi para_of EN -> 0", bidi_para_level_of(pl3, 1), 0)
    pl4 = []
    pl4.append(3)
    pl4.append(2)
    text_check_i(acc, "bidi para_of AL", bidi_para_level_of(pl4, 2), 1)
    li = bidi_levels_init(3, 1)
    text_check_i(acc, "bidi levels len", len(li), 3)
    text_check_i(acc, "bidi levels init 0", li[0], 1)
    text_check_i(acc, "bidi levels init 2", li[2], 1)
    w1a = []
    w1a.append(8)
    bidi_weak_resolve(w1a, 1)
    text_check_i(acc, "bidi W1 NSM dau -> ON", w1a[0], 13)
    w1b = []
    w1b.append(0)
    w1b.append(8)
    bidi_weak_resolve(w1b, 2)
    text_check_i(acc, "bidi W1 NSM <- L", w1b[1], 0)
    w3 = []
    w3.append(2)
    bidi_weak_resolve(w3, 1)
    text_check_i(acc, "bidi W3 AL -> R", w3[0], 1)
    w2 = []
    w2.append(2)
    w2.append(3)
    bidi_weak_resolve(w2, 2)
    text_check_i(acc, "bidi W2 EN <- AL -> AN", w2[1], 6)
    w4 = []
    w4.append(3)
    w4.append(7)
    w4.append(3)
    bidi_weak_resolve(w4, 3)
    text_check_i(acc, "bidi W4 CS giua EN", w4[1], 3)
    w5 = []
    w5.append(3)
    w5.append(5)
    bidi_weak_resolve(w5, 2)
    text_check_i(acc, "bidi W5 ET <- EN", w5[1], 3)
    w6 = []
    w6.append(4)
    bidi_weak_resolve(w6, 1)
    text_check_i(acc, "bidi W6 ES -> ON", w6[0], 13)
    w7 = []
    w7.append(0)
    w7.append(3)
    bidi_weak_resolve(w7, 2)
    text_check_i(acc, "bidi W7 EN <- L", w7[1], 0)
    n1 = []
    n1.append(0)
    n1.append(13)
    n1.append(0)
    bidi_neutral_resolve(n1, 3, 0)
    text_check_i(acc, "bidi N1 ON giua L", n1[1], 0)
    n2 = []
    n2.append(1)
    n2.append(13)
    n2.append(1)
    bidi_neutral_resolve(n2, 3, 0)
    text_check_i(acc, "bidi N1 ON giua R", n2[1], 1)
    n3 = []
    n3.append(13)
    bidi_neutral_resolve(n3, 1, 0)
    text_check_i(acc, "bidi N2 ON -> para L", n3[0], 0)
    n4 = []
    n4.append(13)
    bidi_neutral_resolve(n4, 1, 1)
    text_check_i(acc, "bidi N2 ON -> para R", n4[0], 1)
    im1c = []
    im1c.append(1)
    im1l = []
    im1l.append(0)
    bidi_implicit_resolve(im1c, im1l, 1)
    text_check_i(acc, "bidi I1 R@0 -> 1", im1l[0], 1)
    im2c = []
    im2c.append(0)
    im2l = []
    im2l.append(1)
    bidi_implicit_resolve(im2c, im2l, 1)
    text_check_i(acc, "bidi I2 L@1 -> 2", im2l[0], 2)
    im3c = []
    im3c.append(0)
    im3l = []
    im3l.append(0)
    bidi_implicit_resolve(im3c, im3l, 1)
    text_check_i(acc, "bidi I1 L@0 -> 0", im3l[0], 0)
    od = []
    od.append(0)
    od.append(0)
    od.append(1)
    od.append(1)
    od.append(0)
    vo = bidi_visual_order(od, 5)
    text_check_i(acc, "bidi order 0", vo[0], 0)
    text_check_i(acc, "bidi order 2 (dao)", vo[2], 3)
    text_check_i(acc, "bidi order 4", vo[4], 4)
    vc = []
    vc.append("a")
    vc.append("b")
    vc.append("(")
    vc.append(")")
    vo2 = []
    vo2.append(0)
    vo2.append(1)
    vo2.append(3)
    vo2.append(2)
    vl = []
    vl.append(0)
    vl.append(0)
    vl.append(1)
    vl.append(1)
    text_check(acc, "bidi visual text ab()", bidi_visual_text(vc, vo2, vl, 4) == "ab()")

    # --- seq split + draw visual ---
    sq = bidi_seq_classes("AB1 ")
    text_check_i(acc, "bidi seq AB1_ len", len(sq), 4)
    text_check_i(acc, "bidi seq A", sq[0], 0)
    text_check_i(acc, "bidi seq 1", sq[2], 3)
    text_check_i(acc, "bidi seq space", sq[3], 12)
    sv = bidi_seq_classes("Việt")
    text_check_i(acc, "bidi seq Viet len", len(sv), 4)
    text_check_i(acc, "bidi seq Viet e-moc", sv[2], 0)
    text_check_i(acc, "bidi seq off 0", bidi_seq_offset("Việt", 4, 0), 0)
    text_check_i(acc, "bidi seq off 2", bidi_seq_offset("Việt", 4, 2), 2)
    text_check_i(acc, "bidi seq off 3", bidi_seq_offset("Việt", 4, 3), 3)
    vbuf = []
    surface_ensure_capacity(vbuf, 4800)
    vsurf = PixelSurface(200, 24, 200)
    empty = ColorRgba(0, 0, 0, 0)
    white = ColorRgba(255, 255, 255, 255)
    surface_clear(vbuf, vsurf, empty)
    text_check_i(acc, "bidi draw visual tra 1", bidi_draw_visual(vbuf, vsurf, "Việt", 0.0, 0.0, 1.0, white, 0), 1)
    vpix = text_count_nonzero(vbuf, 4800, 0, 4800)
    surface_clear(vbuf, vsurf, empty)
    draw_string(vbuf, vsurf, "Việt", 0.0, 0.0, 1.0, white)
    text_check_i(acc, "bidi draw visual = draw_string", vpix, text_count_nonzero(vbuf, 4800, 0, 4800))
    surface_clear(vbuf, vsurf, empty)
    bidi_draw_visual(vbuf, vsurf, "AB", 0.0, 0.0, 1.0, white, 1)
    text_check_gt(acc, "bidi draw RTL Latin co pixel", text_count_nonzero(vbuf, 4800, 0, 4800), 0)

    # --- UTF-8 range classifier (Hebrew/Arabic/CJK/emoji that) ---
    hb2 = bidi_seq_classes("אב")
    text_check_i(acc, "bidi seq Heb len", len(hb2), 2)
    text_check_i(acc, "bidi seq Alef R", hb2[0], 1)
    text_check_i(acc, "bidi seq Bet R", hb2[1], 1)
    ab2 = bidi_seq_classes("اب")
    text_check_i(acc, "bidi seq Arab len", len(ab2), 2)
    text_check_i(acc, "bidi seq Alef-Arab AL", ab2[0], 2)
    text_check_i(acc, "bidi seq Ba AL", ab2[1], 2)
    text_check_i(acc, "bidi para Heb", bidi_para_level_of(hb2, 2), 1)
    text_check_i(acc, "bidi para Arab", bidi_para_level_of(ab2, 2), 1)
    mx = bidi_seq_classes("אA")
    ml = bidi_levels_init(2, 1)
    bidi_implicit_resolve(mx, ml, 2)
    mo = bidi_visual_order(ml, 2)
    text_check_i(acc, "bidi order HebRTL dau", mo[0], 1)
    text_check_i(acc, "bidi order HebRTL sau", mo[1], 0)
    sh = bidi_seq_classes("שלום")
    text_check_i(acc, "bidi seq Shalom len", len(sh), 4)
    text_check_i(acc, "bidi seq Shin R", sh[0], 1)
    text_check_i(acc, "bidi seq Mem-sofit R", sh[3], 1)
    nh = bidi_seq_classes("你好")
    text_check_i(acc, "bidi seq Nihao len", len(nh), 2)
    text_check_i(acc, "bidi seq Ni L", nh[0], 0)
    text_check_i(acc, "bidi seq Hao L", nh[1], 0)
    em = bidi_seq_classes("🌍")
    text_check_i(acc, "bidi seq emoji len", len(em), 1)
    text_check_i(acc, "bidi seq emoji ON", em[0], 13)
    surface_clear(vbuf, vsurf, empty)
    bidi_draw_visual(vbuf, vsurf, "אA", 0.0, 0.0, 1.0, white, 1)
    t1 = text_count_nonzero(vbuf, 4800, 0, 4800)
    surface_clear(vbuf, vsurf, empty)
    bidi_draw_visual(vbuf, vsurf, "אA", 0.0, 0.0, 1.0, white, 2)
    t2 = text_count_nonzero(vbuf, 4800, 0, 4800)
    text_check_i(acc, "bidi draw RTL/LTR cung pixel", t1, t2)
    surface_clear(vbuf, vsurf, empty)
    bidi_draw_visual(vbuf, vsurf, "אA", 0.0, 0.0, 1.0, white, 1)
    ebuf = []
    ei = 0
    while ei < 4800:
        ebuf.append(0)
        ei = ei + 1
    esurf = PixelSurface(200, 24, 200)
    surface_clear(ebuf, esurf, empty)
    draw_string(ebuf, esurf, "A", 0.0, 0.0, 1.0, white)
    draw_string(ebuf, esurf, "א", 6.0, 0.0, 1.0, white)
    text_check_i(acc, "bidi draw swap rtl", bidi_buf_equal(vbuf, ebuf, 4800), 1)
    surface_clear(vbuf, vsurf, empty)
    bidi_draw_visual(vbuf, vsurf, "אA", 0.0, 0.0, 1.0, white, 2)
    surface_clear(ebuf, esurf, empty)
    draw_string(ebuf, esurf, "א", 0.0, 0.0, 1.0, white)
    draw_string(ebuf, esurf, "A", 6.0, 0.0, 1.0, white)
    text_check_i(acc, "bidi draw swap ltr", bidi_buf_equal(vbuf, ebuf, 4800), 1)
    surface_clear(vbuf, vsurf, empty)
    text_check_i(acc, "bidi draw milestone tra 1", bidi_draw_visual(vbuf, vsurf, "你好 🌍 שלום", 0.0, 0.0, 1.0, white, 0), 1)
    text_check_gt(acc, "bidi draw milestone co pixel", text_count_nonzero(vbuf, 4800, 0, 4800), 0)
    # --- visual order + glyph that (atlas i18n): milestone Phase 1 ---
    iatl = text_atlas_record_i18n(1)
    iab = atlas_buffer(iatl)
    text_check_i(acc, "bidi atlas bake count", text_atlas_bake_i18n_all(iatl, iab), 10)
    surface_clear(vbuf, vsurf, empty)
    text_check_i(acc, "bidi atlas milestone tra 1", bidi_draw_visual_atlas(vbuf, vsurf, iab, iatl, "你好 🌍 שלום", 0.0, 0.0, 1.0, white, 0), 1)
    text_check_gt(acc, "bidi atlas milestone co pixel", text_count_nonzero(vbuf, 4800, 0, 4800), 0)
    surface_clear(vbuf, vsurf, empty)
    bidi_draw_visual_atlas(vbuf, vsurf, iab, iatl, "אA", 0.0, 0.0, 1.0, white, 1)
    at1 = text_count_nonzero(vbuf, 4800, 0, 4800)
    al1 = 0
    ar1 = 0
    zi = 0
    while zi < 8:
        al1 = al1 + text_count_nonzero(vbuf, 4800, zi * 200 + 0, zi * 200 + 6)
        ar1 = ar1 + text_count_nonzero(vbuf, 4800, zi * 200 + 6, zi * 200 + 12)
        zi = zi + 1
    surface_clear(vbuf, vsurf, empty)
    bidi_draw_visual_atlas(vbuf, vsurf, iab, iatl, "אA", 0.0, 0.0, 1.0, white, 2)
    at2 = text_count_nonzero(vbuf, 4800, 0, 4800)
    al2 = 0
    ar2 = 0
    zi = 0
    while zi < 8:
        al2 = al2 + text_count_nonzero(vbuf, 4800, zi * 200 + 0, zi * 200 + 6)
        ar2 = ar2 + text_count_nonzero(vbuf, 4800, zi * 200 + 6, zi * 200 + 12)
        zi = zi + 1
    text_check_i(acc, "bidi atlas RTL/LTR cung pixel", at1, at2)
    text_check_i(acc, "bidi atlas swap trai", al1, ar2)
    text_check_i(acc, "bidi atlas swap phai", ar1, al2)
    
    print("--- bidi selftest: " + str(acc[0]) + "/" + str(acc[1]) + " PASS ---")
    if acc[0] == acc[1]:
        return "BIDI_OK"
    return "BIDI_FAIL"