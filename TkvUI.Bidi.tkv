    white = ColorRgba(255, 255, 255, 255)
    surface_clear(vbuf, vsurf, empty)
    text_check_i(acc, "bidi draw visual tra 1", bidi_draw_visual(vbuf, vsurf, "Việt", 0.0, 0.0, 1.0, white, 0), 1)
    vpix = text_count_nonzero(vbuf, 4800, 0, 4800)
    surface_clear(vbuf, vsurf, empty)
    draw_string(vbuf, vsurf, "Việt", 0.0, 0.0, 1.0, white)
    text_check_i(acc, "bidi draw visual = draw_string", vpix, text_count_nonzero(vbuf, 4800, 0, 4800))
    surface_clear(vbuf, vsurf, empty)
    bidi_draw_visual(vbuf, vsurf, "AB", 0.0, 0.0, 1.0, white, 1)
    text_check_gt(acc, "bidi draw RTL Latin co pixel", text_count_nonzero(vbuf, 4800, 0, 4800), 0)

    # --- UTF-8 range classifier (Hebrew/Arabic/CJK/emoji that) ---
    hb2 = bidi_seq_classes("אב")
    text_check_i(acc, "bidi seq Heb len", len(hb2), 2)
    text_check_i(acc, "bidi seq Alef R", hb2[0], 1)
    text_check_i(acc, "bidi seq Bet R", hb2[1], 1)
    ab2 = bidi_seq_classes("اب")
    text_check_i(acc, "bidi seq Arab len", len(ab2), 2)
    text_check_i(acc, "bidi seq Alef-Arab AL", ab2[0], 2)
    text_check_i(acc, "bidi seq Ba AL", ab2[1], 2)
    text_check_i(acc, "bidi para Heb", bidi_para_level_of(hb2, 2), 1)
    text_check_i(acc, "bidi para Arab", bidi_para_level_of(ab2, 2), 1)
    mx = bidi_seq_classes("אA")
    ml = bidi_levels_init(2, 1)
    bidi_implicit_resolve(mx, ml, 2)
    mo = bidi_visual_order(ml, 2)
    text_check_i(acc, "bidi order HebRTL dau", mo[0], 1)
    text_check_i(acc, "bidi order HebRTL sau", mo[1], 0)
    sh = bidi_seq_classes("שלום")
    text_check_i(acc, "bidi seq Shalom len", len(sh), 4)
    text_check_i(acc, "bidi seq Shin R", sh[0], 1)
    text_check_i(acc, "bidi seq Mem-sofit R", sh[3], 1)
    nh = bidi_seq_classes("你好")
    text_check_i(acc, "bidi seq Nihao len", len(nh), 2)
    text_check_i(acc, "bidi seq Ni L", nh[0], 0)
    text_check_i(acc, "bidi seq Hao L", nh[1], 0)
    em = bidi_seq_classes("🌍")
    text_check_i(acc, "bidi seq emoji len", len(em), 1)
    text_check_i(acc, "bidi seq emoji ON", em[0], 13)
    surface_clear(vbuf, vsurf, empty)
    bidi_draw_visual(vbuf, vsurf, "אA", 0.0, 0.0, 1.0, white, 1)
    t1 = text_count_nonzero(vbuf, 4800, 0, 4800)
    surface_clear(vbuf, vsurf, empty)
    bidi_draw_visual(vbuf, vsurf, "אA", 0.0, 0.0, 1.0, white, 2)
    t2 = text_count_nonzero(vbuf, 4800, 0, 4800)
    text_check_i(acc, "bidi draw RTL/LTR cung pixel", t1, t2)
    surface_clear(vbuf, vsurf, empty)
    bidi_draw_visual(vbuf, vsurf, "אA", 0.0, 0.0, 1.0, white, 1)
    l1 = 0
    r1 = 0
    zi = 0
    while zi < 8:
        l1 = l1 + text_count_nonzero(vbuf, 4800, zi * 200 + 0, zi * 200 + 6)
        r1 = r1 + text_count_nonzero(vbuf, 4800, zi * 200 + 12, zi * 200 + 18)
        zi = zi + 1
    surface_clear(vbuf, vsurf, empty)
    bidi_draw_visual(vbuf, vsurf, "אA", 0.0, 0.0, 1.0, white, 2)
    l2 = 0
    r2 = 0
    zi = 0
    while zi < 8:
        l2 = l2 + text_count_nonzero(vbuf, 4800, zi * 200 + 0, zi * 200 + 6)
        r2 = r2 + text_count_nonzero(vbuf, 4800, zi * 200 + 12, zi * 200 + 18)
        zi = zi + 1
    text_check_i(acc, "bidi draw swap ngoai", l1, r2)
    text_check_i(acc, "bidi draw swap ngoai 2", r1, l2)
    surface_clear(vbuf, vsurf, empty)
    text_check_i(acc, "bidi draw milestone tra 1", bidi_draw_visual(vbuf, vsurf, "你好 🌍 שלום", 0.0, 0.0, 1.0, white, 0), 1)
    text_check_gt(acc, "bidi draw milestone co pixel", text_count_nonzero(vbuf, 4800, 0, 4800), 0)
    # --- visual order + glyph that (atlas i18n): milestone Phase 1 ---
    iatl = text_atlas_record_i18n(1)
    iab = atlas_buffer(iatl)
    text_check_i(acc, "bidi atlas bake count", text_atlas_bake_i18n_all(iatl, iab), 10)
    surface_clear(vbuf, vsurf, empty)
    text_check_i(acc, "bidi atlas milestone tra 1", bidi_draw_visual_atlas(vbuf, vsurf, iab, iatl, "你好 🌍 שלום", 0.0, 0.0, 1.0, white, 0), 1)
    text_check_gt(acc, "bidi atlas milestone co pixel", text_count_nonzero(vbuf, 4800, 0, 4800), 0)
    surface_clear(vbuf, vsurf, empty)
    bidi_draw_visual_atlas(vbuf, vsurf, iab, iatl, "אA", 0.0, 0.0, 1.0, white, 1)
    at1 = text_count_nonzero(vbuf, 4800, 0, 4800)
    al1 = 0
    ar1 = 0
    zi = 0
    while zi < 8:
        al1 = al1 + text_count_nonzero(vbuf, 4800, zi * 200 + 0, zi * 200 + 6)
        ar1 = ar1 + text_count_nonzero(vbuf, 4800, zi * 200 + 6, zi * 200 + 12)
        zi = zi + 1
    surface_clear(vbuf, vsurf, empty)
    bidi_draw_visual_atlas(vbuf, vsurf, iab, iatl, "אA", 0.0, 0.0, 1.0, white, 2)
    at2 = text_count_nonzero(vbuf, 4800, 0, 4800)
    al2 = 0
    ar2 = 0
    zi = 0
    while zi < 8:
        al2 = al2 + text_count_nonzero(vbuf, 4800, zi * 200 + 0, zi * 200 + 6)
        ar2 = ar2 + text_count_nonzero(vbuf, 4800, zi * 200 + 6, zi * 200 + 12)
        zi = zi + 1
    text_check_i(acc, "bidi atlas RTL/LTR cung pixel", at1, at2)
    text_check_i(acc, "bidi atlas swap trai", al1, ar2)
    text_check_i(acc, "bidi atlas swap phai", ar1, al2)
    
    print("--- bidi selftest: " + str(acc[0]) + "/" + str(acc[1]) + " PASS ---")
    if acc[0] == acc[1]:
        return "BIDI_OK"
    return "BIDI_FAIL"