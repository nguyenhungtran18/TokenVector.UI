    vl.append(1)
    vl.append(1)
    text_check(acc, "bidi visual text ab()", bidi_visual_text(vc, vo2, vl, 4) == "ab()")

    # --- seq split + draw visual ---
    sq = bidi_seq_classes("AB1 ")
    text_check_i(acc, "bidi seq AB1_ len", len(sq), 4)
    text_check_i(acc, "bidi seq A", sq[0], 0)
    text_check_i(acc, "bidi seq 1", sq[2], 3)
    text_check_i(acc, "bidi seq space", sq[3], 12)
    sv = bidi_seq_classes("Việt")
    text_check_i(acc, "bidi seq Viet len", len(sv), 4)
    text_check_i(acc, "bidi seq Viet e-moc", sv[2], 0)
    text_check_i(acc, "bidi seq off 0", bidi_seq_offset("Việt", 6, 0), 0)
    text_check_i(acc, "bidi seq off 2", bidi_seq_offset("Việt", 6, 2), 2)
    text_check_i(acc, "bidi seq off 3", bidi_seq_offset("Việt", 6, 3), 5)
    vbuf = []
    surface_ensure_capacity(vbuf, 4800)
    vsurf = PixelSurface(200, 24, 200)
