def ab_add_splitter(ids: "list[i32]", roles: "list[i32]", parents: "list[i32]", labels: "list[str]", values: "list[str]", xs: "list[f64]", ys: "list[f64]", ws: "list[f64]", hs: "list[f64]", enableds: "list[i32]", focuseds: "list[i32]", selecteds: "list[i32]", checkeds: "list[i32]", s: "NativeSplitter", parent: "i32") -> "i32":
    return ab_add_node(ids, roles, parents, labels, values, xs, ys, ws, hs, enableds, focuseds, selecteds, checkeds, 20, parent, "splitter", "", s.bx, s.by, s.bw, s.bh, s.enabled, 0, 0, 0)

def ab_add_spinbox(ids: "list[i32]", roles: "list[i32]", parents: "list[i32]", labels: "list[str]", values: "list[str]", xs: "list[f64]", ys: "list[f64]", ws: "list[f64]", hs: "list[f64]", enableds: "list[i32]", focuseds: "list[i32]", selecteds: "list[i32]", checkeds: "list[i32]", s: "NativeSpinBox", parent: "i32") -> "i32":
    return ab_add_node(ids, roles, parents, labels, values, xs, ys, ws, hs, enableds, focuseds, selecteds, checkeds, 21, parent, "spinbox", str(s.value), s.bx, s.by, s.bw, s.bh, s.enabled, 0, 0, 0)

def ab_add_tooltip(ids: "list[i32]", roles: "list[i32]", parents: "list[i32]", labels: "list[str]", values: "list[str]", xs: "list[f64]", ys: "list[f64]", ws: "list[f64]", hs: "list[f64]", enableds: "list[i32]", focuseds: "list[i32]", selecteds: "list[i32]", checkeds: "list[i32]", t: "NativeToolTip", parent: "i32") -> "i32":
    # NativeToolTip khong co kich thuoc trong record -> bounds 0 (host tu do).
    return ab_add_node(ids, roles, parents, labels, values, xs, ys, ws, hs, enableds, focuseds, selecteds, checkeds, 22, parent, t.text, "", t.bx, t.by, 0.0, 0.0, 1, 0, 0, 0)

# =========================================================
# SAFE DUMP - cay JSON escape + ghi file that
# =========================================================
def ab_tree_json_safe(ids: "list[i32]", roles: "list[i32]", parents: "list[i32]", labels: "list[str]", values: "list[str]", xs: "list[f64]", ys: "list[f64]", ws: "list[f64]", hs: "list[f64]", enableds: "list[i32]", focuseds: "list[i32]", selecteds: "list[i32]", checkeds: "list[i32]", backend: "i32") -> "str":
    sb = "["
    i = int(0)
    while i < len(ids):
        if i > 0:
            sb = sb + ","
        m = ab_state_mask(1 - enableds[i], focuseds[i], selecteds[i], checkeds[i], 0, 0, 0)
        sb = sb + ab_node_to_json(ids[i], ab_role_for_backend(roles[i], backend), parents[i], labels[i], values[i], xs[i], ys[i], ws[i], hs[i], m)
        i = i + 1
    sb = sb + "]"
    return sb

def ab_dump_tree(path: "str", ids: "list[i32]", roles: "list[i32]", parents: "list[i32]", labels: "list[str]", values: "list[str]", xs: "list[f64]", ys: "list[f64]", ws: "list[f64]", hs: "list[f64]", enableds: "list[i32]", focuseds: "list[i32]", selecteds: "list[i32]", checkeds: "list[i32]", backend: "i32") -> "i32":
    data = ab_tree_json_safe(ids, roles, parents, labels, values, xs, ys, ws, hs, enableds, focuseds, selecteds, checkeds, backend)
    ab_file_write(path, data)
    return len(data)

# =========================================================
# SELFTEST
# =========================================================
def abridge_selftest() -> "str":
    print("== TkvUI.A11yBridge selftest ==")
    acc = []
    acc.append(0)
    acc.append(0)
    # backend
    be = ab_pick_backend()
    ok_be = 0
    if be >= 0:
        if be <= 4:
            ok_be = 1
    text_check(acc, "bridge backend 0..4", ok_be)
    text_check(acc, "bridge backend name", ab_backend_name(1) == "UIA")
    text_check(acc, "bridge backend atspi", ab_backend_name(2) == "AT-SPI")
    text_check(acc, "bridge backend none", ab_backend_name(9) == "none")
    # json escape
    text_check(acc, "bridge esc quote", ab_json_escape("a\"b") == "a\\\"b")
    text_check(acc, "bridge esc nl", ab_json_escape("a\nb") == "a\\nb")
    text_check(acc, "bridge esc plain", ab_json_escape("OK") == "OK")
    text_check(acc, "bridge q", ab_q("Hi") == "\"Hi\"")
    # roles
    text_check_i(acc, "bridge uia button", ab_role_uia(3), 50000)
    text_check_i(acc, "bridge uia edit", ab_role_uia(5), 50004)
    text_check_i(acc, "bridge uia window", ab_role_uia(1), 50032)
    text_check(acc, "bridge uia name", ab_role_uia_name(5) == "Edit")
    text_check(acc, "bridge atspi", ab_role_atspi(3) == "push-button")
    text_check(acc, "bridge atspi entry", ab_role_atspi(5) == "entry")
    text_check(acc, "bridge ns", ab_role_ns(3) == "NSAccessibilityButtonRole")
    text_check(acc, "bridge android", ab_role_android(5) == "android.widget.EditText")
    text_check(acc, "bridge for backend", ab_role_for_backend(3, 2) == "push-button")
    text_check(acc, "bridge for backend none", ab_role_for_backend(3, 0) == "button")
    # states
    m = ab_state_mask(0, 1, 1, 0, 0, 0, 0)
    text_check_i(acc, "bridge mask", m, 6)
    text_check_i(acc, "bridge has focused", ab_state_has(m, 2), 1)
    text_check_i(acc, "bridge has checked 0", ab_state_has(m, 8), 0)
    text_check(acc, "bridge names", ab_state_names(m) == "focused,selected")
    text_check(acc, "bridge names normal", ab_state_names(0) == "normal")
    text_check(acc, "bridge uia state", ab_uia_state_str(m) == "IsEnabled=1;HasKeyboardFocus=1;IsSelected=1;ToggleState=0;ExpandCollapse=0;IsReadOnly=0")
    # uia guarded (khong crash khi thieu DLL)
    lst = ab_uia_listening()
    ok_lst = 0
    if lst == 0:
        ok_lst = 1
    if lst == 1:
        ok_lst = 1
    text_check(acc, "bridge uia listening 0/1", ok_lst)
    text_check_i(acc, "bridge uia raise nop", ab_uia_raise(0, 20005), 0)
    text_check_i(acc, "bridge uia ev focus", ab_uia_event_id(1), 20005)
    text_check(acc, "bridge ev name", ab_event_name(2) == "selection")
    # bridge + events
    br = ab_make_bridge()
    text_check_i(acc, "bridge connect", br.connect(1), 1)
    kinds = []
    targets = []
    datas = []
    br.raise_focus(kinds, targets, datas, 7)
    text_check_i(acc, "bridge focus seq", br.seq, 1)
    text_check_i(acc, "bridge focus id", br.focus_id, 7)
    br.raise_value(kinds, targets, datas, 7, "26")
    br.raise_alert(kinds, targets, datas, "Saved")
    text_check_i(acc, "bridge log n", len(kinds), 3)
    ej = ab_events_json(kinds, targets, datas)
    text_check(acc, "bridge events json", ej == "[{\"seq\":1,\"event\":\"focus\",\"target\":7,\"data\":\"focus\"},{\"seq\":2,\"event\":\"value\",\"target\":7,\"data\":\"26\"},{\"seq\":3,\"event\":\"alert\",\"target\":0,\"data\":\"Saved\"}]")
    br.disconnect()
    br.raise_focus(kinds, targets, datas, 9)
    text_check_i(acc, "bridge dropped", br.dropped, 1)
    text_check_i(acc, "bridge logclear", ab_log_clear(kinds, targets, datas), 0)
    # live regions
    txs = []
    prs = []
    ab_announce(txs, prs, "hello", 0)
    ab_announce(txs, prs, "urgent", 1)
    text_check(acc, "bridge poll assertive", ab_poll(txs, prs) == "urgent")
    text_check(acc, "bridge poll fifo", ab_poll(txs, prs) == "hello")
    text_check(acc, "bridge poll empty", ab_poll(txs, prs) == "")
    # providers
    uia = ab_make_uia()
    text_check_i(acc, "bridge uia push", uia.push_tree("[{}]"), 1)
    text_check_i(acc, "bridge uia len", uia.last_len, 4)
    at = ab_make_atspi()
    at.connect("demo")
    text_check_i(acc, "bridge atspi conn", at.connected, 1)
    text_check(acc, "bridge atspi socket", at.socket_path() == "/tmp/at-spi2/socket")
    ns = ab_make_ns()
    ns.connect("demo")
    text_check(acc, "bridge ns role", ns.role_of(3) == "NSAccessibilityButtonRole")
    tb = ab_make_talkback()
    tb.connect()
    text_check(acc, "bridge tb parcel", tb.parcel_note() == "parcel-via-jni")
    text_check_i(acc, "bridge tb push", tb.push_tree("[{}]"), 1)
    # reader
    rd = ab_detect_reader()
    ok_rd = 0
    if rd >= 0:
        if rd <= 4:
            ok_rd = 1
    text_check(acc, "bridge reader range", ok_rd)
    text_check(acc, "bridge reader nvda", ab_reader_name(1) == "NVDA")
    text_check(acc, "bridge reader vo", ab_reader_name(3) == "VoiceOver")
    text_check_i(acc, "bridge conf nvda", ab_reader_confidence(1), 2)
    # focus tracker
    fids = []
    fids.append(1)
    fids.append(2)
    fids.append(3)
    fms = []
    fms.append(0)
    fms.append(1)
    fms.append(0)
    fout = []
    text_check_i(acc, "bridge focusables", ab_focusables(fids, fms, fout), 2)
    text_check_i(acc, "bridge fnext", ab_focus_next(fout, 1), 3)
    text_check_i(acc, "bridge fnext wrap", ab_focus_next(fout, 3), 1)
    text_check_i(acc, "bridge fprev", ab_focus_prev(fout, 3), 1)
    text_check_i(acc, "bridge fprev wrap", ab_focus_prev(fout, 1), 3)
    # builders
    ids = []
    roles = []
    parents = []
    labels = []
    values = []
    xs = []
    ys = []
    ws = []
    hs = []
    ens = []
    fcs = []
    sls = []
    cks = []
    root = ab_add_window(ids, roles, parents, labels, values, xs, ys, ws, hs, ens, fcs, sls, cks, "Demo", 400.0, 300.0)
    text_check_i(acc, "bridge root", root, 1)
    b = make_native_button(10.0, 10.0, 80.0, 24.0, "Save & \"Go\"")
    nb = ab_add_button(ids, roles, parents, labels, values, xs, ys, ws, hs, ens, fcs, sls, cks, b, root)
    text_check_i(acc, "bridge button nid", nb, 2)
    e = make_native_lineedit(10.0, 40.0, 150.0, "Name")
    e.type_char("A")
    e.focus(1)
    ne = ab_add_lineedit(ids, roles, parents, labels, values, xs, ys, ws, hs, ens, fcs, sls, cks, e, root)
    text_check_i(acc, "bridge edit focused", fcs[ne - 1], 1)
    text_check(acc, "bridge edit value", values[ne - 1] == "A")
    items = []
    items.append("An")
    items.append("Binh")
    lv = make_native_listview(10.0, 70.0, 150.0, 60.0, 2)
    lv.select(1)
    ab_add_listview(ids, roles, parents, labels, values, xs, ys, ws, hs, ens, fcs, sls, cks, lv, items, 2, root)
    text_check_i(acc, "bridge tree n", len(ids), 6)
    text_check_i(acc, "bridge item sel", sls[5], 1)
    # safe json escapes quote in label
    sj = ab_tree_json_safe(ids, roles, parents, labels, values, xs, ys, ws, hs, ens, fcs, sls, cks, 0)
    text_check(acc, "bridge safe json", mv_contains_safe(sj, "Save & \\"))
    # dump that ra file
    path = "build/abridge_selftest.json"
    nbytes = ab_dump_tree(path, ids, roles, parents, labels, values, xs, ys, ws, hs, ens, fcs, sls, cks, 2)
    text_check(acc, "bridge dump size", nbytes > 200)
    text_check_i(acc, "bridge dump exists", tkv_has_file(path), 1)
    # P3 builders: table/tree/menubar/toolbar/scrollbar/splitter/spin/tooltip
    tv = make_native_table(10.0, 130.0, 200.0, 80.0, 3, 4)
    tv.select(1, 1)
    tn = ab_add_tableview(ids, roles, parents, labels, values, xs, ys, ws, hs, ens, fcs, sls, cks, tv, root)
    text_check_i(acc, "bridge table role", roles[tn - 1], 15)
    text_check_i(acc, "bridge table sel", sls[tn - 1], 1)
    text_check_i(acc, "bridge table uia", ab_role_uia(15), 50036)
    tr = make_native_tree(10.0, 220.0, 200.0, 80.0)
    trn = ab_add_tree(ids, roles, parents, labels, values, xs, ys, ws, hs, ens, fcs, sls, cks, tr, root)
    text_check_i(acc, "bridge tree role", roles[trn - 1], 16)
    text_check_i(acc, "bridge tree nosel", sls[trn - 1], 0)
    mb = make_native_menubar(0.0, 0.0, 400.0, 3)
    ml = []
    ml.append("File")
    ml.append("Edit")
    ml.append("Help")
    c0 = len(ids)
    mn = ab_add_menubar(ids, roles, parents, labels, values, xs, ys, ws, hs, ens, fcs, sls, cks, mb, ml, 3, root)
    text_check_i(acc, "bridge menu box", roles[mn - 1], 17)
    text_check_i(acc, "bridge menu kids", len(ids), c0 + 4)
    text_check_i(acc, "bridge menuitem role", roles[c0 + 1], 23)
    text_check(acc, "bridge menuitem label", labels[c0 + 2] == "Edit")
    text_check_i(acc, "bridge menu uia", ab_role_uia(23), 50011)
    tb2 = make_native_toolbar(0.0, 24.0, 400.0, 2)
    tb2.toggle_check(0)
    tips = []
    tips.append("New")
    tips.append("Open")
    bt = ab_add_toolbar(ids, roles, parents, labels, values, xs, ys, ws, hs, ens, fcs, sls, cks, tb2, tips, 2, root)
    text_check_i(acc, "bridge toolbar role", roles[bt - 1], 18)
    text_check(acc, "bridge tool label", labels[bt] == "New")
    text_check_i(acc, "bridge tool checked", cks[bt], 1)
    text_check_i(acc, "bridge toolbar uia", ab_role_uia(18), 50021)
    sb = make_native_scrollbar(380.0, 50.0, 16.0, 200.0, 0)
    sn = ab_add_scrollbar(ids, roles, parents, labels, values, xs, ys, ws, hs, ens, fcs, sls, cks, sb, root)
    text_check_i(acc, "bridge scroll role", roles[sn - 1], 19)
    text_check(acc, "bridge scroll value", values[sn - 1] == "0")
    sp = make_native_splitter(10.0, 260.0, 300.0, 200.0, 0.5, 0)
    pn = ab_add_splitter(ids, roles, parents, labels, values, xs, ys, ws, hs, ens, fcs, sls, cks, sp, root)
    text_check_i(acc, "bridge split role", roles[pn - 1], 20)
    text_check_i(acc, "bridge split uia", ab_role_uia(20), 50038)
    sx = make_native_spinbox(10.0, 300.0, 80.0, 5)
    xn = ab_add_spinbox(ids, roles, parents, labels, values, xs, ys, ws, hs, ens, fcs, sls, cks, sx, root)
    text_check_i(acc, "bridge spin role", roles[xn - 1], 21)
    text_check(acc, "bridge spin value", values[xn - 1] == "5")
    text_check_i(acc, "bridge spin uia", ab_role_uia(21), 50016)
    tt = make_native_tooltip()
    tt.show_at(50.0, 50.0, "hint")
    un = ab_add_tooltip(ids, roles, parents, labels, values, xs, ys, ws, hs, ens, fcs, sls, cks, tt, root)
    text_check_i(acc, "bridge tip role", roles[un - 1], 22)
    text_check(acc, "bridge tip label", labels[un - 1] == "hint")
    text_check_i(acc, "bridge scroll uia", ab_role_uia(19), 50014)
    text_check_i(acc, "bridge tip uia", ab_role_uia(22), 50022)
    # hoi quy ControlType ids theo MS spec (tung sai: slider/tab/link/image)
    text_check_i(acc, "bridge slider uia", ab_role_uia(10), 50015)
    text_check_i(acc, "bridge tab uia", ab_role_uia(13), 50018)
    text_check_i(acc, "bridge link uia", ab_role_uia(12), 50005)
    text_check_i(acc, "bridge image uia", ab_role_uia(7), 50006)
    text_check_i(acc, "bridge table atspi", ab_role_atspi(15) == "table", 1)
    text_check_i(acc, "bridge tree atspi", ab_role_atspi(16) == "tree", 1)
    print("--- abridge selftest: " + str(acc[0]) + "/" + str(acc[1]) + " PASS ---")
    if acc[0] == acc[1]:
        return "ABRIDGE_OK"
    return "ABRIDGE_FAIL"

def mv_contains_safe(hay: "str", nd: "str") -> "i32":
    # Substring search cuc bo (tranh phu thuoc Data)
    nh = len(hay)
    nn = len(nd)
    if nn == 0:
        return 1
    if nn > nh:
        return 0
    i = int(0)
    while i <= nh - nn:
        k = int(0)
        match = 1
        while k < nn:
            if hay[i + k] != nd[k]:
                match = 0
                break
            k = k + 1
        if match == 1:
            return 1
        i = i + 1
    return 0
