    if backend == 1:
        return ab_role_uia_name(role)
    if backend == 2:
        return ab_role_atspi(role)
    if backend == 3:
        return ab_role_ns(role)
    if backend == 4:
        return ab_role_android(role)
    return a11y_role_name(role)

# =========================================================
# STATE MASK - bitmask bang cong (khong bitwise)
# =========================================================
def ab_state_mask(disabled: "i32", focused: "i32", selected: "i32", checked: "i32", expanded: "i32", readonly: "i32", busy: "i32") -> "i32":
    m = int(0)
    if disabled == 1:
        m = m + 1
    if focused == 1:
        m = m + 2
    if selected == 1:
        m = m + 4
    if checked == 1:
        m = m + 8
    if expanded == 1:
        m = m + 16
    if readonly == 1:
        m = m + 32
    if busy == 1:
        m = m + 64
    return m

def ab_state_has(mask: "i32", bit: "i32") -> "i32":
    # Kiem tra bit kieu Toolbar.is_checked (chia lay du)
    if bit <= 0:
        return 0
    return (mask // bit) - ((mask // (bit * 2)) * 2)

def ab_state_names(mask: "i32") -> "str":
    out = ""
    if ab_state_has(mask, 1) == 1:
        out = out + "disabled,"
    if ab_state_has(mask, 2) == 1:
        out = out + "focused,"
    if ab_state_has(mask, 4) == 1:
        out = out + "selected,"
    if ab_state_has(mask, 8) == 1:
        out = out + "checked,"
    if ab_state_has(mask, 16) == 1:
        out = out + "expanded,"
    if ab_state_has(mask, 32) == 1:
        out = out + "readonly,"
    if ab_state_has(mask, 64) == 1:
        out = out + "busy,"
    if out == "":
        out = "normal,"
    return out[0:len(out) - 1]

def ab_uia_state_str(mask: "i32") -> "str":
    # Chuoi trang thai kieu UIA (IsEnabled/HasKeyboardFocus/...)
    s = "IsEnabled=" + str(1 - ab_state_has(mask, 1))
    s = s + ";HasKeyboardFocus=" + str(ab_state_has(mask, 2))
    s = s + ";IsSelected=" + str(ab_state_has(mask, 4))
    s = s + ";ToggleState=" + str(ab_state_has(mask, 8))
    s = s + ";ExpandCollapse=" + str(ab_state_has(mask, 16))
    s = s + ";IsReadOnly=" + str(ab_state_has(mask, 32))
    return s

# =========================================================
# UIA NATIVE (guarded) - chi goi khi DLL present
# =========================================================
def ab_uia_listening() -> "i32":
    # UiaClientsAreListening: 1 = co screen reader dang nghe
    if a11y_win_present() == 1:
        return uia_clients_listening_ex()
    return 0

def ab_uia_raise(provider: "i64", event_id: "i32") -> "i32":
    if a11y_win_present() == 0:
        return 0
    if provider == 0:
        return 0
    return uia_raise_event_ex(provider, event_id)

def ab_uia_event_id(kind: "i32") -> "i32":
    # UIA AutomationEvent ids that
    if kind == 1:
        return 20005
    if kind == 2:
        return 20014
    if kind == 3:
        return 20002
    if kind == 5:
        return 20004
    if kind == 6:
        return 20027
    return 20004

def ab_event_name(kind: "i32") -> "str":
    if kind == 1:
        return "focus"
    if kind == 2:
        return "selection"
    if kind == 3:
        return "value"
    if kind == 4:
        return "property"
    if kind == 5:
        return "state"
    if kind == 6:
        return "alert"
    return "unknown"

# =========================================================
# AbBridge - router trung tam (log o caller lists)
# =========================================================
class AbBridge:
    backend: "i32"
    connected: "i32"
    focus_id: "i32"
    root_id: "i32"
    seq: "i32"
    reader: "i32"
    confidence: "i32"
    dropped: "i32"
    def __init__(self, backend, connected, focus_id, root_id, seq, reader, confidence, dropped):
        self.backend = backend
        self.connected = connected
        self.focus_id = focus_id
        self.root_id = root_id
        self.seq = seq
        self.reader = reader
        self.confidence = confidence
        self.dropped = dropped
    def connect(self, backend: "i32") -> "i32":
        self.backend = backend
        if backend == 0:
            self.connected = 0
        else:
            self.connected = 1
        return self.connected
    def disconnect(self) -> "i32":
        self.connected = 0
        return 0
    def set_reader(self, reader: "i32", confidence: "i32") -> "i32":
        self.reader = reader
        self.confidence = confidence
        return reader
    def log(self, kinds: "list[i32]", targets: "list[i32]", datas: "list[str]", kind: "i32", target: "i32", data: "str") -> "i32":
        if self.connected == 0:
            self.dropped = self.dropped + 1
            return 0
        self.seq = self.seq + 1
        kinds.append(kind)
        targets.append(target)
        datas.append(data)
        if kind == 1:
            self.focus_id = target
        return self.seq
    def raise_focus(self, kinds: "list[i32]", targets: "list[i32]", datas: "list[str]", target: "i32") -> "i32":
        return self.log(kinds, targets, datas, 1, target, ab_event_name(1))
    def raise_selection(self, kinds: "list[i32]", targets: "list[i32]", datas: "list[str]", target: "i32", detail: "str") -> "i32":
        return self.log(kinds, targets, datas, 2, target, detail)
    def raise_value(self, kinds: "list[i32]", targets: "list[i32]", datas: "list[str]", target: "i32", detail: "str") -> "i32":
        return self.log(kinds, targets, datas, 3, target, detail)
    def raise_property(self, kinds: "list[i32]", targets: "list[i32]", datas: "list[str]", target: "i32", detail: "str") -> "i32":
        return self.log(kinds, targets, datas, 4, target, detail)
    def raise_state(self, kinds: "list[i32]", targets: "list[i32]", datas: "list[str]", target: "i32", detail: "str") -> "i32":
        return self.log(kinds, targets, datas, 5, target, detail)
    def raise_alert(self, kinds: "list[i32]", targets: "list[i32]", datas: "list[str]", text: "str") -> "i32":
        return self.log(kinds, targets, datas, 6, self.root_id, text)

def ab_make_bridge() -> "AbBridge":
    return AbBridge(0, 0, -1, 0, 0, 0, 0, 0)

def ab_log_clear(kinds: "list[i32]", targets: "list[i32]", datas: "list[str]") -> "i32":
    while len(kinds) > 0:
        kinds.pop()
    while len(targets) > 0:
        targets.pop()
    while len(datas) > 0:
        datas.pop()
    return 0

def ab_events_json(kinds: "list[i32]", targets: "list[i32]", datas: "list[str]") -> "str":
    sb = "["
    i = int(0)
    while i < len(kinds):
        if i > 0:
            sb = sb + ","
        sb = sb + "{\"seq\":" + str(i + 1) + ",\"event\":" + ab_q(ab_event_name(kinds[i])) + ",\"target\":" + str(targets[i]) + ",\"data\":" + ab_q(datas[i]) + "}"
        i = i + 1
    sb = sb + "]"
    return sb

# =========================================================
# LIVE REGIONS - hang doi thong bao (polite=0/assertive=1)
# =========================================================
def ab_announce(texts: "list[str]", prios: "list[i32]", text: "str", prio: "i32") -> "i32":
    texts.append(text)
    prios.append(prio)
    return len(texts)

def ab_poll(texts: "list[str]", prios: "list[i32]") -> "str":
    # Uu tien assertive truoc (quet 1 luot), roi FIFO
    i = int(0)
    while i < len(prios):
        if prios[i] == 1:
            out = texts[i]
            j = i
            while j < len(texts) - 1:
                texts[j] = texts[j + 1]
                prios[j] = prios[j + 1]
                j = j + 1
            texts.pop()
            prios.pop()
            return out
        i = i + 1
    if len(texts) == 0:
        return ""
    out = texts[0]
    j = int(0)
    while j < len(texts) - 1:
        texts[j] = texts[j + 1]
        prios[j] = prios[j + 1]
        j = j + 1
    texts.pop()
    prios.pop()
    return out

def ab_announce_clear(texts: "list[str]", prios: "list[i32]") -> "i32":
    while len(texts) > 0:
        texts.pop()
    while len(prios) > 0:
        prios.pop()
    return 0

# =========================================================
# PROVIDERS - stub trung thuc theo tung nen
# =========================================================
class AbUia:
    connected: "i32"
    hwnd: "i64"
    pushed: "i32"
    last_len: "i32"
    def __init__(self, connected, hwnd, pushed, last_len):
        self.connected = connected
        self.hwnd = hwnd
        self.pushed = pushed
        self.last_len = last_len
    def connect(self, hwnd: "i64") -> "i32":
        if a11y_win_present() == 0:
            self.connected = 0
            return 0
        self.hwnd = hwnd
        self.connected = 1
        return 1
    def disconnect(self) -> "i32":
        self.connected = 0
        return 0
    def push_tree(self, tree_json: "str") -> "i32":
        # COM IRawElementProviderSimple can vtable (.tkv khong goi duoc)
        # -> ghi nhan payload, cho provider that day len UIA tree.
        self.pushed = self.pushed + 1
        self.last_len = len(tree_json)
        return self.pushed
    def fire(self, provider: "i64", kind: "i32") -> "i32":
        return ab_uia_raise(provider, ab_uia_event_id(kind))

def ab_make_uia() -> "AbUia":
    return AbUia(0, 0, 0, 0)

class AbAtspi:
    connected: "i32"
    app_name: "str"
    pushed: "i32"
    last_len: "i32"
    def __init__(self, connected, app_name, pushed, last_len):
        self.connected = connected
        self.app_name = app_name
        self.pushed = pushed
        self.last_len = last_len
    def connect(self, app_name: "str") -> "i32":
        # Can D-Bus + libatspi.so (pinvoke .so chua co) -> stub, van dem ket noi
        self.app_name = app_name
        self.connected = 1
        return 1
    def disconnect(self) -> "i32":
        self.connected = 0
        return 0
    def push_tree(self, tree_json: "str") -> "i32":
        self.pushed = self.pushed + 1
        self.last_len = len(tree_json)
        return self.pushed
    def socket_path(self) -> "str":
        return "/tmp/at-spi2/socket"

def ab_make_atspi() -> "AbAtspi":
    return AbAtspi(0, "", 0, 0)

class AbNs:
    connected: "i32"
    app_name: "str"
    pushed: "i32"
    last_len: "i32"
    def __init__(self, connected, app_name, pushed, last_len):
        self.connected = connected
        self.app_name = app_name
        self.pushed = pushed
        self.last_len = last_len
    def connect(self, app_name: "str") -> "i32":
        # NSAccessibility protocol (ObjC) — chi macOS that; stub ghi nhan
        self.app_name = app_name
        if a11y_mac_present() == 1:
            self.connected = 1
        else:
            self.connected = 1
        return self.connected
    def disconnect(self) -> "i32":
        self.connected = 0
        return 0
    def push_tree(self, tree_json: "str") -> "i32":
        self.pushed = self.pushed + 1
        self.last_len = len(tree_json)
        return self.pushed
    def role_of(self, role: "i32") -> "str":
        return ab_role_ns(role)

def ab_make_ns() -> "AbNs":
    return AbNs(0, "", 0, 0)

class AbTalkback:
    connected: "i32"
    pushed: "i32"
    last_len: "i32"
    seq: "i32"
    def __init__(self, connected, pushed, last_len, seq):
        self.connected = connected
        self.pushed = pushed
        self.last_len = last_len
        self.seq = seq
    def connect(self) -> "i32":
        # AccessibilityNodeInfo qua JNI shim (host-driven, giong IOSDemo)
        if detect_platform() == 5:
            self.connected = 1
        else:
            self.connected = 1
        return self.connected
    def disconnect(self) -> "i32":
        self.connected = 0
        return 0
    def push_tree(self, tree_json: "str") -> "i32":
        self.pushed = self.pushed + 1
        self.last_len = len(tree_json)
        self.seq = self.seq + 1
        return self.seq
    def parcel_note(self) -> "str":
        return "parcel-via-jni"

def ab_make_talkback() -> "AbTalkback":
    return AbTalkback(0, 0, 0, 0)

# =========================================================
# READER DETECT - best-effort, kem do tin cay
# =========================================================
def ab_detect_reader() -> "i32":
    pid = detect_platform()
    if pid == 1:
        if ab_uia_listening() == 1:
            return 1
        if a11y_win_present() == 1:
            return 2
        return 0
    if pid == 4:
        return 3
    if pid == 6:
        return 3
    if pid == 5:
        return 4
    return 0

def ab_reader_confidence(reader: "i32") -> "i32":
    # 2 = chac (tay nghe that), 1 = doan theo nen, 0 = khong ro
    if reader == 1:
        return 2
    if reader == 2:
        return 1
    if reader == 3:
        return 1
    if reader == 4:
        return 1
    return 0

def ab_reader_name(reader: "i32") -> "str":
    if reader == 1:
        return "NVDA"
    if reader == 2:
        return "Narrator"
    if reader == 3:
        return "VoiceOver"
    if reader == 4:
        return "TalkBack"
    return "unknown"

# =========================================================
# FOCUS TRACKER - duyet id focusable (vong tron)
# =========================================================
def ab_focusables(ids: "list[i32]", masks: "list[i32]", out_ids: "list[i32]") -> "i32":
    # Focus duoc = khong disabled; bo qua id <= 0
    i = int(0)
    while i < len(ids):
        if ids[i] > 0:
            if ab_state_has(masks[i], 1) == 0:
                out_ids.append(ids[i])
        i = i + 1
    return len(out_ids)

def ab_focus_pos(focus_ids: "list[i32]", cur: "i32") -> "i32":
    i = int(0)
    while i < len(focus_ids):
        if focus_ids[i] == cur:
            return i
        i = i + 1
    return -1

def ab_focus_next(focus_ids: "list[i32]", cur: "i32") -> "i32":
    if len(focus_ids) == 0:
        return -1
    p = ab_focus_pos(focus_ids, cur)
    if p < 0:
        return focus_ids[0]
    return focus_ids[(p + 1) - ((p + 1) // len(focus_ids)) * len(focus_ids)]

def ab_focus_prev(focus_ids: "list[i32]", cur: "i32") -> "i32":
    if len(focus_ids) == 0:
        return -1
    p = ab_focus_pos(focus_ids, cur)
    if p < 0:
        return focus_ids[len(focus_ids) - 1]
    if p == 0:
        return focus_ids[len(focus_ids) - 1]
    return focus_ids[p - 1]

# =========================================================
# WIDGET BUILDERS - Native widgets -> cay A11y (caller lists)
# =========================================================
def ab_add_node(ids: "list[i32]", roles: "list[i32]", parents: "list[i32]", labels: "list[str]", values: "list[str]", xs: "list[f64]", ys: "list[f64]", ws: "list[f64]", hs: "list[f64]", enableds: "list[i32]", focuseds: "list[i32]", selecteds: "list[i32]", checkeds: "list[i32]", role: "i32", parent: "i32", label: "str", value: "str", x: "f64", y: "f64", w: "f64", h: "f64", enabled: "i32", focused: "i32", selected: "i32", checked: "i32") -> "i32":
    nid = len(ids) + 1
    ids.append(nid)
    roles.append(role)
    parents.append(parent)
    labels.append(label)
    values.append(value)
    xs.append(x)
    ys.append(y)
    ws.append(w)
    hs.append(h)
    enableds.append(enabled)
    focuseds.append(focused)
    selecteds.append(selected)
    checkeds.append(checked)
    return nid

def ab_add_window(ids: "list[i32]", roles: "list[i32]", parents: "list[i32]", labels: "list[str]", values: "list[str]", xs: "list[f64]", ys: "list[f64]", ws: "list[f64]", hs: "list[f64]", enableds: "list[i32]", focuseds: "list[i32]", selecteds: "list[i32]", checkeds: "list[i32]", title: "str", w: "f64", h: "f64") -> "i32":
    return ab_add_node(ids, roles, parents, labels, values, xs, ys, ws, hs, enableds, focuseds, selecteds, checkeds, 1, -1, title, "", 0.0, 0.0, w, h, 1, 0, 0, 0)

def ab_add_label(ids: "list[i32]", roles: "list[i32]", parents: "list[i32]", labels: "list[str]", values: "list[str]", xs: "list[f64]", ys: "list[f64]", ws: "list[f64]", hs: "list[f64]", enableds: "list[i32]", focuseds: "list[i32]", selecteds: "list[i32]", checkeds: "list[i32]", parent: "i32", text: "str", x: "f64", y: "f64", w: "f64", h: "f64") -> "i32":
    return ab_add_node(ids, roles, parents, labels, values, xs, ys, ws, hs, enableds, focuseds, selecteds, checkeds, 6, parent, text, "", x, y, w, h, 1, 0, 0, 0)

def ab_add_button(ids: "list[i32]", roles: "list[i32]", parents: "list[i32]", labels: "list[str]", values: "list[str]", xs: "list[f64]", ys: "list[f64]", ws: "list[f64]", hs: "list[f64]", enableds: "list[i32]", focuseds: "list[i32]", selecteds: "list[i32]", checkeds: "list[i32]", b: "NativeButton", parent: "i32") -> "i32":
    return ab_add_node(ids, roles, parents, labels, values, xs, ys, ws, hs, enableds, focuseds, selecteds, checkeds, 3, parent, b.label, "", b.bx, b.by, b.bw, b.bh, b.enabled, 0, 0, b.checked)

def ab_add_lineedit(ids: "list[i32]", roles: "list[i32]", parents: "list[i32]", labels: "list[str]", values: "list[str]", xs: "list[f64]", ys: "list[f64]", ws: "list[f64]", hs: "list[f64]", enableds: "list[i32]", focuseds: "list[i32]", selecteds: "list[i32]", checkeds: "list[i32]", e: "NativeLineEdit", parent: "i32") -> "i32":
    foc = 0
    if e.state == 5:
        foc = 1
    shown = e.display_text()
    return ab_add_node(ids, roles, parents, labels, values, xs, ys, ws, hs, enableds, focuseds, selecteds, checkeds, 5, parent, e.placeholder, shown, e.bx, e.by, e.bw, e.bh, e.enabled, foc, 0, 0)

def ab_add_combo(ids: "list[i32]", roles: "list[i32]", parents: "list[i32]", labels: "list[str]", values: "list[str]", xs: "list[f64]", ys: "list[f64]", ws: "list[f64]", hs: "list[f64]", enableds: "list[i32]", focuseds: "list[i32]", selecteds: "list[i32]", checkeds: "list[i32]", c: "NativeComboBox", options: "list[str]", parent: "i32") -> "i32":
    cur = ""
    if c.selected >= 0:
        if c.selected < len(options):
            cur = options[c.selected]
    return ab_add_node(ids, roles, parents, labels, values, xs, ys, ws, hs, enableds, focuseds, selecteds, checkeds, 5, parent, "combo", cur, c.bx, c.by, c.bw, c.bh, c.enabled, 0, 0, 0)

def ab_add_listview(ids: "list[i32]", roles: "list[i32]", parents: "list[i32]", labels: "list[str]", values: "list[str]", xs: "list[f64]", ys: "list[f64]", ws: "list[f64]", hs: "list[f64]", enableds: "list[i32]", focuseds: "list[i32]", selecteds: "list[i32]", checkeds: "list[i32]", lv: "NativeListView", items: "list[str]", n: "i32", parent: "i32") -> "i32":
    box = ab_add_node(ids, roles, parents, labels, values, xs, ys, ws, hs, enableds, focuseds, selecteds, checkeds, 8, parent, "list", "", lv.bx, lv.by, lv.bw, lv.bh, lv.enabled, 0, 0, 0)
    i = int(0)
    while i < n:
        sel = 0
        if i == lv.selected:
            sel = 1
        txt = ""
        if i < len(items):
            txt = items[i]
        y = lv.by + float(i) * lv.item_h - lv.scroll
        ab_add_node(ids, roles, parents, labels, values, xs, ys, ws, hs, enableds, focuseds, selecteds, checkeds, 9, box, txt, "", lv.bx, y, lv.bw, lv.item_h, 1, 0, sel, 0)
        i = i + 1
    return box

def ab_add_tabs(ids: "list[i32]", roles: "list[i32]", parents: "list[i32]", labels: "list[str]", values: "list[str]", xs: "list[f64]", ys: "list[f64]", ws: "list[f64]", hs: "list[f64]", enableds: "list[i32]", focuseds: "list[i32]", selecteds: "list[i32]", checkeds: "list[i32]", t: "NativeTabBar", tablabels: "list[str]", n: "i32", parent: "i32") -> "i32":
    box = ab_add_node(ids, roles, parents, labels, values, xs, ys, ws, hs, enableds, focuseds, selecteds, checkeds, 13, parent, "tabs", "", t.bx, t.by, t.bw, t.bh, t.enabled, 0, 0, 0)
    w = os_tab_cell_w(t.bw, t.count, 60.0)
    i = int(0)
    while i < n:
        sel = 0
        if i == t.active:
            sel = 1
        txt = "Tab"
        if i < len(tablabels):
            txt = tablabels[i]
        ab_add_node(ids, roles, parents, labels, values, xs, ys, ws, hs, enableds, focuseds, selecteds, checkeds, 13, box, txt, "", t.bx + float(i) * w, t.by, w, t.bh, 1, 0, sel, 0)
        i = i + 1
    return box

def ab_add_dialog(ids: "list[i32]", roles: "list[i32]", parents: "list[i32]", labels: "list[str]", values: "list[str]", xs: "list[f64]", ys: "list[f64]", ws: "list[f64]", hs: "list[f64]", enableds: "list[i32]", focuseds: "list[i32]", selecteds: "list[i32]", checkeds: "list[i32]", d: "NativeDialog", parent: "i32") -> "i32":
    return ab_add_node(ids, roles, parents, labels, values, xs, ys, ws, hs, enableds, focuseds, selecteds, checkeds, 2, parent, d.title, d.message, d.bx, d.by, d.bw, d.bh, 1, 0, 0, 0)

def ab_add_progress(ids: "list[i32]", roles: "list[i32]", parents: "list[i32]", labels: "list[str]", values: "list[str]", xs: "list[f64]", ys: "list[f64]", ws: "list[f64]", hs: "list[f64]", enableds: "list[i32]", focuseds: "list[i32]", selecteds: "list[i32]", checkeds: "list[i32]", p: "NativeProgressBar", parent: "i32") -> "i32":
    return ab_add_node(ids, roles, parents, labels, values, xs, ys, ws, hs, enableds, focuseds, selecteds, checkeds, 14, parent, "progress", str(p.percent()), p.bx, p.by, p.bw, p.bh, 1, 0, 0, 0)

def ab_add_slider(ids: "list[i32]", roles: "list[i32]", parents: "list[i32]", labels: "list[str]", values: "list[str]", xs: "list[f64]", ys: "list[f64]", ws: "list[f64]", hs: "list[f64]", enableds: "list[i32]", focuseds: "list[i32]", selecteds: "list[i32]", checkeds: "list[i32]", s: "NativeSlider", parent: "i32") -> "i32":
    return ab_add_node(ids, roles, parents, labels, values, xs, ys, ws, hs, enableds, focuseds, selecteds, checkeds, 10, parent, "slider", str(s.value), s.bx, s.by, s.bw, s.bh, s.enabled, 0, 0, 0)

def ab_add_tableview(ids: "list[i32]", roles: "list[i32]", parents: "list[i32]", labels: "list[str]", values: "list[str]", xs: "list[f64]", ys: "list[f64]", ws: "list[f64]", hs: "list[f64]", enableds: "list[i32]", focuseds: "list[i32]", selecteds: "list[i32]", checkeds: "list[i32]", t: "NativeTableView", parent: "i32") -> "i32":
    sel = 0
    if t.sel_row >= 0:
        sel = 1
    return ab_add_node(ids, roles, parents, labels, values, xs, ys, ws, hs, enableds, focuseds, selecteds, checkeds, 15, parent, "table", "", t.bx, t.by, t.bw, t.bh, t.enabled, 0, sel, 0)

def ab_add_tree(ids: "list[i32]", roles: "list[i32]", parents: "list[i32]", labels: "list[str]", values: "list[str]", xs: "list[f64]", ys: "list[f64]", ws: "list[f64]", hs: "list[f64]", enableds: "list[i32]", focuseds: "list[i32]", selecteds: "list[i32]", checkeds: "list[i32]", t: "NativeTreeView", parent: "i32") -> "i32":
    sel = 0
    if t.selected >= 0:
        sel = 1
    return ab_add_node(ids, roles, parents, labels, values, xs, ys, ws, hs, enableds, focuseds, selecteds, checkeds, 16, parent, "tree", "", t.bx, t.by, t.bw, t.bh, t.enabled, 0, sel, 0)

def ab_add_menubar(ids: "list[i32]", roles: "list[i32]", parents: "list[i32]", labels: "list[str]", values: "list[str]", xs: "list[f64]", ys: "list[f64]", ws: "list[f64]", hs: "list[f64]", enableds: "list[i32]", focuseds: "list[i32]", selecteds: "list[i32]", checkeds: "list[i32]", m: "NativeMenuBar", menulabels: "list[str]", n: "i32", parent: "i32") -> "i32":
    box = ab_add_node(ids, roles, parents, labels, values, xs, ys, ws, hs, enableds, focuseds, selecteds, checkeds, 17, parent, "menubar", "", m.bx, m.by, m.bw, m.bh, m.enabled, 0, 0, 0)
    x = m.bx
    i = int(0)
    while i < n and i < m.nmenus:
        txt = "menu"
        if i < len(menulabels):
            txt = menulabels[i]
        w = m.menu_w(i)
        sel = 0
        if i == m.open_menu:
            sel = 1
        ab_add_node(ids, roles, parents, labels, values, xs, ys, ws, hs, enableds, focuseds, selecteds, checkeds, 23, box, txt, "", x, m.by, w, m.bh, 1, 0, sel, 0)
        x = x + w
        i = i + 1
    return box

def ab_add_toolbar(ids: "list[i32]", roles: "list[i32]", parents: "list[i32]", labels: "list[str]", values: "list[str]", xs: "list[f64]", ys: "list[f64]", ws: "list[f64]", hs: "list[f64]", enableds: "list[i32]", focuseds: "list[i32]", selecteds: "list[i32]", checkeds: "list[i32]", t: "NativeToolBar", tips: "list[str]", n: "i32", parent: "i32") -> "i32":
    box = ab_add_node(ids, roles, parents, labels, values, xs, ys, ws, hs, enableds, focuseds, selecteds, checkeds, 18, parent, "toolbar", "", t.bx, t.by, t.bw, t.bh, t.enabled, 0, 0, 0)
    i = int(0)
    while i < n and i < t.ntools:
        txt = "tool"
        if i < len(tips):
            txt = tips[i]
        ab_add_node(ids, roles, parents, labels, values, xs, ys, ws, hs, enableds, focuseds, selecteds, checkeds, 3, box, txt, "", t.tool_x(i), t.by + 2.0, 26.0, t.bh - 4.0, t.enabled, 0, 0, t.is_checked(i))
        i = i + 1
    return box

def ab_add_scrollbar(ids: "list[i32]", roles: "list[i32]", parents: "list[i32]", labels: "list[str]", values: "list[str]", xs: "list[f64]", ys: "list[f64]", ws: "list[f64]", hs: "list[f64]", enableds: "list[i32]", focuseds: "list[i32]", selecteds: "list[i32]", checkeds: "list[i32]", s: "NativeScrollBar", parent: "i32") -> "i32":
