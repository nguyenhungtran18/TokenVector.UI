# -*- coding: utf-8 -*-
"""TkvUI.A11yBridge - screen-reader bridge da nen (Phase 4).

Phu thuoc: Core, Text, Platform (detect_platform, tkv_has_file),
A11y (roles, tree_to_json, probes), Widgets.Native (widget->node builders).
DAG: Bridge <- Native, Bridge <- A11y. Khong vong import.

Kien truc:
- Backend pick theo platform + probe DLL/.so (UIA / AT-SPI / NS / TalkBack).
- Role/state map rieng moi nen (UIA ControlType, AT-SPI roles, NS roles,
  Android classes) — khong bitwise (constraint compiler).
- Event router + live-region announcer: log o caller lists, serialize JSON.
- Providers la stub trung thuc: dem + ghi nhan, chi goi native khi probe OK
  (DllNotFoundException se crash exe neu goi chay).
- Dump cay that ra file qua extern WriteAllText (ten rieng ab_file_write).

Tien to ab_*/Ab* — khong trung khi merge.
"""
__tkv_import__ = ["TkvUI.Core", "TkvUI.Text", "TkvUI.Platform", "TkvUI.A11y", "TkvUI.Widgets.Native"]
__tkv_extern_method__ = [{"name": "ab_file_write", "assembly": "mscorlib", "class": "System.IO.File", "method": "WriteAllText", "params": ["str", "str"], "returns": "void"}]

# Backends (tai lieu; so sanh truc tiep OK, gan local dung literal)
AB_BACKEND_NONE = 0
AB_BACKEND_UIA = 1
AB_BACKEND_ATSPI = 2
AB_BACKEND_NS = 3
AB_BACKEND_TALKBACK = 4

# Readers
AB_READER_UNKNOWN = 0
AB_READER_NVDA = 1
AB_READER_NARRATOR = 2
AB_READER_VOICEOVER = 3
AB_READER_TALKBACK = 4

# Event kinds
AB_EV_FOCUS = 1
AB_EV_SELECTION = 2
AB_EV_VALUE = 3
AB_EV_PROPERTY = 4
AB_EV_STATE = 5
AB_EV_ALERT = 6

# State bits (cong don, khong bitwise)
AB_ST_DISABLED = 1
AB_ST_FOCUSED = 2
AB_ST_SELECTED = 4
AB_ST_CHECKED = 8
AB_ST_EXPANDED = 16
AB_ST_READONLY = 32
AB_ST_BUSY = 64
AB_ST_OFFSCREEN = 128

# =========================================================
# BACKEND PICK
# =========================================================
def ab_pick_backend() -> "i32":
    pid = detect_platform()
    if pid == 1:
        if a11y_win_present() == 1:
            return 1
        return 1
    if pid == 2:
        return 2
    if pid == 3:
        return 2
    if pid == 4:
        if a11y_mac_present() == 1:
            return 3
        return 3
    if pid == 5:
        return 4
    if pid == 6:
        return 3
    return 0

def ab_backend_name(b: "i32") -> "str":
    if b == 1:
        return "UIA"
    if b == 2:
        return "AT-SPI"
    if b == 3:
        return "NSAccessibility"
    if b == 4:
        return "TalkBack"
    return "none"

# =========================================================
# JSON ESCAPE - label/value an toan (A11y goc khong escape)
# =========================================================
def ab_hex_digit(v: "i32") -> "str":
    if v == 10:
        return "a"
    if v == 11:
        return "b"
    if v == 12:
        return "c"
    if v == 13:
        return "d"
    if v == 14:
        return "e"
    if v == 15:
        return "f"
    return str(v)

def ab_char_code(ch: "str") -> "i32":
    # Ma don vi ASCII in duoc qua char_code (Text); ngoai bang -> -1
    return char_code(ch)

def ab_json_escape(s: "str") -> "str":
    # Rendition JSON-correct cho ky tu dac biet; ngoai ASCII in duoc -> "?"
    # (dam bao len == bytes khi ghi UTF-8, giong pdf_sanitize).
    # LUU Y compiler: cam so sanh thu tu tren chuoi (ch < " " crash codegen);
    # dung char_code (Text) de kiem tra vung in duoc.
    out = ""
    i = int(0)
    n = len(s)
    while i < n:
        ch = s[i]
        if ch == "\"":
            out = out + "\\\""
        else:
            if ch == "\\":
                out = out + "\\\\"
            else:
                if ch == "\n":
                    out = out + "\\n"
                else:
                    if ab_char_code(ch) < 0:
                        out = out + "?"
                    else:
                        out = out + ch
        i = i + 1
    return out

def ab_q(s: "str") -> "str":
    return "\"" + ab_json_escape(s) + "\""

def ab_node_to_json(nid: "i32", role: "str", parent: "i32", label: "str", value: "str", x: "f64", y: "f64", w: "f64", h: "f64", mask: "i32") -> "str":
    sb = ""
    sb = sb + "{\"nid\":" + str(nid) + ",\"role\":" + ab_q(role) + ",\"parent\":" + str(parent)
    sb = sb + ",\"label\":" + ab_q(label) + ",\"value\":" + ab_q(value)
    sb = sb + ",\"bounds\":[" + str(x) + "," + str(y) + "," + str(w) + "," + str(h) + "]"
    sb = sb + ",\"mask\":" + str(mask) + "}"
    return sb

