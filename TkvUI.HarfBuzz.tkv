"""TkvUI.HarfBuzz - leaf HarfBuzz FFI + shaping orchestration (L2 wire)

Leaf module: khong import Text/Bidi/Widgets -> Text co the import mot chieu
(pha vong import Text <-> Bidi). Chi can Core + Viet (utf8) + Platform (mem/file).
Pinvoke can libharfbuzz.dll; thieu DLL -> hb_lib_present=0, shape ve 0 (skip-sach).
"""
__tkv_import__ = ["TkvUI.Core", "TkvUI.Viet", "TkvUI.Platform"]
