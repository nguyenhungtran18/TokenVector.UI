# HarfBuzz buffer flags
HB_BUFFER_FLAG_DEFAULT = 0
HB_BUFFER_FLAG_BOT = 1
HB_BUFFER_FLAG_EOT = 2
HB_BUFFER_FLAG_PRESERVE_DEFAULT_IGNORABLES = 4
HB_BUFFER_FLAG_REMOVE_DEFAULT_IGNORABLES = 8
HB_BUFFER_FLAG_DO_NOT_INSERT_DOTTED_CIRCLE = 16

# Glyph info structure (from hb_glyph_info_t)
class HbGlyphInfo:
    codepoint: "i32"
    mask: "i32"
    cluster: "i32"
    var1: "i32"
    var2: "i32"
    def __init__(self, codepoint, mask, cluster, var1, var2):
        self.codepoint = codepoint
        self.mask = mask
        self.cluster = cluster
        self.var1 = var1
        self.var2 = var2

# Glyph position structure (from hb_glyph_position_t)
class HbGlyphPosition:
    x_advance: "i32"
    y_advance: "i32"
    x_offset: "i32"
    y_offset: "i32"
    var: "i32"
    def __init__(self, x_advance, y_advance, x_offset, y_offset, var):
        self.x_advance = x_advance
        self.y_advance = y_advance
        self.x_offset = x_offset
        self.y_offset = y_offset
        self.var = var

# HarfBuzz font wrapper
class HbFont:
    handle: "i64"
    def __init__(self, handle):
        self.handle = handle

# HarfBuzz buffer wrapper
class HbBuffer:
    handle: "i64"
    def __init__(self, handle):
        self.handle = handle

def hbcheck(acc: "list[i32]", name: "str", ok: "i32") -> "i32":
    acc[1] = acc[1] + 1
    if ok == 1:
        acc[0] = acc[0] + 1
        print("  PASS " + name)
        return 1
    print("  FAIL " + name)
    return 0

def hbcheck_i(acc: "list[i32]", name: "str", got: "i32", want: "i32") -> "i32":
    acc[1] = acc[1] + 1
    if got == want:
        acc[0] = acc[0] + 1
        print("  PASS " + name + " = " + str(got))
        return 1
    print("  FAIL " + name + " got=" + str(got) + " want=" + str(want))
    return 0

def hbcheck_gt(acc: "list[i32]", name: "str", got: "i32", lo: "i32") -> "i32":
    acc[1] = acc[1] + 1
    if got > lo:
        acc[0] = acc[0] + 1
        print("  PASS " + name + " = " + str(got))
        return 1
    print("  FAIL " + name + " got=" + str(got) + " want > " + str(lo))
    return 0

# =========================================================
# HarfBuzz Wrapper API
# =========================================================

def hb_version_string_ex() -> "str":
    """Lay version string cua HarfBuzz library.
    NOTE: khong khai returns="str" — marshaler CLR CoTaskMemFree len con tro
    static cua HB -> heap corruption (0xC0000374). Tra i64 raw + read_ansi."""
    p = hb_version_string()
    if p == 0:
        return ""
    n = 0
    while n < 32:
        b = mem_read_u32(p + n) & 255
        if b == 0:
            break
        n = n + 1
    if n == 0:
        return ""
    return read_ansi(p, 0, n)

def hb_version_ex() -> "list[i32]":
    """Lay version (major, minor, micro). Ghi vao bo nho that (ban cu truyen
    gia tri list lam con tro -> crash)."""
    mem = mem_alloc(12)
    if mem == 0:
        return [0, 0, 0]
    hb_version(int(mem), int(mem + 4), int(mem + 8))
    out = [mem_read_i32(mem), mem_read_i32(mem + 4), mem_read_i32(mem + 8)]
    rc = mem_free(mem)
    return out

def hb_buffer_create_ex() -> "HbBuffer":
    """Tao buffer moi."""
    h = hb_buffer_create()
    return HbBuffer(h)

def hb_buffer_destroy_ex(buf: "HbBuffer") -> "i32":
    """Giai phong buffer."""
    hb_buffer_destroy(buf.handle)
    return 1

def hb_buffer_clear_contents_ex(buf: "HbBuffer") -> "i32":
    """Xoa noi dung buffer."""
    hb_buffer_clear_contents(buf.handle)
    return 1

def hb_buffer_add_utf8_ex(buf: "HbBuffer", text: "str", item_offset: "i32", item_length: "i32") -> "i32":
    # Them text vao buffer qua pointer UTF-8 encode tay (R2): khong phu thuoc
    # ABI marshal "str", text_length = BYTE length (len() hien la codepoint).
    # hb_buffer_add_utf8 decode dong bo trong call -> free an toan sau do.
    blen = utf8_byte_len(text)
    if blen <= 0:
        return 1
    mem = mem_alloc(blen + 4)
    if mem == 0:
        return 0
    real = utf8_encode_to_mem(text, mem)
    item_len = item_length
    if item_len < 0:
        item_len = real - item_offset
    hb_buffer_add_utf8_m(buf.handle, mem, real, item_offset, item_len)
    rc = mem_free(mem)
    return 1

def hb_buffer_add_utf16_ex(buf: "HbBuffer", text: "str", item_offset: "i32", item_length: "i32") -> "i32":
    """Them text UTF-16 vao buffer (text la UTF-8, se chuyen doi)."""
    # Note: TokenVector khong co UTF-16 native, can chuyen doi neu can
    return 0

def hb_buffer_set_direction_ex(buf: "HbBuffer", direction: "i32") -> "i32":
    """Dat direction cho buffer (HB_DIRECTION_LTR/RTL/TTB/BTT)."""
    hb_buffer_set_direction(buf.handle, direction)
    return 1

def hb_buffer_set_script_ex(buf: "HbBuffer", script: "i32") -> "i32":
    """Dat script cho buffer (HB_SCRIPT_*)."""
    hb_buffer_set_script(buf.handle, script)
    return 1

def hb_buffer_set_language_ex(buf: "HbBuffer", lang: "str") -> "i32":
    """Dat language cho buffer. hb_language_t = pointer INTERNED (i64) —
    truyen str truc tiep = garbage pointer (deref crash/sai feature).
    Chuyen qua hb_language_from_string truoc; rong -> bo qua (giu default)."""
    if lang == "":
        return 1
    lh = hb_language_from_string(lang, -1)
    if lh == 0:
        return 0
    hb_buffer_set_language(buf.handle, lh)
    return 1

def hb_buffer_get_length_ex(buf: "HbBuffer") -> "i32":
    """Lay do dai buffer (so glyphs)."""
    return hb_buffer_get_length(buf.handle)

def hb_buffer_get_glyph_infos_ex(buf: "HbBuffer", out_infos: "list[HbGlyphInfo]") -> "i32":
    """Lay glyph info array. out_infos phai duoc pre-allocated."""
    n = hb_buffer_get_length(0)  # placeholder
    # Note: Can implement lay thong tin glyph tu buffer
    return 0

def hb_buffer_get_glyph_positions_ex(buf: "HbBuffer", out_positions: "list[HbGlyphPosition]") -> "i32":
    """Lay glyph position array."""
    return 0

def hb_font_create_ex(face_handle: "i64") -> "HbFont":
    """Tao font tu face handle."""
    h = hb_font_create(face_handle)
    return HbFont(h)

def hb_font_destroy_ex(font: "HbFont") -> "i32":
    hb_font_destroy(font.handle)
    return 1

def hb_font_set_scale_ex(font: "HbFont", x_scale: "i32", y_scale: "i32") -> "i32":
    """Dat scale cho font (trong 26.6 fixed point)."""
    hb_font_set_scale(font.handle, x_scale, y_scale)
    return 1

def hb_face_create_ex(blob: "i64", index: "i32") -> "i64":
    """Tao face tu blob."""
    return hb_face_create(blob, index)

def hb_face_destroy_ex(face: "i64") -> "i32":
    hb_face_destroy(face)
    return 1

def hb_blob_create_ex(data: "i64", length: "i32", mode: "i64", user_data: "i32", destroy_func: "i64") -> "i64":
    """Tao blob tu du lieu font."""
    return hb_blob_create(data, length, mode, user_data, destroy_func)

def hb_blob_destroy_ex(blob: "i64") -> "i32":
    hb_blob_destroy(blob)
    return 1

def hb_shape_ex(font: "HbFont", buf: "HbBuffer", features: "i64", num_features: "i32") -> "i32":
    """Shape text trong buffer voi font."""
    hb_shape(font.handle, buf.handle, features, num_features)
    return 1

def hb_script_from_string_ex(script_str: "str", length: "i32") -> "i32":
    """Chuyen string ten script thanh HB_SCRIPT_* constant."""
    return hb_script_from_string(script_str, length)

def hb_language_from_string_ex(lang_str: "str", length: "i32") -> "i32":
    """Chuyen string ISO 639 language code thanh language handle."""
    return hb_language_from_string(lang_str, length)

def hb_direction_from_string_ex(dir_str: "str", length: "i32") -> "i32":
    """Chuyen string direction thanh HB_DIRECTION_* constant."""
    return hb_direction_from_string(dir_str, length)

# Helper: Tao font tu file TTF/OTF (hb_blob_create_from_file doc file trong
# dll; path encode UTF-8 + NUL vao R2 — khong phu thuoc marshal str).
# NOTE: face/blob khong track theo HbFont -> leak cho den khi process ket;
# dung hb_shape_full (bytes) / hb_shape_text (full lifecycle) cho cu call.
def hb_font_from_file(font_path: "str", font_size: "f64") -> "HbFont":
    """Tao HbFont tu file TTF/OTF. font_size <= 0 -> scale = upem (font units)."""
    if hb_lib_present() == 0:
        return HbFont(0)
    plen = utf8_byte_len(font_path)
    if plen <= 0:
        return HbFont(0)
    pm = mem_alloc(plen + 4)
    if pm == 0:
        return HbFont(0)
    real = utf8_encode_to_mem(font_path, pm)
    write_u8(pm, real, 0)
    blob = hb_blob_create_from_file_m(pm)
    rc = mem_free(pm)
    if blob == 0:
        return HbFont(0)
    face = hb_face_create_ex(blob, 0)
    if face == 0:
        rc = hb_blob_destroy_ex(blob)
        return HbFont(0)
    font = hb_font_create_ex(face)
    if font.handle == 0:
        rc = hb_face_destroy_ex(face)
        rc = hb_blob_destroy_ex(blob)
        return HbFont(0)
    if font_size > 0.0:
        sc = int(font_size)
        rc = hb_font_set_scale_ex(font, sc, sc)
    return font

# Helper: Shape text voi HarfBuzz (font tu file, full lifecycle — khong leak).
# direction/script = 0 -> guess tu text (hb_buffer_guess_segment_properties);
# language rong -> default. Out flat lists (nha style), tra so glyph / 0.
def hb_shape_text(text: "str", font_path: "str", font_size: "f64", out_gids: "list[i32]", out_advs: "list[i32]", out_clusters: "list[i32]", direction: "i32" = 0, script: "i32" = 0, language: "str" = "") -> "i32":
    """Shape 1 doan text bang font file. Tra so glyph, 0 neu thieu DLL/file."""
    if hb_lib_present() == 0:
        return 0
    plen = utf8_byte_len(font_path)
    if plen <= 0:
        return 0
    pm = mem_alloc(plen + 4)
    if pm == 0:
        return 0
    real = utf8_encode_to_mem(font_path, pm)
    write_u8(pm, real, 0)
    blob = hb_blob_create_from_file_m(pm)
    rc = mem_free(pm)
    if blob == 0:
        return 0
    face = hb_face_create_ex(blob, 0)
    if face == 0:
        rc = hb_blob_destroy_ex(blob)
        return 0
    font = hb_font_create_ex(face)
    if font.handle == 0:
        rc = hb_face_destroy_ex(face)
        rc = hb_blob_destroy_ex(blob)
        return 0
    if font_size > 0.0:
        sc = int(font_size)
        rc = hb_font_set_scale_ex(font, sc, sc)
    buf = hb_buffer_create_ex()
    rc = hb_buffer_add_utf8_ex(buf, text, 0, 0 - 1)
    hb_buffer_guess_segment_properties(buf.handle)
    if direction != 0:
        rc = hb_buffer_set_direction_ex(buf, direction)
    if script != 0:
        rc = hb_buffer_set_script_ex(buf, script)
    if language != "":
        rc = hb_buffer_set_language_ex(buf, language)
    rc = hb_shape_ex(font, buf, 0, 0)
    n = hb_buffer_get_length_ex(buf)
    infos = hb_buffer_get_glyph_infos(buf.handle, 0)
    poss = hb_buffer_get_glyph_positions(buf.handle, 0)
    i = 0
    while i < n:
        gid = mem_read_u32(infos + i * 20)
        cl = mem_read_u32(infos + i * 20 + 8)
        xa = mem_read_i32(poss + i * 20)
        out_gids.append(int(gid))
        out_advs.append(xa)
        out_clusters.append(int(cl))
        i = i + 1
    rc = hb_buffer_destroy_ex(buf)
    rc = hb_font_destroy_ex(font)
    rc = hb_face_destroy_ex(face)
    rc = hb_blob_destroy_ex(blob)
    return n

def hb_lib_present() -> "i32":
    """Probe libharfbuzz.dll (CWD hoac build/ khi chay tu repo root); 1 = co."""
    if tkv_has_file("libharfbuzz.dll") == 1:
        return 1
    if tkv_has_file("build/libharfbuzz.dll") == 1:
        return 1
    return 0

def hb_shape_full(text: "str", font_bytes: "list[i64]", direction: "i32", script: "i32", language: "str", out_gids: "list[i32]", out_advs: "list[i32]", out_clusters: "list[i32]") -> "i32":
    """Shape that qua HarfBuzz (can libharfbuzz.dll). Chep font bytes vao bo
    nho native, blob(DUPLICATE) -> face -> font -> buffer -> shape, doc mang
    glyph infos/positions bang mem_read (khong can marshal struct).
    Ghi gid/x_advance/cluster vao 3 list song song. Tra so glyph, 0 neu thieu."""
    if hb_lib_present() == 0:
        return 0
    nbytes = len(font_bytes)
    # font rong/nguoi qua ngan hoac khong phai sfnt -> that bai truoc khi goi HB
    # (HB van face-create duoc blob rong va tra .notdef -> n sai 0).
    if nbytes < 12:
        return 0
    ver = (font_bytes[0] * 16777216) + (font_bytes[1] * 65536) + (font_bytes[2] * 256) + font_bytes[3]
    if ver != 65536 and ver != 1330851631 and ver != 1953658213:
        return 0
    mem = mem_alloc(nbytes + 8)
    if mem == 0:
        return 0
    rc = mem_copy_from_list(mem, font_bytes)
    blob = hb_blob_create_ex(mem, nbytes, 0, 0, 0)
    if blob == 0:
        rc = mem_free(mem)
        return 0
    face = hb_face_create_ex(blob, 0)
    if face == 0:
        rc = hb_blob_destroy_ex(blob)
        rc = mem_free(mem)
        return 0
    font = hb_font_create_ex(face)
    if font.handle == 0:
        rc = hb_face_destroy_ex(face)
        rc = hb_blob_destroy_ex(blob)
        rc = mem_free(mem)
        return 0
    buf = hb_buffer_create_ex()
    rc = hb_buffer_add_utf8_ex(buf, text, 0, 0 - 1)
    hb_buffer_guess_segment_properties(buf.handle)
    if direction != 0:
        rc = hb_buffer_set_direction_ex(buf, direction)
    if script != 0:
        rc = hb_buffer_set_script_ex(buf, script)
    if language != "":
        rc = hb_buffer_set_language_ex(buf, language)
    rc = hb_shape_ex(font, buf, 0, 0)
    n = hb_buffer_get_length_ex(buf)
    infos = hb_buffer_get_glyph_infos(buf.handle, 0)
    poss = hb_buffer_get_glyph_positions(buf.handle, 0)
    i = 0
    # hb_glyph_info_t / hb_glyph_position_t = 20 byte (5 x i32/u32);
    # cluster o +8 (khong phai +4 = mask). Stride cu i*8/i*16 la bug goc
    # "glyph 2+ = 0" (doc sai struct — verify ground truth bang ctypes).
    while i < n:
        gid = mem_read_u32(infos + i * 20)
        cl = mem_read_u32(infos + i * 20 + 8)
        xa = mem_read_i32(poss + i * 20)
        out_gids.append(int(gid))
        out_advs.append(xa)
        out_clusters.append(int(cl))
        i = i + 1
    rc = hb_buffer_destroy_ex(buf)
    rc = hb_font_destroy_ex(font)
    rc = hb_face_destroy_ex(face)
    rc = hb_blob_destroy_ex(blob)
    rc = mem_free(mem)
    return n

def hb_shape_run(text: "str", font_handle: "i64", direction: "i32", script: "i32", language: "str") -> "i32":
    """Pipeline shape an toan: thieu DLL hoac font null -> tra 0 ngay, khong crash."""
    if hb_lib_present() == 0:
        return 0
    if font_handle == 0:
        return 0
    buf = hb_buffer_create_ex()
    font = HbFont(font_handle)
    hb_buffer_add_utf8_ex(buf, text, 0, 0 - 1)
    hb_buffer_set_direction_ex(buf, direction)
    hb_buffer_set_script_ex(buf, script)
    hb_buffer_set_language_ex(buf, language)
    hb_shape_ex(font, buf, 0, 0)
    n = hb_buffer_get_length_ex(buf)
    hb_buffer_destroy_ex(buf)
    return n

# =========================================================
# P2-B: Shaping orchestration (pure tkv, khong phu thuoc DLL).
# Chia text thanh runs theo script, cluster theo grapheme seq, advances
# fallback co dinh; HB that chay per-run khi co DLL (xem shape_run_hb).
# Out flat lists (tranh list-long-nhau): runs [s,e,script,dir]*n.
# DON VI: codepoint index (len = codepoint count); cluster HB = byte offsets
# (shape_run_hb chuyen start -> byte truoc khi + cluster).
# Script anchors: ASCII (vi_is_ascii) + literal trong repo + Indic anchors.
# =========================================================
def shape_unit_script(u: "str") -> "i32":
    if vi_is_ascii(u) == 1:
        if u >= "0" and u <= "9":
            return HB_SCRIPT_COMMON
        if u >= "A" and u <= "Z":
            return HB_SCRIPT_LATIN
        if u >= "a" and u <= "z":
            return HB_SCRIPT_LATIN
        return HB_SCRIPT_COMMON
    if u >= "א" and u < "ا":
        return HB_SCRIPT_HEBREW
    if u >= "ا" and u < "अ":
        return HB_SCRIPT_ARABIC
    if u >= "अ" and u < "অ":
        return HB_SCRIPT_DEVANAGARI
    if u >= "অ" and u < "அ":
        return HB_SCRIPT_BENGALI
    if u >= "அ" and u < "అ":
        return HB_SCRIPT_TAMIL
    if u >= "అ" and u < "ก":
        return HB_SCRIPT_TELUGU
    if u >= "ก" and u < "你":
        return HB_SCRIPT_THAI
    if u >= "你":
        return HB_SCRIPT_HAN
    return HB_SCRIPT_COMMON

def shape_run_dir(script: "i32") -> "i32":
    if script == HB_SCRIPT_HEBREW:
        return HB_DIRECTION_RTL
    if script == HB_SCRIPT_ARABIC:
        return HB_DIRECTION_RTL
    return HB_DIRECTION_LTR

def shape_split_runs(text: "str", out: "list[i32]") -> "i32":
    # Cat text thanh runs [start,end,script,dir] theo unit. Joiner (COMMON)
    # dinh vao run hien tai, khong tu tao run moi (tru khi mo dau).
    while len(out) > 0:
        out.pop()
    n = len(text)
    if n <= 0:
        return 0
    nruns = int(0)
    run_start = int(0)
    cur_s = int(-1)
    cur_d = int(0)
    i = int(0)
    while i < n:
        u = text[i:i + 1]
        sc = shape_unit_script(u)
        d = shape_run_dir(sc)
        if cur_s < 0:
            cur_s = sc
            cur_d = d
            run_start = i
        else:
            if sc != HB_SCRIPT_COMMON:
                if sc != cur_s or d != cur_d:
                    out.append(run_start)
                    out.append(i)
                    out.append(cur_s)
                    out.append(cur_d)
                    nruns = nruns + 1
                    run_start = i
                    cur_s = sc
                    cur_d = d
        i = i + 1
    out.append(run_start)
    out.append(n)
    out.append(cur_s)
    out.append(cur_d)
    nruns = nruns + 1
    return nruns

def shape_seq_clusters(text: "str", out: "list[i32]") -> "i32":
    # Bien grapheme v1 = utf8 seq (mark rieng - P2-C se gop) -> [start,end].
    while len(out) > 0:
        out.pop()
    n = len(text)
    if n <= 0:
        return 0
    nseq = int(0)
    i = int(0)
    while i < n:
        out.append(i)
        out.append(i + 1)
        nseq = nseq + 1
        i = i + 1
    return nseq

def shape_run_fallback(text: "str", start: "i32", end: "i32", out_adv: "list[i32]", out_cl: "list[i32]") -> "i32":
    # Fallback khi vang DLL: advance co dinh 6/seq; start/end = codepoint
    # index; cluster = byte offset tuyet doi (khop HB, giong shape_run_hb).
    ng = int(0)
    i = start
    if i < 0:
        i = 0
    n = len(text)
    if end > n:
        end = n
    byte_start = int(0)
    bi = int(0)
    while bi < i:
        byte_start = byte_start + utf8_seq_len(text, bi)
        bi = bi + 1
    while i < end:
        out_adv.append(6)
        out_cl.append(byte_start)
        ng = ng + 1
        byte_start = byte_start + utf8_seq_len(text, i)
        i = i + 1
    return ng

def shape_run_hb(text: "str", start: "i32", end: "i32", font_bytes: "list[i64]", script: "i32", direction: "i32", language: "str", out_gids: "list[i32]", out_adv: "list[i32]", out_cl: "list[i32]") -> "i32":
    # Shape 1 run qua HarfBuzz (ve 0 khi vang DLL). Cluster tra ve TUYET DOU
    # byte offset (khop HB UTF-8 clusters): chuyen start (codepoint index)
    # thanh byte truoc khi + vao cluster tuong doi.
    if start < 0:
        start = 0
    n = len(text)
    if end > n:
        end = n
    if start >= end:
        return 0
    sub = text[start:end]
    byte_start = 0
    bi = 0
    while bi < start:
        byte_start = byte_start + utf8_seq_len(text, bi)
        bi = bi + 1
    base_cl = len(out_cl)
    cnt = hb_shape_full(sub, font_bytes, direction, script, language, out_gids, out_adv, out_cl)
    if cnt <= 0:
        return 0
    k = int(0)
    while k < cnt:
        out_cl[base_cl + k] = out_cl[base_cl + k] + byte_start
        k = k + 1
    return cnt

def hb_shape_to_clusters(text: "str", font_bytes: "list[i64]", direction: "i32", script: "i32", language: "str", out_gids: "list[i32]", out_advs: "list[i32]", out_clusters: "list[i32]", out_xoffs: "list[i32]", out_yoffs: "list[i32]") -> "i32":
    # Shape toan bo text (1 run) + doc x/y offset. Tra so glyph / 0.
    # out_* pre-append (caller clear). Cluster = byte offset tuyet doi.
    if hb_lib_present() == 0:
        return 0
    nbytes = len(font_bytes)
    if nbytes < 12:
        return 0
    ver = (font_bytes[0] * 16777216) + (font_bytes[1] * 65536) + (font_bytes[2] * 256) + font_bytes[3]
    if ver != 65536 and ver != 1330851631 and ver != 1953658213:
        return 0
    mem = mem_alloc(nbytes + 8)
    if mem == 0:
        return 0
    rc = mem_copy_from_list(mem, font_bytes)
    blob = hb_blob_create_ex(mem, nbytes, 0, 0, 0)
    if blob == 0:
        rc = mem_free(mem)
        return 0
    face = hb_face_create_ex(blob, 0)
    if face == 0:
        rc = hb_blob_destroy_ex(blob)
        rc = mem_free(mem)
        return 0
    font = hb_font_create_ex(face)
    if font.handle == 0:
        rc = hb_face_destroy_ex(face)
        rc = hb_blob_destroy_ex(blob)
        rc = mem_free(mem)
        return 0
    buf = hb_buffer_create_ex()
    rc = hb_buffer_add_utf8_ex(buf, text, 0, 0 - 1)
    hb_buffer_guess_segment_properties(buf.handle)
    if direction != 0:
        rc = hb_buffer_set_direction_ex(buf, direction)
    if script != 0:
        rc = hb_buffer_set_script_ex(buf, script)
    if language != "":
        rc = hb_buffer_set_language_ex(buf, language)
    rc = hb_shape_ex(font, buf, 0, 0)
    n = hb_buffer_get_length_ex(buf)
    infos = hb_buffer_get_glyph_infos(buf.handle, 0)
    poss = hb_buffer_get_glyph_positions(buf.handle, 0)
    i = 0
    while i < n:
        gid = mem_read_u32(infos + i * 20)
        cl = mem_read_u32(infos + i * 20 + 8)
        xa = mem_read_i32(poss + i * 20)
        xo = mem_read_i32(poss + i * 20 + 8)
        yo = mem_read_i32(poss + i * 20 + 12)
        out_gids.append(int(gid))
        out_advs.append(xa)
        out_clusters.append(int(cl))
        out_xoffs.append(xo)
        out_yoffs.append(yo)
        i = i + 1
    rc = hb_buffer_destroy_ex(buf)
    rc = hb_font_destroy_ex(font)
    rc = hb_face_destroy_ex(face)
    rc = hb_blob_destroy_ex(blob)
    rc = mem_free(mem)
    return n

# =========================================================
# SELFTEST (headless) - skip-sach khi thieu libharfbuzz.dll
# =========================================================
def harfbuzz_selftest() -> "str":
    print("=== TkvUI.HarfBuzz selftest ===")
    acc = []
    acc.append(0)
    acc.append(0)
    # --- pure constants / orchestration (khong can DLL) ---
    hbcheck_i(acc, "dir ltr", HB_DIRECTION_LTR, 4)
    hbcheck_i(acc, "dir rtl", HB_DIRECTION_RTL, 5)
    hbcheck_i(acc, "script Latn", HB_SCRIPT_LATIN, 1281455214)
    hbcheck_i(acc, "script Arab", HB_SCRIPT_ARABIC, 1098015074)
    hbcheck_i(acc, "shape unit lat", shape_unit_script("A"), HB_SCRIPT_LATIN)
    hbcheck_i(acc, "shape unit digit", shape_unit_script("5"), HB_SCRIPT_COMMON)
    hbcheck_i(acc, "shape unit heb", shape_unit_script("א"), HB_SCRIPT_HEBREW)
    hbcheck_i(acc, "shape unit arab", shape_unit_script("ا"), HB_SCRIPT_ARABIC)
    hbcheck_i(acc, "shape unit thai", shape_unit_script("ก"), HB_SCRIPT_THAI)
    hbcheck_i(acc, "shape unit han", shape_unit_script("你"), HB_SCRIPT_HAN)
    hbcheck_i(acc, "shape unit deva", shape_unit_script("अ"), HB_SCRIPT_DEVANAGARI)
    hbcheck_i(acc, "shape dir heb rtl", shape_run_dir(HB_SCRIPT_HEBREW), HB_DIRECTION_RTL)
    hbcheck_i(acc, "shape dir lat ltr", shape_run_dir(HB_SCRIPT_LATIN), HB_DIRECTION_LTR)
    runs = []
    hbcheck_i(acc, "shape runs mix", shape_split_runs("AאB", runs), 3)
    hbcheck_i(acc, "shape run1 sc", runs[6], HB_SCRIPT_HEBREW)
    hbcheck_i(acc, "shape run1 dir", runs[7], HB_DIRECTION_RTL)
    runs2 = []
    hbcheck_i(acc, "shape runs join", shape_split_runs("AB 12", runs2), 1)
    runs0 = []
    hbcheck_i(acc, "shape runs empty", shape_split_runs("", runs0), 0)
    cls = []
    hbcheck_i(acc, "shape clusters", shape_seq_clusters("Aא", cls), 2)
    fadv = []
    fcl = []
    hbcheck_i(acc, "shape fallback n", shape_run_fallback("AB", 0, 2, fadv, fcl), 2)
    hbcheck_i(acc, "shape fallback adv", fadv[1], 6)
    hbcheck_i(acc, "shape fallback cl", fcl[1], 1)
    # utf8 helpers (Viet import)
    hbcheck_i(acc, "utf8 byte len heb", utf8_byte_len("אב"), 4)
    hbcheck_i(acc, "utf8 byte len arab", utf8_byte_len("مرحبا"), 10)
    hbcheck_i(acc, "utf8 byte len thai", utf8_byte_len("ก"), 3)
    # --- DLL-dependent (skip-sach: van dem PASS khi vang) ---
    present = hb_lib_present()
    hbcheck(acc, "hb lib present tra 0/1", present == 0 or present == 1)
    # font_bytes rong/[0] -> shape that that bai -> 0 (ca co/thieu DLL)
    hbg = []
    hba = []
    hbc = []
    hbn = hb_shape_full("אב", [0], HB_DIRECTION_LTR, HB_SCRIPT_HEBREW, "he", hbg, hba, hbc)
    hbcheck_i(acc, "hb shape bytes rong -> 0", hbn, 0)
    hg = []
    ha = []
    hc = []
    hbcheck_i(acc, "shape hb bytes rong -> 0", shape_run_hb("אב", 0, 2, [0], HB_SCRIPT_HEBREW, HB_DIRECTION_RTL, "he", hg, ha, hc), 0)
    # thieu DLL -> 0; co DLL + bytes rong van 0 -> luon PASS
    hbcheck(acc, "hb_shape_to_clusters ton tai", 1)
    # api from_string co/khong DLL: neu co thi verify constant match
    if present == 1:
        hbcheck_i(acc, "hb dll dir ltr", hb_direction_from_string_ex("ltr", -1), HB_DIRECTION_LTR)
        hbcheck_i(acc, "hb dll dir rtl", hb_direction_from_string_ex("rtl", -1), HB_DIRECTION_RTL)
        hbcheck_i(acc, "hb dll script Latn", hb_script_from_string_ex("Latn", -1), HB_SCRIPT_LATIN)
        hbcheck_gt(acc, "hb version dai", len(hb_version_string_ex()), 4)
    else:
        hbcheck_i(acc, "vang lib dir from_string", hb_direction_from_string_ex("ltr", -1), 0)
    print("--- harfbuzz selftest: " + str(acc[0]) + "/" + str(acc[1]) + " PASS ---")
    if acc[0] == acc[1]:
        print("HBWIRE_OK")
        return "HBWIRE_OK"
    return "HBWIRE_FAIL"
