# HarfBuzz direction constants (GIA TRI THAT tu hb-common.h / verify bang
# hb_direction_from_string tren libharfbuzz 14.5.0: ltr=4 rtl=5 ttb=6 btt=7;
# 0 = INVALID — cu LTR=0/RTL=1 truoc day khong dung, set_direction vo nghia).
HB_DIRECTION_INVALID = 0
HB_DIRECTION_LTR = 4
HB_DIRECTION_RTL = 5
HB_DIRECTION_TTB = 6
HB_DIRECTION_BTT = 7

# HarfBuzz script constants — tag ISO 15924 (hb_script_t = HB_TAG), lay dung
# gia tri tu hb_script_from_string tren dll 14.5.0 (khong phai so nho 0..31;
# set_script voi so nho = script rong, khong co GSUB script-ruled features).
# Zyyy=COMMON, Qaai=INHERITED, con lai nhu code ISO tuong ung.
HB_SCRIPT_COMMON = 1517910393
HB_SCRIPT_INHERITED = 1365336425
HB_SCRIPT_ARABIC = 1098015074
HB_SCRIPT_HEBREW = 1214603890
HB_SCRIPT_SYRIAC = 1400468067
HB_SCRIPT_THAANA = 1416126817
HB_SCRIPT_DEVANAGARI = 1147500129
