HB_SCRIPT_CHEROKEE = 1130915186
HB_SCRIPT_UNIFIED_CANADIAN_ABORIGINAL_SYLLABICS = 1130458739
HB_SCRIPT_OGHAM = 1332175213
HB_SCRIPT_RUNIC = 1383427698
HB_SCRIPT_KHMER = 1265134962
HB_SCRIPT_MONGOLIAN = 1299148391
